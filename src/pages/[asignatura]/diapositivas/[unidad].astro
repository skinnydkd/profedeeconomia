---
import { getCollection } from 'astro:content';
import { readFileSync, existsSync } from 'node:fs';
import { resolve } from 'node:path';
import type { GetStaticPaths } from 'astro';
import Deck from '@components/slides/Deck.astro';
import { buildDeck } from '@/lib/slides/build-deck';
import { getLocale } from '@/i18n/locale';
import '@/styles/global.css';
import '@/styles/slides.css';

export const getStaticPaths = (async () => {
  const units = await getCollection('libro');
  return units
    .filter((u) => u.data.estado === 'publicado' && u.data.lang === 'es')
    .map((u) => {
      const unidad = u.id.split('/').pop()!.replace(/\.mdx?$/, '');
      return { params: { asignatura: u.data.asignatura, unidad }, props: { asignatura: u.data.asignatura, unidad } };
    });
}) satisfies GetStaticPaths;

const { asignatura, unidad } = Astro.props as { asignatura: string; unidad: string };
const locale = getLocale(Astro.currentLocale);

// Under /ca, build the deck from the Valencian libro sibling (ES fallback when
// the translation is missing). The route slug stays the ES unit slug.
const dir = resolve('src/content/asignaturas', asignatura, 'libro');
const candidates =
  locale === 'ca'
    ? [`${unidad}.ca.mdx`, `${unidad}.ca.md`, `${unidad}.mdx`, `${unidad}.md`]
    : [`${unidad}.mdx`, `${unidad}.md`];
const filePath = candidates.map((f) => resolve(dir, f)).find((p) => existsSync(p))!;
const raw = readFileSync(filePath, 'utf8');
const deck = buildDeck(raw, locale);

const copy = {
  es: { diapositivas: 'Diapositivas' },
  ca: { diapositivas: 'Diapositives' },
}[locale];
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{deck.title} — {copy.diapositivas} · profedeeconomia.es</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <Deck deck={deck} locale={locale} />
  </body>
</html>
