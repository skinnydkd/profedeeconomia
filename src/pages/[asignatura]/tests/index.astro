---
import BaseLayout from '@layouts/BaseLayout.astro';
import { ASIGNATURA_SLUGS, ASIGNATURAS } from '@/lib/asignaturas';
import { breadcrumbLd } from '@/lib/seo';
import { getCollection } from 'astro:content';
import { getLocale } from '@/i18n/locale';
import { pickLocalizedEntry } from '@/i18n/content-locale';
import { localizeAsignatura } from '@/i18n/asignaturas-ca';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  return ASIGNATURA_SLUGS.filter((slug) => ASIGNATURAS[slug].estado === 'publicado').map((slug) => ({
    params: { asignatura: slug },
    props: { asignatura: ASIGNATURAS[slug] },
  }));
}) satisfies GetStaticPaths;

const locale = getLocale(Astro.currentLocale);
const a = localizeAsignatura(Astro.props.asignatura, locale);

const all = await getCollection('tests');
const caById = new Map(
  all.filter((t) => t.data.estado === 'publicado' && t.data.lang === 'ca').map((t) => [t.id, t]),
);
const tests = all
  .filter((t) => t.data.asignatura === a.slug && t.data.estado === 'publicado' && t.data.lang === 'es')
  .sort((x, y) => x.data.unidad_relacionada - y.data.unidad_relacionada)
  .map((t) => pickLocalizedEntry(t, caById, locale));

// Match each test with its libro unit so we can show the unit lema (localized)
const allLibro = await getCollection('libro');
const libroCaById = new Map(allLibro.filter((u) => u.data.lang === 'ca').map((u) => [u.id, u]));
const libroBySlug = new Map(
  allLibro
    .filter((u) => u.data.asignatura === a.slug && u.data.lang === 'es')
    .map((u) => [u.data.unidad, pickLocalizedEntry(u, libroCaById, locale)])
);

const copy = {
  es: {
    inicio: 'Inicio', tests: 'Tests', titulo: 'Tests de autoevaluación',
    descripcion: `Tests de autoevaluación para cada unidad de ${a.title}.`,
    vacio: 'Los tests se publicarán a medida que se completen las unidades.',
    intro: 'Un test por unidad. Auto-corregidos en el navegador, pensados para repaso o examen rápido. Las preguntas son originales y todas tienen explicación.',
    meta: (n: number) => `${n} ${n === 1 ? 'test' : 'tests'} · ~10 preguntas cada uno`,
    preguntas: 'preguntas', empezar: 'Empezar test →',
    nota: 'Los tests son una herramienta de repaso, no de evaluación oficial. Las preguntas y respuestas están redactadas a partir del contenido del libro de la unidad correspondiente. Si encuentras una pregunta confusa o una respuesta discutible, escríbenos a',
  },
  ca: {
    inicio: 'Inici', tests: 'Tests', titulo: "Tests d'autoavaluació",
    descripcion: `Tests d'autoavaluació per a cada unitat de ${a.title}.`,
    vacio: 'Els tests es publicaran a mesura que es completen les unitats.',
    intro: 'Un test per unitat. Autocorregits al navegador, pensats per a repàs o examen ràpid. Les preguntes són originals i totes tenen explicació.',
    meta: (n: number) => `${n} ${n === 1 ? 'test' : 'tests'} · ~10 preguntes cadascun`,
    preguntas: 'preguntes', empezar: 'Començar test →',
    nota: "Els tests són una ferramenta de repàs, no d'avaluació oficial. Les preguntes i respostes estan redactades a partir del contingut del llibre de la unitat corresponent. Si trobes una pregunta confusa o una resposta discutible, escriu-nos a",
  },
}[locale];

const breadcrumb = breadcrumbLd([
  { name: copy.inicio, path: '/' },
  { name: a.shortLabel, path: `/${a.slug}/` },
  { name: copy.tests, path: `/${a.slug}/tests/` },
]);
---

<BaseLayout
  title={`${copy.tests} — ${a.shortLabel}`}
  description={copy.descripcion}
  noindex
  jsonLd={breadcrumb}
  contentLang={locale}
>
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">{copy.inicio}</a> <span class="sep">›</span>
      <a href={`/${a.slug}/`}>{a.shortLabel}</a> <span class="sep">›</span>
      <span>{copy.tests}</span>
    </nav>
  </div>

  <section class="hero">
    <div class="container">
      <span class="kicker kicker--sentence">{a.shortLabel} · {copy.tests}</span>
      <h1>{copy.titulo}</h1>
      <p class="lede">
        {tests.length === 0 ? copy.vacio : copy.intro}
      </p>
      {tests.length > 0 && (
        <p class="meta">
          {copy.meta(tests.length)}
        </p>
      )}
    </div>
  </section>

  {tests.length > 0 && (
    <section class="grid">
      <div class="container">
        <ul class="card-grid">
          {tests.map((t) => {
            const slug = t.id.split('/').pop()?.replace(/\.mdx?$/, '').replace(/\.ca$/, '');
            const unit = libroBySlug.get(t.data.unidad_relacionada);
            return (
              <li class="card">
                <div class="card__num">{String(t.data.unidad_relacionada).padStart(2, '0')}</div>
                <h3 class="card__title">{t.data.title}</h3>
                {unit?.data.lema && <p class="card__lede">{unit.data.lema}</p>}
                <div class="card__meta">
                  <span>{t.data.preguntas.length} {copy.preguntas}</span>
                  {t.data.duracion_estimada && <span>· {t.data.duracion_estimada}</span>}
                </div>
                <a class="cta" href={`/${a.slug}/tests/${slug}/`}>{copy.empezar}</a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <section class="note">
    <div class="container">
      <p class="note-text">
        {copy.nota}
        <a class="editorial-link" href="mailto:hola@profedeeconomia.es">hola@profedeeconomia.es</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4vw, 3rem);
  }
  .breadcrumb { font-size: 0.92rem; color: var(--color-ink-mute); margin: 2rem 0; }
  .breadcrumb a { color: var(--color-ink-mute); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-terra); }
  .breadcrumb .sep { margin: 0 0.5em; color: var(--color-mustard); }

  .hero { padding: 1rem 0 clamp(2rem, 5vw, 4rem); }
  h1 { margin: 1rem 0 0.6rem; }
  .lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.35rem;
    color: var(--color-ink-soft);
    max-width: 55ch;
    line-height: 1.5;
    margin: 1.5rem 0 0.6rem;
    font-variation-settings: "SOFT" 80;
  }
  .meta { font-family: var(--font-sans); font-size: 0.9rem; color: var(--color-ink-mute); margin-top: 0.4rem; }

  .grid { padding-bottom: clamp(3rem, 7vw, 6rem); }
  .card-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: 1.5rem;
  }
  .card {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 8px;
    padding: 1.6rem 1.7rem 1.7rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: transform .2s var(--ease-soft), border-color .2s var(--ease-soft), box-shadow .2s var(--ease-soft);
  }
  .card:hover {
    border-color: var(--color-terra);
    transform: translateY(-2px);
    box-shadow: 0 4px 18px rgba(42, 31, 24, 0.08);
  }
  .card__num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.8rem;
    color: var(--color-mustard-deep);
    font-variation-settings: "SOFT" 100, "WONK" 1;
    line-height: 1;
  }
  .card__title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.25;
    color: var(--color-ink);
    margin: 0;
    font-weight: 500;
    font-variation-settings: "SOFT" 60;
  }
  .card__lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--color-ink-soft);
    line-height: 1.45;
    margin: 0;
    font-variation-settings: "SOFT" 80;
    flex: 1;
  }
  .card__meta {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-mute);
    margin-top: 0.4rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 0.9rem;
    background: var(--color-terra);
    color: var(--color-bg);
    border-radius: 5px;
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 600;
    margin-top: 0.6rem;
    transition: background .2s var(--ease-soft);
  }
  .cta:hover { background: var(--color-terra-deep); }

  .note { padding: 0 0 clamp(3rem, 6vw, 5rem); }
  .note-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-ink-mute);
    max-width: 60ch;
    line-height: 1.5;
    font-variation-settings: "SOFT" 80;
    border-top: 1px dashed var(--color-line);
    padding-top: 1.5rem;
  }
</style>
