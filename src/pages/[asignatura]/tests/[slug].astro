---
import BaseLayout from '@layouts/BaseLayout.astro';
import { ASIGNATURAS } from '@/lib/asignaturas';
import { getCollection } from 'astro:content';
import { getLocale } from '@/i18n/locale';
import { pickLocalizedEntry } from '@/i18n/content-locale';
import { localizeAsignatura } from '@/i18n/asignaturas-ca';
import QuizPlayer from '@components/QuizPlayer.tsx';
import { quizLd, type TestQuestion } from '@/lib/seo';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const all = await getCollection('tests');
  return all
    .filter((t) => t.data.estado === 'publicado' && t.data.lang === 'es')
    .map((t) => {
      const slug = t.id.split('/').pop()?.replace(/\.mdx?$/, '') ?? t.id;
      return {
        params: { asignatura: t.data.asignatura, slug },
        props: { test: t },
      };
    });
}) satisfies GetStaticPaths;

const locale = getLocale(Astro.currentLocale);
const testEs = Astro.props.test;
const a = localizeAsignatura(ASIGNATURAS[testEs.data.asignatura], locale);
const testCaById = new Map(
  (await getCollection('tests'))
    .filter((t) => t.data.estado === 'publicado' && t.data.lang === 'ca')
    .map((t) => [t.id, t]),
);
const test = pickLocalizedEntry(testEs, testCaById, locale);

// Related libro unit (ES source), swapped to its CA sibling for the lema.
const allLibro = await getCollection('libro');
const libroCaById = new Map(allLibro.filter((u) => u.data.lang === 'ca').map((u) => [u.id, u]));
const unitEs = allLibro.find(
  (u) => u.data.asignatura === a.slug && u.data.unidad === test.data.unidad_relacionada && u.data.lang === 'es'
);
const unit = unitEs ? pickLocalizedEntry(unitEs, libroCaById, locale) : undefined;
const unitSlug = unitEs?.id.split('/').pop()?.replace(/\.mdx?$/, '');

const copy = {
  es: { inicio: 'Inicio', tests: 'Tests', unidad: 'Unidad', test: 'Test', preguntas: 'preguntas', volver: 'Volver a la unidad del libro', descripcion: `Test de autoevaluación de la unidad ${test.data.unidad_relacionada} de ${a.title}.` },
  ca: { inicio: 'Inici', tests: 'Tests', unidad: 'Unitat', test: 'Test', preguntas: 'preguntes', volver: 'Tornar a la unitat del llibre', descripcion: `Test d'autoavaluació de la unitat ${test.data.unidad_relacionada} de ${a.title}.` },
}[locale];

// Education Q&A structured data for the very questions QuizPlayer renders below.
const quiz = quizLd({
  name: test.data.title,
  about: unit?.data.title ?? a.title,
  educationalLevel: a.level,
  path: `/${a.slug}/tests/${Astro.params.slug}/`,
  questions: test.data.preguntas as TestQuestion[],
  locale,
});
---

<BaseLayout
  title={`${test.data.title} — ${a.seoName}`}
  brandSuffix={false}
  description={copy.descripcion}
  jsonLd={quiz ?? undefined}
  contentLang={locale}
>
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">{copy.inicio}</a> <span class="sep">›</span>
      <a href={`/${a.slug}/`}>{a.shortLabel}</a> <span class="sep">›</span>
      <a href={`/${a.slug}/tests/`}>{copy.tests}</a> <span class="sep">›</span>
      <span>{copy.unidad} {test.data.unidad_relacionada}</span>
    </nav>
  </div>

  <section class="hero">
    <div class="container">
      <span class="kicker kicker--sentence">{copy.test} · {copy.unidad} {test.data.unidad_relacionada}</span>
      <h1>{test.data.title}</h1>
      {unit?.data.lema && <p class="lede">{unit.data.lema}</p>}
      <p class="meta">
        {test.data.preguntas.length} {copy.preguntas}
        {test.data.duracion_estimada && <> · {test.data.duracion_estimada}</>}
        {unit && unitSlug && (
          <> ·
            <a class="link" href={`/${a.slug}/libro/${unitSlug}/`}>{copy.volver}</a>
          </>
        )}
      </p>
    </div>
  </section>

  <section class="player-wrap">
    <div class="container container--narrow">
      <QuizPlayer
        client:load
        preguntas={test.data.preguntas}
        storageKey={`test-${a.slug}-${test.data.unidad_relacionada}`}
        locale={locale}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4vw, 3rem);
  }
  .container--narrow { max-width: 760px; }

  .breadcrumb { font-size: 0.92rem; color: var(--color-ink-mute); margin: 2rem 0; }
  .breadcrumb a { color: var(--color-ink-mute); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-terra); }
  .breadcrumb .sep { margin: 0 0.5em; color: var(--color-mustard); }

  .hero { padding: 1rem 0 clamp(1.5rem, 4vw, 3rem); }
  h1 { max-width: 22ch; margin: 1rem 0 0.6rem; }
  .lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.35rem;
    color: var(--color-ink-soft);
    max-width: 50ch;
    margin: 1rem 0 1.5rem;
    line-height: 1.5;
    font-variation-settings: "SOFT" 80;
  }
  .meta {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    color: var(--color-ink-mute);
  }
  .meta .link { color: var(--color-terra); text-decoration: none; }
  .meta .link:hover { color: var(--color-terra-deep); border-bottom: 1px solid var(--color-terra); }

  .player-wrap { padding-bottom: clamp(3rem, 7vw, 6rem); }
</style>

{/* QuizPlayer styles now ship with the component (src/components/QuizPlayer.css). */}
