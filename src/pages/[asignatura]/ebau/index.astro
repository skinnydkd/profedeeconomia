---
/**
 * Cuaderno de preparación EBAU/PAU de una asignatura (de momento EDMN 2BACH,
 * Comunitat Valenciana). Varias secciones (colección `ebau`) renderizadas en
 * orden como un solo documento, con descarga en PDF.
 */
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '@layouts/BaseLayout.astro';
import { ASIGNATURAS, type AsignaturaSlug } from '@/lib/asignaturas';
import { breadcrumbLd } from '@/lib/seo';
import { slugFamilia, intercalarFamilias } from '@/lib/ebau';
import { getCollection, render } from 'astro:content';
import { getLocale } from '@/i18n/locale';
import { pickLocalizedEntry } from '@/i18n/content-locale';
import { localizeAsignatura } from '@/i18n/asignaturas-ca';
import type { GetStaticPaths } from 'astro';
import SectionHeader from '@components/SectionHeader.astro';
import EbauProse from '@components/ebau/EbauProse.astro';

export const getStaticPaths = (async () => {
  const all = await getCollection('ebau');
  const bySlug = new Map<AsignaturaSlug, typeof all>();
  for (const e of all) {
    if (e.data.estado !== 'publicado' || e.data.lang !== 'es') continue;
    const arr = bySlug.get(e.data.asignatura) ?? [];
    arr.push(e);
    bySlug.set(e.data.asignatura, arr);
  }
  return [...bySlug.entries()].map(([slug, secciones]) => {
    secciones.sort((a, b) => a.data.orden - b.data.orden);
    return { params: { asignatura: slug }, props: { secciones, asignatura: ASIGNATURAS[slug] } };
  });
}) satisfies GetStaticPaths;

const locale = getLocale(Astro.currentLocale);
const a = localizeAsignatura(Astro.props.asignatura, locale);
const caById = new Map(
  (await getCollection('ebau'))
    .filter((e) => e.data.estado === 'publicado' && e.data.lang === 'ca')
    .map((e) => [e.id, e]),
);
const secciones = Astro.props.secciones.map((s) => pickLocalizedEntry(s, caById, locale));
const comunidad = secciones[0]?.data.comunidad ?? 'Comunitat Valenciana';
const familiasCa = new Map(
  (await getCollection('ebauProblemas'))
    .filter((e) => e.data.estado === 'publicado' && e.data.lang === 'ca')
    .map((e) => [e.id, e]),
);
const familias = (await getCollection('ebauProblemas'))
  .filter((e) => e.data.asignatura === a.slug && e.data.estado === 'publicado' && e.data.lang === 'es')
  .map((e) => pickLocalizedEntry(e, familiasCa, locale));
const bloques = await Promise.all(
  intercalarFamilias(secciones, familias).map(async (b) =>
    b.kind === 'seccion' ? { kind: 'seccion' as const, Content: (await render(b.entry)).Content } : b,
  ),
);
// Link the Valencian PDF only when it exists; else fall back to Spanish (no 404).
const caEbau = locale === 'ca' && existsSync(resolve('public/downloads', `${a.slug}-ebau.ca.pdf`));
const pdfHref = `/downloads/${a.slug}-ebau${caEbau ? '.ca' : ''}.pdf`;

const copy = {
  es: {
    inicio: 'Inicio', ebau: 'Preparación EBAU', titulo: 'Preparación de la prueba EBAU',
    descripcion: `Cuaderno de preparación de la prueba de acceso (EBAU/PAU) de ${a.title} en ${comunidad}: estructura, teoría, problemas resueltos y simulacros.`,
    lede: 'Estructura de la prueba, teoría esencial, problemas resueltos paso a paso y simulacros completos con solucionario y baremo.',
    descargar: 'Descargar el cuaderno EBAU en PDF', descargarSub: 'Guía + teoría + problemas resueltos + simulacros',
    previsualizar: 'Previsualizar versión impresa',
    familias: 'Problemas resueltos por tipo de ejercicio',
    examenes: '↗ Exámenes EBAU oficiales de otras comunidades (con resolución)',
    adaptPre: 'Cuaderno orientado a la prueba de acceso de la ', adaptPost: ', según el modelo y los criterios oficiales más recientes. Confirma siempre el modelo vigente de tu convocatoria: la estructura puede ajustarse cada curso.',
  },
  ca: {
    inicio: 'Inici', ebau: 'Preparació EBAU', titulo: 'Preparació de la prova EBAU',
    descripcion: `Quadern de preparació de la prova d'accés (EBAU/PAU) de ${a.title} a ${comunidad}: estructura, teoria, problemes resolts i simulacres.`,
    lede: 'Estructura de la prova, teoria essencial, problemes resolts pas a pas i simulacres complets amb solucionari i barem.',
    descargar: 'Descarregar el quadern EBAU en PDF', descargarSub: 'Guia + teoria + problemes resolts + simulacres',
    previsualizar: 'Previsualitzar versió impresa',
    familias: "Problemes resolts per tipus d'exercici",
    examenes: "↗ Exàmens EBAU oficials d'altres comunitats (amb resolució)",
    adaptPre: "Quadern orientat a la prova d'accés de la ", adaptPost: ', segons el model i els criteris oficials més recents. Confirma sempre el model vigent de la teua convocatòria: l\'estructura pot ajustar-se cada curs.',
  },
}[locale];

const breadcrumb = breadcrumbLd([
  { name: copy.inicio, path: '/' },
  { name: a.shortLabel, path: `/${a.slug}/` },
  { name: copy.ebau, path: `/${a.slug}/ebau/` },
], locale);
---

<BaseLayout title={`${copy.ebau} — ${a.shortLabel}`} description={copy.descripcion} jsonLd={breadcrumb} contentLang={secciones.every((s) => s.data.lang === locale) ? locale : 'es'} translated={Astro.props.secciones.every((s) => caById.has(`${s.id}.ca`))}>
  <SectionHeader
    locale={locale}
    kicker={`${a.shortLabel} · ${comunidad}`}
    crumbs={[
      { name: copy.inicio, path: '/' },
      { name: a.shortLabel, path: `/${a.slug}/` },
      { name: copy.ebau },
    ]}
  >
    <Fragment slot="title">{copy.titulo}</Fragment>
    <Fragment slot="lede">{copy.lede}</Fragment>
    <div class="downloads">
      <a class="download-cta" href={pdfHref} download>
        <span class="download-cta__icon" aria-hidden="true">↓</span>
        <span class="download-cta__text">
          <strong>{copy.descargar}</strong>
          <span class="muted">{copy.descargarSub}</span>
        </span>
      </a>
      <a class="download-secondary" href={`${locale === 'ca' ? '/ca' : ''}/${a.slug}/ebau/imprimir/?preview=1`} target="_blank" rel="noopener">{copy.previsualizar}</a>
    </div>
    <p class="examenes-link">
      <a href={`/${a.slug}/ebau/examenes/`}>{copy.examenes}</a>
    </p>
    <p class="adapt-note">
      {copy.adaptPre}<strong>{comunidad}</strong>{copy.adaptPost}
    </p>
  </SectionHeader>

  <section class="body">
    <div class="container container--narrow">
      <EbauProse>
        {bloques.map((b) =>
          b.kind === 'seccion' ? (
            <b.Content />
          ) : (
            <nav class="familias" aria-label={copy.familias}>
              <h2>{copy.familias}</h2>
              <ul>
                {b.entries.map((f) => (
                  <li>
                    <a href={`/${a.slug}/ebau/${slugFamilia(f.id)}/`}>{f.data.title}</a>
                    <p>{f.data.descripcion}</p>
                  </li>
                ))}
              </ul>
            </nav>
          ),
        )}
      </EbauProse>
    </div>
  </section>
</BaseLayout>

<style>
  .container { max-width: 1240px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem); }
  .container--narrow { max-width: 820px; }
  .downloads { margin-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1.2rem; }
  .download-cta { display: inline-flex; align-items: center; gap: 1rem; padding: 0.9rem 1.4rem 0.9rem 1.1rem; background: var(--color-terra); color: #fff; text-decoration: none; border-radius: 6px; transition: background .2s var(--ease-soft), transform .2s var(--ease-soft); }
  .download-cta:hover { background: var(--color-terra-deep); transform: translateY(-1px); }
  .download-cta__icon { font-family: var(--font-serif); font-style: italic; font-size: 1.7rem; line-height: 1; color: var(--color-mustard-soft); font-variation-settings: "SOFT" 100, "WONK" 1; }
  .download-cta__text { display: flex; flex-direction: column; gap: 0.15rem; }
  .download-cta__text strong { font-family: var(--font-sans); font-size: 0.95rem; font-weight: 600; }
  .download-cta__text .muted { font-family: var(--font-sans); font-size: 0.78rem; letter-spacing: 0.04em; }
  .download-secondary { font-family: var(--font-serif); font-style: italic; font-size: 1rem; color: var(--color-ink-soft); text-decoration: none; border-bottom: 1px dashed var(--color-line); padding-bottom: 1px; font-variation-settings: "SOFT" 80; }
  .download-secondary:hover { color: var(--color-terra); border-bottom-color: var(--color-terra); }
  .adapt-note { margin: 1.6rem 0 0; font-family: var(--font-serif); font-style: italic; font-size: 1rem; color: var(--color-ink-soft); background: var(--color-mustard-soft); border-radius: 4px; padding: 0.9rem 1.2rem; max-width: 60ch; }
  .examenes-link { margin: 0.8rem 0 0; }
  .examenes-link a { font-family: var(--font-sans); font-size: 0.95rem; font-weight: 600; color: var(--color-terra-ink); text-decoration: none; }
  .examenes-link a:hover { text-decoration: underline; }
  .familias { margin: 2.5rem 0; padding: 1.5rem 1.8rem; border: 1px solid var(--color-line); border-radius: 6px; background: var(--color-paper); }
  .familias h2 { margin: 0 0 1rem; font-size: 1.3rem; }
  .familias ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .familias a { font-family: var(--font-serif); font-size: 1.15rem; font-weight: 500; color: var(--color-terra-ink); text-decoration: none; }
  .familias a:hover { text-decoration: underline; }
  .familias p { margin: 0.2rem 0 0; font-size: 0.95rem; color: var(--color-ink-soft); }
  .body { padding: clamp(1.5rem, 4vw, 3rem) 0 clamp(3rem, 7vw, 6rem); }
</style>
