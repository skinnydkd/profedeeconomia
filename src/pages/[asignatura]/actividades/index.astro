---
import BaseLayout from '@layouts/BaseLayout.astro';
import { ASIGNATURA_SLUGS, ASIGNATURAS } from '@/lib/asignaturas';
import { breadcrumbLd } from '@/lib/seo';
import { getCollection } from 'astro:content';
import { getLocale } from '@/i18n/locale';
import { pickLocalizedEntry } from '@/i18n/content-locale';
import { localizeAsignatura } from '@/i18n/asignaturas-ca';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  return ASIGNATURA_SLUGS.map((slug) => ({
    params: { asignatura: slug },
    props: { asignatura: ASIGNATURAS[slug] },
  }));
}) satisfies GetStaticPaths;

const locale = getLocale(Astro.currentLocale);
const a = localizeAsignatura(Astro.props.asignatura, locale);

const all = await getCollection('actividades');
const caById = new Map(
  all.filter((x) => x.data.estado === 'publicado' && x.data.lang === 'ca').map((x) => [x.id, x]),
);
const items = all
  .filter((x) => x.data.asignatura === a.slug && x.data.estado === 'publicado' && x.data.lang === 'es')
  .sort((x, y) => x.data.unidad_relacionada - y.data.unidad_relacionada)
  .map((x) => pickLocalizedEntry(x, caById, locale));

const TIPO_LABEL: Record<'es' | 'ca', Record<string, string>> = {
  es: { caso: 'Caso', ejercicio: 'Ejercicio', debate: 'Debate', dinamica: 'Dinámica', proyecto: 'Proyecto' },
  ca: { caso: 'Cas', ejercicio: 'Exercici', debate: 'Debat', dinamica: 'Dinàmica', proyecto: 'Projecte' },
};

const copy = {
  es: {
    inicio: 'Inicio', actividades: 'Actividades', titulo: 'Actividades para el aula',
    descripcion: `Actividades pensadas para el aula, una por unidad de ${a.title}.`,
    vacio: 'Las actividades se publicarán a medida que se completen las unidades.',
    intro: 'Una propuesta por unidad: casos reales, ejercicios numéricos, debates, dinámicas y un proyecto. Cada ficha incluye objetivos, pasos y rúbrica de evaluación.',
    meta: (n: number) => `${n} ${n === 1 ? 'actividad' : 'actividades'}`,
    alumno: 'Cuaderno del alumno', alumnoSub: 'PDF · enunciados para trabajar, sin soluciones',
    profesor: 'Cuaderno del profesor', profesorSub: 'PDF · con soluciones de los ejercicios y solucionario de tests',
    previsualizar: 'Previsualizar el cuaderno en el navegador', abrir: 'Abrir ficha →',
    nota: 'Las actividades están pensadas para sesiones de 50-90 minutos. Se pueden adaptar a clase entera, grupos pequeños o trabajo individual según el contexto. Si las usáis con vuestro alumnado y descubrís ajustes que funcionan mejor, escribidnos a',
  },
  ca: {
    inicio: 'Inici', actividades: 'Activitats', titulo: "Activitats per a l'aula",
    descripcion: `Activitats pensades per a l'aula, una per unitat de ${a.title}.`,
    vacio: 'Les activitats es publicaran a mesura que es completen les unitats.',
    intro: 'Una proposta per unitat: casos reals, exercicis numèrics, debats, dinàmiques i un projecte. Cada fitxa inclou objectius, passos i rúbrica d\'avaluació.',
    meta: (n: number) => `${n} ${n === 1 ? 'activitat' : 'activitats'}`,
    alumno: "Quadern de l'alumne", alumnoSub: 'PDF · enunciats per a treballar, sense solucions',
    profesor: 'Quadern del professor', profesorSub: 'PDF · amb solucions dels exercicis i solucionari de tests',
    previsualizar: 'Previsualitzar el quadern al navegador', abrir: 'Obrir fitxa →',
    nota: "Les activitats estan pensades per a sessions de 50-90 minuts. Es poden adaptar a classe sencera, grups xicotets o treball individual segons el context. Si les useu amb el vostre alumnat i descobriu ajustos que funcionen millor, escriviu-nos a",
  },
}[locale];

const breadcrumb = breadcrumbLd([
  { name: copy.inicio, path: '/' },
  { name: a.shortLabel, path: `/${a.slug}/` },
  { name: copy.actividades, path: `/${a.slug}/actividades/` },
]);
---

<BaseLayout
  title={`${copy.actividades} — ${a.shortLabel}`}
  description={copy.descripcion}
  jsonLd={breadcrumb}
  contentLang={locale}
>
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">{copy.inicio}</a> <span class="sep">›</span>
      <a href={`/${a.slug}/`}>{a.shortLabel}</a> <span class="sep">›</span>
      <span>{copy.actividades}</span>
    </nav>
  </div>

  <section class="hero">
    <div class="container">
      <span class="kicker kicker--sentence">{a.shortLabel} · {copy.actividades}</span>
      <h1>{copy.titulo}</h1>
      <p class="lede">
        {items.length === 0 ? copy.vacio : copy.intro}
      </p>
      {items.length > 0 && (
        <p class="meta">
          {copy.meta(items.length)}
        </p>
      )}

      {items.length > 0 && (
        <div class="downloads">
          <a class="download-cta" href={`/downloads/${a.slug}-cuaderno-alumno.pdf`} download>
            <span class="download-cta__icon" aria-hidden="true">↓</span>
            <span class="download-cta__text">
              <strong>{copy.alumno}</strong>
              <span class="muted">{copy.alumnoSub}</span>
            </span>
          </a>
          <a class="download-cta download-cta--alt" href={`/downloads/${a.slug}-cuaderno.pdf`} download>
            <span class="download-cta__icon" aria-hidden="true">↓</span>
            <span class="download-cta__text">
              <strong>{copy.profesor}</strong>
              <span class="muted">{copy.profesorSub}</span>
            </span>
          </a>
          <a class="download-secondary" href={`/${a.slug}/actividades/imprimir/profesor/?preview=1`} target="_blank" rel="noopener">
            {copy.previsualizar}
          </a>
        </div>
      )}
    </div>
  </section>

  {items.length > 0 && (
    <section class="grid">
      <div class="container">
        <ul class="card-grid">
          {items.map((it) => {
            const slug = it.id.split('/').pop()?.replace(/\.mdx?$/, '').replace(/\.ca$/, '');
            return (
              <li class={`card card--${it.data.tipo}`}>
                <div class="card__head">
                  <span class="card__num">{String(it.data.unidad_relacionada).padStart(2, '0')}</span>
                  <span class={`card__badge badge--${it.data.tipo}`}>{TIPO_LABEL[locale][it.data.tipo]}</span>
                </div>
                <h3 class="card__title">{it.data.title}</h3>
                <p class="card__desc">{it.data.descripcion}</p>
                <div class="card__meta">
                  {it.data.duracion && <span>{it.data.duracion}</span>}
                  {it.data.agrupacion && <span>· {it.data.agrupacion}</span>}
                </div>
                <a class="cta" href={`/${a.slug}/actividades/${slug}/`}>{copy.abrir}</a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <section class="note">
    <div class="container">
      <p class="note-text">
        {copy.nota}
        <a class="editorial-link" href="mailto:hola@profedeeconomia.es">hola@profedeeconomia.es</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4vw, 3rem);
  }
  .breadcrumb { font-size: 0.92rem; color: var(--color-ink-mute); margin: 2rem 0; }
  .breadcrumb a { color: var(--color-ink-mute); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-terra); }
  .breadcrumb .sep { margin: 0 0.5em; color: var(--color-mustard); }

  .hero { padding: 1rem 0 clamp(2rem, 5vw, 4rem); }
  h1 { margin: 1rem 0 0.6rem; }
  .lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.35rem;
    color: var(--color-ink-soft);
    max-width: 55ch;
    line-height: 1.5;
    margin: 1.5rem 0 0.6rem;
    font-variation-settings: "SOFT" 80;
  }
  .meta { font-family: var(--font-sans); font-size: 0.9rem; color: var(--color-ink-mute); margin-top: 0.4rem; }

  .downloads {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem;
  }
  .download-cta {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.4rem 0.9rem 1.1rem;
    background: var(--color-terra);
    color: #fff;
    text-decoration: none;
    border-radius: 6px;
    transition: background .2s var(--ease-soft), transform .2s var(--ease-soft);
  }
  .download-cta:hover { background: var(--color-terra-deep); transform: translateY(-1px); }
  .download-cta__icon {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.7rem;
    line-height: 1;
    color: var(--color-mustard-soft);
    font-variation-settings: "SOFT" 100, "WONK" 1;
  }
  .download-cta__text { display: flex; flex-direction: column; gap: 0.15rem; }
  .download-cta__text strong { font-family: var(--font-sans); font-size: 0.95rem; font-weight: 600; }
  .download-cta__text .muted { font-family: var(--font-sans); font-size: 0.78rem; opacity: 0.75; letter-spacing: 0.04em; }
  .download-secondary {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    color: var(--color-ink-soft);
    text-decoration: none;
    border-bottom: 1px dashed var(--color-line);
    padding-bottom: 1px;
    font-variation-settings: "SOFT" 80;
  }
  .download-secondary:hover { color: var(--color-terra); border-bottom-color: var(--color-terra); }

  .grid { padding-bottom: clamp(3rem, 7vw, 6rem); }
  .card-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1.5rem;
  }
  .card {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 8px;
    padding: 1.5rem 1.7rem 1.7rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: transform .2s var(--ease-soft), border-color .2s var(--ease-soft), box-shadow .2s var(--ease-soft);
  }
  .card:hover {
    border-color: var(--color-terra);
    transform: translateY(-2px);
    box-shadow: 0 4px 18px rgba(42, 31, 24, 0.08);
  }

  .card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .card__num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.6rem;
    color: var(--color-mustard-deep);
    font-variation-settings: "SOFT" 100, "WONK" 1;
    line-height: 1;
  }
  .card__badge {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: var(--color-terra-soft);
    color: var(--color-terra-deep);
  }
  .badge--caso     { background: var(--color-terra-soft);   color: var(--color-terra-deep); }
  .badge--ejercicio{ background: var(--color-mustard-soft); color: var(--color-mustard-deep); }
  .badge--debate   { background: #DBEDED;                   color: #1F6E6E; }
  .badge--dinamica { background: var(--color-fopp-soft);    color: var(--color-fopp); }
  .badge--proyecto { background: var(--color-bg-soft);      color: var(--color-ink); }

  .card__title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.25;
    color: var(--color-ink);
    margin: 0.3rem 0 0.2rem;
    font-weight: 500;
    font-variation-settings: "SOFT" 60;
  }
  .card__desc {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--color-ink-soft);
    line-height: 1.45;
    margin: 0;
    font-variation-settings: "SOFT" 80;
    flex: 1;
  }
  .card__meta {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-mute);
    margin-top: 0.4rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 0.9rem;
    background: var(--color-terra);
    color: var(--color-bg);
    border-radius: 5px;
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 600;
    margin-top: 0.6rem;
    transition: background .2s var(--ease-soft);
  }
  .cta:hover { background: var(--color-terra-deep); }

  .note { padding: 0 0 clamp(3rem, 6vw, 5rem); }
  .note-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-ink-mute);
    max-width: 60ch;
    line-height: 1.5;
    font-variation-settings: "SOFT" 80;
    border-top: 1px dashed var(--color-line);
    padding-top: 1.5rem;
  }
</style>
