---
import BaseLayout from '@layouts/BaseLayout.astro';
import { ASIGNATURAS } from '@/lib/asignaturas';
import { breadcrumbLd } from '@/lib/seo';
import { getCollection, render } from 'astro:content';
import { getLocale } from '@/i18n/locale';
import { pickLocalizedEntry } from '@/i18n/content-locale';
import { localizeAsignatura } from '@/i18n/asignaturas-ca';
import HerramientaIsland from '@components/calculadoras/HerramientaIsland.astro';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const all = await getCollection('recursos');
  return all
    .filter((x) => x.data.estado === 'publicado' && x.data.lang === 'es')
    .map((x) => {
      const slug = x.id.split('/').pop()?.replace(/\.mdx?$/, '') ?? x.id;
      return {
        params: { asignatura: x.data.asignatura, slug },
        props: { recurso: x },
      };
    });
}) satisfies GetStaticPaths;

const locale = getLocale(Astro.currentLocale);
const recursoEs = Astro.props.recurso;
const a = localizeAsignatura(ASIGNATURAS[recursoEs.data.asignatura], locale);
const recCaById = new Map(
  (await getCollection('recursos'))
    .filter((x) => x.data.estado === 'publicado' && x.data.lang === 'ca')
    .map((x) => [x.id, x]),
);
const recurso = pickLocalizedEntry(recursoEs, recCaById, locale);
const { Content } = await render(recurso);

const allLibro = await getCollection('libro');
const libroCaById = new Map(allLibro.filter((u) => u.data.lang === 'ca').map((u) => [u.id, u]));
const unitEs = recurso.data.unidad_relacionada
  ? allLibro.find(
      (u) => u.data.asignatura === a.slug && u.data.unidad === recurso.data.unidad_relacionada && u.data.lang === 'es'
    )
  : null;
const unit = unitEs ? pickLocalizedEntry(unitEs, libroCaById, locale) : null;
const unitSlug = unitEs?.id.split('/').pop()?.replace(/\.mdx?$/, '');

const copy = {
  es: { inicio: 'Inicio', recursos: 'Recursos', unidad: 'Unidad', kicker: 'Recurso interactivo', volver: 'Volver a la Unidad' },
  ca: { inicio: 'Inici', recursos: 'Recursos', unidad: 'Unitat', kicker: 'Recurs interactiu', volver: 'Tornar a la Unitat' },
}[locale];

const recursoSlug = recursoEs.id.split('/').pop()?.replace(/\.mdx?$/, '') ?? recursoEs.id;
const breadcrumb = breadcrumbLd([
  { name: copy.inicio, path: '/' },
  { name: a.shortLabel, path: `/${a.slug}/` },
  { name: copy.recursos, path: `/${a.slug}/recursos/` },
  { name: recurso.data.title, path: `/${a.slug}/recursos/${recursoSlug}/` },
]);
---

<BaseLayout title={recurso.data.seoTitle ?? `${recurso.data.title} — ${a.seoName}`} brandSuffix={false} description={recurso.data.descripcion} ogType="article" jsonLd={breadcrumb} contentLang={locale}>
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">{copy.inicio}</a> <span class="sep">›</span>
      <a href={`/${a.slug}/`}>{a.shortLabel}</a> <span class="sep">›</span>
      <a href={`/${a.slug}/recursos/`}>{copy.recursos}</a> <span class="sep">›</span>
      <span>{recurso.data.title}</span>
    </nav>
  </div>

  <section class="hero">
    <div class="container">
      <span class="kicker kicker--sentence">{copy.kicker}{recurso.data.unidad_relacionada !== undefined ? ` · ${copy.unidad} ${recurso.data.unidad_relacionada}` : ''}</span>
      <h1>{recurso.data.title}</h1>
      <p class="lede">{recurso.data.descripcion}</p>
      {unit && unitSlug && (
        <p class="meta">
          <a class="link" href={`/${a.slug}/libro/${unitSlug}/`}>
            {copy.volver} {unit.data.unidad}: {unit.data.title}
          </a>
        </p>
      )}
    </div>
  </section>

  <section class="player-wrap">
    <div class="container container--narrow">
      <HerramientaIsland componente={recurso.data.componente} locale={locale} />
    </div>
  </section>

  <section class="body">
    <div class="container container--narrow">
      <article class="prose">
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .container { max-width: 1240px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem); }
  .container--narrow { max-width: 820px; }

  .breadcrumb { font-size: 0.92rem; color: var(--color-ink-mute); margin: 2rem 0; }
  .breadcrumb a { color: var(--color-ink-mute); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-terra); }
  .breadcrumb .sep { margin: 0 0.5em; color: var(--color-mustard); }

  .hero { padding: 1rem 0 clamp(1.5rem, 4vw, 3rem); }
  h1 { max-width: 22ch; margin: 1rem 0 0.6rem; }
  .lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.35rem;
    color: var(--color-ink-soft);
    max-width: 50ch;
    margin: 1rem 0 1rem;
    line-height: 1.5;
    font-variation-settings: "SOFT" 80;
  }
  .meta { font-family: var(--font-sans); font-size: 0.92rem; color: var(--color-ink-mute); }
  .meta .link { color: var(--color-terra); text-decoration: none; border-bottom: 1px solid var(--color-line); }
  .meta .link:hover { color: var(--color-terra-deep); border-bottom-color: var(--color-terra); }

  .player-wrap { padding: clamp(1rem, 3vw, 2rem) 0 clamp(2rem, 5vw, 4rem); }

  .body { padding: 0 0 clamp(3rem, 7vw, 6rem); }
  .prose {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-ink);
  }
  .prose :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    margin: 2em 0 0.7em;
    position: relative;
    padding-top: 1em;
    font-weight: 500;
  }
  .prose :global(p) { margin: 0 0 1em; }
  .prose :global(ul) { padding-left: 1.4rem; margin: 0 0 1em; }
  .prose :global(li) { margin-bottom: 0.4em; }
  .prose :global(ul li::marker) { color: var(--color-mustard); }
  .prose :global(strong) { color: var(--color-ink); }
</style>

{/* Global styles for the calculator components */}
