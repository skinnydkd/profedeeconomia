---
import BaseLayout from '@layouts/BaseLayout.astro';
import { ASIGNATURAS } from '@/lib/asignaturas';
import { getCollection, render } from 'astro:content';
import UnitNotes from '@components/UnitNotes.tsx';
import RecursosRelacionados from '@components/libro/RecursosRelacionados.astro';
import { getIndiceRecursos } from '@/lib/recursos-relacionados-sources';
import { recursosDeUnidad } from '@/lib/recursos-relacionados';
import { getMaterialPorUnidad } from '@/lib/material-unidad-sources';
import { articleLd, breadcrumbLd, subjectTitle, SITE } from '@/lib/seo';
import { cargarFamilias } from '@/lib/ebau-familias';
import { familiasDeUnidad, slugFamilia } from '@/lib/ebau';
import { getLocale } from '@/i18n/locale';
import { pickLocalizedEntry } from '@/i18n/content-locale';
import { localizeAsignatura } from '@/i18n/asignaturas-ca';
import type { GetStaticPaths } from 'astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import { existsSync } from 'node:fs';

export const getStaticPaths = (async () => {
  const allUnits = await getCollection('libro');
  return allUnits
    .filter((u) => u.data.estado === 'publicado' && u.data.lang === 'es')
    .map((u) => {
      const slug = u.id.split('/').pop()?.replace(/\.mdx?$/, '') ?? u.id;
      return {
        params: { asignatura: u.data.asignatura, unidad: slug },
        props: { unit: u },
      };
    });
}) satisfies GetStaticPaths;

const { unit } = Astro.props;
const locale = getLocale(Astro.currentLocale);
// Localized so the <title> suffix and educationalLevel are not Castilian under /ca.
const a = localizeAsignatura(ASIGNATURAS[unit.data.asignatura], locale);

// Valencian siblings (published), keyed by "<esId>.ca". Swap the ES unit for
// its CA sibling under /ca (ES fallback when the translation is missing).
const caById = new Map(
  (await getCollection('libro'))
    .filter((u) => u.data.estado === 'publicado' && u.data.lang === 'ca')
    .map((u) => [u.id, u]),
);
const view = pickLocalizedEntry(unit, caById, locale);
const { Content, headings } = await render(view);

const copy = {
  es: { inicio: 'Inicio', libro: 'Libro', unidad: 'Unidad', sabers: 'Saberes', duracion: 'Duración estimada', conceptos: 'Conceptos clave', objetivos: 'Objetivos', enEsta: 'En esta unidad', volver: '← Volver al índice', volverSub: 'Libro', ejercicios: 'Ejercicios resueltos tipo EBAU' },
  ca: { inicio: 'Inici', libro: 'Llibre', unidad: 'Unitat', sabers: 'Sabers', duracion: 'Durada estimada', conceptos: 'Conceptes clau', objetivos: 'Objectius', enEsta: 'En esta unitat', volver: "← Tornar a l'índex", volverSub: 'Llibre', ejercicios: 'Exercicis resolts tipus EBAU' },
}[locale];

// Adjacent units within the same asignatura (ordered on the ES source of truth;
// titles shown are localized via the CA sibling when present).
const all = (await getCollection('libro'))
  .filter((u) => u.data.asignatura === unit.data.asignatura && u.data.estado === 'publicado' && u.data.lang === 'es')
  .sort((x, y) => x.data.unidad - y.data.unidad);

const idx = all.findIndex((u) => u.id === unit.id);
const prev = idx > 0 ? pickLocalizedEntry(all[idx - 1], caById, locale) : null;
const next = idx < all.length - 1 ? pickLocalizedEntry(all[idx + 1], caById, locale) : null;
const idToSlug = (id: string) => id.split('/').pop()?.replace(/\.mdx?$/, '').replace(/\.ca$/, '') ?? id;

// Stable per-unit namespace for the UnitNotes localStorage state.
const unitKey = `${a.slug}-u${unit.data.unidad}`;

// Related transversal resources for this unit (inverse index, built once per build).
const recursos = recursosDeUnidad(await getIndiceRecursos(locale), unit.data.asignatura, unit.data.unidad);

// The unit's own material, linked from the top (VIS-NAV-05): before, the page
// only led back to the hub, so a teacher had to go round to find the slides.
const material = (await getMaterialPorUnidad(unit.data.asignatura, locale)).find((m) => m.unidad === unit.data.unidad);
const mCopy = {
  es: {
    label: 'Material de esta unidad', enEsta: 'En esta unidad:', diapositivas: 'Diapositivas', pdf: 'PDF de diapositivas', test: 'Test', reto: 'Reto',
    actividades: (n: number) => (n === 1 ? '1 actividad' : `${n} actividades`),
    imprimir: 'Libro completo para imprimir',
    acciones: 'Compartir esta unidad', copiar: 'Copiar enlace', copiado: 'Enlace copiado.', copiaManual: 'Enlace seleccionado: cópialo con Ctrl+C.', enlace: 'Enlace de la unidad',
    classroom: 'Compartir en Classroom', nuevaPestana: '(se abre en una pestaña nueva)', errata: 'Informar de un error',
    comprueba: 'Comprueba lo que sabes', testUnidad: 'Test de la unidad',
  },
  ca: {
    label: 'Material d\'esta unitat', enEsta: 'En esta unitat:', diapositivas: 'Diapositives', pdf: 'PDF de diapositives', test: 'Test', reto: 'Repte',
    actividades: (n: number) => (n === 1 ? '1 activitat' : `${n} activitats`),
    // The printable book is Spanish only (see imprimir.astro).
    imprimir: 'Llibre complet per a imprimir (en castellà)',
    acciones: 'Compartir esta unitat', copiar: 'Copiar l\'enllaç', copiado: 'Enllaç copiat.', copiaManual: 'Enllaç seleccionat: copia\'l amb Ctrl+C.', enlace: 'Enllaç de la unitat',
    classroom: 'Compartir a Classroom', nuevaPestana: '(s\'obri en una pestanya nova)', errata: 'Informar d\'un error',
    comprueba: 'Comprova el que saps', testUnidad: 'Test de la unitat',
  },
}[locale];

// Solved-problem families of this unit (published ones only).
const familias = familiasDeUnidad(await cargarFamilias(unit.data.asignatura, locale), unit.data.asignatura, unit.data.unidad);

// Localized view of the unit (CA sibling under /ca, ES otherwise).
const d = view.data;

// Structured data (JSON-LD): the unit as an Article + its breadcrumb trail.
const unitTitle = `${copy.unidad} ${d.unidad}. ${d.title}`;
const unitPath = `/${a.slug}/libro/${idToSlug(unit.id)}/`;
// The unit's key diagram as a raster image (scripts/build-esquemas.mjs):
// an explicit `imagen` wins, then this locale's capture, then the ES one.
const esquema = [locale === 'ca' ? '.ca' : '', '']
  .map((sfx) => `/esquemas/${a.slug}/${idToSlug(unit.id)}${sfx}.png`)
  .find((src) => existsSync(`public${src}`));
const imagen = d.imagen ?? esquema;

// Every unit opens with a blockquote fitxa («Al acabar esta unidad sabrás…»)
// that lists the objectives; the opener only repeats them when it is missing.
const objetivosEnTexto = /^> \*\*(Al acabar esta unidad sabrás|En acabar esta unitat sabràs)/m.test(view.body ?? '');
// Same URL scheme as /[asignatura]/diapositivas/ (Blob redirect in vercel.json).
const slidesPdf = `/slides/${a.slug}/${idToSlug(unit.id)}${locale === 'ca' ? '.ca' : ''}.pdf`;
const imprimirHref = `/${a.slug}/libro/imprimir/#cap-${unit.data.unidad}`;
const canonical = `${SITE.url}${locale === 'ca' ? '/ca' : ''}${unitPath}`;
const classroomHref = `https://classroom.google.com/share?url=${encodeURIComponent(canonical)}`;
const errataHref = `mailto:${SITE.email}?subject=${encodeURIComponent(`Errata: ${unitTitle}`)}&body=${encodeURIComponent(`${canonical}\n\n`)}`;
const isoDay = (day?: Date) => day?.toISOString().slice(0, 10);
const jsonLd = [
  articleLd({
    title: unitTitle,
    description: d.lema ?? d.title,
    path: unitPath,
    datePublished: isoDay(d.publicado_en),
    dateModified: isoDay(d.actualizado_en ?? d.publicado_en),
    section: a.shortLabel,
    image: imagen ?? `/og/${a.slug}.png`,
    educationalLevel: a.level,
    teaches: d.conceptos_clave,
    locale,
  }),
  breadcrumbLd([
    { name: copy.inicio, path: '/' },
    { name: a.shortLabel, path: `/${a.slug}/` },
    { name: copy.libro, path: `/${a.slug}/libro/` },
    { name: unitTitle, path: unitPath },
  ], locale),
];
---

<BaseLayout
  title={d.seoTitle ?? subjectTitle(d.title, a)}
  brandSuffix={false}
  description={d.lema ?? d.title}
  ogType="article"
  ogImage={imagen}
  jsonLd={jsonLd}
  contentLang={view.data.lang}
  translated={caById.has(`${unit.id}.ca`)}
>
  <div class="container">
    <Breadcrumb
      locale={locale}
      items={[
        { name: copy.inicio, path: '/' },
        { name: a.shortLabel, path: `/${a.slug}/` },
        { name: copy.libro, path: `/${a.slug}/libro/` },
        { name: `${copy.unidad} ${d.unidad}` },
      ]}
    />
  </div>

  <section class="unit-opener">
    <div class="container">
      <div class="unit-num">
        {copy.unidad} {d.unidad}
        {d.bloque ? ` · ${d.bloque}` : ''}
        {d.sabers.length > 0 ? ` · ${copy.sabers} ${d.sabers.join(', ')}` : ''}
      </div>
      <h1>{d.title}</h1>
      {d.lema && <p class="lede">{d.lema}</p>}
      <nav class="unit-material" aria-label={mCopy.label}>
        <span class="unit-material__label">{mCopy.enEsta}</span>
        <ul>
          {material && <li><a href={material.diapositivas}>{mCopy.diapositivas}</a></li>}
          <li><a href={slidesPdf} download>{mCopy.pdf}</a></li>
          {material?.test && <li><a href={material.test}>{mCopy.test}</a></li>}
          {material?.actividadesHref && <li><a href={material.actividadesHref}>{mCopy.actividades(material.actividades)}</a></li>}
          {material?.retos.map((r, i) => (
            <li><a href={r}>{material.retos.length > 1 ? `${mCopy.reto} ${i + 1}` : mCopy.reto}</a></li>
          ))}
          <li><a href={imprimirHref}>{mCopy.imprimir}</a></li>
        </ul>
      </nav>

      <div class="unit-actions" role="group" aria-label={mCopy.acciones}>
        <button type="button" class="unit-actions__btn" data-copy-url={canonical} data-ok={mCopy.copiado} data-manual={mCopy.copiaManual}>{mCopy.copiar}</button>
        <a class="unit-actions__btn" href={classroomHref} target="_blank" rel="noopener">{mCopy.classroom}<span class="vh"> {mCopy.nuevaPestana}</span></a>
        <a class="unit-actions__btn" href={errataHref}>{mCopy.errata}</a>
        <input class="unit-actions__url" type="text" readonly value={canonical} aria-label={mCopy.enlace} hidden />
        <p class="unit-actions__status" role="status"></p>
      </div>

      <dl class="unit-meta">
        {d.duracion && (
          <div>
            <dt>{copy.duracion}</dt>
            <dd>{d.duracion}</dd>
          </div>
        )}
        {d.conceptos_clave.length > 0 && (
          <div>
            <dt>{copy.conceptos}</dt>
            <dd>
              <div class="tag-row">
                {d.conceptos_clave.map((c) => <span class="tag">{c}</span>)}
              </div>
            </dd>
          </div>
        )}
        {d.objetivos.length > 0 && !objetivosEnTexto && (
          <div style="grid-column: 1 / -1;">
            <dt>{copy.objetivos}</dt>
            <dd>
              <ul class="objetivos">
                {d.objetivos.map((o) => <li>{o}</li>)}
              </ul>
            </dd>
          </div>
        )}
      </dl>
    </div>
  </section>

  <div class="container">
    <div class="article-layout">
      {headings.length > 0 && (
        <nav class="article-toc" aria-label={copy.enEsta}>
          {/* Open by default (sidebar on desktop, and without JS); the inline
              script folds it below 1100px before first paint. */}
          <details class="toc-details" open data-toc>
            <summary class="toc-title">{copy.enEsta}</summary>
            <ol>
              {headings.filter((h) => h.depth === 2 || h.depth === 3).map((h) => (
                <li class={`toc-d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          </details>
          <script is:inline>
            (function () {
              var d = document.querySelector('[data-toc]');
              var mq = matchMedia('(min-width: 1100px)');
              d.open = mq.matches;
              mq.addEventListener('change', function (e) { d.open = e.matches; });
            })();
          </script>
        </nav>
      )}

      <article class="article-body">
        <Content />

        {(material?.test || familias.length > 0) && (
          <section class="unit-check" aria-labelledby="unit-check-title">
            <h2 id="unit-check-title" class="unit-check__title">{mCopy.comprueba}</h2>
            <ul>
              {material?.test && <li><a class="unit-check__test" href={material.test}>{mCopy.testUnidad} →</a></li>}
              {familias.map((f) => (
                <li><a href={`/${a.slug}/ebau/${slugFamilia(f.id)}/`}>{copy.ejercicios}: {f.data.title}</a></li>
              ))}
            </ul>
          </section>
        )}

        <nav class="unit-nav">
          {prev ? (
            <a class="prev" href={`/${a.slug}/libro/${idToSlug(prev.id)}/`}>
              <span class="label">← {copy.unidad} {prev.data.unidad}</span>
              <span class="title">{prev.data.title}</span>
            </a>
          ) : (
            <a class="prev" href={`/${a.slug}/libro/`}>
              <span class="label">{copy.volver}</span>
              <span class="title">{a.shortLabel} · {copy.volverSub}</span>
            </a>
          )}
          {next ? (
            <a class="next" href={`/${a.slug}/libro/${idToSlug(next.id)}/`}>
              <span class="label">{copy.unidad} {next.data.unidad} →</span>
              <span class="title">{next.data.title}</span>
            </a>
          ) : (
            <span></span>
          )}
        </nav>

        <UnitNotes client:idle unitKey={unitKey} unitTitle={d.title} locale={locale} />

        <RecursosRelacionados recursos={recursos} asignaturaLabel={a.shortLabel} unidad={unit.data.unidad} />
      </article>
    </div>
  </div>

  <div class="read-progress" aria-hidden="true"></div>
</BaseLayout>

<script>
  // TOC: mark the section being read (aria-current), fold the mobile TOC after a jump.
  const toc = document.querySelector<HTMLDetailsElement>('[data-toc]');
  if (toc) {
    const pairs = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')]
      .map((l) => [l, document.getElementById(decodeURIComponent(l.hash.slice(1)))] as const)
      .filter((p): p is readonly [HTMLAnchorElement, HTMLElement] => p[1] !== null);
    let current: HTMLAnchorElement | undefined;
    const update = () => {
      const line = innerHeight * 0.3;
      let next: HTMLAnchorElement | undefined;
      for (const [l, h] of pairs) if (h.getBoundingClientRect().top < line) next = l;
      if (next === current) return;
      current?.removeAttribute('aria-current');
      next?.setAttribute('aria-current', 'true');
      current = next;
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(update, { rootMargin: '0px 0px -70% 0px' });
      pairs.forEach(([, h]) => io.observe(h));
    }
    toc.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a') && !matchMedia('(min-width: 1100px)').matches) toc.open = false;
    });
  }

  // «Copiar enlace»: Clipboard API, else show the URL selected for Ctrl+C.
  const btn = document.querySelector<HTMLButtonElement>('[data-copy-url]');
  if (btn) {
    const box = btn.parentElement!;
    const status = box.querySelector<HTMLElement>('[role="status"]')!;
    const input = box.querySelector<HTMLInputElement>('.unit-actions__url')!;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copyUrl!);
        status.textContent = btn.dataset.ok!;
      } catch {
        input.hidden = false;
        input.focus();
        input.select();
        status.textContent = btn.dataset.manual!;
      }
    });
  }
</script>

<style>
  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4vw, 3rem);
  }


  .unit-opener {
    padding: 1rem 0 4rem;
    background: var(--color-bg);
  }
  .unit-num {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-ink-mute);
    margin-bottom: 1.2rem;
    font-weight: 500;
  }
  h1 { max-width: 20ch; margin: 0 0 0.6rem; }
  .lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1.45;
    color: var(--color-ink-soft);
    max-width: 50ch;
    margin: 0 0 2.8rem;
    font-variation-settings: "SOFT" 80;
  }

  .unit-material { margin: 1.2rem 0 0.6rem; font-size: 1rem; color: var(--color-ink-soft); display: flex; flex-wrap: wrap; align-items: center; column-gap: 0.5em; }
  .unit-material__label { font-weight: 600; color: var(--color-ink); }
  .unit-material ul { display: contents; list-style: none; }
  .unit-material li { display: inline-flex; align-items: center; }
  .unit-material li + li::before { content: "·"; margin-right: 0.5em; color: var(--color-mustard); }
  /* ≥24px targets everywhere, 44px on touch screens. */
  .unit-material a { display: inline-flex; align-items: center; min-height: 1.75rem; color: var(--color-terra-ink); text-decoration: none; }
  .unit-material a:hover { text-decoration: underline; }

  .unit-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin: 0 0 1.6rem; }
  .unit-actions__btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.3rem 0.85rem;
    font: 500 0.9rem/1.2 var(--font-sans);
    color: var(--color-terra-ink);
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 6px;
    text-decoration: none;
    cursor: pointer;
    transition: background .15s var(--ease-soft), border-color .15s var(--ease-soft);
  }
  .unit-actions__btn:hover { background: var(--color-terra-soft); border-color: var(--color-terra); }
  .unit-actions__btn:active { background: var(--color-terra-soft); border-color: var(--color-terra-deep); transform: translateY(1px); }
  .unit-actions__url { flex: 1 1 16rem; min-height: 2.25rem; padding: 0.3rem 0.6rem; font: 0.9rem var(--font-mono); color: var(--color-ink); background: var(--color-paper); border: 1px solid var(--color-line); border-radius: 6px; }
  .unit-actions__status { flex-basis: 100%; margin: 0; font-size: 0.9rem; color: var(--color-ink-soft); }
  .unit-actions__status:empty { display: none; }
  @media (pointer: coarse) {
    .unit-material a, .unit-actions__btn, .unit-actions__url { min-height: 44px; }
  }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .unit-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 1.5rem 2.5rem;
    padding: 1.8rem;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 6px;
    box-shadow: 0 1px 2px rgba(42, 31, 24, 0.05), 0 4px 14px rgba(42, 31, 24, 0.06);
    margin: 0;
  }
  .unit-meta dt {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink-mute);
    margin-bottom: 0.4rem;
    font-weight: 600;
  }
  .unit-meta dd { margin: 0; font-size: 1rem; color: var(--color-ink); }
  .tag-row { line-height: 1.8; }
  .tag {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--color-ink);
  }
  .tag:not(:last-child)::after {
    content: " · ";
    color: var(--color-mustard);
  }
  .objetivos { margin: 0.4rem 0 0; padding-left: 1.1rem; font-size: 1rem; color: var(--color-ink-soft); }
  .objetivos li { margin-bottom: 0.4rem; }

  /* Phones: the preamble (opener, fitxa, TOC, content fitxa) used to fill
     eight screens before the first section. Same content, tighter rhythm. */
  @media (max-width: 700px) {
    .unit-opener { padding-bottom: 1.5rem; }
    .lede { font-size: 1.2rem; margin-bottom: 1.2rem; }
    .unit-meta { padding: 1.1rem 1.2rem; gap: 0.9rem; }
    .unit-meta dd, .tag { font-size: 0.9rem; }
    .unit-meta dt { margin-bottom: 0.2rem; }
    .tag-row { line-height: 1.5; }
    .unit-material { margin-top: 0.6rem; }
    .unit-actions { gap: 0.4rem; margin-bottom: 1.2rem; }
    .unit-actions__btn { padding: 0.3rem 0.7rem; font-size: 0.86rem; }
  }

  /* The content's own fitxa (reading time, saberes, pre-requisites,
     objectives): the first blockquote of every unit. Lighter than prose. */
  .article-body > :global(blockquote:first-child) {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }
  .article-body > :global(blockquote:first-child p:first-child) { font-size: 0.92rem; }
  .article-body > :global(blockquote:first-child strong) { font-weight: 600; color: var(--color-ink-soft); }

  /* ARTICLE LAYOUT */
  .article-layout {
    display: grid;
    /* minmax(0, 1fr), not 1fr: a bare `1fr` is `minmax(auto, 1fr)`, whose auto
       floor is the track's min-content. One wide table in the article was
       therefore widening the whole column past the viewport and dragging the
       TOC and every paragraph out with it (horizontal scroll on phones). */
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    padding: 4rem 0;
  }
  @media (min-width: 1100px) {
    .article-layout {
      grid-template-columns: 220px minmax(0, var(--measure-prose)) 1fr;
      gap: 4rem;
    }
    /* Sidebar mode lives only here. Below 1100px the layout is a single column,
       so the TOC must stay in normal flow — if it were sticky it would pin to the
       top and the scrolling content (diagrams included) would slide under it and
       overlap. */
    .article-toc {
      order: -1;
      position: sticky;
      top: 5rem;
      align-self: start;
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
    }
  }

  .article-toc {
    font-size: 0.92rem;
  }
  .article-toc .toc-title { font-family: var(--font-sans); font-size: 0.78rem; font-weight: 600; color: var(--color-ink-mute); text-transform: uppercase; letter-spacing: 0.12em; list-style: none; }
  .article-toc .toc-title::-webkit-details-marker { display: none; }
  /* In-flow (below 1100px): a folded bar the reader opens on demand. */
  @media (max-width: 1099px) {
    .article-layout { gap: 1.5rem; padding: 1.5rem 0 4rem; }
    .article-toc .toc-title {
      display: flex;
      justify-content: space-between;
      align-items: center;
      min-height: 44px;
      padding: 0 1rem;
      background: var(--color-paper);
      border: 1px solid var(--color-line);
      border-radius: 6px;
      cursor: pointer;
    }
    .article-toc .toc-title:hover { border-color: var(--color-terra); color: var(--color-ink); }
    .article-toc .toc-title::after { content: "+"; font-family: var(--font-mono); font-size: 1.1rem; color: var(--color-terra-ink); }
    .article-toc details[open] .toc-title::after { content: "−"; }
    .article-toc details[open] ol { margin-top: 1rem; }
  }
  /* Sidebar: a plain label, always open. */
  @media (min-width: 1100px) {
