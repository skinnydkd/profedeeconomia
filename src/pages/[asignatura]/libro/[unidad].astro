        z-index: 70;
        pointer-events: none;
        animation: read-progress linear both;
        animation-timeline: scroll(root);
      }
    }
  }
  @keyframes read-progress { to { transform: scaleX(1); } }

  /* Prev/next */
  .unit-nav {
