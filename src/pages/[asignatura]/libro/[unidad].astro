    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-terra-ink);
    font-weight: 700;
  }
  .unit-nav .title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.3;
