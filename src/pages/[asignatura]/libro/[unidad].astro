    line-height: 1.4;
    position: relative;
    padding-left: 1.6rem;
  }
  /* Same scheme as the body: «02» for a section, «2.3» for a subsection. */
  .article-toc li.toc-d2 { counter-increment: toc-h2; counter-reset: toc-h3; }
  .article-toc li.toc-d3 { counter-increment: toc-h3; padding-left: 2.6rem; font-size: 0.95em; }
  .article-toc li.toc-d3::before { content: counter(toc-h2) "." counter(toc-h3); left: 1rem; }
  .article-toc li::before {
    content: counter(toc-h2, decimal-leading-zero);
    position: absolute;
    left: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-mustard-deep);
    letter-spacing: 0.04em;
    top: 0.2em;
  }
  .article-toc a { color: var(--color-ink-soft); text-decoration: none; }
  .article-toc a:hover { color: var(--color-terra); }

  .article-body {
    max-width: var(--measure-prose);
    font-size: 1.2rem;
    line-height: 1.72;
    counter-reset: h2section;
  }
  /* Phones: 1.125rem, the project's body minimum, instead of 1.2rem. */
  @media (max-width: 700px) { .article-body { font-size: 1.125rem; } }
  /* Direct children only: the MDX sections are children of the article, while
     the headings inside components (calculators, solved exercises, «Para el
     aula»…) are not sections and must not take a number or this size. */
  .article-body > :global(h2) {
    margin-top: 3em;
    font-size: 2rem;
    position: relative;
    padding-top: 1.2em;
    letter-spacing: -0.02em;
    counter-increment: h2section;
    counter-reset: h3section;
  }
  /* Auto-numbering: §1, §2, §3 … as eyebrow before the heading text.
     `top: 1.5em` aligns the marker baseline to the cap-line of the heading
     text (h2 font-size 2rem + padding-top 1.2em).
   */
  .article-body > :global(h2::after) {
    content: counter(h2section, decimal-leading-zero);
    position: absolute;
    top: 1.5em;
    right: 100%;
    margin-right: 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-mustard-deep);
    letter-spacing: 0.04em;
    font-weight: 500;
    line-height: 1;
