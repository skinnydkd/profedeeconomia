  }

  .article-body :global(ul li::marker) { color: var(--color-mustard); }

  .article-body :global(ul),
  .article-body :global(ol) {
    padding-left: 1.4rem;
    margin: 0 0 1.4em;
  }
  .article-body :global(li) { margin-bottom: 0.5em; }
  .article-body :global(strong) { color: var(--color-ink); }
  .article-body :global(em) { color: var(--color-ink); font-style: italic; }

  /* Tables inside MDX */
  .article-body :global(table) {
    /* A table cannot shrink below its min-content, so on a phone a wide one
       would push the page sideways. `display: block` + this width triad makes
       it stretch to the full measure when it fits and scroll inside its own
       box when it does not, leaving the page itself at viewport width.
       overflow-x: auto also keeps the corners clipped (it replaces the former
       `overflow: hidden`, which existed for the border-radius). */
    display: block;
    width: max-content;
    min-width: 100%;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: separate;
    border-spacing: 0;
    margin: 2.2rem 0;
    font-size: 0.98rem;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 6px;
  }
  /* A Markdown table sits in a scrolling .tabla-scroll box (global.css), which
     takes over the sideways scroll: the table keeps its normal layout and the
     box, being focusable, can be scrolled with the keyboard too. The rule above
     stays for tables that components render themselves. */
  .article-body :global(.tabla-scroll) { margin: 2.2rem 0; }
  .article-body :global(.tabla-scroll > table) {
    display: table;
    width: 100%;
    min-width: 0;
    max-width: none;
    overflow-x: visible;
    margin: 0;
  }
  /* Printing the web page has no viewport to scroll: let the table reflow. */
  @media print {
    .article-body :global(table) {
      display: table;
      width: 100%;
      overflow-x: visible;
    }
  }
  .article-body :global(table th),
  .article-body :global(table td) {
    text-align: left;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--color-line-soft);
    vertical-align: top;
  }
  .article-body :global(table tr:last-child td) { border-bottom: none; }
  .article-body :global(table th) {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-terra-deep);
    background: var(--color-terra-soft);
    font-weight: 700;
  }

  .unit-check { margin: 3.5rem 0 0; padding-top: 1.5rem; border-top: 1px solid var(--color-line); }
  .article-body .unit-check__title { margin: 0 0 0.8rem; font-size: 1.5rem; }
  .article-body .unit-check ul { list-style: none; padding: 0; margin: 0; font-size: 1.05rem; }
  .unit-check li { margin: 0 0 0.4rem; }
  .unit-check a { color: var(--color-terra-ink); display: inline-flex; min-height: 1.75rem; align-items: center; }
  .unit-check .unit-check__test { font-weight: 600; font-size: 1.15rem; }

  /* Reading progress: pure CSS (scroll-driven animation); absent where the
     browser lacks it or the reader asked for less motion. */
  .read-progress { display: none; }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .read-progress {
        display: block;
        position: fixed;
        inset: 0 0 auto 0;
        height: 3px;
        background: var(--color-terra);
