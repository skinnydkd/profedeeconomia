     The two overrides below had lost the base rule that draws it. */
  .article-body > :global(h2::before) {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 4rem;
    height: 4px;
    border-radius: 999px;
    background: var(--color-terra);
  }
  .article-body > :global(h2:nth-of-type(2n)::before) { background: var(--color-mustard); }
  .article-body > :global(h2:nth-of-type(3n)::before) { background: var(--color-eco1); }

  .article-body > :global(h3) {
    counter-increment: h3section;
    position: relative;
    padding-left: 2.4rem;
    margin-top: 2.2em;
  }
  .article-body > :global(h3::before) {
    content: counter(h2section) "." counter(h3section);
    position: absolute;
    left: 0;
    top: 0.05em;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95em;
    color: var(--color-mustard-deep);
    font-variation-settings: "SOFT" 100, "WONK" 1;
