---
/**
 * Print-ready single-page render of an entire book.
 * Used by paged.js (via pagedjs-cli) to produce the downloadable PDF.
 *
 * The browser also previews this as a paginated document because we
 * include the paged.js polyfill at the bottom of the document.
 *
 * Generates one path per asignatura that has at least one published unit.
 */
import { ACCENTS, ASIGNATURA_SLUGS, ASIGNATURAS } from '@/lib/asignaturas';
import { getCollection, render } from 'astro:content';
import { getLocale } from '@/i18n/locale';
import { pickLocalizedEntry } from '@/i18n/content-locale';
import { localizeAsignatura } from '@/i18n/asignaturas-ca';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const all = await getCollection('libro');
  const allReto = await getCollection('retoCurso');
  const allEbau = await getCollection('ebau');

  // Printable ES book. CA printable editions are out of scope here, so keep the
  // ES source of truth only (CA siblings would otherwise duplicate every unit).
  const bySlug = new Map<string, typeof all>();
  for (const u of all) {
    if (u.data.estado !== 'publicado' || u.data.lang !== 'es') continue;
    const arr = bySlug.get(u.data.asignatura) ?? [];
    arr.push(u);
    bySlug.set(u.data.asignatura, arr);
  }

  const retoBySlug = new Map<string, typeof allReto>();
  for (const r of allReto) {
    if (r.data.estado !== 'publicado' || r.data.lang !== 'es') continue;
    const arr = retoBySlug.get(r.data.asignatura) ?? [];
    arr.push(r);
    retoBySlug.set(r.data.asignatura, arr);
  }

  const ebauBySlug = new Map<string, typeof allEbau>();
  for (const e of allEbau) {
    if (e.data.estado !== 'publicado' || e.data.lang !== 'es') continue;
    const arr = ebauBySlug.get(e.data.asignatura) ?? [];
    arr.push(e);
    ebauBySlug.set(e.data.asignatura, arr);
  }

  return ASIGNATURA_SLUGS.flatMap((slug) => {
    const units = bySlug.get(slug);
    if (!units || units.length === 0) return [];
    units.sort((a, b) => a.data.unidad - b.data.unidad);
    const reto = (retoBySlug.get(slug) ?? []).slice().sort((a, b) => a.data.orden - b.data.orden);
    const ebau = (ebauBySlug.get(slug) ?? []).slice().sort((a, b) => a.data.orden - b.data.orden);
    return [{ params: { asignatura: slug }, props: { units, reto, ebau, asignatura: ASIGNATURAS[slug] } }];
  });
}) satisfies GetStaticPaths;

const locale = getLocale(Astro.currentLocale);
const a = localizeAsignatura(Astro.props.asignatura, locale);

// Swap each ES entry for its Valencian sibling under /ca (ES fallback). Each
// map is built from a concrete getCollection call so the entry types stay
// specific (a shared helper would widen them to a union).
const caPub = 'publicado';
const libroCa = new Map(
  (await getCollection('libro')).filter((e) => e.data.estado === caPub && e.data.lang === 'ca').map((e) => [e.id, e]),
);
const retoCa = new Map(
  (await getCollection('retoCurso')).filter((e) => e.data.estado === caPub && e.data.lang === 'ca').map((e) => [e.id, e]),
);
const ebauCa = new Map(
  (await getCollection('ebau')).filter((e) => e.data.estado === caPub && e.data.lang === 'ca').map((e) => [e.id, e]),
);
const units = Astro.props.units.map((u) => pickLocalizedEntry(u, libroCa, locale));
const reto = Astro.props.reto.map((r) => pickLocalizedEntry(r, retoCa, locale));
const ebau = Astro.props.ebau.map((e) => pickLocalizedEntry(e, ebauCa, locale));

// Pre-render each unit so we have headings + Content
const rendered = await Promise.all(
  units.map(async (u) => {
    const { Content } = await render(u);
    return { unit: u, Content };
  })
);
const renderedReto = await Promise.all(
  reto.map(async (r) => {
    const { Content } = await render(r);
    return { entry: r, Content };
  })
);
const renderedEbau = await Promise.all(
  ebau.map(async (e) => {
    const { Content } = await render(e);
    return { entry: e, Content };
  })
);

const today = new Date().toLocaleDateString(locale === 'ca' ? 'ca-ES' : 'es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const totalUnits = units.length;

const copy = {
  es: {
    unidades: 'unidades', curriculo: 'Currículo estatal LOMLOE', editorial: 'Editorial', edicion: 'Edición',
    edicionVal: 'Curso 2026/27 · borrador', generado: 'Generado',
    sobreH: 'Sobre este libro',
    sobreP1a: 'Este libro forma parte de los materiales abiertos de', sobreP1b: ', una plataforma de recursos para profesores de instituto de economía, empresa y finanzas. Todo el contenido se publica bajo licencia', sobreP1c: ': podéis copiarlo, redistribuirlo y adaptarlo siempre que citéis la autoría y no lo uséis con fines comerciales.',
    sobreP2a: 'Este libro se basa en el currículo básico estatal LOMLOE para', sobreP2b: '). Cada comunidad autónoma establece concreciones específicas en su currículo propio; conviene consultar la concreción de vuestra CCAA para ajustar la programación al centro.',
    colofon: 'Composición tipográfica con Fraunces y Switzer. Generado con Astro y paged.js. Comentarios, erratas y propuestas:',
    indice: 'Índice general', contenido: 'Contenido', unidad: 'Unidad', pagina: 'Página',
    duracion: 'Duración', conceptos: 'Conceptos clave', objetivos: 'Objetivos de la unidad',
    apendice: 'Apéndice', guiaEbau: 'Guía EBAU', guiaEbauLede: 'Para llegar al examen con la cabeza en su sitio.',
  },
  ca: {
    unidades: 'unitats', curriculo: 'Currículum estatal LOMLOE', editorial: 'Editorial', edicion: 'Edició',
    edicionVal: 'Curs 2026/27 · esborrany', generado: 'Generat',
    sobreH: 'Sobre este llibre',
    sobreP1a: 'Este llibre forma part dels materials oberts de', sobreP1b: ', una plataforma de recursos per a professors d\'institut d\'economia, empresa i finances. Tot el contingut es publica sota llicència', sobreP1c: ': podeu copiar-lo, redistribuir-lo i adaptar-lo sempre que en citeu l\'autoria i no l\'useu amb fins comercials.',
    sobreP2a: 'Este llibre es basa en el currículum bàsic estatal LOMLOE per a', sobreP2b: '). Cada comunitat autònoma estableix concrecions específiques al seu currículum propi; convé consultar la concreció de la vostra CCAA per a ajustar la programació al centre.',
    colofon: 'Composició tipogràfica amb Fraunces i Switzer. Generat amb Astro i paged.js. Comentaris, errades i propostes:',
    indice: 'Índex general', contenido: 'Contingut', unidad: 'Unitat', pagina: 'Pàgina',
    duracion: 'Durada', conceptos: 'Conceptes clau', objetivos: 'Objectius de la unitat',
    apendice: 'Apèndix', guiaEbau: 'Guia EBAU', guiaEbauLede: "Per a arribar a l'examen amb el cap al seu lloc.",
  },
}[locale];

const accent = ACCENTS[a.color];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <title>{a.title} — profedeeconomia</title>
    <meta name="robots" content="noindex,nofollow" />

    {/* All fonts are self-hosted for the print route — Fontshare's (and
        Google's) CDN crashes paged.js / pagedjs-cli with a ProgressEvent
        during rendering, and self-hosting removes the build-time network
        dependency. */}
    <style is:inline>
      @font-face { font-family: 'Fraunces'; src: url('/fonts/fraunces-latin-normal.woff2') format('woff2'); font-weight: 300 700; font-style: normal; font-display: swap; }
      @font-face { font-family: 'Fraunces'; src: url('/fonts/fraunces-latin-italic.woff2') format('woff2'); font-weight: 300 700; font-style: italic; font-display: swap; }
      @font-face { font-family: 'Switzer'; src: url('/fonts/switzer/switzer-400.woff2') format('woff2'); font-weight: 400; font-display: swap; font-style: normal; }
      @font-face { font-family: 'Switzer'; src: url('/fonts/switzer/switzer-500.woff2') format('woff2'); font-weight: 500; font-display: swap; font-style: normal; }
      @font-face { font-family: 'Switzer'; src: url('/fonts/switzer/switzer-600.woff2') format('woff2'); font-weight: 600; font-display: swap; font-style: normal; }
      @font-face { font-family: 'Switzer'; src: url('/fonts/switzer/switzer-700.woff2') format('woff2'); font-weight: 700; font-display: swap; font-style: normal; }
      @font-face { font-family: 'JetBrains Mono'; src: url('/fonts/jetbrains-mono-latin.woff2') format('woff2'); font-weight: 400 500; font-style: normal; font-display: swap; }
    </style>

    <style is:global>
      /* =========================================================
         Variant C tokens (mirror of global.css, kept local to the
         print route so paged.js can resolve them without Tailwind).
         ========================================================= */
      :root {
        --color-bg: #FBF6EC;
        --color-paper: #FFFFFF;
        --color-bg-soft: #F8E8D0;
        --color-bg-cream: #F5EDD9;

        --color-ink: #2A1F18;
        --color-ink-soft: #5C4A3D;
        --color-ink-mute: #8A7868;
        --color-line: #E5D4BD;
        --color-line-soft: #EFE2CB;

        --color-terra: #C44E2C;
        --color-terra-deep: #9C3A1C;
        --color-terra-soft: #FBE3D6;

        --color-mustard: #D4A24C;
        --color-mustard-deep: #A87A2A;
        --color-mustard-soft: #F5E5BC;

        --color-fopp: #5B3A4E;
        --color-fopp-soft: #ECDCE5;

        --font-serif: "Fraunces", Georgia, serif;
        --font-sans: "Switzer", -apple-system, "Segoe UI", sans-serif;
        --font-mono: "JetBrains Mono", ui-monospace, Menlo, monospace;
      }

      /* =========================================================
         @page rules — A5 portrait, 165×220 mm, generous margins.
         paged.js consumes these via "page-break-*" and "@page" CSS.
         ========================================================= */
      @page {
        size: 165mm 235mm;
        margin: 11mm 12mm 12mm 12mm;

        @top-left {
          content: string(book-title);
          font-family: var(--font-sans);
          font-size: 8.5pt;
          letter-spacing: 0.06em;
          text-transform: uppercase;
          color: var(--color-ink-mute);
        }
        @top-right {
          content: string(unit-title);
          font-family: var(--font-serif);
          font-style: italic;
          font-size: 9pt;
          color: var(--color-ink-mute);
        }
        @bottom-right {
          content: counter(page);
          font-family: var(--font-serif);
          font-size: 10pt;
          color: var(--color-terra);
        }
      }

      /* No running headers on cover and credits */
      @page :first { @top-left { content: none; } @top-right { content: none; } @bottom-right { content: none; } }
      @page no-header { @top-left { content: none; } @top-right { content: none; } }

      /* Right and left pages — even mirror */
      @page :left {
        margin-left: 12mm;
        margin-right: 12mm;
        @bottom-right { content: none; }
        @bottom-left {
          content: counter(page);
          font-family: var(--font-serif);
          font-size: 10pt;
          color: var(--color-terra);
        }
      }

      /* =========================================================
         Base
         ========================================================= */
      * { box-sizing: border-box; }
      html { font-size: 9pt; }
      body {
        margin: 0;
        background: var(--color-bg);
        color: var(--color-ink);
        font-family: var(--font-serif);
        font-size: 9pt;
        line-height: 1.23;
        font-feature-settings: "kern", "liga", "ss01";
        font-variation-settings: "SOFT" 50, "WONK" 0;
      }

      /* .book-title-string is set dynamically in an inline style block below
         based on the current asignatura (cannot be in <style is:global> since
         it must vary per page). */

      h1, h2, h3, h4 {
        font-family: var(--font-serif);
        font-weight: 500;
        color: var(--color-ink);
        line-height: 1.18;
      }

      p { margin: 0 0 0.4em; orphans: 2; widows: 2; }

      a { color: var(--color-terra); text-decoration: none; }
      strong { color: var(--color-ink); }
      em { font-style: italic; }

      code {
        font-family: var(--font-mono);
        font-size: 0.92em;
        background: var(--color-bg-cream);
        padding: 0.05em 0.35em;
        border-radius: 2px;
      }
      pre {
        font-family: var(--font-mono);
        background: var(--color-bg-cream);
        padding: 0.7rem 1rem;
        border-radius: 4px;
        border-left: 3px solid var(--color-mustard);
        color: var(--color-mustard-deep);
        font-size: 9.5pt;
        font-weight: 500;
        margin: 0.6em 0;
        white-space: pre-wrap;
      }
      pre code {
        color: inherit;
        background: transparent;
        font-weight: inherit;
        padding: 0;
      }

      ul, ol { padding-left: 1.2em; margin: 0 0 0.5em; }
      li { margin-bottom: 0.16em; }
      ul li::marker { color: var(--color-mustard); }

      table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin: 0.8em 0;
        font-size: 9.5pt;
        page-break-inside: auto;
      }
      th, td {
        text-align: left;
        padding: 0.32em 0.55em;
        border-bottom: 1px solid var(--color-line-soft);
        vertical-align: top;
      }
      th {
        font-family: var(--font-sans);
        font-size: 8pt;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-terra-deep);
        background: var(--color-terra-soft);
        font-weight: 700;
      }

      /* =========================================================
         Cover page
         ========================================================= */
      .cover {
        page: no-header;
        break-after: page;
        height: 191mm;             /* 235 - 22 - 22 */
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .cover__top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        font-family: var(--font-sans);
        font-size: 8.5pt;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--book-accent);
      }
      .cover__top .mark {
        width: 20pt; height: 20pt;
        border-radius: 50%;
        background: var(--book-accent);
        position: relative;
      }
      .cover__top .mark::before {
        content: "";
        position: absolute; inset: 4pt;
        background: var(--color-mustard);
        border-radius: 50%;
      }
      .cover__top .mark::after {
        content: "";
        position: absolute; inset: 8pt;
        background: var(--color-bg);
        border-radius: 50%;
      }

      .cover__center {
        margin-top: -16mm;
      }
      .cover__num {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 120pt;
        line-height: 0.82;
        color: var(--book-accent-soft);
        margin: 0 0 2mm -2pt;
        font-weight: 400;
        font-variation-settings: "SOFT" 100, "WONK" 1;
        display: block;
      }
      .cover__rule {
        width: 34mm;
        height: 5pt;
        background: var(--book-accent);
        border-radius: 999px;
        margin: 0 0 7mm;
      }
      .cover__kicker {
        font-family: var(--font-sans);
        font-size: 9.5pt;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--book-accent);
        font-weight: 700;
        margin-bottom: 3mm;
      }
      .cover__title {
        font-family: var(--font-serif);
        font-size: 46pt;
        line-height: 1.04;
        letter-spacing: -0.025em;
        color: var(--color-ink);
        margin: 0 0 5mm;
        font-weight: 400;
        font-variation-settings: "SOFT" 80, "WONK" 0;
        max-width: 24ch;
      }
      .cover__title em {
        font-style: italic;
        color: var(--book-accent);
        font-variation-settings: "SOFT" 100, "WONK" 1;
      }
      .cover__lede {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 14pt;
        color: var(--color-ink-soft);
        line-height: 1.45;
        max-width: 28ch;
        margin: 0;
        font-variation-settings: "SOFT" 80;
      }
      .cover__inside {
        margin-top: 7mm;
        font-family: var(--font-sans);
        font-size: 8.5pt;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-ink-mute);
      }
      .cover__inside strong { color: var(--book-accent-deep); font-weight: 700; }

      .cover__bottom {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        font-family: var(--font-sans);
        font-size: 9pt;
        color: var(--color-ink-soft);
      }
      .cover__bottom .stack { display: flex; flex-direction: column; gap: 2mm; }
      .cover__bottom .stack strong {
        color: var(--color-ink);
        font-weight: 600;
        font-size: 9.5pt;
      }
      .cover__bottom .stack .muted {
        font-size: 8pt;
        color: var(--color-ink-mute);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      /* =========================================================
         Credits / colophon page
         ========================================================= */
      .credits {
        page: no-header;
        break-before: page;
        break-after: page;
        height: 191mm;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding-bottom: 5mm;
      }
      .credits h2 {
        font-family: var(--font-sans);
        font-size: 8.5pt;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--book-accent);
        margin: 0 0 4mm;
        font-weight: 700;
      }
      .credits p {
        font-family: var(--font-serif);
        font-size: 10pt;
        color: var(--color-ink-soft);
        line-height: 1.5;
        max-width: 28em;
      }
      .credits .colophon-note {
        margin-top: 8mm;
        padding-top: 4mm;
        border-top: 1px dashed var(--color-line);
        font-size: 9pt;
        color: var(--color-ink-mute);
        font-style: italic;
      }

      /* =========================================================
         Table of contents — paged.js target-counter for page nums
         ========================================================= */
      .toc {
        break-before: page;
        break-after: page;
        padding-top: 10mm;
      }
      .toc__kicker {
        font-family: var(--font-sans);
        font-size: 8.5pt;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--book-accent);
        font-weight: 700;
        margin-bottom: 4mm;
      }
      .toc h2 {
        font-family: var(--font-serif);
        font-size: 36pt;
        line-height: 1;
        margin: 0 0 12mm;
        color: var(--color-ink);
        font-weight: 400;
        font-variation-settings: "SOFT" 80, "WONK" 0;
      }
      .toc__list { list-style: none; padding: 0; margin: 0; }
      .toc__item {
        display: grid;
        grid-template-columns: 16mm 1fr auto;
        column-gap: 4mm;
        align-items: baseline;
        padding: 3mm 0;
        border-bottom: 1px solid var(--color-line-soft);
        break-inside: avoid;
        page-break-inside: avoid;
      }
      .toc__num {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 13pt;
        color: var(--color-mustard-deep);
        font-variation-settings: "SOFT" 100, "WONK" 1;
      }
      .toc__title-block {
        display: flex;
        flex-direction: column;
        gap: 1mm;
      }
      .toc__title {
        font-family: var(--font-serif);
        font-size: 12pt;
        color: var(--color-ink);
        line-height: 1.2;
      }
      .toc__lede {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 9pt;
        color: var(--color-ink-mute);
        line-height: 1.35;
        font-variation-settings: "SOFT" 80;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .toc__page {
        font-family: var(--font-mono);
        font-size: 9.5pt;
        color: var(--book-accent-deep);
        font-weight: 500;
      }
      .toc__page::after {
        content: target-counter(attr(href url), page);
      }

      /* =========================================================
         Chapter opener (one per unit)
         ========================================================= */
      .chapter {
        break-before: page;
      }
      /* Compact opener: a header band at the top of the unit's first page,
         not a full blank page. The unit content flows right after it. */
      .chapter__opener {
        padding: 4mm 0 5mm;
        margin-bottom: 4mm;
        border-bottom: 1px solid var(--color-line);
        position: relative;
      }
      .chapter__opener::before {
        content: "";
        position: absolute;
        top: 0; left: 0;
        width: 26mm; height: 3pt;
        background: var(--book-accent);
        border-radius: 999px;
      }
      .chapter__kicker {
        font-family: var(--font-sans);
        font-size: 9pt;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--book-accent);
        font-weight: 700;
        margin-bottom: 4mm;
      }
      .chapter__num {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 34pt;
        line-height: 0.95;
        color: var(--color-mustard-deep);
        margin: 0 0 1mm;
        font-weight: 400;
        font-variation-settings: "SOFT" 100, "WONK" 1;
      }
      .chapter__title {
        font-family: var(--font-serif);
        font-size: 22pt;
        line-height: 1.06;
        letter-spacing: -0.02em;
        color: var(--color-ink);
        margin: 0 0 3mm;
        font-weight: 400;
        font-variation-settings: "SOFT" 80, "WONK" 0;
        max-width: 26ch;
      }
      .chapter__lede {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 11pt;
        line-height: 1.35;
        color: var(--color-ink-soft);
        max-width: 40em;
        margin: 0 0 4mm;
        font-variation-settings: "SOFT" 80;
      }
      .chapter__meta {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(40mm, 1fr));
        gap: 2mm 6mm;
        padding-top: 3mm;
        border-top: 1px dashed var(--color-line);
        font-family: var(--font-sans);
      }
      .chapter__meta dt {
        font-size: 7.5pt;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-ink-mute);
        margin-bottom: 1mm;
        font-weight: 600;
      }
      .chapter__meta dd { margin: 0; font-size: 10pt; color: var(--color-ink); }
      .chapter__meta dd ul { padding: 0; margin: 0; list-style: none; }
      .chapter__meta dd ul li { font-size: 9pt; }

      .chapter__content {
        string-set: unit-title attr(data-unit-title);
        padding-top: 0;
      }
      .chapter__content > p:first-of-type::first-letter {
        font-family: var(--font-serif);
        font-weight: 500;
        font-size: 4.3em;
        line-height: 0.85;
        float: left;
        padding: 0.04em 0.12em 0 0;
        color: var(--color-terra);
        font-variation-settings: "SOFT" 100, "WONK" 1;
      }
      .chapter__content h2 {
        font-size: 13.5pt;
        margin: 1.1em 0 0.4em;
        position: relative;
        padding-top: 0.6em;
        break-after: avoid;
      }
      .chapter__content h2::before {
        content: "";
        position: absolute;
        top: 0; left: 0;
        width: 22mm; height: 3px;
        background: var(--color-terra);
        border-radius: 999px;
      }
      .chapter__content h2:nth-of-type(2n)::before { background: var(--color-mustard); }
      .chapter__content h3 {
        font-size: 11pt;
        margin: 0.9em 0 0.3em;
        color: var(--color-ink);
        break-after: avoid;
      }

      /* Callout-like blocks: pedagogical boxes that should not be inflated
         by their airy web margins when paginated, and must not fragment
         across pages. Includes the 7 new pilot components. */
      .chapter__content .callout,
      .chapter__content .solved-exercise,
      .chapter__content .curiosity,
      .chapter__content .real-example,
      .chapter__content .takeaways,
      .chapter__content .steps,
      .chapter__content .tldr,
      .chapter__content .caso,
      .chapter__content .vuelve,
      .chapter__content .pista-ebau,
      .chapter__content .voces,
      .chapter__content .reto {
        margin: 0.8em 0 !important;
        padding: 0.7rem 0.95rem !important;
        page-break-inside: avoid;
        break-inside: avoid;
      }
      .chapter__content .takeaways { padding-left: 1.8rem !important; }
      .chapter__content .callout > :first-child,
      .chapter__content .curiosity > :first-child,
      .chapter__content .real-example > :first-child,
      .chapter__content .solved-exercise > :first-child,
      .chapter__content .takeaways > :first-child,
      .chapter__content .steps > :first-child,
      .chapter__content .tldr > :first-child,
      .chapter__content .caso > :first-child,
      .chapter__content .vuelve > :first-child,
      .chapter__content .pista-ebau > :first-child,
      .chapter__content .voces > :first-child,
      .chapter__content .reto > :first-child { margin-top: 0 !important; }
      .chapter__content .callout > :last-child,
      .chapter__content .curiosity > :last-child,
      .chapter__content .real-example > :last-child,
      .chapter__content .solved-exercise > :last-child,
      .chapter__content .takeaways > :last-child,
      .chapter__content .steps > :last-child,
      .chapter__content .tldr > :last-child,
      .chapter__content .caso > :last-child,
      .chapter__content .vuelve > :last-child,
      .chapter__content .pista-ebau > :last-child,
      .chapter__content .voces > :last-child,
      .chapter__content .reto > :last-child { margin-bottom: 0 !important; }

      /* MirarFora: a full final page per unit. */
      .chapter__content .mirar-fora {
        break-before: page;
        margin-top: 0 !important;
        padding-top: 0 !important;
        border-top: none !important;
      }
      .chapter__content .mirar-fora__recurso,
      .chapter__content .mirar-fora__actividad {
        break-inside: avoid;
        page-break-inside: avoid;
      }

      /* Suppress drop cap on the first paragraph that follows a heading
         or one of the unit-opener pedagogical blocks (TL;DR / CasoDilema)
         which already sit before the body and shouldn't trigger drop cap
         on the prose that follows. */
      .chapter__content h2 + p::first-letter,
      .chapter__content h3 + p::first-letter,
      .chapter__content .tldr + p::first-letter,
      .chapter__content .caso + p::first-letter {
        font-family: inherit;
        font-weight: inherit;
        font-size: inherit;
        line-height: inherit;
        float: none;
        padding: 0;
        color: inherit;
      }

      /* =========================================================
         Print typography refinements (paged.js)
         ========================================================= */
      /* Hyphenation for Spanish body copy — softens the ragged edge
         without forcing justification (which would risk rivers). */
      .chapter__content p,
      .chapter__content li {
        -webkit-hyphens: auto;
        hyphens: auto;
        hyphenate-limit-chars: 6 3 3;
      }

      /* Figures: the web float/bleed variants don't paginate cleanly under
         paged.js (floats and CSS transforms shift the image during page
         fragmentation), so in print EVERY figure collapses to a plain centered
         block. The !important flags beat the component's scoped variant rules,
         which otherwise have equal specificity and can win by source order.
         The web keeps the richer layout. */
      .chapter__content figure.figure {
        break-inside: avoid;
        page-break-inside: avoid;
        display: block;
        float: none !important;
        transform: none !important;
        margin: 0.9em auto !important;
        max-width: 100%;
      }
      /* Narrower images in print keep the book compact without cropping. */
      .chapter__content figure.figure { max-width: 78% !important; }
      .chapter__content .figure--left,
      .chapter__content .figure--right {
        max-width: 48% !important;
      }
      .chapter__content .figure--inline-small {
        max-width: 42mm !important;
      }
      .chapter__content .figure--wide,
      .chapter__content .figure--full {
        max-width: 92% !important;
      }
      .chapter__content .figure--tight {
        max-width: 62% !important;
      }

      /* Keep diagrams whole on a page and bounded to the text block */
      .chapter__content .diagram,
      .chapter__content figure svg {
        break-inside: avoid;
        page-break-inside: avoid;
        max-width: 100%;
        height: auto;
      }

      /* =========================================================
         Reto del curso — pàgines d'introducció abans del TOC
         ========================================================= */
      .reto-intro { break-before: page; }
      .reto-intro__page {
        break-after: page;
        padding-top: 8mm;
      }
      .reto-intro__page :global(h1) {
        font-family: var(--font-serif);
        font-size: 30pt;
        line-height: 1.05;
        margin: 0 0 6mm;
        color: var(--color-ink);
        font-weight: 400;
        font-variation-settings: "SOFT" 80, "WONK" 0;
        letter-spacing: -0.015em;
      }
      .reto-intro__page :global(h2) {
        font-family: var(--font-sans);
        font-size: 9.5pt;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--book-accent);
        margin: 6mm 0 2mm;
        font-weight: 700;
      }
      .reto-intro__page :global(p) {
        font-family: var(--font-serif);
        font-size: 10.5pt;
        line-height: 1.55;
        color: var(--color-ink);
        margin: 0 0 0.6em;
      }
      .reto-intro__page :global(table) { font-size: 9pt; margin: 3mm 0; }

      /* =========================================================
         Apèndix EBAU — secció final del PDF
         ========================================================= */
      .ebau-apendix { break-before: page; }
      .ebau-apendix__cover {
        page: no-header;
        break-after: page;
        height: 191mm;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .ebau-apendix__kicker {
        font-family: var(--font-sans);
        font-size: 10pt;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: var(--book-accent);
        font-weight: 700;
        margin-bottom: 4mm;
      }
      .ebau-apendix__title {
        font-family: var(--font-serif);
        font-size: 48pt;
        line-height: 1;
        margin: 0 0 6mm;
        color: var(--color-ink);
        font-weight: 400;
        font-variation-settings: "SOFT" 80, "WONK" 0;
        letter-spacing: -0.02em;
      }
      .ebau-apendix__lede {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 14pt;
        color: var(--color-ink-soft);
        margin: 0;
        font-variation-settings: "SOFT" 80;
      }
      .ebau-apendix__section {
        break-before: page;
        padding-top: 8mm;
        font-family: var(--font-serif);
      }
      .ebau-apendix__section-title {
        font-family: var(--font-serif);
        font-size: 22pt;
        line-height: 1.1;
        margin: 0 0 6mm;
        color: var(--color-ink);
        font-weight: 400;
        font-variation-settings: "SOFT" 80, "WONK" 0;
        position: relative;
        padding-top: 4mm;
        letter-spacing: -0.012em;
      }
      .ebau-apendix__section-title::before {
        content: "";
        position: absolute;
        top: 0; left: 0;
        width: 26mm; height: 3pt;
        background: var(--book-accent);
        border-radius: 999px;
      }
      .ebau-apendix__section :global(h2) {
        font-family: var(--font-serif);
        font-size: 13pt;
        margin: 1.1em 0 0.4em;
        color: var(--color-ink);
        font-weight: 500;
      }
      .ebau-apendix__section :global(h3) {
        font-family: var(--font-serif);
        font-size: 11pt;
        margin: 0.9em 0 0.3em;
        color: var(--color-ink);
        font-weight: 500;
      }
      .ebau-apendix__section :global(p) {
        font-size: 10pt;
        line-height: 1.5;
        margin: 0 0 0.5em;
      }
      .ebau-apendix__section :global(table) { font-size: 9pt; }
      .ebau-apendix__section :global(blockquote) {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 11pt;
        color: var(--book-accent-deep);
        border-left: 3px solid var(--book-accent);
        padding: 0.6em 1em;
        margin: 1em 0;
        background: var(--color-bg-cream);
      }
      /* Formula blocks (rendered as <pre><code>) inside the EBAU appendix:
         override the global pre styling so formulas read as ACCENT-colored
         lines, not as ink-black code chunks. */
      .ebau-apendix__section :global(pre) {
        font-family: var(--font-mono);
        background: var(--color-bg-cream);
        border-left: 3px solid var(--book-accent);
        color: var(--book-accent-deep) !important;
        padding: 0.7rem 1rem;
        border-radius: 4px;
        font-size: 10pt;
        margin: 0.7em 0;
        white-space: pre-wrap;
        font-weight: 500;
      }
      .ebau-apendix__section :global(pre code) {
        color: inherit !important;
        background: transparent !important;
        font-weight: inherit;
        padding: 0;
      }
      .ebau-apendix__section :global(code) {
        color: var(--book-accent-deep);
        background: var(--color-bg-cream);
      }
    </style>
  </head>
  <style is:inline set:html={`.book-title-string { string-set: book-title "${a.shortLabel} · ${a.title}"; } body { --book-accent: ${accent.base}; --book-accent-deep: ${accent.deep}; --book-accent-soft: ${accent.soft}; }`}></style>
  <body class="book-title-string">

    {/* ------------------------------------------------------------ COVER */}
    <section class="cover">
      <header class="cover__top">
        <span>profedeeconomia.es</span>
        <span class="mark"></span>
      </header>
      <div class="cover__center">
        <span class="cover__num">{a.num}</span>
        <div class="cover__rule"></div>
        <div class="cover__kicker">{a.shortLabel} · {a.level}</div>
        <h1 class="cover__title">
          {a.title}
        </h1>
        <p class="cover__lede">{a.tagline}</p>
        <p class="cover__inside">
          <strong>{totalUnits} {copy.unidades}</strong> · {copy.curriculo} · {a.marcoNormativo}
        </p>
      </div>
      <footer class="cover__bottom">
        <div class="stack">
          <span class="muted">{copy.editorial}</span>
          <strong>profedeeconomia.es</strong>
        </div>
        <div class="stack">
          <span class="muted">{copy.edicion}</span>
          <strong>{copy.edicionVal}</strong>
        </div>
        <div class="stack">
          <span class="muted">{copy.generado}</span>
          <strong>{today}</strong>
        </div>
      </footer>
    </section>

    {/* ------------------------------------------------------------ CREDITS */}
    <section class="credits">
      <h2>{copy.sobreH}</h2>
      <p>
        {copy.sobreP1a}
        <strong>profedeeconomia.es</strong>{copy.sobreP1b} <em>Creative Commons BY-NC-SA</em>{copy.sobreP1c}
      </p>
      <p>
        {copy.sobreP2a}
        <strong>{a.title}</strong> ({a.marcoNormativo}{copy.sobreP2b}
      </p>
      <p class="colophon-note">
        {copy.colofon}
        <a href="mailto:hola@profedeeconomia.es">hola@profedeeconomia.es</a>.
      </p>
    </section>

    {/* ------------------------------------------------------ RETO DEL CURSO INTRO */}
    {renderedReto.length > 0 && (
      <section class="reto-intro">
        {renderedReto.map(({ entry, Content }) => (
          <div class="reto-intro__page" data-orden={entry.data.orden}>
            <Content />
          </div>
        ))}
      </section>
    )}

    {/* ------------------------------------------------------------ TOC */}
    <section class="toc">
      <div class="toc__kicker">{copy.indice} · {totalUnits} {copy.unidades}</div>
      <h2>{copy.contenido}</h2>
      <ol class="toc__list">
        {rendered.map(({ unit }) => (
          <li class="toc__item">
            <span class="toc__num">{String(unit.data.unidad).padStart(2, '0')}</span>
            <div class="toc__title-block">
              <a class="toc__title" href={`#cap-${unit.data.unidad}`}>{unit.data.title}</a>
              {unit.data.lema && <span class="toc__lede">{unit.data.lema}</span>}
            </div>
            <a class="toc__page" href={`#cap-${unit.data.unidad}`} aria-label={copy.pagina}></a>
          </li>
        ))}
      </ol>
    </section>

    {/* ------------------------------------------------------------ CHAPTERS */}
    {rendered.map(({ unit, Content }) => (
      <section class="chapter" id={`cap-${unit.data.unidad}`}>
        <div class="chapter__opener">
          <div>
            <div class="chapter__kicker">
              {copy.unidad} {unit.data.unidad}
              {unit.data.bloque ? ` · ${unit.data.bloque}` : ''}
            </div>
            <div class="chapter__num">{String(unit.data.unidad).padStart(2, '0')}</div>
            <h2 class="chapter__title">{unit.data.title}</h2>
            {unit.data.lema && <p class="chapter__lede">{unit.data.lema}</p>}

            <dl class="chapter__meta">
              {unit.data.duracion && (
                <div>
                  <dt>{copy.duracion}</dt>
                  <dd>{unit.data.duracion}</dd>
                </div>
              )}
              {unit.data.conceptos_clave.length > 0 && (
                <div>
                  <dt>{copy.conceptos}</dt>
                  <dd>{unit.data.conceptos_clave.slice(0, 6).join(' · ')}</dd>
                </div>
              )}
              {unit.data.objetivos.length > 0 && (
                <div style="grid-column: 1 / -1;">
                  <dt>{copy.objetivos}</dt>
                  <dd>
                    <ul>
                      {unit.data.objetivos.map((o) => <li>· {o}</li>)}
                    </ul>
                  </dd>
                </div>
              )}
            </dl>
          </div>
        </div>

        <div class="chapter__content" data-unit-title={`${copy.unidad} ${unit.data.unidad} · ${unit.data.title}`}>
          <Content />
        </div>
      </section>
    ))}

    {/* ------------------------------------------------------------ APÈNDIX EBAU */}
    {renderedEbau.length > 0 && (
      <section class="ebau-apendix">
        <div class="ebau-apendix__cover">
          <span class="ebau-apendix__kicker">{copy.apendice}</span>
          <h2 class="ebau-apendix__title">{copy.guiaEbau}</h2>
          <p class="ebau-apendix__lede">{copy.guiaEbauLede}</p>
        </div>
        {renderedEbau.map(({ entry, Content }) => (
          <article class="ebau-apendix__section" data-orden={entry.data.orden}>
            <h2 class="ebau-apendix__section-title">{entry.data.title}</h2>
            <Content />
          </article>
        ))}
      </section>
    )}

    {/*
      paged.js polyfill — only loaded for in-browser preview. pagedjs-cli
      injects its own polyfill, and stacking both causes a runtime conflict
      ("ProgressEvent" thrown from the second initialization). To preview
      paginated layout in a regular browser, append ?preview=1 to the URL.
    */}
    <script is:inline>
      if (new URLSearchParams(location.search).has('preview')) {
        const s = document.createElement('script');
        s.src = 'https://unpkg.com/pagedjs/dist/paged.polyfill.js';
        document.body.appendChild(s);
      }
    </script>
  </body>
</html>
