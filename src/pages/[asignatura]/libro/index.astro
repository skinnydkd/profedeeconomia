---
import BaseLayout from '@layouts/BaseLayout.astro';
import { ASIGNATURA_SLUGS, ASIGNATURAS } from '@/lib/asignaturas';
import { breadcrumbLd, itemListLd } from '@/lib/seo';
import { getCollection } from 'astro:content';
import { getLocale } from '@/i18n/locale';
import { pickLocalizedEntry } from '@/i18n/content-locale';
import { localizeAsignatura } from '@/i18n/asignaturas-ca';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  return ASIGNATURA_SLUGS.filter((slug) => ASIGNATURAS[slug].estado === 'publicado').map((slug) => ({
    params: { asignatura: slug },
    props: { asignatura: ASIGNATURAS[slug] },
  }));
}) satisfies GetStaticPaths;

const locale = getLocale(Astro.currentLocale);
const a = localizeAsignatura(Astro.props.asignatura, locale);

const allUnits = await getCollection('libro');
const caById = new Map(
  allUnits
    .filter((u) => u.data.estado === 'publicado' && u.data.lang === 'ca')
    .map((u) => [u.id, u]),
);
const units = allUnits
  .filter((u) => u.data.asignatura === a.slug && u.data.estado === 'publicado' && u.data.lang === 'es')
  .sort((x, y) => x.data.unidad - y.data.unidad)
  .map((u) => pickLocalizedEntry(u, caById, locale));

const copy = {
  es: {
    inicio: 'Inicio', libro: 'Libro',
    kicker: `${a.shortLabel} · Libro`,
    descripcion: `Las unidades del libro de ${a.title}.`,
    vacio: 'Las unidades publicadas aparecerán aquí a medida que se vayan completando.',
    unidad: (n: number) => `${n} ${n === 1 ? 'unidad publicada' : 'unidades publicadas'}.`,
    descargar: 'Descargar libro completo',
    descargarSub: (n: number) => `PDF · ${n} unidades · todas las páginas`,
    previsualizar: 'Previsualizar versión impresa en navegador',
    indice: `Libro ${a.shortLabel} — Índice de unidades`,
    unidadLd: (n: number, t: string) => `Unidad ${n}. ${t}`,
  },
  ca: {
    inicio: 'Inici', libro: 'Llibre',
    kicker: `${a.shortLabel} · Llibre`,
    descripcion: `Les unitats del llibre de ${a.title}.`,
    vacio: 'Les unitats publicades apareixeran ací a mesura que es completen.',
    unidad: (n: number) => `${n} ${n === 1 ? 'unitat publicada' : 'unitats publicades'}.`,
    descargar: 'Descarregar llibre complet',
    descargarSub: (n: number) => `PDF · ${n} unitats · totes les pàgines`,
    previsualizar: 'Previsualitzar versió impresa al navegador',
    indice: `Llibre ${a.shortLabel} — Índex d'unitats`,
    unidadLd: (n: number, t: string) => `Unitat ${n}. ${t}`,
  },
}[locale];

// The PDF is published to /downloads/<slug>-libro.pdf when the
// `npm run build:pdf` step has been run. We always render the CTA;
// if the file is not yet committed it will 404, which is acceptable
// during early publishing.
const pdfHref = `/downloads/${a.slug}-libro${locale === 'ca' ? '.ca' : ''}.pdf`;

const idToSlug = (id: string) => id.split('/').pop()?.replace(/\.mdx?$/, '').replace(/\.ca$/, '') ?? id;
const unitPath = (id: string) => `/${a.slug}/libro/${idToSlug(id)}/`;

const jsonLd = [
  breadcrumbLd([
    { name: copy.inicio, path: '/' },
    { name: a.shortLabel, path: `/${a.slug}/` },
    { name: copy.libro, path: `/${a.slug}/libro/` },
  ], locale),
  ...(units.length > 0
    ? [
        itemListLd({
          name: copy.indice,
          locale,
          items: units.map((u) => ({
            name: copy.unidadLd(u.data.unidad, u.data.title),
            path: unitPath(u.id),
          })),
        }),
      ]
    : []),
];
---

<BaseLayout
  title={`${copy.libro} — ${a.shortLabel}`}
  description={copy.descripcion}
  jsonLd={jsonLd}
  contentLang={locale}
>
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">{copy.inicio}</a> <span class="sep">›</span>
      <a href={`/${a.slug}/`}>{a.shortLabel}</a> <span class="sep">›</span>
      <span>{copy.libro}</span>
    </nav>
  </div>

  <section class="hero">
    <div class="container">
      <span class="kicker kicker--sentence">{copy.kicker}</span>
      <h1>{a.title}</h1>
      <p class="subtitle">
        {units.length === 0 ? copy.vacio : copy.unidad(units.length)}
      </p>

      {units.length > 0 && (
        <div class="downloads">
          <a class="download-cta" href={pdfHref} download>
            <span class="download-cta__icon" aria-hidden="true">↓</span>
            <span class="download-cta__text">
              <strong>{copy.descargar}</strong>
              <span class="muted">{copy.descargarSub(units.length)}</span>
            </span>
          </a>
          <a class="download-secondary" href={`/${a.slug}/libro/imprimir/?preview=1`} target="_blank" rel="noopener">
            {copy.previsualizar}
          </a>
        </div>
      )}
    </div>
  </section>

  {units.length > 0 && (
    <section class="units">
      <div class="container">
        <ol class="unit-list">
          {units.map((u) => (
            <li>
              <span class="num">{String(u.data.unidad).padStart(2, '0')}</span>
              <a class="title" href={unitPath(u.id)}>
                {u.data.title}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4vw, 3rem);
  }
  .breadcrumb { font-size: 0.92rem; color: var(--color-ink-mute); margin: 2rem 0; }
  .breadcrumb a { color: var(--color-ink-mute); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-terra); }
  .breadcrumb .sep { margin: 0 0.5em; color: var(--color-mustard); }

  .hero { padding: 1rem 0 clamp(2rem, 5vw, 4rem); }
  h1 { margin: 1rem 0 0.6rem; }
  .subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.3rem;
    color: var(--color-ink-soft);
    max-width: 55ch;
    line-height: 1.5;
    font-variation-settings: "SOFT" 80;
  }

  .units { padding-bottom: clamp(3rem, 7vw, 6rem); }
  .unit-list { margin: 0; padding: 0; list-style: none; }
  .unit-list li {
    display: flex;
    gap: 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px dashed var(--color-line);
    align-items: baseline;
  }
  .unit-list .num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.3rem;
    color: var(--color-mustard-deep);
    min-width: 2.5rem;
    font-variation-settings: "SOFT" 100, "WONK" 1;
  }
  .unit-list a.title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    color: var(--color-ink);
    text-decoration: none;
  }
  .unit-list a.title:hover { color: var(--color-terra); }

  .downloads {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem;
  }
  .download-cta {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.4rem 0.9rem 1.1rem;
    background: var(--color-terra);
    color: #fff;
    text-decoration: none;
    border-radius: 6px;
    transition: background .2s var(--ease-soft), transform .2s var(--ease-soft);
  }
  .download-cta:hover {
    background: var(--color-terra-deep);
    transform: translateY(-1px);
  }
  .download-cta__icon {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.7rem;
    line-height: 1;
    color: var(--color-mustard-soft);
    font-variation-settings: "SOFT" 100, "WONK" 1;
  }
  .download-cta__text { display: flex; flex-direction: column; gap: 0.15rem; }
  .download-cta__text strong {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
  }
  .download-cta__text .muted {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    opacity: 0.75;
    letter-spacing: 0.04em;
  }
  .download-secondary {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    color: var(--color-ink-soft);
    text-decoration: none;
    border-bottom: 1px dashed var(--color-line);
    padding-bottom: 1px;
    font-variation-settings: "SOFT" 80;
  }
  .download-secondary:hover { color: var(--color-terra); border-bottom-color: var(--color-terra); }
</style>
