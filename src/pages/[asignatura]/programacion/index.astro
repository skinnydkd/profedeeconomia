---
/**
 * Programación didáctica de referencia de una asignatura.
 * Una sola entrada por asignatura (colección `programacion`): incluye un
 * resumen "de referencia" arriba y el desarrollo normativo completo debajo,
 * todo desde la misma fuente para que ambas vistas sean coherentes.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { ASIGNATURAS } from '@/lib/asignaturas';
import { breadcrumbLd } from '@/lib/seo';
import { getCollection, render } from 'astro:content';
import { getLocale } from '@/i18n/locale';
import { pickLocalizedEntry } from '@/i18n/content-locale';
import { localizeAsignatura } from '@/i18n/asignaturas-ca';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const all = await getCollection('programacion');
  return all
    .filter((p) => p.data.estado === 'publicado' && p.data.lang === 'es')
    .map((p) => ({
      params: { asignatura: p.data.asignatura },
      props: { prog: p },
    }));
}) satisfies GetStaticPaths;

const locale = getLocale(Astro.currentLocale);
const progEs = Astro.props.prog;
const a = localizeAsignatura(ASIGNATURAS[progEs.data.asignatura], locale);
const caById = new Map(
  (await getCollection('programacion'))
    .filter((p) => p.data.estado === 'publicado' && p.data.lang === 'ca')
    .map((p) => [p.id, p]),
);
const prog = pickLocalizedEntry(progEs, caById, locale);
const { Content } = await render(prog);
const pdfHref = `/downloads/${a.slug}-programacion${locale === 'ca' ? '.ca' : ''}.pdf`;

const copy = {
  es: {
    inicio: 'Inicio', programacion: 'Programación', titulo: 'Programación didáctica de referencia',
    descargar: 'Descargar programación en PDF', descargarSub: 'Documento completo · listo para adaptar a tu centro',
    previsualizar: 'Previsualizar versión impresa',
    adapt: (m: string) => `Documento de referencia basado en el currículo estatal (${m}). Cada comunidad autónoma fija su concreción: adáptalo a la de tu centro antes de presentarlo.`,
    metaTitle: 'Programación didáctica',
  },
  ca: {
    inicio: 'Inici', programacion: 'Programació', titulo: 'Programació didàctica de referència',
    descargar: 'Descarregar programació en PDF', descargarSub: 'Document complet · a punt per a adaptar al teu centre',
    previsualizar: 'Previsualitzar versió impresa',
    adapt: (m: string) => `Document de referència basat en el currículum estatal (${m}). Cada comunitat autònoma fixa la seua concreció: adapta'l a la del teu centre abans de presentar-lo.`,
    metaTitle: 'Programació didàctica',
  },
}[locale];

const breadcrumb = breadcrumbLd([
  { name: copy.inicio, path: '/' },
  { name: a.shortLabel, path: `/${a.slug}/` },
  { name: copy.programacion, path: `/${a.slug}/programacion/` },
]);
---

<BaseLayout title={`${copy.metaTitle} — ${a.shortLabel}`} description={prog.data.descripcion} jsonLd={breadcrumb} contentLang={locale}>
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">{copy.inicio}</a> <span class="sep">›</span>
      <a href={`/${a.slug}/`}>{a.shortLabel}</a> <span class="sep">›</span>
      <span>{copy.programacion}</span>
    </nav>
  </div>

  <section class="hero">
    <div class="container">
      <span class="kicker kicker--sentence">{a.shortLabel} · {a.level}</span>
      <h1>{copy.titulo}</h1>
      <p class="lede">{prog.data.descripcion}</p>
      <div class="downloads">
        <a class="download-cta" href={pdfHref} download>
          <span class="download-cta__icon" aria-hidden="true">↓</span>
          <span class="download-cta__text">
            <strong>{copy.descargar}</strong>
            <span class="muted">{copy.descargarSub}</span>
          </span>
        </a>
        <a class="download-secondary" href={`/${a.slug}/programacion/imprimir/?preview=1`} target="_blank" rel="noopener">
          {copy.previsualizar}
        </a>
      </div>
      <p class="adapt-note">
        {copy.adapt(a.marcoNormativo)}
      </p>
    </div>
  </section>

  <section class="body">
    <div class="container container--narrow">
      <article class="prose">
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .container { max-width: 1240px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem); }
  .container--narrow { max-width: 820px; }

  .breadcrumb { font-size: 0.92rem; color: var(--color-ink-mute); margin: 2rem 0; }
  .breadcrumb a { color: var(--color-ink-mute); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-terra); }
  .breadcrumb .sep { margin: 0 0.5em; color: var(--color-mustard); }

  .hero { padding: 1rem 0 clamp(1.5rem, 4vw, 3rem); }
  h1 { max-width: 22ch; margin: 1rem 0 0.6rem; }
  .lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.35rem;
    color: var(--color-ink-soft);
    max-width: 52ch;
    margin: 1rem 0 1.5rem;
    line-height: 1.5;
    font-variation-settings: "SOFT" 80;
  }

  .downloads { display: flex; flex-wrap: wrap; align-items: center; gap: 1.2rem; }
  .download-cta {
    display: inline-flex; align-items: center; gap: 1rem;
    padding: 0.9rem 1.4rem 0.9rem 1.1rem;
    background: var(--color-terra); color: #fff; text-decoration: none;
    border-radius: 6px; transition: background .2s var(--ease-soft), transform .2s var(--ease-soft);
  }
  .download-cta:hover { background: var(--color-terra-deep); transform: translateY(-1px); }
  .download-cta__icon {
    font-family: var(--font-serif); font-style: italic; font-size: 1.7rem; line-height: 1;
    color: var(--color-mustard-soft); font-variation-settings: "SOFT" 100, "WONK" 1;
  }
  .download-cta__text { display: flex; flex-direction: column; gap: 0.15rem; }
  .download-cta__text strong { font-family: var(--font-sans); font-size: 0.95rem; font-weight: 600; }
  .download-cta__text .muted { font-family: var(--font-sans); font-size: 0.78rem; opacity: 0.75; letter-spacing: 0.04em; }
  .download-secondary {
    font-family: var(--font-serif); font-style: italic; font-size: 1rem;
    color: var(--color-ink-soft); text-decoration: none;
    border-bottom: 1px dashed var(--color-line); padding-bottom: 1px;
    font-variation-settings: "SOFT" 80;
  }
  .download-secondary:hover { color: var(--color-terra); border-bottom-color: var(--color-terra); }

  .adapt-note {
    margin: 1.6rem 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    color: var(--color-ink-soft);
    background: var(--color-mustard-soft);
    border-radius: 4px;
    padding: 0.9rem 1.2rem;
    max-width: 60ch;
  }

  .body { padding: clamp(1.5rem, 4vw, 3rem) 0 clamp(3rem, 7vw, 6rem); }
  .prose { font-size: 1.05rem; line-height: 1.7; color: var(--color-ink); }
  .prose :global(h2) {
    font-family: var(--font-serif); font-size: 1.6rem; margin: 2.2em 0 0.7em;
    position: relative; padding-top: 1em; font-weight: 500;
  }
  .prose :global(h3) { font-family: var(--font-serif); font-size: 1.25rem; margin: 1.6em 0 0.5em; font-weight: 500; }
  .prose :global(p) { margin: 0 0 1em; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.4rem; margin: 0 0 1em; }
  .prose :global(li) { margin-bottom: 0.4em; }
  .prose :global(ul li::marker) { color: var(--color-mustard); }
  .prose :global(strong) { color: var(--color-ink); }
  .prose :global(table) {
    width: 100%; border-collapse: separate; border-spacing: 0;
    margin: 1.4em 0; font-size: 0.92rem;
  }
  .prose :global(th), .prose :global(td) {
    text-align: left; padding: 0.55em 0.75em;
    border-bottom: 1px solid var(--color-line-soft); vertical-align: top;
  }
  .prose :global(th) {
    font-family: var(--font-sans); font-size: 0.78rem; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--color-terra-deep); background: var(--color-terra-soft); font-weight: 700;
  }
  .prose :global(blockquote) {
    margin: 1.4em 0; padding: 0.8em 1.2em;
    border-left: 3px solid var(--color-mustard); background: var(--color-bg-cream);
    font-style: italic; color: var(--color-ink-soft); border-radius: 0 4px 4px 0;
  }
</style>
