---
/**
 * Portada del cuaderno de proyecto de una asignatura (de momento GPE).
 * Muestra el recorrido de fases como tarjetas + las descargas (cuaderno
 * alumno/profesor para rellenar y guía completa del profe).
 */
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '@layouts/BaseLayout.astro';
import { ASIGNATURAS, type AsignaturaSlug } from '@/lib/asignaturas';
import { breadcrumbLd } from '@/lib/seo';
import { getCollection } from 'astro:content';
import { getLocale } from '@/i18n/locale';
import { pickLocalizedEntry } from '@/i18n/content-locale';
import { localizeAsignatura } from '@/i18n/asignaturas-ca';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const all = await getCollection('proyecto');
  const bySlug = new Map<AsignaturaSlug, typeof all>();
  for (const e of all) {
    if (e.data.estado !== 'publicado' || e.data.lang !== 'es') continue;
    const arr = bySlug.get(e.data.asignatura) ?? [];
    arr.push(e);
    bySlug.set(e.data.asignatura, arr);
  }
  return [...bySlug.entries()].map(([slug, secciones]) => {
    secciones.sort((a, b) => a.data.orden - b.data.orden);
    return { params: { asignatura: slug }, props: { secciones, asignatura: ASIGNATURAS[slug] } };
  });
}) satisfies GetStaticPaths;

const locale = getLocale(Astro.currentLocale);
const a = localizeAsignatura(Astro.props.asignatura, locale);
const caById = new Map(
  (await getCollection('proyecto'))
    .filter((e) => e.data.estado === 'publicado' && e.data.lang === 'ca')
    .map((e) => [e.id, e]),
);
const secciones = Astro.props.secciones.map((s) => pickLocalizedEntry(s, caById, locale));

const copy = {
  es: {
    inicio: 'Inicio', cuaderno: 'Cuaderno de proyecto', fase: 'Fase',
    descripcion: `Cuaderno de proyecto de ${a.title}: guía paso a paso, por fases, para que el alumnado desarrolle su propia iniciativa emprendedora.`,
    lede: 'Una guía paso a paso, fase a fase, para que vuestro alumnado convierta un reto de su entorno en un proyecto emprendedor: equipo, oportunidad, modelo de negocio, viabilidad y puesta en marcha.',
    downloadsLead: ['Descargad el ', 'cuaderno del equipo', ' y rellenadlo fase a fase, con sus plantillas visuales.'],
    alumno: 'Cuaderno del alumno (para rellenar)', alumnoSub: 'Una hoja por fase con plantilla visual en blanco',
    profesor: 'Cuaderno del profesor (con orientación)', profesorSub: 'El mismo, con orientación docente por fase',
    guia: 'Guía completa del proyecto en PDF',
    adapt: 'Cuaderno pensado para trabajar el proyecto a lo largo del curso. Adáptalo a la duración, el agrupamiento y el contexto de tu centro.',
    relatedPre: 'Este es el recorrido anclado al temario de ', relatedPost: '. Si buscas la versión transversal y modular —de un sprint a un curso entero, para cualquier asignatura y nivel—, es el mismo viaje en ', relatedLink: '«De cero a empresa»',
  },
  ca: {
    inicio: 'Inici', cuaderno: 'Quadern de projecte', fase: 'Fase',
    descripcion: `Quadern de projecte de ${a.title}: guia pas a pas, per fases, perquè l'alumnat desenvolupe la seua pròpia iniciativa emprenedora.`,
    lede: "Una guia pas a pas, fase a fase, perquè el vostre alumnat convertisca un repte del seu entorn en un projecte emprenedor: equip, oportunitat, model de negoci, viabilitat i posada en marxa.",
    downloadsLead: ['Descarregueu el ', "quadern de l'equip", ' i ompliu-lo fase a fase, amb les seues plantilles visuals.'],
    alumno: "Quadern de l'alumne (per a omplir)", alumnoSub: 'Un full per fase amb plantilla visual en blanc',
    profesor: 'Quadern del professor (amb orientació)', profesorSub: 'El mateix, amb orientació docent per fase',
    guia: 'Guia completa del projecte en PDF',
    adapt: "Quadern pensat per a treballar el projecte al llarg del curs. Adapta'l a la durada, l'agrupament i el context del teu centre.",
    relatedPre: 'Este és el recorregut ancorat al temari de ', relatedPost: '. Si busques la versió transversal i modular —d\'un sprint a un curs sencer, per a qualsevol assignatura i nivell—, és el mateix viatge en ', relatedLink: '«De zero a empresa»',
  },
}[locale];
// The project cuaderno uses a `proyecto-` prefix so it never collides with the
// activity workbook (<slug>-cuaderno[-alumno].pdf). Only render the download
// CTAs for subjects that actually have the generated files (currently GPE).
const has = (file: string) => existsSync(resolve('public/downloads', file));
const caSuffix = locale === 'ca' ? '.ca' : '';
const guiaFile = `${a.slug}-proyecto${caSuffix}.pdf`;
const alumnoFile = `${a.slug}-proyecto-cuaderno-alumno${caSuffix}.pdf`;
const profesorFile = `${a.slug}-proyecto-cuaderno-profesor${caSuffix}.pdf`;
const guiaHref = `/downloads/${guiaFile}`;
const alumnoHref = `/downloads/${alumnoFile}`;
const profesorHref = `/downloads/${profesorFile}`;
const hasCuaderno = has(alumnoFile) && has(profesorFile);
const hasGuia = has(guiaFile);
const faseHref = (orden: number) => `/${a.slug}/proyecto/${String(orden).padStart(2, '0')}`;

const breadcrumb = breadcrumbLd([
  { name: copy.inicio, path: '/' },
  { name: a.shortLabel, path: `/${a.slug}/` },
  { name: copy.cuaderno, path: `/${a.slug}/proyecto/` },
]);
---

<BaseLayout
  title={`${copy.cuaderno} — ${a.shortLabel}`}
  description={copy.descripcion}
  jsonLd={breadcrumb}
  contentLang={locale}
>
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">{copy.inicio}</a> <span class="sep">›</span>
      <a href={`/${a.slug}/`}>{a.shortLabel}</a> <span class="sep">›</span>
      <span>{copy.cuaderno}</span>
    </nav>
  </div>

  <section class="hero" style={`--accent: var(--color-${a.color}); --accent-soft: var(--color-${a.color}-soft);`}>
    <div class="container">
      <h1>{copy.cuaderno}</h1>
      <p class="lede">{copy.lede}</p>

      {hasCuaderno && (
        <>
          <p class="downloads-lead">{copy.downloadsLead[0]}<strong>{copy.downloadsLead[1]}</strong>{copy.downloadsLead[2]}</p>
          <div class="downloads">
            <a class="download-cta" href={alumnoHref} download>
              <span class="download-cta__icon" aria-hidden="true">↓</span>
              <span class="download-cta__text">
                <strong>{copy.alumno}</strong>
                <span class="muted">{copy.alumnoSub}</span>
              </span>
            </a>
            <a class="download-cta" href={profesorHref} download>
              <span class="download-cta__icon" aria-hidden="true">↓</span>
              <span class="download-cta__text">
                <strong>{copy.profesor}</strong>
                <span class="muted">{copy.profesorSub}</span>
              </span>
            </a>
            {hasGuia && <a class="download-secondary" href={guiaHref} download>{copy.guia}</a>}
          </div>
        </>
      )}

      <p class="adapt-note">
        {copy.adapt}
      </p>
      <p class="related-note">
        {copy.relatedPre}<strong>{a.shortLabel}</strong>{copy.relatedPost}<a href="/emprendimiento/proyecto/">{copy.relatedLink}</a>.
      </p>
    </div>
  </section>

  <section class="fases" style={`--accent: var(--color-${a.color}); --accent-soft: var(--color-${a.color}-soft);`}>
    <div class="container">
      <ol class="fase-grid">
        {secciones.map((s) => (
          <li>
            <a class="fase-card" href={faseHref(s.data.orden)}>
              <span class="fase-card__num">{String(s.data.orden).padStart(2, '0')}</span>
              <span class="fase-card__label">{s.data.fase ?? `${copy.fase} ${s.data.orden}`}</span>
              <span class="fase-card__title">{s.data.title}</span>
              {s.data.entregable && <span class="fase-card__entregable">{s.data.entregable}</span>}
              <span class="fase-card__go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .container { max-width: 1240px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem); }
  .breadcrumb { font-size: 0.92rem; color: var(--color-ink-mute); margin: 2rem 0; }
  .breadcrumb a { color: var(--color-ink-mute); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-gpe); }
  .breadcrumb .sep { margin: 0 0.5em; color: var(--color-mustard); }
  .hero { padding: 1rem 0 clamp(1.5rem, 4vw, 3rem); }
  .kicker { font-family: var(--font-sans); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.04em; text-transform: none; color: var(--accent); }
  h1 { max-width: 22ch; margin: 1rem 0 0.6rem; }
  .lede { font-family: var(--font-serif); font-style: italic; font-size: 1.35rem; color: var(--color-ink-soft); max-width: 52ch; margin: 1rem 0 1.5rem; line-height: 1.5; font-variation-settings: "SOFT" 80; }
  .downloads-lead { font-size: 1rem; color: var(--color-ink-soft); margin: 0 0 1rem; }
  .downloads { display: flex; flex-wrap: wrap; align-items: center; gap: 1.2rem; }
  .download-cta { display: inline-flex; align-items: center; gap: 1rem; padding: 0.9rem 1.4rem 0.9rem 1.1rem; background: var(--accent); color: #fff; text-decoration: none; border-radius: 6px; transition: filter .2s var(--ease-soft), transform .2s var(--ease-soft); }
  .download-cta:hover { filter: brightness(0.92); transform: translateY(-1px); }
  .download-cta__icon { font-family: var(--font-serif); font-style: italic; font-size: 1.7rem; line-height: 1; color: var(--color-mustard-soft); font-variation-settings: "SOFT" 100, "WONK" 1; }
  .download-cta__text { display: flex; flex-direction: column; gap: 0.15rem; }
  .download-cta__text strong { font-family: var(--font-sans); font-size: 0.95rem; font-weight: 600; }
  .download-cta__text .muted { font-family: var(--font-sans); font-size: 0.78rem; opacity: 0.8; letter-spacing: 0.04em; }
  .download-secondary { font-family: var(--font-serif); font-style: italic; font-size: 1rem; color: var(--color-ink-soft); text-decoration: none; border-bottom: 1px dashed var(--color-line); padding-bottom: 1px; font-variation-settings: "SOFT" 80; }
  .download-secondary:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .adapt-note { margin: 1.6rem 0 0; font-family: var(--font-serif); font-style: italic; font-size: 1rem; color: var(--color-ink-soft); background: var(--accent-soft); border-radius: 4px; padding: 0.9rem 1.2rem; max-width: 60ch; }
  .related-note { margin: 1rem 0 0; font-size: 0.98rem; color: var(--color-ink-soft); line-height: 1.6; max-width: 60ch; }
  .related-note a { color: var(--accent); text-decoration: none; border-bottom: 1px solid var(--accent-soft); }
  .related-note a:hover { border-bottom-color: var(--accent); }
  .fases { padding: clamp(1.5rem, 4vw, 3rem) 0 clamp(3rem, 7vw, 6rem); }
  .fase-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: 1.2rem; }
  .fase-card { position: relative; display: flex; flex-direction: column; gap: 0.35rem; height: 100%; padding: 1.4rem 1.5rem; background: var(--color-paper); border: 1px solid var(--color-line); border-top: 3px solid var(--accent); border-radius: 8px; text-decoration: none; color: inherit; transition: transform .2s var(--ease-soft), box-shadow .2s var(--ease-soft); }
  .fase-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(42, 31, 24, 0.08); }
  .fase-card__num { font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent); font-weight: 500; }
  .fase-card__label { font-family: var(--font-sans); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-ink-mute); font-weight: 600; }
  .fase-card__title { font-family: var(--font-serif); font-size: 1.2rem; line-height: 1.2; color: var(--color-ink); margin-top: 0.1rem; }
  .fase-card__entregable { font-size: 0.9rem; color: var(--color-ink-soft); line-height: 1.45; margin-top: 0.2rem; }
  .fase-card__go { margin-top: auto; padding-top: 0.6rem; color: var(--accent); font-size: 1.1rem; }
</style>
