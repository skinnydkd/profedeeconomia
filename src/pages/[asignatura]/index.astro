---
import BaseLayout from '@layouts/BaseLayout.astro';
import { ASIGNATURA_SLUGS, ASIGNATURAS, leyCurricular } from '@/lib/asignaturas';
import { cursoLabel } from '@/i18n/ui';
import { breadcrumbLd, courseLd, faqLd } from '@/lib/seo';
import { subjectFaqs } from '@/lib/faq';
import FaqHub from '@components/FaqHub.astro';
import { getMaterialPorUnidad } from '@/lib/material-unidad-sources';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { getLocale } from '@/i18n/locale';
import { localizeAsignatura } from '@/i18n/asignaturas-ca';
import { pickLocalizedEntry } from '@/i18n/content-locale';
import Breadcrumb from '@components/Breadcrumb.astro';
import AsignaturaCaratula from '@components/asignaturas/AsignaturaCaratula.astro';
import { getSituaciones } from '@/lib/situaciones-sources';
import { situacionSlug } from '@/lib/situaciones';

export const getStaticPaths = (() => {
  return ASIGNATURA_SLUGS.map((slug) => ({
    params: { asignatura: slug },
    props: { asignatura: ASIGNATURAS[slug] },
  }));
}) satisfies GetStaticPaths;

const locale = getLocale(Astro.currentLocale);
const { asignatura: asignaturaEs } = Astro.props;
const a = localizeAsignatura(asignaturaEs, locale);
// Which course the subject belongs to, under the title: the hero never said it
// (only the breadcrumb acronym did). Optional subjects already name their two
// courses in the course label, so their «Optativa» modality would repeat it.
const cursoLinea = [
  cursoLabel(a.curso, locale),
  a.curso !== 'bach' ? a.modalidad : undefined,
].filter(Boolean);
const isPublicado = a.estado === 'publicado';

// Show the EBAU card only for subjects that have published EBAU content.
const ebauAll = await getCollection('ebau');
const hasEbau = ebauAll.some((e) => e.data.asignatura === a.slug && e.data.estado === 'publicado');

// Show the project-workbook card only for subjects that have published content.
const proyectoAll = await getCollection('proyecto');
const hasProyecto = proyectoAll.some((e) => e.data.asignatura === a.slug && e.data.estado === 'publicado');

// Show the refuerzo/ampliación card only for subjects that have published content.
const refuerzoAll = await getCollection('refuerzo');
const hasRefuerzo = refuerzoAll.some((e) => e.data.asignatura === a.slug && e.data.estado === 'publicado');

// Show the evaluación competencial card only for subjects that have published content.
const evaluacionAll = await getCollection('evaluacion');
const hasEvaluacion = evaluacionAll.some((e) => e.data.asignatura === a.slug && e.data.estado === 'publicado');

const testsAll = await getCollection('tests');
const hasTests = testsAll.some((t) => t.data.asignatura === a.slug && t.data.estado === 'publicado');
const recursosAll = await getCollection('recursos');
const hasRecursos = recursosAll.some((rec) => rec.data.asignatura === a.slug && rec.data.estado === 'publicado');
const retosAll = await getCollection('retos');
const hasRetos = retosAll.some((r) => r.data.asignatura === a.slug && r.data.estado === 'publicado');
// Like the cards above: a subject with no published activities (CJD) linked to
// an empty «se publicarán próximamente» page.
const actividadesAll = await getCollection('actividades');
const hasActividades = actividadesAll.some((x) => x.data.asignatura === a.slug && x.data.estado === 'publicado');

// Every user-facing string on this hub, keyed by section slug / group id so the
// structure below stays language-agnostic.
const copy = {
  es: {
    bcInicio: 'Inicio',
    metaDesc: (titulo: string, nivel: string, ley: string, marco: string) =>
      `Material gratuito para impartir ${titulo} en ${nivel}: libro en PDF, diapositivas, actividades, tests y recursos. Currículo estatal ${ley}: ${marco}.`,
    curriculumNote: (titulo: string, ley: string, marco: string) =>
      `Este libro se basa en el currículo básico estatal ${ley} para ${titulo}, según ${marco}. Cada comunidad autónoma establece concreciones específicas: conviene consultar la de tu comunidad para ajustar la programación a tu centro.`,
    curriculumPendiente: (marco: string) =>
      `El material se preparará según ${marco}. Si quieres estar al tanto de cuándo se publica, sigue`,
    pdfCta: 'Descargar el libro en PDF',
    pdfSub: (n: number) => `Gratis · ${n} unidades`,
    proximamente: 'Próximamente',
    enPreparacion:
      'Este material está en preparación. Cuando se publique tendrá la misma estructura que el resto: libro, diapositivas, actividades, tests y recursos.',
    sectionsH: 'Todo el material, un solo curso',
    hubIntro:
      'Cada asignatura reúne aquí todo su material con la misma estructura. Lo que cambia es el contenido, no el sitio donde encontrarlo.',
    olimpiadaTitle: 'Olimpiada de Economía',
    olimpiadaDesc:
      'Prepara la Olimpiada: la guía del examen, simulacros oficiales, fichas-resumen, banco de preguntas y taller de comentario de texto.',
    olimpiadaCta: 'Preparar la Olimpiada →',
    grupos: {
      material: { label: 'El material del curso', desc: 'Lo que llevas a clase: libro, diapositivas y actividades para imprimir.' },
      interactivo: { label: 'Práctica interactiva', desc: 'Para trabajar en pantalla: se autocorrige, se autoguarda y engancha al alumnado.' },
      profe: { label: 'Para el profesorado', desc: 'La planificación del curso, lista para adaptar a tu centro.' },
    },
    secciones: {
      'libro': { title: 'Libro', desc: 'Los capítulos del curso, listos para leer en pantalla o descargar como PDF.' },
      'diapositivas': { title: 'Diapositivas', desc: 'Las diapositivas de cada unidad, sacadas del libro. Para proyectar o descargar en PDF.' },
      'actividades': { title: 'Actividades', desc: 'Casos prácticos y ejercicios graduados por unidad, listos para imprimir.' },
      'refuerzo': { title: 'Refuerzo y ampliación', desc: 'Por evaluación: repaso esencial con ejercicios guiados (refuerzo) y retos de más nivel (ampliación).' },
      'proyecto': { title: 'Cuaderno de proyecto', desc: 'Guía paso a paso para que el alumnado desarrolle su propio proyecto emprendedor, fase a fase.' },
      'tests': { title: 'Tests', desc: 'Tests autocorregibles por unidad: respuesta inmediata, nota y repaso en el navegador.' },
      'recursos': { title: 'Simuladores', desc: 'Calculadoras y simuladores interactivos (punto muerto, VAN, equilibrio de mercado…) para experimentar con los modelos.' },
      'retos': { title: 'Retos competenciales', desc: 'Escenarios paso a paso centrados en una competencia específica; al final, tu nivel de logro.' },
      'actividades-dinamicas': { title: 'Árboles de decisión', desc: 'Casos con decisiones encadenadas: cada elección mueve unos indicadores y abre la siguiente.' },
      'ebau': { title: 'Preparación EBAU', desc: 'Estructura de la prueba, teoría esencial, problemas resueltos y simulacros con solucionario.' },
      'ebau/examenes': { title: 'Exámenes EBAU por comunidad', desc: 'Exámenes oficiales de años anteriores de las comunidades autónomas, con su resolución en PDF descargable.' },
      'evaluacion': { title: 'Evaluación competencial', desc: 'Competencias específicas con sus criterios de evaluación y una rúbrica de niveles de logro por competencia.' },
      'programacion': { title: 'Programación', desc: 'Programación didáctica de referencia: objetivos, temporalización y evaluación competencial, lista para adaptar.' },
    },
  },
  ca: {
    bcInicio: 'Inici',
    metaDesc: (titulo: string, nivel: string, ley: string, marco: string) =>
      `Material gratuït per a impartir ${titulo} en ${nivel}: llibre en PDF, diapositives, activitats, tests i recursos. Currículum estatal ${ley}: ${marco}.`,
    curriculumNote: (titulo: string, ley: string, marco: string) =>
      `Este llibre es basa en el currículum bàsic estatal ${ley} per a ${titulo}, segons ${marco}. Cada comunitat autònoma establix concrecions específiques: convé consultar la de la teua comunitat per a ajustar la programació al teu centre.`,
    curriculumPendiente: (marco: string) =>
      `El material es prepararà segons ${marco}. Si vols estar al corrent de quan es publica, seguix`,
    pdfCta: 'Descarregar el llibre en PDF',
    pdfSub: (n: number) => `Gratis · ${n} unitats`,
    proximamente: 'Pròximament',
    enPreparacion:
      'Este material està en preparació. Quan es publique tindrà la mateixa estructura que la resta: llibre, diapositives, activitats, tests i recursos.',
    sectionsH: 'Tot el material, un sol curs',
    hubIntro:
      "Cada assignatura reunix ací tot el seu material amb la mateixa estructura. El que canvia és el contingut, no el lloc on trobar-lo.",
    olimpiadaTitle: "Olimpíada d'Economia",
    olimpiadaDesc:
      "Prepara l'Olimpíada: la guia de l'examen, simulacres oficials, fitxes-resum, banc de preguntes i taller de comentari de text.",
    olimpiadaCta: "Preparar l'Olimpíada →",
    grupos: {
      material: { label: 'El material del curs', desc: 'El que portes a classe: llibre, diapositives i activitats per a imprimir.' },
      interactivo: { label: 'Pràctica interactiva', desc: "Per a treballar en pantalla: s'autocorregix, s'autoguarda i enganxa l'alumnat." },
      profe: { label: 'Per al professorat', desc: 'La planificació del curs, llesta per a adaptar al teu centre.' },
    },
    secciones: {
      'libro': { title: 'Llibre', desc: 'Els capítols del curs, llestos per a llegir en pantalla o descarregar com a PDF.' },
      'diapositivas': { title: 'Diapositives', desc: 'Les diapositives de cada unitat, tretes del llibre. Per a projectar o descarregar en PDF.' },
      'actividades': { title: 'Activitats', desc: 'Casos pràctics i exercicis graduats per unitat, llestos per a imprimir.' },
      'refuerzo': { title: 'Reforç i ampliació', desc: "Per avaluació: repàs essencial amb exercicis guiats (reforç) i reptes de més nivell (ampliació)." },
      'proyecto': { title: 'Quadern de projecte', desc: "Guia pas a pas perquè l'alumnat desenvolupe el seu propi projecte emprenedor, fase a fase." },
      'tests': { title: 'Tests', desc: 'Tests autocorregibles per unitat: resposta immediata, nota i repàs en el navegador.' },
      'recursos': { title: 'Simuladors', desc: 'Calculadores i simuladors interactius (punt mort, VAN, equilibri de mercat…) per a experimentar amb els models.' },
      'retos': { title: 'Reptes competencials', desc: "Escenaris pas a pas centrats en una competència específica; al final, el teu nivell d'assoliment." },
      'actividades-dinamicas': { title: 'Arbres de decisió', desc: 'Casos amb decisions encadenades: cada elecció mou uns indicadors i obri la següent.' },
      'ebau': { title: 'Preparació EBAU', desc: 'Estructura de la prova, teoria essencial, problemes resolts i simulacres amb solucionari.' },
      'ebau/examenes': { title: 'Exàmens EBAU per comunitat', desc: "Exàmens oficials d'anys anteriors de les comunitats autònomes, amb la seua resolució en PDF descarregable." },
      'evaluacion': { title: 'Avaluació competencial', desc: "Competències específiques amb els seus criteris d'avaluació i una rúbrica de nivells d'assoliment per competència." },
      'programacion': { title: 'Programació', desc: 'Programació didàctica de referència: objectius, temporalització i avaluació competencial, llesta per a adaptar.' },
    },
  },
}[locale];

// Sections grouped by nature: the course material (book + printable), the
// interactive practice, and what's for the teacher. Programación goes last.
const material = [
  'libro',
  'diapositivas',
  ...(hasActividades ? ['actividades'] : []),
  ...(hasRefuerzo ? ['refuerzo'] : []),
  ...(hasProyecto ? ['proyecto'] : []),
];
const interactivo = [
  ...(hasTests ? ['tests'] : []),
  ...(hasRecursos ? ['recursos'] : []),
  ...(hasRetos ? ['retos'] : []),
  'actividades-dinamicas',
  ...(hasEbau ? ['ebau', 'ebau/examenes'] : []),
];
const profe = [...(hasEvaluacion ? ['evaluacion'] : []), 'programacion'];
const grupos = [
  { ...copy.grupos.material, sections: material },
  { ...copy.grupos.interactivo, sections: interactivo },
  { ...copy.grupos.profe, sections: profe },
] as { label: string; desc: string; sections: (keyof typeof copy.secciones)[] }[];

// Unit by unit (VIS-NAV-05): a teacher prepares «unit 7» — chapter, slides,
// test, activities — and used to rebuild it by jumping across five indexes.
const situaciones = isPublicado ? await getSituaciones(a.slug, locale) : [];
const saCopy = {
  es: { titulo: 'Situaciones de aprendizaje', intro: 'El curso en el orden en que lo damos: cada situación con su reto, su producto final y todo el material.', todas: 'Ver todas las situaciones →' },
  ca: { titulo: "Situacions d'aprenentatge", intro: "El curs en l'ordre en què el donem: cada situació amb el seu repte, el seu producte final i tot el material.", todas: 'Veure totes les situacions →' },
}[locale];
const porUnidad = isPublicado ? await getMaterialPorUnidad(a.slug, locale) : [];
const uCopy = {
  es: {
    titulo: 'Unidad a unidad',
    intro: 'Todo el material de cada unidad en una línea: el capítulo del libro, sus diapositivas, su test y sus actividades.',
    diapositivas: 'Diapositivas', test: 'Test', reto: 'Reto',
    actividades: (n: number) => (n === 1 ? '1 actividad' : `${n} actividades`),
  },
  ca: {
    titulo: 'Unitat a unitat',
    intro: 'Tot el material de cada unitat en una línia: el capítol del llibre, les diapositives, el test i les activitats.',
    diapositivas: 'Diapositives', test: 'Test', reto: 'Repte',
    actividades: (n: number) => (n === 1 ? '1 activitat' : `${n} activitats`),
  },
}[locale];

const breadcrumb = breadcrumbLd([
  { name: copy.bcInicio, path: '/' },
  { name: a.shortLabel, path: `/${a.slug}/` },
], locale);

// Course JSON-LD (only for published subjects): `teaches` derived from the
// published book unit titles, aligned to the LOMLOE Real Decreto.
const libroAll = await getCollection('libro');
const libroCaById = new Map(
  libroAll.filter((u) => u.data.lang === 'ca' && u.data.estado === 'publicado').map((u) => [u.id, u]),
);
const unitTitles = libroAll
  .filter((u) => u.data.asignatura === a.slug && u.data.estado === 'publicado' && u.data.lang === 'es')
  .sort((x, y) => x.data.unidad - y.data.unidad)
  .map((u) => pickLocalizedEntry(u, libroCaById, locale).data.title);
// The FAQ is ES prose (visible block + FAQPage JSON-LD); it is built from the
// ES asignatura so its sentences don't end up half-translated. Content phase.
const faqs = subjectFaqs(a, locale);
// The hub, not /libro/, is what ranks for «… libro pdf gratis» (GSC Jul–Oct
// 2026: 27k impressions on /ipe2-fp/ vs 101 on /ipe2-fp/libro/), so the
// download has to be one click from the search result. Same file as /libro/.
const pdfHref = `/downloads/${a.slug}-libro${locale === 'ca' ? '.ca' : ''}.pdf`;
const jsonLd = isPublicado
  ? [
      breadcrumb,
      courseLd({
        name: `${a.title} (${a.level})`,
        description: a.tagline,
        path: `/${a.slug}/`,
        educationalLevel: a.level,
        marcoNormativo: a.marcoNormativo,
        ley: leyCurricular(a),
        targetName: `${a.title}, ${a.level}`,
        teaches: unitTitles,
        locale,
      }),
      faqLd(faqs),
    ]
  : breadcrumb;
---

<BaseLayout
  title={a.seoTitle}
  brandSuffix={false}
  description={copy.metaDesc(a.title, a.level, leyCurricular(a), a.marcoNormativo)}
  jsonLd={jsonLd}
  contentLang={locale}
>

  <div class="container">
    <Breadcrumb
      locale={locale}
      items={[
        { name: copy.bcInicio, path: '/' },
        { name: a.shortLabel },
      ]}
    />
  </div>

  <section class="hub-hero">
    <div class="container hub-hero__grid">
      <AsignaturaCaratula asignatura={a} class="hub-cover" />
      <div class="hub-hero__text">
      <h1 class="title" style={`color: var(--color-${a.color}-ink)`}>{a.title}</h1>
      <p class="hub-curso">
        {cursoLinea.map((parte, i) => (<>{i > 0 && <span class="sep" aria-hidden="true">·</span>}{parte}</>))}
      </p>

      {isPublicado ? (
        <>
          <p class="subtitle">{a.tagline}</p>
          {unitTitles.length > 0 && (
            <a class="download-cta" href={pdfHref} download>
              <span class="download-cta__icon" aria-hidden="true">↓</span>
              <span class="download-cta__text">
                <strong>{copy.pdfCta}</strong>
                <span class="muted">{copy.pdfSub(unitTitles.length)}</span>
              </span>
            </a>
          )}
        </>
      ) : (
        <>
          <p class="subtitle proximamente-tag">{copy.proximamente}</p>
          <p class="desc">
            {a.tagline}
          </p>
          <p class="desc">
            {copy.enPreparacion}
          </p>
        </>
      )}

      <div class="curriculum-note">
        {isPublicado
          ? copy.curriculumNote(a.title, leyCurricular(a), a.marcoNormativo)
          : <>{copy.curriculumPendiente(a.marcoNormativo)} <a class="editorial-link" href="https://instagram.com/profedeeconomia" rel="external">@profedeeconomia</a>.</>
        }
      </div>
      </div>
    </div>
  </section>

  {situaciones.length > 0 && (
    <section class="hub-situaciones" aria-labelledby="hub-sa-h">
      <div class="container">
        <h2 id="hub-sa-h">{saCopy.titulo}</h2>
        <p class="hub-intro">{saCopy.intro}</p>
        <ol class="sa-cards">
          {situaciones.map((sa) => (
            <li>
              <a class={`sa-card c-${a.color}`} href={`/${a.slug}/situaciones/${situacionSlug(sa)}/`}>
                <span class="sa-card__num" aria-hidden="true">{String(sa.data.orden).padStart(2, '0')}</span>
                <span class="sa-card__title">{sa.data.title}</span>
                <span class="sa-card__lede">{sa.data.producto_final}</span>
              </a>
            </li>
          ))}
        </ol>
        <p class="sa-all"><a class="editorial-link" href={`/${a.slug}/situaciones/`}>{saCopy.todas}</a></p>
      </div>
    </section>
  )}

  {isPublicado && (
    <section class="hub-sections">
      <div class="container">
        <h2>{copy.sectionsH}</h2>
        <p class="hub-intro">
          {copy.hubIntro}
        </p>

        {grupos.map((g) => (
          <div class="section-group">
            <div class="section-group__head">
              <h3 class="section-group__title">{g.label}</h3>
              <p class="section-group__desc">{g.desc}</p>
            </div>
            <nav class="subject-sections" aria-label={g.label}>
              {g.sections.map((slug) => (
                <a href={`/${a.slug}/${slug}/`} class={`section-card c-${a.color}`}>
                  <h4>{copy.secciones[slug].title}</h4>
                  <p class="desc">{copy.secciones[slug].desc}</p>
                </a>
              ))}
            </nav>
          </div>
        ))}

        {(a.slug === 'edmn-2bach' || a.slug === 'eco-1bach') && (
          <a href="/olimpiada/" class="olimpiada-card">
            <h3>{copy.olimpiadaTitle}</h3>
            <p class="desc">{copy.olimpiadaDesc}</p>
            <span class="ol-cta">{copy.olimpiadaCta}</span>
          </a>
        )}
      </div>
    </section>
  )}

  {porUnidad.length > 0 && (
    <section class="hub-unidades" aria-labelledby="hub-unidades-h">
      <div class="container">
        <h2 id="hub-unidades-h">{uCopy.titulo}</h2>
        <p class="hub-intro">{uCopy.intro}</p>
        <ol class="unidades">
          {porUnidad.map((u) => (
            <li class="unidad">
              <span class="unidad__num" aria-hidden="true">{String(u.unidad).padStart(2, '0')}</span>
              <div class="unidad__body">
                <a class="unidad__title" href={u.libro}>{u.title}</a>
                <p class="unidad__links">
                  <a href={u.diapositivas}>{uCopy.diapositivas}</a>
                  {u.test && <><span class="sep" aria-hidden="true">·</span><a href={u.test}>{uCopy.test}</a></>}
                  {u.actividadesHref && <><span class="sep" aria-hidden="true">·</span><a href={u.actividadesHref}>{uCopy.actividades(u.actividades)}</a></>}
                  {u.retos.map((r, i) => (
                    <><span class="sep" aria-hidden="true">·</span><a href={r}>{u.retos.length > 1 ? `${uCopy.reto} ${i + 1}` : uCopy.reto}</a></>
                  ))}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {isPublicado && <FaqHub faqs={faqs} />}

</BaseLayout>

<style>
  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4vw, 3rem);
  }

  .hub-hero { padding: 1rem 0 3.5rem; }
  .hub-hero h1 { max-width: 22ch; margin: 0 0 0.6rem; }
  /* Text left, cover right; on narrow screens the cover slots in right after
     the title and course line (the text wrapper dissolves into the flex). */
  .hub-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }
  .hub-hero__text { grid-column: 1; grid-row: 1; }
  .hub-hero :global(.hub-cover) { grid-column: 2; grid-row: 1; border-radius: 6px; margin-top: 0.4rem; }
  @media (max-width: 860px) {
    .hub-hero__grid { display: flex; flex-direction: column; gap: 0; }
    .hub-hero__text { display: contents; }
    .hub-hero__text > * { order: 4; }
    .hub-hero__text > h1 { order: 1; }
    .hub-hero__text > .hub-curso { order: 2; }
    .hub-hero :global(.hub-cover) { order: 3; margin: 0 0 1.4rem; }
  }

  /* Per-asignatura title colour carries the color-coding on the hub now that the
     accent stripe is gone; the -ink hue is AA-safe on cream (see global.css). */
  .hub-curso {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    margin: 0 0 1rem;
  }
  .hub-curso .sep { margin: 0 0.5em; color: var(--color-mustard); }
  .subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    /* 1.5rem made a seven-line lede on a phone, pushing the first section
       link below the second screen. */
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    color: var(--color-ink-soft);
    font-variation-settings: "SOFT" 80;
    margin: 0;
  }
  .download-cta {
    display: inline-flex; align-items: center; gap: 1rem;
    margin-top: 1.6rem;
    padding: 0.9rem 1.4rem 0.9rem 1.1rem;
    background: var(--color-terra); color: #fff; text-decoration: none;
    border-radius: 6px;
