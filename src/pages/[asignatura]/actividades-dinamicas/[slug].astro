---
import BaseLayout from '@layouts/BaseLayout.astro';
import { ASIGNATURAS } from '@/lib/asignaturas';
import { breadcrumbLd } from '@/lib/seo';
import { getCollection } from 'astro:content';
import { getLocale } from '@/i18n/locale';
import { pickLocalizedEntry } from '@/i18n/content-locale';
import { localizeAsignatura } from '@/i18n/asignaturas-ca';
import QuizPlayer from '@components/QuizPlayer.tsx';
import ArbolDecisiones from '@components/actividades/ArbolDecisiones.astro';
import { parseTreeFromMdxBody } from '@components/actividades/parse-tree.ts';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const libroAll = await getCollection('libro');
  return libroAll
    .filter((u) => u.data.estado === 'publicado' && u.data.lang === 'es')
    .map((u) => {
      const slug = u.id.split('/').pop()?.replace(/\.mdx?$/, '') ?? u.id;
      return {
        params: { asignatura: u.data.asignatura, slug },
        props: { unit: u },
      };
    });
}) satisfies GetStaticPaths;

const locale = getLocale(Astro.currentLocale);
const unitEs = Astro.props.unit;
const a = localizeAsignatura(ASIGNATURAS[unitEs.data.asignatura as keyof typeof ASIGNATURAS], locale);
const unidad = unitEs.data.unidad;

const [libroAll, testsAll, dinAll, recAll] = await Promise.all([
  getCollection('libro'),
  getCollection('tests'),
  getCollection('actividadesDinamicas'),
  getCollection('recursos'),
]);
const libroCaById = new Map(libroAll.filter((u) => u.data.lang === 'ca').map((u) => [u.id, u]));
const unit = pickLocalizedEntry(unitEs, libroCaById, locale);

// Serve ES entries as the source of truth, swapped to their CA sibling under /ca.
const dinCaById = new Map(dinAll.filter((d) => d.data.lang === 'ca').map((d) => [d.id, d]));
const test = testsAll.find((t) => t.data.asignatura === a.slug && t.data.unidad_relacionada === unidad && t.data.estado === 'publicado' && t.data.lang === 'es');
const simuladores = dinAll.filter((d) => d.data.asignatura === a.slug && d.data.unidad_relacionada === unidad && d.data.estado === 'publicado' && d.data.lang === 'es');
const recursos = recAll.filter((r) => r.data.asignatura === a.slug && r.data.unidad_relacionada === unidad && r.data.estado === 'publicado' && r.data.lang === 'es');

// Pre-parse simulator JSON so build-time errors surface clearly. The route slug
// and storage id stay ES-stable; the CA sibling only supplies localized display.
const simuladoresParsed = simuladores.map((esSim) => {
  const s = pickLocalizedEntry(esSim, dinCaById, locale);
  const simSlug = esSim.id.split('/').pop()?.replace(/\.mdx?$/, '') ?? esSim.id;
  try {
    return { entry: s, simSlug, tree: parseTreeFromMdxBody(s.body ?? '') };
  } catch (err) {
    throw new Error(`Cannot parse simulator JSON in ${s.id}: ${(err as Error).message}`);
  }
});

const copy = {
  es: { inicio: 'Inicio', actividades: 'Actividades interactivas', unidad: 'Unidad', actividadesShort: 'Actividades', descripcion: `Test, simuladores y recursos interactivos de la unidad ${unidad}.`, test: 'Test de autoevaluación', preguntas: 'preguntas', simuladores: 'Simuladores de decisión', recursos: 'Recursos interactivos' },
  ca: { inicio: 'Inici', actividades: 'Activitats interactives', unidad: 'Unitat', actividadesShort: 'Activitats', descripcion: `Test, simuladors i recursos interactius de la unitat ${unidad}.`, test: "Test d'autoavaluació", preguntas: 'preguntes', simuladores: 'Simuladors de decisió', recursos: 'Recursos interactius' },
}[locale];

const unitSlug = unitEs.id.split('/').pop()?.replace(/\.mdx?$/, '') ?? unitEs.id;
const breadcrumb = breadcrumbLd([
  { name: copy.inicio, path: '/' },
  { name: a.shortLabel, path: `/${a.slug}/` },
  { name: copy.actividades, path: `/${a.slug}/actividades-dinamicas/` },
  { name: `${copy.unidad} ${unidad}: ${unit.data.title}`, path: `/${a.slug}/actividades-dinamicas/${unitSlug}/` },
]);
---

<BaseLayout title={`${copy.actividadesShort} · ${unit.data.title} — ${a.shortLabel}`} description={copy.descripcion} ogType="article" jsonLd={breadcrumb} contentLang={locale}>
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">{copy.inicio}</a> <span class="sep">›</span>
      <a href={`/${a.slug}/`}>{a.shortLabel}</a> <span class="sep">›</span>
      <a href={`/${a.slug}/actividades-dinamicas/`}>{copy.actividades}</a> <span class="sep">›</span>
      <span>{copy.unidad} {unidad}</span>
    </nav>
  </div>

  <section class="hero">
    <div class="container">
      <span class="kicker kicker--sentence">{copy.unidad} {unidad} · {a.shortLabel}</span>
      <h1>{unit.data.title}</h1>
      {unit.data.lema && <p class="lede">{unit.data.lema}</p>}
    </div>
  </section>

  {test && (
    <section class="bloque">
      <div class="container container--narrow">
        <h2 class="bloque__h2">{copy.test}</h2>
        <p class="bloque__meta">{test.data.preguntas.length} {copy.preguntas}{test.data.duracion_estimada && <> · {test.data.duracion_estimada}</>}</p>
        <QuizPlayer preguntas={test.data.preguntas} storageKey={`test-${a.slug}-u${unidad}`} client:load />
      </div>
    </section>
  )}

  {simuladoresParsed.length > 0 && (
    <section class="bloque bloque--alt">
      <div class="container container--narrow">
        <h2 class="bloque__h2">{copy.simuladores}</h2>
        {simuladoresParsed.map(({ entry, simSlug, tree }) => (
          <article class="simulador">
            <h3 class="simulador__h3">{entry.data.title}</h3>
            {entry.data.descripcion && <p class="simulador__lede">{entry.data.descripcion}</p>}
            <ArbolDecisiones data={tree} simuladorId={`${a.slug}-${simSlug}`} locale={locale} />
          </article>
        ))}
      </div>
    </section>
  )}

  {recursos.length > 0 && (
    <section class="bloque">
      <div class="container container--narrow">
        <h2 class="bloque__h2">{copy.recursos}</h2>
        <ul class="recurso-list">
          {recursos.map((r) => {
            const rSlug = r.id.split('/').pop()?.replace(/\.mdx?$/, '') ?? r.id;
            return (
              <li>
                <a href={`/${a.slug}/recursos/${rSlug}/`}>
                  <h3>{r.data.title}</h3>
                  <p>{r.data.descripcion}</p>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  {!test && simuladoresParsed.length === 0 && recursos.length === 0 && (
    <section class="bloque">
      <div class="container container--narrow">
        <p class="empty">Pronto aquí: simulador, recursos y test de esta unidad.</p>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .bloque { padding: 48px 0; border-top: 1px solid var(--color-line); }
  .bloque--alt { background: var(--color-bg-cream); }
  .bloque__h2 { font-family: var(--font-serif); font-size: 28px; margin: 0 0 8px; }
  .bloque__meta { font-family: var(--font-mono); font-size: 13px; color: var(--color-ink-mute); margin: 0 0 24px; }
  .simulador { margin-bottom: 40px; }
  .simulador__h3 { font-family: var(--font-serif); font-size: 22px; margin: 24px 0 6px; }
  .simulador__lede { font-family: var(--font-serif); font-style: italic; color: var(--color-ink-soft); margin: 0 0 18px; }
  .recurso-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); }
  .recurso-list a { display: block; padding: 18px 20px; background: var(--color-paper); border: 1px solid var(--color-line); border-radius: 6px; text-decoration: none; color: inherit; }
  .recurso-list a:hover { border-color: var(--color-terra); }
  .recurso-list h3 { font-family: var(--font-serif); font-size: 18px; margin: 0 0 6px; }
  .recurso-list p  { font-size: 14px; color: var(--color-ink-soft); margin: 0; }
  .empty { font-family: var(--font-serif); font-style: italic; color: var(--color-ink-mute); }
</style>
