---
/**
 * A single interdisciplinary project. Routed by `[materia]/[slug]` (two params).
 * Renders the reto, the producto final, the MDX body (sessions + conexión), the
 * rubric, the curriculum map (economics units and, when the project declares
 * it, what it works from the partner subject's curriculum) and competences.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import ProyectoMeta from '@components/proyectos/ProyectoMeta.astro';
import Rubrica from '@components/debates/Rubrica.astro';
import PuenteUnidades from '@components/emprendimiento/PuenteUnidades.astro';
import { materiaMeta } from '@/lib/proyectos';
import { breadcrumbLd } from '@/lib/seo';
import { getLocale } from '@/i18n/locale';
import { pickLocalizedEntry } from '@/i18n/content-locale';
import { localizeFamilias, MATERIAS_PROYECTOS_CA } from '@/i18n/familias-ca';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import SectionHeader from '@components/SectionHeader.astro';

export const getStaticPaths = (async () => {
  // ES entries define the canonical routes; CA siblings (lang: ca) must NOT
  // create their own routes.
  const all = (await getCollection('proyectos')).filter(
    (e) => e.data.estado === 'publicado' && e.data.lang === 'es',
  );
  return all.map((entry) => {
    const [materia, ...rest] = entry.id.replace(/^proyectos\//, '').split('/');
    return { params: { materia, slug: rest.join('/') }, props: { entry } };
  });
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const caById = new Map(
  (await getCollection('proyectos'))
    .filter((e) => e.data.estado === 'publicado' && e.data.lang === 'ca')
    .map((e) => [e.id, e]),
);
const view = pickLocalizedEntry(entry, caById, locale);
const d = view.data;
const { Content } = await render(view);
const materia = materiaMeta(d.materia);
const [materiaLocal] = localizeFamilias([materia], MATERIAS_PROYECTOS_CA, locale);
const materiaSocia = d.materia_socia ?? [];
// Valencian elides «de» before a vowel or h + vowel: «d'Història», «d'Ètica i valors».
const deCa = /^h?[aeiouàèéíïòóúü]/i.test(materiaLocal.label) ? `d'${materiaLocal.label}` : `de ${materiaLocal.label}`;
const copy = {
  es: { proyectos: 'Proyectos', inicio: 'Inicio', reto: 'El reto', productoFinal: 'Producto final:', objetivos: 'Objetivos', conceptos: 'Conceptos:', rubrica: 'Rúbrica de evaluación', sociaH: `Qué se trabaja de ${materiaLocal.label}`, sociaNota: 'Competencias específicas y saberes básicos del currículo estatal (Real Decreto 217/2022 para la ESO y Real Decreto 243/2022 para el Bachillerato). Cada comunidad autónoma los concreta en su propio currículo.', sociaCe: 'Competencias específicas:', sociaSaberes: 'Saberes básicos:', compH: 'Competencias que se trabajan', clave: 'Clave:', especificas: 'Específicas:', volver: '← Todos los proyectos' },
  ca: { proyectos: 'Projectes', inicio: 'Inici', reto: 'El repte', productoFinal: 'Producte final:', objetivos: 'Objectius', conceptos: 'Conceptes:', rubrica: "Rúbrica d'avaluació", sociaH: `Què es treballa ${deCa}`, sociaNota: "Competències específiques i sabers bàsics del currículum estatal (Reial Decret 217/2022 per a l'ESO i Reial Decret 243/2022 per al Batxillerat). Cada comunitat autònoma els concreta en el seu currículum propi.", sociaCe: 'Competències específiques:', sociaSaberes: 'Sabers bàsics:', compH: 'Competències que es treballen', clave: 'Clau:', especificas: 'Específiques:', volver: '← Tots els projectes' },
}[locale];
const breadcrumb = breadcrumbLd([
  { name: copy.inicio, path: '/' },
  { name: copy.proyectos, path: '/proyectos/' },
  { name: d.title, path: `/proyectos/${d.materia}/${Astro.params.slug}/` },
], locale);
---
<BaseLayout title={`${d.title} — ${copy.proyectos}`} description={d.descripcion} ogType="article" jsonLd={breadcrumb} contentLang={view.data.lang} translated={caById.has(`${entry.id}.ca`)}>
  <SectionHeader
    locale={locale}
    tight
    kicker={materiaLocal.label}
    titleStyle={`color: var(${materia.colorVar}-ink)`}
    crumbs={[
      { name: copy.inicio, path: '/' },
      { name: copy.proyectos, path: '/proyectos/' },
      { name: d.title },
    ]}
  >
    <Fragment slot="title">{d.title}</Fragment>
    <Fragment slot="lede">{d.descripcion}</Fragment>
    <ProyectoMeta materia={d.materia} nivel={d.nivel} duracion={d.duracion} agrupacion={d.agrupacion} locale={locale} />
  </SectionHeader>

  <section class="body">
    <div class="container container--narrow">
      <section class="block reto">
        <h2>{copy.reto}</h2>
        <blockquote class="reto__q">{d.reto}</blockquote>
        <p class="producto"><strong>{copy.productoFinal}</strong> {d.producto_final}</p>
      </section>

      {d.objetivos.length > 0 && (
        <section class="block">
          <h2>{copy.objetivos}</h2>
          <ul>{d.objetivos.map((o) => <li>{o}</li>)}</ul>
          {d.conceptos_clave.length > 0 && (
            <p class="conceptos"><strong>{copy.conceptos}</strong> {d.conceptos_clave.join(' · ')}</p>
          )}
        </section>
      )}

      <article class="prose"><Content /></article>

      {d.rubrica.length > 0 && (
        <section class="block">
          <h2>{copy.rubrica}</h2>
          <Rubrica rubrica={d.rubrica} locale={locale} />
        </section>
      )}

      <PuenteUnidades unidades={d.unidades_relacionadas} />

      {materiaSocia.length > 0 && (
        <section class="block socia">
          <h2>{copy.sociaH}</h2>
          <p class="socia__nota">{copy.sociaNota}</p>
          {materiaSocia.map((m) => (
            <div class="socia__materia">
              <h3>{m.materia} <span class="socia__curso">· {m.curso}</span></h3>
              <p><strong>{copy.sociaCe}</strong></p>
              <ul>{m.competencias_especificas.map((c) => <li>{c}</li>)}</ul>
              <p><strong>{copy.sociaSaberes}</strong></p>
              <ul>{m.saberes.map((s) => <li>{s}</li>)}</ul>
            </div>
          ))}
        </section>
      )}

      {(d.competencias_clave.length > 0 || d.competencias_especificas.length > 0) && (
        <section class="block">
          <h2>{copy.compH}</h2>
          {d.competencias_clave.length > 0 && (<p><strong>{copy.clave}</strong> {d.competencias_clave.join(' · ')}</p>)}
          {d.competencias_especificas.length > 0 && (<p><strong>{copy.especificas}</strong> {d.competencias_especificas.join(' · ')}</p>)}
        </section>
      )}

      <nav class="back"><a href="/proyectos/">{copy.volver}</a></nav>
    </div>
  </section>
</BaseLayout>
<style>
  .container { max-width: 1240px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem); }
  .container--narrow { max-width: 820px; }
  .body { padding: 1rem 0 clamp(3rem, 7vw, 6rem); }
  .block { margin: 1.6rem 0; }
  .block h2 { font-family: var(--font-serif); font-size: 1.4rem; font-weight: 500; margin: 0 0 0.5rem; }
  .block ul { padding-left: 1.3rem; } .block li { margin-bottom: 0.3em; }
  .block ul li::marker { color: var(--color-mustard); }
  .conceptos { color: var(--color-ink-soft); margin-top: 0.6rem; }
  .socia__nota { color: var(--color-ink-soft); font-size: 0.95rem; margin: 0 0 0.4rem; }
  .socia__materia h3 { font-size: 1.15rem; margin: 1.4rem 0 0.5rem; }
  .socia__curso { color: var(--color-ink-soft); }
  .socia__materia p { margin: 0.6rem 0 0.2rem; }
  .socia__materia ul { margin: 0; }
  .reto__q { font-family: var(--font-serif); font-style: italic; font-size: 1.3rem; line-height: 1.4; color: var(--color-ink); margin: 0.4rem 0 1rem; padding: 0.2rem 0; }
  .producto { color: var(--color-ink-soft); }
  .prose { font-size: 1.05rem; line-height: 1.7; color: var(--color-ink); }
  .prose :global(h2) { font-family: var(--font-serif); font-size: 1.6rem; margin: 2.2em 0 0.7em; position: relative; padding-top: 1em; font-weight: 500; }
  .prose :global(h3) { font-family: var(--font-serif); font-size: 1.25rem; margin: 1.6em 0 0.5em; font-weight: 500; }
  .prose :global(p) { margin: 0 0 1em; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.4rem; margin: 0 0 1em; }
  .prose :global(ul li::marker) { color: var(--color-mustard); }
  .back { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-line); font-family: var(--font-sans); }
  .back a { color: var(--color-terra); text-decoration: none; font-weight: 500; }
  .back a:hover { text-decoration: underline; }
</style>
