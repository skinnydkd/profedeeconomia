---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { groupByFamilia, MATERIAS } from '@/lib/proyectos';
import { getCollection } from 'astro:content';
import { getLocale } from '@/i18n/locale';
import { t } from '@/i18n/ui';
import { localizeFamilias, MATERIAS_PROYECTOS_CA } from '@/i18n/familias-ca';
import { localizeFicha, PROYECTOS_CA } from '@/i18n/fichas-ca';

const locale = getLocale(Astro.currentLocale);

// Page-opening captures of each proyecto (scripts/build-screenshots.mjs), keyed
// by the ES slug (materia/NN-nombre) — shared by both locales.
const THUMBS = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/screenshots/proyectos/**/*.webp',
  { eager: true },
);
const thumbDe = (slug: string): ImageMetadata | undefined =>
  THUMBS[`/src/assets/screenshots/proyectos/${slug}.webp`]?.default;
const materias = localizeFamilias(MATERIAS, MATERIAS_PROYECTOS_CA, locale);

// The card fields (title, descripcion, duracion) are overlaid from fichas-ca.ts;
// the MDX bodies behind each card stay ES until the content phase.
const copy = {
  es: {
    metaTitle: 'Proyectos interdisciplinares',
    metaDesc:
      'Proyectos ABP que cruzan la economía con otra materia —historia, matemáticas, geografía, ética, lengua, tecnología— con su reto, secuencia de sesiones, conexión curricular y rúbrica.',
    bcInicio: 'Inicio',
    bcCurrent: 'Proyectos',
    heroAccent: 'Proyectos',
    heroTail: 'que cruzan materias.',
    lede: 'Aprendizaje por proyectos donde la economía se cruza con otra materia: un reto, un producto final, la secuencia de sesiones y la rúbrica. Cada uno con su encaje curricular en las unidades de economía.',
  },
  ca: {
    metaTitle: 'Projectes interdisciplinaris',
    metaDesc:
      "Projectes ABP que creuen l'economia amb una altra matèria —història, matemàtiques, geografia, ètica, llengua, tecnologia— amb el seu repte, seqüència de sessions, connexió curricular i rúbrica.",
    bcInicio: 'Inici',
    bcCurrent: 'Projectes',
    heroAccent: 'Projectes',
    heroTail: 'que creuen matèries.',
    lede: "Aprenentatge per projectes on l'economia es creua amb una altra matèria: un repte, un producte final, la seqüència de sessions i la rúbrica. Cada un amb el seu encaix curricular en les unitats d'economia.",
  },
}[locale];

// CA siblings (lang: ca) render via the fichas-ca overlay above, not as their
// own cards — keep only the ES entries.
const all = (await getCollection('proyectos')).filter((e) => e.data.estado === 'publicado' && e.data.lang === 'es');
const groups = groupByFamilia(materias, all.map((e) => ({
  slug: e.id.replace(/^proyectos\//, ''),
  data: { ...e.data, familia: e.data.materia },
})));
const activeMaterias = new Set(groups.map((g) => g.familia.slug));
const NIVEL_LABEL: Record<string, string> = {
  eso: t('nivel.eso', locale),
  bach: t('nivel.bach', locale),
  fp: t('nivel.fp', locale),
};
---
<BaseLayout
  title={copy.metaTitle}
  description={copy.metaDesc}
  contentLang={locale}
>
  <div class="container">
    <nav class="breadcrumb"><a href="/">{copy.bcInicio}</a> <span class="sep">›</span> <span>{copy.bcCurrent}</span></nav>
  </div>
  <section class="hero">
    <div class="container">
      <h1><span class="serif-italic-wonk accent">{copy.heroAccent}</span> {copy.heroTail}</h1>
      <p class="lede">
        {copy.lede}
      </p>
    </div>
  </section>
  <section class="filters">
    <div class="container">
      <button class="chip is-active" data-filter="all" type="button">{t('filtro.todos', locale)}</button>
      {materias.filter((m) => activeMaterias.has(m.slug)).map((m) => (
        <button class="chip" data-filter={m.slug} type="button" style={`--chip-color: var(${m.colorVar})`}>{m.label}</button>
      ))}
    </div>
  </section>
  {groups.map((g) => (
    <section class="familia" data-familia={g.familia.slug}>
      <div class="container">
        <div class="familia__head" style={`--fam-color: var(${g.familia.colorVar})`}>
          <h2>{g.familia.label}</h2>
          <p>{g.familia.intro}</p>
        </div>
        <div class="card-grid">
          {g.items.map((d) => {
            const data = localizeFicha(d.data, d.slug, PROYECTOS_CA, locale);
            const th = thumbDe(d.slug);
            return (
              <a class="card" href={`/proyectos/${d.slug}/`} style={`--fam-color: var(${g.familia.colorVar}); --fam-ink: var(${g.familia.colorVar}-ink)`}>
                {th && <Image class="card__thumb" src={th} alt="" widths={[320, 640]} sizes="(min-width: 720px) 320px, 90vw" />}
                <span class="card__eyebrow">{g.familia.label}</span>
                <h3 class="card__title serif">{data.title}</h3>
                <p class="card__desc">{data.descripcion}</p>
                <span class="card__meta">{data.nivel.map((n) => NIVEL_LABEL[n] ?? n).join(' · ')} · {data.duracion}</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  ))}
</BaseLayout>
<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const sections = document.querySelectorAll<HTMLElement>('.familia');
  chips.forEach((chip) => chip.addEventListener('click', () => {
    chips.forEach((c) => c.classList.remove('is-active'));
    chip.classList.add('is-active');
    const f = chip.dataset.filter;
    sections.forEach((s) => { s.hidden = f !== 'all' && s.dataset.familia !== f; });
  }));
</script>
<style>
  .container { max-width: 1240px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem); }
  .breadcrumb { font-size: 0.92rem; color: var(--color-ink-mute); margin: 2rem 0; }
  .breadcrumb a { color: var(--color-ink-mute); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-terra); }
  .breadcrumb .sep { margin: 0 0.5em; color: var(--color-mustard); }
  .hero { padding: 1rem 0 2rem; }
  .kicker { font-family: var(--font-sans); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-terra-deep); }
  .accent { color: var(--color-terra); }
  h1 { margin: 0.6rem 0 0.8rem; }
  .lede { font-size: 1.2rem; color: var(--color-ink-soft); line-height: 1.55; max-width: 60ch; }
  .filters .container { display: flex; flex-wrap: wrap; gap: 0.5rem; padding-top: 1rem; padding-bottom: 1.5rem; }
  .chip { font-family: var(--font-sans); font-size: 0.85rem; font-weight: 600; color: var(--color-ink-soft); background: transparent; border: 1.5px solid var(--color-line); border-radius: 999px; padding: 0.4rem 0.9rem; cursor: pointer; transition: all .15s ease; }
  .chip:hover { border-color: var(--chip-color, var(--color-terra)); color: var(--chip-color, var(--color-terra)); }
  .chip.is-active { background: var(--chip-color, var(--color-ink)); border-color: var(--chip-color, var(--color-ink)); color: var(--color-paper); }
  .familia { padding: 1.5rem 0; }
  .familia__head { border-left: 4px solid var(--fam-color); padding-left: 1rem; margin-bottom: 1.5rem; }
  .familia__head h2 { font-family: var(--font-serif); font-size: 1.7rem; font-weight: 500; margin: 0; }
  .familia__head p { color: var(--color-ink-soft); margin: 0.3rem 0 0; }
  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(290px, 100%), 1fr)); gap: 1.2rem; }
  .card { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.4rem; background: var(--color-paper); border: 1px solid var(--color-line); border-top: 4px solid var(--fam-color); border-radius: 10px; text-decoration: none; transition: transform .15s ease, box-shadow .15s ease; }
  .card:hover { transform: translateY(-3px); box-shadow: 0 8px 28px rgba(42, 31, 24, 0.1); }
  .card__thumb { display: block; width: calc(100% + 2.8rem); height: auto; margin: -1.4rem -1.4rem 0.35rem; border-radius: 6px 6px 0 0; border-bottom: 1px solid var(--color-line); }
  .card__eyebrow { font-family: var(--font-sans); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fam-ink); }
  .card__title { font-size: 1.3rem; color: var(--color-ink); margin: 0; }
  .card__desc { color: var(--color-ink-soft); font-size: 0.95rem; line-height: 1.5; margin: 0; flex: 1; }
  .card__meta { font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-ink-mute); margin-top: 0.3rem; }
</style>
