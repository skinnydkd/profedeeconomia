---
/**
 * Generadores hub: the external LOMLOE generators (hosted on the sibling project)
 * plus native teacher tools (rubric, grading, templates) grouped by purpose.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { GENERADORES_EXTERNOS, gruposNativos } from '@/lib/generadores';
import { getLocale } from '@/i18n/locale';
import { t } from '@/i18n/ui';
import { localizeGeneradorNativo, localizeGeneradorExterno } from '@/i18n/generadores-ca';

const locale = getLocale(Astro.currentLocale);

// Real captures of each native tool (scripts/build-screenshots.mjs), keyed by
// the ES slug. The external LOMLOE generators have no local page to capture,
// so their cards stay text-only.
const THUMBS = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/screenshots/generadores/*.webp',
  { eager: true },
);
const thumbDe = (slug: string): ImageMetadata | undefined =>
  THUMBS[`/src/assets/screenshots/generadores/${slug}.webp`]?.default;

const grupos = gruposNativos();
const TIPO_LABEL: Record<string, string> = {
  rubrica: t('tipo.rubrica', locale),
  calculadora: t('tipo.calculadora', locale),
  plantilla: t('tipo.plantilla', locale),
};
const GRUPO_LABEL: Record<string, string> = {
  evaluacion: t('gen.grupo.evaluacion', locale),
  aula: t('gen.grupo.aula', locale),
};

const copy = {
  es: {
    metaTitle: 'Herramientas docentes',
    metaDesc:
      'Generadores LOMLOE (situaciones de aprendizaje, programación) y herramientas de evaluación y aula: rúbricas, calificaciones y plantillas para imprimir.',
    heroAccent: 'Herramientas',
    heroTail: 'docentes.',
    lede: 'Lo que uso para preparar las clases: los generadores LOMLOE de mi proyecto hermano y un puñado de herramientas de evaluación y aula que funcionan en el navegador, se autoguardan y se exportan o imprimen.',
    bcInicio: 'Inicio',
    bcCurrent: 'Herramientas docentes',
    notePre: 'Los generadores LOMLOE viven en',
    notePost: 'donde los mantengo. El resto son herramientas que he montado aquí, por si os sirven.',
  },
  ca: {
    metaTitle: 'Ferramentes docents',
    metaDesc:
      "Generadors LOMLOE (situacions d'aprenentatge, programació) i ferramentes d'avaluació i aula: rúbriques, qualificacions i plantilles per a imprimir.",
    heroAccent: 'Ferramentes',
    heroTail: 'docents.',
    lede: "El que use per a preparar les classes: els generadors LOMLOE del meu projecte germà i un grapat de ferramentes d'avaluació i aula que funcionen en el navegador, s'autoguarden i s'exporten o s'imprimeixen.",
    bcInicio: 'Inici',
    bcCurrent: 'Ferramentes docents',
    notePre: 'Els generadors LOMLOE viuen en',
    notePost: "on els mantinc. La resta són ferramentes que he muntat ací, per si us serveixen.",
  },
}[locale];
---

<BaseLayout
  title={copy.metaTitle}
  description={copy.metaDesc}
  contentLang={locale}
>
  <div class="container">
    <nav class="breadcrumb"><a href="/">{copy.bcInicio}</a> <span class="sep">›</span> <span>{copy.bcCurrent}</span></nav>
  </div>

  <section class="hero">
    <div class="container">
      <h1><span class="serif-italic-wonk accent">{copy.heroAccent}</span> {copy.heroTail}</h1>
      <p class="lede">
        {copy.lede}
      </p>
    </div>
  </section>

  <section class="tools">
    <div class="container">
      <h2 class="group-title">{t('gen.lomloe', locale)}</h2>
      <div class="tool-grid">
        {GENERADORES_EXTERNOS.map((raw) => {
          const g = localizeGeneradorExterno(raw, locale);
          return (
            <a class="tool-card" href={g.href} rel="external noopener" target="_blank">
              <span class="tc-eyebrow">{g.eyebrow}</span>
              <h3 class="tc-title serif">{g.title}</h3>
              <p class="tc-desc">{g.descripcion}</p>
              <span class="tc-cta">{t('card.abrirExterno', locale)}</span>
            </a>
          );
        })}
      </div>

      {grupos.map((grupo) => (
        <>
          <h2 class="group-title">{GRUPO_LABEL[grupo.grupo] ?? grupo.label}</h2>
          <div class="tool-grid">
            {grupo.items.map((raw) => {
              const g = localizeGeneradorNativo(raw, locale);
              const th = thumbDe(raw.slug);
              return (
                <a class="tool-card" href={`/generadores/${g.slug}/`}>
                  {th && <Image class="tc-thumb" src={th} alt="" widths={[320, 640]} sizes="(min-width: 720px) 320px, 90vw" />}
                  <span class="tc-eyebrow">{TIPO_LABEL[g.tipo] ?? g.tipo}</span>
                  <h3 class="tc-title serif">{g.title}</h3>
                  <p class="tc-desc">{g.descripcion}</p>
                  <span class="tc-cta">{t('card.abrir', locale)}</span>
                </a>
              );
            })}
          </div>
        </>
      ))}

      <p class="note">
        {copy.notePre}
        <a href="https://oposicioneseconomia.es" class="editorial-link" rel="external noopener" target="_blank">oposicioneseconomia.es</a>,
        {copy.notePost}
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .container { max-width: 1240px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem); }
  .breadcrumb { font-size: 0.92rem; color: var(--color-ink-mute); margin: 2rem 0; }
  .breadcrumb a { color: var(--color-ink-mute); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-terra); }
  .breadcrumb .sep { margin: 0 0.5em; color: var(--color-mustard); }
  .hero { padding: 1rem 0 clamp(1.5rem, 4vw, 2.5rem); }
  h1 { max-width: 22ch; margin: 1rem 0 0.6rem; }
  .kicker { font-family: var(--font-sans); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-terra-deep); }
  .accent { color: var(--color-terra); }
  .lede { font-family: var(--font-serif); font-style: italic; font-size: 1.3rem; color: var(--color-ink-soft); max-width: 58ch; margin: 1.2rem 0; line-height: 1.5; font-variation-settings: "SOFT" 80; }
  .tools { padding: 0 0 clamp(3rem, 7vw, 6rem); }
  .group-title { font-family: var(--font-serif); font-size: 1.5rem; font-weight: 500; margin: 1.5rem 0 1rem; }
  .tool-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 1.5rem; margin-bottom: 1.5rem; }
  .tool-card { display: block; background: #fff; border: 1px solid var(--color-line); padding: 1.6rem 1.75rem 1.4rem; text-decoration: none; color: inherit; transition: box-shadow 0.18s ease, border-color 0.18s ease, transform 0.18s ease; }
  .tool-card:hover { box-shadow: 0 4px 18px rgba(42, 31, 24, 0.08); border-top-color: var(--color-terra); transform: translateY(-2px); }
  .tc-thumb { display: block; width: calc(100% + 3.5rem); height: auto; margin: -1.6rem -1.75rem 0.8rem; border-bottom: 1px solid var(--color-line); }
  .tc-eyebrow { font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-eco1, #1F6E6E); font-weight: 600; }
  .tc-title { font-size: 1.5rem; line-height: 1.1; margin: 0.5rem 0 0.75rem; font-variation-settings: "SOFT" 80; }
  .tc-desc { color: var(--color-ink-soft); font-size: 1rem; line-height: 1.6; margin: 0 0 1rem; }
  .tc-cta { font-size: 0.9rem; font-weight: 600; color: var(--color-terra); }
  .note { font-family: var(--font-serif); font-style: italic; color: var(--color-ink-soft); max-width: 60ch; font-size: 1.05rem; line-height: 1.55; font-variation-settings: "SOFT" 80; }
</style>
