---
/** A single teacher tool. Routed by `[slug]` over GENERADORES_NATIVOS. */
import BaseLayout from '@layouts/BaseLayout.astro';
import GeneradorIsland from '@components/generadores/GeneradorIsland.astro';
import { GENERADORES_NATIVOS, generadorPorSlug } from '@/lib/generadores';
import type { GetStaticPaths } from 'astro';
import { getLocale } from '@/i18n/locale';
import { t } from '@/i18n/ui';
import { localizeGeneradorNativo } from '@/i18n/generadores-ca';
import SectionHeader from '@components/SectionHeader.astro';

export const getStaticPaths = (async () => {
  return GENERADORES_NATIVOS.map((g) => ({ params: { slug: g.slug }, props: { componente: g.componente, slug: g.slug } }));
}) satisfies GetStaticPaths;

const locale = getLocale(Astro.currentLocale);
const { componente, slug } = Astro.props;
const g = localizeGeneradorNativo(generadorPorSlug(slug)!, locale);

const copy = {
  es: { bcInicio: 'Inicio', bcGeneradores: 'Herramientas docentes', metaSuffix: 'Herramientas docentes' },
  ca: { bcInicio: 'Inici', bcGeneradores: 'Ferramentes docents', metaSuffix: 'Ferramentes docents' },
}[locale];
---

<BaseLayout title={`${g.title} — ${copy.metaSuffix}`} description={g.descripcion} contentLang={locale}>
  <SectionHeader
    locale={locale}
    tight
    kicker={copy.bcGeneradores}
    crumbs={[
      { name: copy.bcInicio, path: '/' },
      { name: copy.bcGeneradores, path: '/generadores/' },
      { name: g.title },
    ]}
  >
    <Fragment slot="title">{g.title}</Fragment>
    <Fragment slot="lede">{g.descripcion}</Fragment>
    <p class="como">{g.comoUsar}</p>
  </SectionHeader>

  <section class="player-wrap">
    <!-- The rubric grid (criteria × four levels) does not fit in 900 px. -->
    <div class:list={['container', g.tipo !== 'rubrica' && 'container--narrow']}>
      <GeneradorIsland componente={componente} locale={locale} />
    </div>
  </section>

  <section class="body">
    <div class="container container--narrow">
      <nav class="back"><a href="/generadores/">{t('generadores.volver', locale)}</a></nav>
    </div>
  </section>
</BaseLayout>

<style>
  .container { max-width: 1240px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem); }
  .container--narrow { max-width: 900px; }
  .body { padding: 1rem 0; }
  .como { color: var(--color-ink-soft); font-size: 0.98rem; }
  .player-wrap { padding: clamp(1rem, 3vw, 2rem) 0 clamp(1.5rem, 4vw, 2.5rem); }
  .back { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--color-line); font-family: var(--font-sans); }
  .back a { color: var(--color-terra); text-decoration: none; font-weight: 500; }
  .back a:hover { text-decoration: underline; }
</style>
