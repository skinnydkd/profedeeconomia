---
import BaseLayout from '@layouts/BaseLayout.astro';
import SubjectCard from '@components/SubjectCard.astro';
import { ASIGNATURAS_PUBLICADAS } from '@/lib/asignaturas';
import { organizationLd, websiteLd } from '@/lib/seo';
import { getLocale } from '@/i18n/locale';
import { localizeAsignatura } from '@/i18n/asignaturas-ca';

const locale = getLocale(Astro.currentLocale);

// Keep all subject counts in sync with the published catalogue so the
// homepage never drifts out of date when new asignaturas ship.
const NUM_WORDS = {
  es: ['cero', 'una', 'dos', 'tres', 'cuatro', 'cinco', 'seis', 'siete', 'ocho', 'nueve', 'diez', 'once', 'doce'],
  ca: ['zero', 'una', 'dues', 'tres', 'quatre', 'cinc', 'sis', 'set', 'huit', 'nou', 'deu', 'onze', 'dotze'],
} as const;
const numAsignaturas = ASIGNATURAS_PUBLICADAS.length;
const numAsignaturasPalabra = NUM_WORDS[locale][numAsignaturas] ?? String(numAsignaturas);
const NumPalabraCap = numAsignaturasPalabra.charAt(0).toUpperCase() + numAsignaturasPalabra.slice(1);

// «Material transversal» strip metadata — locale-independent (slug, letter,
// color), in the same order as the «Otros» menu. Titles/CTAs/descriptions
// are localized via `copy.transversal` below. Each card links to its hub.
const TRANSVERSAL_META = [
  { slug: 'dinamicas',      letra: 'D', color: '--color-terra' },
  { slug: 'herramientas',   letra: 'H', color: '--color-eco1' },
  { slug: 'emprendimiento', letra: 'E', color: '--color-mustard' },
  { slug: 'proyectos',      letra: 'P', color: '--color-eeae' },
  { slug: 'debates',        letra: 'D', color: '--color-gpe' },
  { slug: 'juegos',         letra: 'J', color: '--color-fopp' },
  { slug: 'jocs-economics', letra: 'O', color: '--color-taller3' },
  { slug: 'generadores',    letra: 'G', color: '--color-ipe2' },
] as const;

const copy = {
  es: {
    pageTitle: 'Material para impartir economía, empresa y finanzas en el instituto',
    descIntro: 'Material editorial para profesores de instituto.',
    descBody: 'asignaturas con libro, diapositivas, actividades, tests y recursos. Currículo estatal LOMLOE.',
    heroLead: 'Material para impartir',
    heroAccent: 'economía, empresa y finanzas',
    heroTail: 'en el instituto.',
    lede: 'El material que uso cada día en clase, esta vez ordenado por asignatura. Cada una con su libro, sus diapositivas, sus actividades, sus tests y sus recursos.',
    metaAsignaturas: 'asignaturas',
    metaCurriculo: 'Currículo estatal LOMLOE',
    metaProbado: 'Probado en aula',
    metaProfes: 'Hecho por profesores en activo',
    subjectsPrefix: 'Las',
    subjectsWord: 'asignaturas',
    subjectsNote: 'Cada una es un producto entero, con la misma estructura interna. Entras por la asignatura, no por el tipo de material.',
    transversalTitle: 'Material',
    transversalAccent: 'transversal',
    transversalNote: 'Lo que no encaja dentro de una asignatura concreta vive aquí. Para los días en que la teoría no sostiene la sesión.',
    transversal: {
      dinamicas:        { title: 'Dinámicas',                  cta: 'Ver las dinámicas',    desc: 'Role-plays, simulaciones y juegos de aula, con guía para el profe, materiales para imprimir y su encaje curricular.' },
      herramientas:     { title: 'Herramientas',                cta: 'Ver las herramientas', desc: 'La caja de herramientas: calculadoras y simuladores interactivos —punto muerto, ratios, VAN y TIR, elasticidad, nómina…— listos para clase.' },
      emprendimiento:   { title: 'Emprendimiento',               cta: 'Ver emprendimiento',   desc: '«De cero a empresa»: el alumnado crea y valida su propio negocio en doce fases, con cuaderno, plantillas y ejemplos reales.' },
      proyectos:        { title: 'Proyectos interdisciplinares', cta: 'Ver los proyectos',    desc: 'Proyectos ABP que cruzan la economía con otra materia (historia, matemáticas, geografía…), con su reto, secuencia de sesiones y rúbrica.' },
      debates:          { title: 'Debates',                      cta: 'Ver los debates',      desc: 'Las grandes controversias económicas para argumentar en clase: moción, posturas, argumentario, rúbrica y ficha imprimible.' },
      juegos:           { title: 'Juegos',                       cta: 'Ver los juegos',       desc: 'Stonks, Econrisk, Econopoly, Insider y Cajút: simuladores, estrategia y dinámicas multijugador, todos probados en clase real.' },
      'jocs-economics': { title: 'Juegos Económicos',            cta: 'Ver el concurso',      desc: 'Un concurso competitivo por equipos para repasar economía jugando, con ranking por alumno e instituto.' },
      generadores:      { title: 'Herramientas Docentes',        cta: 'Ver las herramientas', desc: 'Generadores LOMLOE (situaciones de aprendizaje, programación) y herramientas de evaluación y aula: rúbricas, calificaciones y plantillas.' },
    },
    pullquote: 'El material para impartir economía, empresa y finanzas en el instituto, reunido por asignatura en lugar de por tipo de archivo. Ordenado como hace falta cuando entras a clase un lunes a las 8:15.',
    whyIntro: 'Todo lo que verás aquí parte del currículo básico estatal LOMLOE:',
    whyRdBach: 'Real Decreto 243/2022',
    whyParaBach: 'para Bachillerato,',
    whyRdEso: 'Real Decreto 217/2022',
    whyRest: 'para ESO. Cada comunidad autónoma añade su concreción, y conviene revisarla. Aquí no finjo cubrir las diecisiete: cubro la base común, que ya es bastante.',
  },
  ca: {
    pageTitle: "Material per a impartir economia, empresa i finances a l'institut",
    descIntro: "Material editorial per a professorat d'institut.",
    descBody: 'assignatures amb llibre, diapositives, activitats, tests i recursos. Currículum estatal LOMLOE.',
    heroLead: 'Material per a impartir',
    heroAccent: 'economia, empresa i finances',
    heroTail: "a l'institut.",
    lede: 'El material que use cada dia a classe, esta vegada ordenat per assignatura. Cadascuna amb el seu llibre, les seues diapositives, les seues activitats, els seus tests i els seus recursos.',
    metaAsignaturas: 'assignatures',
    metaCurriculo: 'Currículum estatal LOMLOE',
    metaProbado: "Provat a l'aula",
    metaProfes: 'Fet per professorat en actiu',
    subjectsPrefix: 'Les',
    subjectsWord: 'assignatures',
    subjectsNote: "Cadascuna és un producte sencer, amb la mateixa estructura interna. Entres per l'assignatura, no pel tipus de material.",
    transversalTitle: 'Material',
    transversalAccent: 'transversal',
    transversalNote: "El que no encaixa dins d'una assignatura concreta viu ací. Per als dies en què la teoria no sosté la sessió.",
    transversal: {
      dinamicas:        { title: 'Dinàmiques',                    cta: 'Veure les dinàmiques',  desc: "Role-plays, simulacions i jocs d'aula, amb guia per al profe, materials per a imprimir i el seu encaix curricular." },
      herramientas:     { title: 'Ferramentes',                   cta: 'Veure les ferramentes', desc: 'La caixa de ferramentes: calculadores i simuladors interactius —punt mort, ràtios, VAN i TIR, elasticitat, nòmina…— llestos per a classe.' },
      emprendimiento:   { title: 'Emprenedoria',                  cta: 'Veure emprenedoria',    desc: "«De zero a empresa»: l'alumnat crea i valida el seu propi negoci en dotze fases, amb quadern, plantilles i exemples reals." },
      proyectos:        { title: 'Projectes interdisciplinaris',  cta: 'Veure els projectes',   desc: "Projectes ABP que creuen l'economia amb una altra matèria (història, matemàtiques, geografia…), amb el seu repte, seqüència de sessions i rúbrica." },
      debates:          { title: 'Debats',                        cta: 'Veure els debats',      desc: 'Les grans controvèrsies econòmiques per a argumentar a classe: moció, postures, argumentari, rúbrica i fitxa imprimible.' },
      juegos:           { title: 'Jocs',                          cta: 'Veure els jocs',        desc: 'Stonks, Econrisk, Econopoly, Insider i Cajút: simuladors, estratègia i dinàmiques multijugador, tots provats en classe real.' },
      'jocs-economics': { title: 'Jocs Econòmics',                cta: 'Veure el concurs',      desc: 'Un concurs competitiu per equips per a repassar economia jugant, amb rànquing per alumne i institut.' },
      generadores:      { title: 'Ferramentes Docents',           cta: 'Veure les ferramentes', desc: "Generadors LOMLOE (situacions d'aprenentatge, programació) i ferramentes d'avaluació i aula: rúbriques, qualificacions i plantilles." },
    },
    pullquote: "El material per a impartir economia, empresa i finances a l'institut, reunit per assignatura en compte de per tipus d'arxiu. Ordenat com cal quan entres a classe un dilluns a les 8:15.",
    whyIntro: 'Tot el que veuràs ací parteix del currículum bàsic estatal LOMLOE:',
    whyRdBach: 'Reial Decret 243/2022',
    whyParaBach: 'per a Batxillerat,',
    whyRdEso: 'Reial Decret 217/2022',
    whyRest: "per a l'ESO. Cada comunitat autònoma hi afig la seua concreció, i convé revisar-la. Ací no fingisc cobrir les disset: cobrisc la base comuna, que ja és bastant.",
  },
}[locale];
---

<BaseLayout
  title={copy.pageTitle}
  description={`${copy.descIntro} ${NumPalabraCap} ${copy.descBody}`}
  jsonLd={[organizationLd(locale), websiteLd(locale)]}
  contentLang={locale}
>

  <section class="hero">
    <div class="container">
      <h1>
        {copy.heroLead}
        <span class="serif-italic-wonk hero-accent">{copy.heroAccent}</span>
        {copy.heroTail}
      </h1>
      <p class="lede">
        {copy.lede}
      </p>
      <div class="hero-meta">
        <span>{NumPalabraCap} {copy.metaAsignaturas}</span>
        <span>{copy.metaCurriculo}</span>
        <span>{copy.metaProbado}</span>
        <span>{copy.metaProfes}</span>
      </div>
    </div>
  </section>

  <section class="subjects-section">
    <div class="container">
      <div class="subjects-header">
        <h2>
          {copy.subjectsPrefix} {numAsignaturasPalabra} <span class="ornament serif-italic-wonk">{copy.subjectsWord}</span>
        </h2>
        <span class="note">
          {copy.subjectsNote}
        </span>
      </div>

      <div class="subjects-grid">
        {ASIGNATURAS_PUBLICADAS.map((a) => <SubjectCard asignatura={localizeAsignatura(a, locale)} />)}
      </div>
    </div>
  </section>

  <section class="strip">
    <div class="container">
      <div class="subjects-header">
        <h2>
          {copy.transversalTitle} <span class="ornament serif-italic-wonk">{copy.transversalAccent}</span>
        </h2>
        <span class="note">
          {copy.transversalNote}
        </span>
      </div>

      <div class="strip-grid">
        {TRANSVERSAL_META.map((t) => {
          const tc = copy.transversal[t.slug];
          return (
            <div class="strip-item">
              <span class="icon" style={`background: var(${t.color})`}>
                {t.slug === 'jocs-economics' ? (
                  <svg class="icon-rings" viewBox="0 0 30 16" width="26" height="14" fill="none" stroke="var(--color-paper)" stroke-width="1.7" aria-hidden="true">
                    <circle cx="6" cy="6" r="4.2" />
                    <circle cx="15" cy="6" r="4.2" />
                    <circle cx="24" cy="6" r="4.2" />
                    <circle cx="10.5" cy="10" r="4.2" />
                    <circle cx="19.5" cy="10" r="4.2" />
                  </svg>
                ) : <span aria-hidden="true">{t.letra}</span>}
              </span>
              <h3>{tc.title}</h3>
              <p>{tc.desc}</p>
              <a href={`/${t.slug}/`} class="editorial-link">{tc.cta} →</a>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section class="why">
    <div class="container-narrow">
      <p class="pullquote">
        {copy.pullquote}
      </p>
      <p class="why-body">
        {copy.whyIntro}
        <em>{copy.whyRdBach}</em> {copy.whyParaBach}
        <em>{copy.whyRdEso}</em> {copy.whyRest}
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4vw, 3rem);
  }
  .container-narrow {
    max-width: 740px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4vw, 3rem);
  }

  /* ---- HERO ---- */
  .hero {
    padding: clamp(4rem, 9vw, 7rem) 0 clamp(3rem, 6vw, 5rem);
    background:
      radial-gradient(ellipse 60% 50% at 90% 15%, var(--color-mustard-soft) 0%, transparent 60%),
      radial-gradient(ellipse 50% 40% at 5% 90%, var(--color-terra-soft) 0%, transparent 60%),
      var(--color-bg);
    position: relative;
    overflow: hidden;
  }
  .hero h1 {
    max-width: 17ch;
    margin-bottom: 1.4rem;
  }
  .hero-accent { color: var(--color-terra); }
  .lede {
    font-size: clamp(1.25rem, 1.6vw, 1.5rem);
    max-width: 50ch;
    color: var(--color-ink-soft);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    line-height: 1.5;
    font-variation-settings: "SOFT" 80;
    margin: 0;
  }
  .hero-meta {
    margin-top: 2.2rem;
    font-size: 0.95rem;
    color: var(--color-ink-mute);
    line-height: 1.7;
  }
  .hero-meta span:not(:last-child)::after {
    content: " · ";
    color: var(--color-mustard);
  }

  /* ---- SECTIONS ---- */
  .subjects-section,
  .strip,
  .why { padding: clamp(3rem, 7vw, 6rem) 0; }

  .subjects-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .subjects-header h2 { margin: 0; }
  .ornament { color: var(--color-mustard-deep); }
  .note {
    font-size: 1rem;
    color: var(--color-ink-soft);
    font-family: var(--font-serif);
    font-style: italic;
    max-width: 40ch;
    font-variation-settings: "SOFT" 80;
  }

  .subjects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  /* ---- STRIP ---- */
  .strip {
    background: var(--color-bg-soft);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  .strip-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2.5rem;
  }
  .strip-item {
    padding: 1.5rem;
    background: var(--color-paper);
    border-radius: 6px;
    border: 1px solid var(--color-line);
  }
  .strip-item .icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-paper);
    margin-bottom: 1rem;
    font-variation-settings: "SOFT" 100, "WONK" 1;
  }
  .icon-1 { background: var(--color-terra); }
  .icon-2 { background: var(--color-eco1); }
  .icon-3 { background: var(--color-mustard); }

  .strip-item h3 { margin: 0 0 0.5rem; font-size: 1.3rem; }
  .strip-item p {
    color: var(--color-ink-soft);
    font-size: 1rem;
    margin: 0 0 0.8rem;
    line-height: 1.6;
  }

  /* ---- WHY ---- */
  .pullquote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.6rem;
    line-height: 1.45;
    color: var(--color-ink-soft);
    border-top: 2px solid var(--color-terra);
    border-bottom: 2px solid var(--color-terra);
    padding: 1.5rem 0;
    margin: 1.5rem 0 2rem;
    font-variation-settings: "SOFT" 80;
  }
  .why-body {
    color: var(--color-ink-soft);
    font-size: 1.1rem;
    line-height: 1.65;
  }
</style>
