---
/**
 * Herramientas hub. The toolbox: existing calculator/simulator islands grouped
 * by family (FAMILIAS_HERRAMIENTA order), each card linking to its detail page.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { gruposHerramientas, FAMILIAS_HERRAMIENTA } from '@/lib/herramientas';
import { getLocale } from '@/i18n/locale';
import { t } from '@/i18n/ui';
import { localizeHerramienta } from '@/i18n/herramientas-ca';
import { localizeFamilias, FAMILIAS_HERRAMIENTA_CA } from '@/i18n/familias-ca';

const locale = getLocale(Astro.currentLocale);

// Real captures of each tool's UI (scripts/build-screenshots.mjs), keyed by the
// ES familia/slug — the CA overlay never renames routes, so both locales share
// the same preview.
const THUMBS = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/screenshots/herramientas/**/*.webp',
  { eager: true },
);
const thumbDe = (familia: string, slug: string): ImageMetadata | undefined =>
  THUMBS[`/src/assets/screenshots/herramientas/${familia}/${slug}.webp`]?.default;

const groups = gruposHerramientas();
const activeFamilias = new Set(groups.map((g) => g.familia.slug));

// Family headers and filter chips read from the localized list; the grouping
// itself stays keyed by the ES registry slugs.
const familias = localizeFamilias(FAMILIAS_HERRAMIENTA, FAMILIAS_HERRAMIENTA_CA, locale);
const familiaPorSlug = new Map(familias.map((f) => [f.slug, f]));

const TIPO_LABEL: Record<string, string> = {
  calculadora: t('tipo.calculadora', locale),
  simulador: t('tipo.simulador', locale),
  test: t('tipo.test', locale),
  generador: t('tipo.generador', locale),
  buscador: t('tipo.buscador', locale),
  plantilla: t('tipo.plantilla', locale),
};

const copy = {
  es: {
    metaTitle: 'Herramientas',
    metaDesc:
      'Calculadoras y simuladores para usar en clase: punto muerto, ratios, VAN/TIR, elasticidad, nómina, IRPF y más, con su encaje curricular.',
    heroAccent: 'Herramientas',
    heroTail: 'para usar en clase.',
    lede: 'La caja de herramientas del web: calculadoras y simuladores interactivos —punto muerto, ratios, VAN y TIR, elasticidad, nómina…— agrupados por tema y con el mapa de en qué unidades de qué asignaturas encajan.',
    bcInicio: 'Inicio',
    bcCurrent: 'Herramientas',
  },
  ca: {
    metaTitle: 'Ferramentes',
    metaDesc:
      "Calculadores i simuladors per a usar a classe: punt mort, ràtios, VAN/TIR, elasticitat, nòmina, IRPF i més, amb el seu encaix curricular.",
    heroAccent: 'Ferramentes',
    heroTail: 'per a usar a classe.',
    lede: "La caixa de ferramentes del web: calculadores i simuladors interactius —punt mort, ràtios, VAN i TIR, elasticitat, nòmina…— agrupats per tema i amb el mapa d'en quines unitats de quines assignatures encaixen.",
    bcInicio: 'Inici',
    bcCurrent: 'Ferramentes',
  },
}[locale];
---

<BaseLayout
  title={copy.metaTitle}
  description={copy.metaDesc}
  contentLang={locale}
>
  <div class="container">
    <nav class="breadcrumb"><a href="/">{copy.bcInicio}</a> <span class="sep">›</span> <span>{copy.bcCurrent}</span></nav>
  </div>

  <section class="hero">
    <div class="container">
      <h1><span class="serif-italic-wonk accent">{copy.heroAccent}</span> {copy.heroTail}</h1>
      <p class="lede">
        {copy.lede}
      </p>
    </div>
  </section>

  <section class="filters">
    <div class="container">
      <button class="chip is-active" data-filter="all" type="button">{t('filtro.todas', locale)}</button>
      {familias.filter((f) => activeFamilias.has(f.slug)).map((f) => (
        <button class="chip" data-filter={f.slug} type="button"
          style={`--chip-color: var(${f.colorVar})`}>{f.label}</button>
      ))}
    </div>
  </section>

  {groups.map((g) => {
    const familia = familiaPorSlug.get(g.familia.slug) ?? g.familia;
    return (
      <section class="familia" data-familia={familia.slug}>
        <div class="container">
          <div class="familia__head" style={`--fam-color: var(${familia.colorVar})`}>
            <h2>{familia.label}</h2>
            <p>{familia.intro}</p>
          </div>
          <div class="card-grid">
            {g.items.map(({ h: raw }) => {
              const h = localizeHerramienta(raw, locale);
              const th = thumbDe(raw.familia, raw.slug);
              return (
                <a class="card" href={`/herramientas/${h.familia}/${h.slug}/`} style={`--fam-color: var(${familia.colorVar}); --fam-ink: var(${familia.colorVar}-ink)`}>
                  {th && <Image class="card__thumb" src={th} alt="" widths={[320, 640]} sizes="(min-width: 720px) 320px, 90vw" />}
                  <span class="card__eyebrow">{TIPO_LABEL[h.tipo] ?? h.tipo}</span>
                  <h3 class="card__title serif">{h.title}</h3>
                  <p class="card__desc">{h.descripcion}</p>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    );
  })}
</BaseLayout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const sections = document.querySelectorAll<HTMLElement>('.familia');
  chips.forEach((chip) => chip.addEventListener('click', () => {
    chips.forEach((c) => c.classList.remove('is-active'));
    chip.classList.add('is-active');
    const f = chip.dataset.filter;
    sections.forEach((s) => { s.hidden = f !== 'all' && s.dataset.familia !== f; });
  }));
</script>

<style>
  .container { max-width: 1240px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem); }
  .breadcrumb { font-size: 0.92rem; color: var(--color-ink-mute); margin: 2rem 0; }
  .breadcrumb a { color: var(--color-ink-mute); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-terra); }
  .breadcrumb .sep { margin: 0 0.5em; color: var(--color-mustard); }
  .hero { padding: 1rem 0 2rem; }
  .kicker { font-family: var(--font-sans); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-terra-deep); }
  .accent { color: var(--color-terra); }
  h1 { margin: 0.6rem 0 0.8rem; }
  .lede { font-size: 1.2rem; color: var(--color-ink-soft); line-height: 1.55; max-width: 60ch; }
  .filters .container { display: flex; flex-wrap: wrap; gap: 0.5rem; padding-top: 1rem; padding-bottom: 1.5rem; }
  .chip { font-family: var(--font-sans); font-size: 0.85rem; font-weight: 600; color: var(--color-ink-soft); background: transparent; border: 1.5px solid var(--color-line); border-radius: 999px; padding: 0.4rem 0.9rem; cursor: pointer; transition: all .15s ease; }
  .chip:hover { border-color: var(--chip-color, var(--color-terra)); color: var(--chip-color, var(--color-terra)); }
  .chip.is-active { background: var(--chip-color, var(--color-ink)); border-color: var(--chip-color, var(--color-ink)); color: var(--color-paper); }
  .familia { padding: 1.5rem 0; }
  .familia__head { border-left: 4px solid var(--fam-color); padding-left: 1rem; margin-bottom: 1.5rem; }
  .familia__head h2 { font-family: var(--font-serif); font-size: 1.7rem; font-weight: 500; margin: 0; }
  .familia__head p { color: var(--color-ink-soft); margin: 0.3rem 0 0; }
  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(290px, 100%), 1fr)); gap: 1.2rem; }
  .card { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.4rem; background: var(--color-paper); border: 1px solid var(--color-line); border-top: 4px solid var(--fam-color); border-radius: 10px; text-decoration: none; transition: transform .15s ease, box-shadow .15s ease; }
  .card:hover { transform: translateY(-3px); box-shadow: 0 8px 28px rgba(42, 31, 24, 0.1); }
  .card__thumb { display: block; width: calc(100% + 2.8rem); height: auto; margin: -1.4rem -1.4rem 0.35rem; border-radius: 6px 6px 0 0; border-bottom: 1px solid var(--color-line); }
  .card__eyebrow { font-family: var(--font-sans); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fam-ink); }
  .card__title { font-size: 1.3rem; color: var(--color-ink); margin: 0; }
  .card__desc { color: var(--color-ink-soft); font-size: 0.95rem; line-height: 1.5; margin: 0; flex: 1; }
</style>
