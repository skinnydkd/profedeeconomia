---
/**
 * A single tool. Routed by `[familia]/[slug]` (two single-segment params). Renders
 * the interactive island (via HerramientaIsland), the curriculum map (units derived
 * from the recursos that embed this componente) and the competences.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import HerramientaIsland from '@components/calculadoras/HerramientaIsland.astro';
import PuenteUnidades from '@components/emprendimiento/PuenteUnidades.astro';
import { HERRAMIENTAS, herramientaPorSlug, unidadesPorComponente, recursoCanonicoPorComponente, FAMILIAS_HERRAMIENTA } from '@/lib/herramientas';
import { breadcrumbLd } from '@/lib/seo';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { getLocale } from '@/i18n/locale';
import { t } from '@/i18n/ui';
import { localizeHerramienta } from '@/i18n/herramientas-ca';
import { localizeFamilias, FAMILIAS_HERRAMIENTA_CA } from '@/i18n/familias-ca';

export const getStaticPaths = (async () => {
  return HERRAMIENTAS.map((h) => ({
    params: { familia: h.familia, slug: h.slug },
    props: { componente: h.componente, familia: h.familia, slug: h.slug },
  }));
}) satisfies GetStaticPaths;

const locale = getLocale(Astro.currentLocale);
const { componente, familia, slug } = Astro.props;
const h = localizeHerramienta(herramientaPorSlug(familia, slug)!, locale);
const famMeta = localizeFamilias(FAMILIAS_HERRAMIENTA, FAMILIAS_HERRAMIENTA_CA, locale)
  .find((f) => f.slug === familia)!;

const copy = {
  es: { bcInicio: 'Inicio', bcHerramientas: 'Herramientas', metaSuffix: 'Herramientas' },
  ca: { bcInicio: 'Inici', bcHerramientas: 'Ferramentes', metaSuffix: 'Ferramentes' },
}[locale];

const recursos = await getCollection('recursos');
const publicados = recursos.filter((r) => r.data.estado === 'publicado' && r.data.lang === 'es');
const derivadas = unidadesPorComponente(publicados).get(componente) ?? [];
// Consolidate onto the subject twin when there is exactly one — see
// recursoCanonicoPorComponente. The page stays browsable; it just stops
// competing with its own duplicate in search.
const canonicalPath = recursoCanonicoPorComponente(publicados).get(componente);
const unidades = h.unidades_relacionadas ?? derivadas;
const breadcrumb = breadcrumbLd([
  { name: copy.bcInicio, path: '/' },
  { name: copy.bcHerramientas, path: '/herramientas/' },
  { name: h.title, path: `/herramientas/${familia}/${slug}/` },
]);
---

<BaseLayout title={`${h.title} — ${copy.metaSuffix}`} description={h.descripcion} ogType="article" jsonLd={breadcrumb} contentLang={locale} canonicalPath={canonicalPath}>
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">{copy.bcInicio}</a> <span class="sep">›</span>
      <a href="/herramientas/">{copy.bcHerramientas}</a> <span class="sep">›</span>
      <span>{h.title}</span>
    </nav>
  </div>

  <section class="body">
    <div class="container container--narrow">
      <h1 style={`color: var(${famMeta.colorVar}-ink)`}>{h.title}</h1>
      <p class="lede">{h.descripcion}</p>
    </div>
  </section>

  <section class="player-wrap">
    <div class="container container--narrow">
      <HerramientaIsland componente={componente} locale={locale} />
    </div>
  </section>

  <section class="body">
    <div class="container container--narrow">
      <PuenteUnidades unidades={unidades} />

      {h.competencias_clave.length > 0 && (
        <section class="block">
          <h2>{t('herramienta.competencias', locale)}</h2>
          <p><strong>{t('herramienta.clave', locale)}:</strong> {h.competencias_clave.join(' · ')}</p>
          {h.competencias_especificas.length > 0 && (
            <p><strong>{t('herramienta.especificas', locale)}:</strong> {h.competencias_especificas.join(' · ')}</p>
          )}
        </section>
      )}

      <nav class="back"><a href="/herramientas/">{t('herramienta.volver', locale)}</a></nav>
    </div>
  </section>
</BaseLayout>

<style>
  .container { max-width: 1240px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem); }
  .container--narrow { max-width: 820px; }
  .breadcrumb { font-size: 0.92rem; color: var(--color-ink-mute); margin: 2rem 0; }
  .breadcrumb a { color: var(--color-ink-mute); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-terra); }
  .breadcrumb .sep { margin: 0 0.5em; color: var(--color-mustard); }
  .body { padding: 1rem 0; }
  .kicker { font-family: var(--font-sans); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  h1 { margin: 0.6rem 0 0.4rem; max-width: 24ch; }
  .lede { font-size: 1.2rem; color: var(--color-ink-soft); line-height: 1.5; margin: 0 0 0.5rem; }
  .player-wrap { padding: clamp(1rem, 3vw, 2rem) 0 clamp(1.5rem, 4vw, 2.5rem); }
  .block { margin: 1.6rem 0; }
  .block h2 { font-family: var(--font-serif); font-size: 1.4rem; font-weight: 500; margin: 0 0 0.5rem; }
  .back { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--color-line); font-family: var(--font-sans); }
  .back a { color: var(--color-terra); text-decoration: none; font-weight: 500; }
  .back a:hover { text-decoration: underline; }
</style>
