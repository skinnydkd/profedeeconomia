---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeader from '@components/SectionHeader.astro';
import { getLocale } from '@/i18n/locale';
import { SITE } from '@/lib/seo';

const locale = getLocale(Astro.currentLocale);

const copy = {
  es: {
    inicio: 'Inicio',
    pageTitle: 'Contacto',
    description: 'Cómo contactar con profedeeconomia.es: erratas, propuestas de material y colaboración del profesorado de economía.',
    h1: 'Escríbeme',
    lede: '¿Una errata, una propuesta de actividad, una duda sobre el material o ganas de colaborar? Me interesa lo que veis en el aula.',
    correoLabel: 'Correo',
    instagramLabel: 'Instagram',
    p: 'Si me escribes para señalar un error en el contenido, indícame la asignatura y la unidad: así lo corrijo antes. El material es abierto (licencia Creative Commons BY-NC-SA); puedes usarlo y adaptarlo en tus clases citando la fuente.',
  },
  ca: {
    inicio: 'Inici',
    pageTitle: 'Contacte',
    description: "Com contactar amb profedeeconomia.es: errades, propostes de material i col·laboració del professorat d'economia.",
    h1: 'Escriu-me',
    lede: 'Una errada, una proposta d\'activitat, un dubte sobre el material o ganes de col·laborar? M\'interessa el que veieu a l\'aula.',
    correoLabel: 'Correu',
    instagramLabel: 'Instagram',
    p: "Si m'escrius per a assenyalar un error en el contingut, indica'm l'assignatura i la unitat: així el corregisc abans. El material és obert (llicència Creative Commons BY-NC-SA); pots usar-lo i adaptar-lo a les teues classes citant la font.",
  },
}[locale];
---
<BaseLayout
  title={copy.pageTitle}
  description={copy.description}
  contentLang={locale}
>
  <SectionHeader
    locale={locale}
    crumbs={[
      { name: copy.inicio, path: '/' },
      { name: copy.pageTitle },
    ]}
  >
    <Fragment slot="title">{copy.h1}</Fragment>
    <Fragment slot="lede">{copy.lede}</Fragment>
  </SectionHeader>

  <div class="container">
    <div class="prose">
      <ul class="contact-list">
        <li>
          <span class="contact-list__k">{copy.correoLabel}</span>
          <a class="editorial-link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </li>
        <li>
          <span class="contact-list__k">{copy.instagramLabel}</span>
          <a class="editorial-link" href="https://instagram.com/profedeeconomia" rel="external">@profedeeconomia</a>
        </li>
      </ul>

      <p>
        {copy.p}
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .container { max-width: 1240px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem); }
  /* Same left edge as the header; the text keeps its reading measure. */
  .prose { max-width: 62ch; padding-bottom: 5rem; }
  .prose > h2:first-child { margin-top: 0; }
  .contact-list { list-style: none; padding: 0; margin: 0 0 2.5rem; display: flex; flex-direction: column; gap: 1rem; }
  .contact-list li { display: flex; flex-direction: column; gap: 0.2rem; padding-left: 0; }
  .contact-list__k { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-ink-mute); }
  .contact-list a { font-size: 1.2rem; }
  p { font-size: 1.12rem; line-height: 1.7; color: var(--color-ink-soft); }
</style>
