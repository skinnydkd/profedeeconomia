---
/**
 * Debates hub. Lists published debates grouped by family (FAMILIAS_DEBATE order),
 * each card linking to its detail page, with a client-side family filter.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { groupByFamilia, FAMILIAS_DEBATE } from '@/lib/debates';
import { getCollection } from 'astro:content';
import { getLocale } from '@/i18n/locale';
import { t } from '@/i18n/ui';
import { localizeFamilias, FAMILIAS_DEBATE_CA } from '@/i18n/familias-ca';
import { localizeFicha, DEBATES_CA } from '@/i18n/fichas-ca';

const locale = getLocale(Astro.currentLocale);
const familias = localizeFamilias(FAMILIAS_DEBATE, FAMILIAS_DEBATE_CA, locale);

// The card fields (title, descripcion, duracion, agrupacion) are overlaid from
// fichas-ca.ts; the MDX bodies behind each card stay ES until the content phase.
const copy = {
  es: {
    metaTitle: 'Debates',
    metaDesc:
      'Controversias económicas para argumentar en clase: moción, posturas, argumentario, mecánica de turnos y rúbrica, con su encaje curricular.',
    bcInicio: 'Inicio',
    bcCurrent: 'Debates',
    heroAccent: 'Debates',
    heroTail: 'para argumentar en clase.',
    lede: 'Las grandes controversias económicas, listas para llevar al aula: la moción, las posturas enfrentadas, el argumentario por bando, la mecánica de turnos y una rúbrica de evaluación. Cada uno con su encaje curricular.',
  },
  ca: {
    metaTitle: 'Debats',
    metaDesc:
      "Controvèrsies econòmiques per a argumentar a classe: moció, postures, argumentari, mecànica de torns i rúbrica, amb el seu encaix curricular.",
    bcInicio: 'Inici',
    bcCurrent: 'Debats',
    heroAccent: 'Debats',
    heroTail: 'per a argumentar a classe.',
    lede: "Les grans controvèrsies econòmiques, llestes per a portar a l'aula: la moció, les postures enfrontades, l'argumentari per bàndol, la mecànica de torns i una rúbrica d'avaluació. Cada un amb el seu encaix curricular.",
  },
}[locale];

const all = (await getCollection('debates')).filter((e) => e.data.estado === 'publicado' && e.data.lang === 'es');
// entry.id from glob loader is "debates/familia/nn-slug"; strip the prefix so
// slugs resolve to "familia/nn-slug" and hrefs are /debates/familia/nn-slug/
const groups = groupByFamilia(familias, all.map((e) => ({
  slug: e.id.replace(/^debates\//, ''),
  data: e.data,
})));
const activeFamilias = new Set(groups.map((g) => g.familia.slug));
---

<BaseLayout
  title={copy.metaTitle}
  description={copy.metaDesc}
  contentLang={locale}
>
  <div class="container">
    <nav class="breadcrumb"><a href="/">{copy.bcInicio}</a> <span class="sep">›</span> <span>{copy.bcCurrent}</span></nav>
  </div>

  <section class="hero">
    <div class="container">
      <h1><span class="serif-italic-wonk accent">{copy.heroAccent}</span> {copy.heroTail}</h1>
      <p class="lede">
        {copy.lede}
      </p>
    </div>
  </section>

  <section class="filters">
    <div class="container">
      <button class="chip is-active" data-filter="all" type="button">{t('filtro.todos', locale)}</button>
      {familias.filter((f) => activeFamilias.has(f.slug)).map((f) => (
        <button class="chip" data-filter={f.slug} type="button"
          style={`--chip-color: var(${f.colorVar})`}>{f.label}</button>
      ))}
    </div>
  </section>

  {groups.map((g) => (
    <section class="familia" data-familia={g.familia.slug}>
      <div class="container">
        <div class="familia__head" style={`--fam-color: var(${g.familia.colorVar}); --fam-ink: var(${g.familia.colorVar}-ink)`}>
          <h2>{g.familia.label}</h2>
          <p>{g.familia.intro}</p>
        </div>
        <div class="card-grid">
          {g.items.map((d) => {
            const data = localizeFicha(d.data, d.slug, DEBATES_CA, locale);
            return (
              <a class="card" href={`/debates/${d.slug}/`} style={`--fam-color: var(${g.familia.colorVar}); --fam-ink: var(${g.familia.colorVar}-ink)`}>
                <span class="card__eyebrow">{g.familia.label}</span>
                <h3 class="card__title serif">{data.title}</h3>
                <p class="card__desc">{data.descripcion}</p>
                <span class="card__meta">{data.duracion} · {data.agrupacion}</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  ))}
</BaseLayout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const sections = document.querySelectorAll<HTMLElement>('.familia');
  chips.forEach((chip) => chip.addEventListener('click', () => {
    chips.forEach((c) => c.classList.remove('is-active'));
    chip.classList.add('is-active');
    const f = chip.dataset.filter;
    sections.forEach((s) => { s.hidden = f !== 'all' && s.dataset.familia !== f; });
  }));
</script>

<style>
  .container { max-width: 1240px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem); }
  .breadcrumb { font-size: 0.92rem; color: var(--color-ink-mute); margin: 2rem 0; }
  .breadcrumb a { color: var(--color-ink-mute); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-terra); }
  .breadcrumb .sep { margin: 0 0.5em; color: var(--color-mustard); }
  .hero { padding: 1rem 0 2rem; }
  .accent { color: var(--color-terra); }
  h1 { margin: 0.6rem 0 0.8rem; }
  .lede { font-size: 1.2rem; color: var(--color-ink-soft); line-height: 1.55; max-width: 60ch; }
  .filters .container { display: flex; flex-wrap: wrap; gap: 0.5rem; padding-top: 1rem; padding-bottom: 1.5rem; }
  .chip { font-family: var(--font-sans); font-size: 0.85rem; font-weight: 600; color: var(--color-ink-soft); background: transparent; border: 1.5px solid var(--color-line); border-radius: 999px; padding: 0.4rem 0.9rem; cursor: pointer; transition: all .15s ease; }
  .chip:hover { border-color: var(--chip-color, var(--color-terra)); color: var(--chip-color, var(--color-terra)); }
  .chip.is-active { background: var(--chip-color, var(--color-ink)); border-color: var(--chip-color, var(--color-ink)); color: var(--color-paper); }
  .familia { padding: 1.5rem 0; }
  .familia__head { margin-bottom: 1.5rem; }
  .familia__head h2 { font-family: var(--font-serif); font-size: 1.7rem; font-weight: 500; margin: 0; color: var(--fam-ink); }
  .familia__head p { color: var(--color-ink-soft); margin: 0.3rem 0 0; }
  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 1.2rem; }
  .card { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.4rem; background: var(--color-paper); border: 1px solid var(--color-line); border-radius: 10px; text-decoration: none; transition: transform .15s ease, box-shadow .15s ease; }
  .card:hover { transform: translateY(-3px); box-shadow: 0 8px 28px rgba(42, 31, 24, 0.1); }
  .card__eyebrow { font-family: var(--font-sans); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fam-ink); }
  .card__title { font-size: 1.3rem; color: var(--color-ink); margin: 0; }
  .card__desc { color: var(--color-ink-soft); font-size: 0.95rem; line-height: 1.5; margin: 0; flex: 1; }
  .card__meta { font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-ink-mute); margin-top: 0.3rem; }
</style>
