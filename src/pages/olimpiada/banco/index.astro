---
/**
 * Banco de preguntas interactivo por bloque temático.
 * Builds `porBloque` from BANCO data and passes it to the BancoIsland Preact island.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { BLOQUES } from '@/lib/olimpiada';
import { preguntasDeBloque } from '@/lib/olimpiada/banco';
import BancoIsland from '@components/olimpiada/BancoIsland.tsx';
import type { Pregunta } from '@components/QuizPlayer.tsx';
import type { PreguntaBanco } from '@/lib/olimpiada/banco';
import { getLocale } from '@/i18n/locale';
import { localizeFamilias, BLOQUES_OLIMPIADA_CA } from '@/i18n/familias-ca';
import SectionHeader from '@components/SectionHeader.astro';

// Build the porBloque record — each block maps its questions to QuizPlayer's Pregunta shape.
const porBloque: Record<string, Pregunta[]> = {};
for (const b of BLOQUES) {
  porBloque[b.slug] = preguntasDeBloque(b.slug).map((p: PreguntaBanco) => ({
    tipo: 'opcion-multiple' as const,
    enunciado: p.enunciado,
    opciones: p.opciones,
    correcta: p.correcta,
    explicacion: p.explicacion,
  }));
}

const locale = getLocale(Astro.currentLocale);

// Only the block labels are localized; the questions themselves stay ES.
const bloqueTabs = localizeFamilias(BLOQUES, BLOQUES_OLIMPIADA_CA, locale)
  .map((b) => ({ slug: b.slug, label: b.label }));

// The hero intro and breadcrumb are localized — the BancoIsland quiz (bloque
// labels, questions) comes from the olimpiada registry and stays in Spanish under /ca.
const copy = {
  es: {
    heroTitle: 'Banco de preguntas',
    lede: 'Selecciona un bloque temático y practica con preguntas tipo test. Cada pregunta tiene feedback explicativo para consolidar la teoría.',
    bcInicio: 'Inicio',
    bcOlimpiada: 'Olimpiada',
    bcCurrent: 'Banco de preguntas',
  },
  ca: {
    heroTitle: 'Banc de preguntes',
    lede: 'Selecciona un bloc temàtic i practica amb preguntes tipus test. Cada pregunta té feedback explicatiu per a consolidar la teoria.',
    bcInicio: 'Inici',
    bcOlimpiada: 'Olimpíada',
    bcCurrent: 'Banc de preguntes',
  },
}[locale];
---

<BaseLayout
  title="Banco de preguntas — Olimpiada de Economía"
  description="Test interactivo por bloques temáticos para la Olimpiada de Economía. Selecciona un bloque y practica con feedback inmediato."
  contentLang="es"
  translated={false}
>
  <SectionHeader
    locale={locale}
    kicker={copy.bcOlimpiada}
    lang={locale}
    crumbs={[
      { name: copy.bcInicio, path: '/' },
      { name: copy.bcOlimpiada, path: '/olimpiada/' },
      { name: copy.bcCurrent },
    ]}
  >
    <Fragment slot="title">{copy.heroTitle}</Fragment>
    <Fragment slot="lede">{copy.lede}</Fragment>
  </SectionHeader>

  <section class="banco-section">
    <div class="container container--narrow">
      <BancoIsland client:load porBloque={porBloque} bloques={bloqueTabs} />
    </div>
  </section>

  <div class="container back-link">
    <a href="/olimpiada/">← Olimpiada de Economía</a>
  </div>
</BaseLayout>

<style>
  .container { max-width: 1240px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem); }
  .container--narrow { max-width: 820px; }


  .banco-section { padding: 0 0 3rem; }

  .back-link { padding: 0 0 3rem; }
  .back-link a { font-family: var(--font-sans); font-size: 0.95rem; font-weight: 500; color: var(--color-terra-ink); text-decoration: none; }
  .back-link a:hover { text-decoration: underline; }
</style>
