---
/**
 * Single texto detail for the taller de textos.
 * Route param: slug = entry id stripped of "olimpiada/textos/" prefix.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { getLocale } from '@/i18n/locale';
import { pickLocalizedEntry } from '@/i18n/content-locale';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import SectionHeader from '@components/SectionHeader.astro';

export const getStaticPaths = (async () => {
  // ES entries define the canonical routes; CA siblings (lang: ca) must NOT
  // create their own routes.
  const all = (await getCollection('olimpiadaTextos')).filter(
    (e) => e.data.estado === 'publicado' && e.data.lang === 'es',
  );
  return all.map((entry) => ({
    params: {
      slug: entry.id.replace(/^olimpiada\/textos\//, '').replace(/\.(md|mdx)$/, ''),
    },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const caById = new Map(
  (await getCollection('olimpiadaTextos'))
    .filter((e) => e.data.estado === 'publicado' && e.data.lang === 'ca')
    .map((e) => [e.id, e]),
);
const view = pickLocalizedEntry(entry, caById, locale);
const d = view.data;
const { Content } = await render(view);
const copy = {
  es: { taller: 'Taller de textos', inicio: 'Inicio', olimpiada: 'Olimpiada', volver: '← Todos los textos' },
  ca: { taller: 'Taller de textos', inicio: 'Inici', olimpiada: 'Olimpíada', volver: '← Tots els textos' },
}[locale];
---

<BaseLayout title={`${d.title} — ${copy.taller}`} description={d.descripcion} contentLang={view.data.lang} translated={caById.has(`${entry.id}.ca`)}>
  <SectionHeader
    locale={locale}
    tight
    kicker={copy.taller}
    crumbs={[
      { name: copy.inicio, path: '/' },
      { name: copy.olimpiada, path: '/olimpiada/' },
      { name: copy.taller, path: '/olimpiada/textos/' },
      { name: d.title },
    ]}
  >
    <Fragment slot="title">{d.title}</Fragment>
    <Fragment slot="lede">{d.descripcion}</Fragment>
    <p class="source">{d.fuente} <span class="sep-mid">·</span> {d.fecha}</p>
  </SectionHeader>

  <section class="body">
    <div class="container container--narrow">
      <article class="prose">
        <Content />
      </article>

      <nav class="back"><a href="/olimpiada/textos/">{copy.volver}</a></nav>
    </div>
  </section>
</BaseLayout>

<style>
  .container { max-width: 1240px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem); }
  .container--narrow { max-width: 820px; }

  .body { padding: 1rem 0 clamp(3rem, 7vw, 6rem); }
  .source { font-family: var(--font-mono); font-size: 0.85rem; color: var(--color-ink-mute); margin: 0 0 0.6rem; }
  .sep-mid { margin: 0 0.4em; color: var(--color-mustard); }

  .prose { font-size: 1.05rem; line-height: 1.7; color: var(--color-ink); }
  .prose :global(h2) { font-family: var(--font-serif); font-size: 1.6rem; margin: 2.2em 0 0.7em; position: relative; padding-top: 1em; font-weight: 500; }
  .prose :global(h3) { font-family: var(--font-serif); font-size: 1.25rem; margin: 1.6em 0 0.5em; font-weight: 500; }
  .prose :global(p) { margin: 0 0 1em; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.4rem; margin: 0 0 1em; }
  .prose :global(ul li::marker) { color: var(--color-mustard); }
  .prose :global(blockquote) {
    border-left: 4px solid var(--color-line); margin: 1.5em 0;
    padding: 0.4em 1em; color: var(--color-ink-soft); font-style: italic;
  }

  .back { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-line); font-family: var(--font-sans); }
  .back a { color: var(--color-terra); text-decoration: none; font-weight: 500; }
  .back a:hover { text-decoration: underline; }
</style>
