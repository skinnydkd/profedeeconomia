---
/**
 * Hub page for the «Olimpiada de Economía» prep section.
 * Renders the exam guide (GUIA) and a card grid to the 5 sub-areas.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { GUIA } from '@/lib/olimpiada';
import { getLocale } from '@/i18n/locale';
import { localizeGuia } from '@/i18n/olimpiada-ca';

const locale = getLocale(Astro.currentLocale);

// The sub-area cards come from a literal list, not a registry, so their copy
// lives inline here alongside the page chrome; hrefs and colors are structural.
const copy = {
  es: {
    metaTitle: 'Olimpiada de Economía — Preparación',
    metaDesc:
      'Prepara la Olimpiada de Economía: simulacros de examen, fichas-resumen de los 6 bloques, banco de preguntas interactivo, taller de textos y lecturas. Nivel 2.º Bach / 1.º carrera.',
    heroAccent: 'Olimpiada',
    heroTail: 'de Economía.',
    lede: 'Material para preparar la Olimpiada de Economía de Bachillerato: los 6 bloques del temario, simulacros de exámenes reales, banco de preguntas interactivo y taller para la Parte III. Nivel 2.º Bach y primer curso de carrera.',
    bcInicio: 'Inicio',
    bcCurrent: 'Olimpiada de Economía',
    eyebrow: 'Olimpiada',
    tituloExamen: 'Cómo es el examen',
    tituloRecursos: 'Recursos de preparación',
    guiaDuracion: 'Duración',
    guiaTotal: 'Total',
    subAreas: {
      simulacros: {
        title: 'Simulacros',
        desc: 'Exámenes oficiales recientes de la fase nacional y de varias comunidades autónomas, más un megaexamen de práctica. Entrena en condiciones reales.',
      },
      fichas: {
        title: 'Fichas-resumen',
        desc: 'Los 6 bloques temáticos sintetizados: conceptos clave, gráficos canónicos y ejercicios tipo Olimpiada.',
      },
      banco: {
        title: 'Banco de preguntas',
        desc: 'Test interactivo por bloques. Elige un tema y practica tipo test con feedback inmediato.',
      },
      textos: {
        title: 'Taller de textos',
        desc: 'Textos de prensa económica con preguntas guiadas. Prepara la Parte III del examen.',
      },
      lecturas: {
        title: 'Lecturas recomendadas',
        desc: 'Bibliografía seleccionada para ir más allá del temario: economía conductual, teoría de juegos, finanzas y empresa.',
      },
    },
  },
  ca: {
    metaTitle: "Olimpíada d'Economia — Preparació",
    metaDesc:
      "Prepara l'Olimpíada d'Economia: simulacres d'examen, fitxes-resum dels 6 blocs, banc de preguntes interactiu, taller de textos i lectures. Nivell 2n Batx / 1r carrera.",
    heroAccent: 'Olimpíada',
    heroTail: "d'Economia.",
    lede: "Material per a preparar l'Olimpíada d'Economia de Batxillerat: els 6 blocs del temari, simulacres d'exàmens reals, banc de preguntes interactiu i taller per a la Part III. Nivell 2n Batx i primer curs de carrera.",
    bcInicio: 'Inici',
    bcCurrent: "Olimpíada d'Economia",
    eyebrow: 'Olimpíada',
    tituloExamen: "Com és l'examen",
    tituloRecursos: 'Recursos de preparació',
    guiaDuracion: 'Duració',
    guiaTotal: 'Total',
    subAreas: {
      simulacros: {
        title: 'Simulacres',
        desc: "Exàmens oficials recents de la fase nacional i de diverses comunitats autònomes, més un megaexamen de pràctica. Entrena en condicions reals.",
      },
      fichas: {
        title: 'Fitxes-resum',
        desc: 'Els 6 blocs temàtics sintetitzats: conceptes clau, gràfics canònics i exercicis tipus Olimpíada.',
      },
      banco: {
        title: 'Banc de preguntes',
        desc: 'Test interactiu per blocs. Tria un tema i practica tipus test amb retroacció immediata.',
      },
      textos: {
        title: 'Taller de textos',
        desc: 'Textos de premsa econòmica amb preguntes guiades. Prepara la Part III de l\'examen.',
      },
      lecturas: {
        title: 'Lectures recomanades',
        desc: 'Bibliografia seleccionada per a anar més enllà del temari: economia conductual, teoria de jocs, finances i empresa.',
      },
    },
  },
}[locale];

const guia = localizeGuia(GUIA, locale);

const subAreas = [
  { key: 'simulacros', href: '/olimpiada/simulacros/', color: '--color-edmn' },
  { key: 'fichas', href: '/olimpiada/fichas/', color: '--color-eco1' },
  { key: 'banco', href: '/olimpiada/banco/', color: '--color-taller3' },
  { key: 'textos', href: '/olimpiada/textos/', color: '--color-ipe2' },
  { key: 'lecturas', href: '/olimpiada/lecturas/', color: '--color-fopp' },
] as const;
---

<BaseLayout
  title={copy.metaTitle}
  description={copy.metaDesc}
  contentLang={locale}
>
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">{copy.bcInicio}</a> <span class="sep">›</span>
      <span>{copy.bcCurrent}</span>
    </nav>
  </div>

  <section class="hero">
    <div class="container">
      <h1><span class="serif-italic-wonk accent">{copy.heroAccent}</span> {copy.heroTail}</h1>
      <p class="lede">
        {copy.lede}
      </p>
    </div>
  </section>

  <section class="guia">
    <div class="container">
      <h2 class="section-title">{copy.tituloExamen}</h2>
      <div class="guia__meta">
        <span class="guia__chip">{copy.guiaDuracion}: {guia.duracion}</span>
        <span class="guia__chip">{copy.guiaTotal}: {guia.total}</span>
      </div>
      <ol class="guia__partes">
        {guia.partes.map((parte) => (
          <li class="guia__parte">
            <div class="guia__parte-head">
              <strong class="guia__parte-nombre">{parte.nombre}</strong>
              <span class="guia__parte-puntos">{parte.puntos}</span>
            </div>
            <p class="guia__parte-desc">{parte.descripcion}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="subareas">
    <div class="container">
      <h2 class="section-title">{copy.tituloRecursos}</h2>
      <div class="card-grid">
        {subAreas.map((s) => (
          <a class="card" href={s.href} style={`--fam-color: var(${s.color}); --fam-ink: var(${s.color}-ink)`}>
            <span class="card__eyebrow">{copy.eyebrow}</span>
            <h3 class="card__title serif">{copy.subAreas[s.key].title}</h3>
            <p class="card__desc">{copy.subAreas[s.key].desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container { max-width: 1240px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem); }
  .breadcrumb { font-size: 0.92rem; color: var(--color-ink-mute); margin: 2rem 0; }
  .breadcrumb a { color: var(--color-ink-mute); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-terra); }
  .breadcrumb .sep { margin: 0 0.5em; color: var(--color-mustard); }

  .hero { padding: 1rem 0 2rem; }
  .kicker { font-family: var(--font-sans); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-terra-deep); }
  .accent { color: var(--color-terra); }
  h1 { margin: 0.6rem 0 0.8rem; }
  .lede { font-size: 1.2rem; color: var(--color-ink-soft); line-height: 1.55; max-width: 60ch; }

  .section-title {
    font-family: var(--font-serif); font-size: 1.7rem; font-weight: 500;
    margin: 0 0 1.2rem; color: var(--color-ink);
  }

  /* Guia del examen */
  .guia { padding: 1.5rem 0 2rem; background: var(--color-bg-soft); }
  .guia__meta { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 1.4rem; }
  .guia__chip {
    font-family: var(--font-sans); font-size: 0.85rem; font-weight: 600;
    background: var(--color-paper); border: 1.5px solid var(--color-line);
    border-radius: 999px; padding: 0.3rem 0.9rem; color: var(--color-ink-soft);
  }
  .guia__partes { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .guia__parte {
    background: var(--color-paper); border: 1px solid var(--color-line);
    border-radius: 8px;
    padding: 1rem 1.2rem;
  }
  .guia__parte-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.4rem; }
  .guia__parte-nombre { font-family: var(--font-serif); font-size: 1.1rem; color: var(--color-ink); }
  .guia__parte-puntos {
    font-family: var(--font-mono); font-size: 0.85rem; font-weight: 600;
    color: var(--color-terra); white-space: nowrap;
  }
  .guia__parte-desc { color: var(--color-ink-soft); font-size: 0.95rem; line-height: 1.55; margin: 0; }

  /* Sub-areas card grid */
  .subareas { padding: 2rem 0 3rem; }
  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 1.2rem; }
  .card {
    display: flex; flex-direction: column; gap: 0.5rem;
    padding: 1.4rem; background: var(--color-paper);
    border: 1px solid var(--color-line); border-top: 4px solid var(--fam-color);
    border-radius: 10px; text-decoration: none;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .card:hover { transform: translateY(-3px); box-shadow: 0 8px 28px rgba(42, 31, 24, 0.1); }
  .card__eyebrow {
    font-family: var(--font-sans); font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--fam-ink);
  }
  .card__title { font-size: 1.3rem; color: var(--color-ink); margin: 0; }
  .card__desc { color: var(--color-ink-soft); font-size: 0.95rem; line-height: 1.5; margin: 0; flex: 1; }
</style>
