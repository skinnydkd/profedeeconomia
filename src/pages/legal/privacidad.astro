---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeader from '@components/SectionHeader.astro';
import { getLocale } from '@/i18n/locale';
import { resolveMeasurementId, gaCookieNames } from '@/lib/analytics';
import { SITE } from '@/lib/seo';

const locale = getLocale(Astro.currentLocale);

// Cookie names are derived from the live measurement ID, so this page can never
// claim a cookie the tag does not actually set.
const [browserCookie, sessionCookie] = gaCookieNames(
  resolveMeasurementId(import.meta.env.PUBLIC_GA_MEASUREMENT_ID) || undefined,
);

// Legal copy carries inline emphasis, so paragraphs are authored as HTML and
// rendered with set:html. Every string below is author-controlled — no user
// input reaches this page.
const copy = {
  es: {
    inicio: 'Inicio',
    pageTitle: 'Política de privacidad',
    description: 'Política de privacidad de profedeeconomia.es: qué datos tratamos, qué cookies usa la analítica y cómo aceptarla o rechazarla en cualquier momento.',
    h1: 'Política de privacidad',
    updatedLabel: 'Última actualización:',
    updatedDate: '23 de noviembre de 2026',
    lede: 'En resumen: <strong>no te pedimos registrarte, no hay publicidad y no vendemos nada</strong>. Para leer el material no hace falta darnos ningún dato. Solo tratamos datos en tres casos que te contamos abajo: los juegos en línea (que piden un alias), una medición de audiencia sin cookies y, si la aceptas, Google Analytics.',

    h2Datos: '1. Qué datos tratamos',
    pDatos: 'Para leer el libro, las diapositivas o las actividades no te pedimos registrarte ni rellenar formularios. Como cualquier web, el servidor que la aloja (<strong>Vercel Inc.</strong>) recibe tu dirección IP para poder enviarte la página. Además tratamos datos en los juegos en línea (apartado 2) y en la medición de audiencia (apartado 3). Si nos escribes por correo, trataremos tu mensaje únicamente para responderte y no lo usaremos para ningún otro fin ni lo cederemos a terceros.',

    h2Juegos: '2. Juegos en línea',
    pJuegosMenores: '<strong>Muchos jugadores son alumnos menores de edad.</strong> Por eso los juegos piden un <strong>alias, nunca el nombre real</strong>. Si los usáis en clase, pedid a vuestros alumnos que elijan un alias que no los identifique (ni nombre y apellidos, ni el usuario de sus redes).',
    pJuegosJocs: '<strong>Jocs Econòmics.</strong> Guardamos el alias, el nombre del instituto que escribe el jugador, la puntuación, el número de preguntas respondidas, el tiempo total, la dificultad alcanzada y la fecha de la partida. <strong>El alias, el instituto, la puntuación y la fecha aparecen en el ranking público</strong>, y los nombres de instituto se ofrecen como sugerencia a otros jugadores. Los datos de una partida en curso (preguntas vistas, vidas) se borran automáticamente al acabarla o tras 30 minutos sin actividad. Las puntuaciones y los institutos <strong>se conservan hasta que se solicite su supresión</strong>: ahora mismo no hay un borrado automático.',
    pJuegosBg: '<strong>Business Game.</strong> Quien crea una liga indica su nombre, el instituto y los parámetros del mercado. Cada equipo indica el nombre del equipo, el instituto y, si quiere, una lista de integrantes; en ese campo <strong>usad alias o iniciales, no nombres reales</strong>. Guardamos también las decisiones y los resultados de cada ronda. Los demás participantes de la liga ven el nombre de los equipos, su instituto y sus resultados; la lista de integrantes no se muestra a nadie. Para volver a la partida, tu navegador guarda una clave de acceso que caduca a los 400 días. Las ligas y sus datos <strong>se conservan hasta que se solicite su supresión</strong>.',
    pJuegosProveedor: 'Los datos de Jocs Econòmics y de Business Game se guardan en una base de datos de <strong>Supabase Inc.</strong>, que actúa como encargado del tratamiento por nuestra cuenta. Si esos datos se tratan fuera del Espacio Económico Europeo, la transferencia se ampara en las cláusulas contractuales tipo de la Comisión Europea. Para frenar abusos, el servidor usa tu IP durante un minuto para contar cuántas partidas o ligas se crean desde la misma red; no la guarda en la base de datos.',
    pJuegosMulti: '<strong>Cajút e Insider.</strong> El alias y las respuestas de cada jugador pasan por un servidor de <strong>PartyKit</strong> (Cloudflare Inc.) que coordina la sala, y los ven los demás jugadores de esa sala. Solo se mantienen en la memoria de la sala mientras la partida está abierta: no se escriben en ninguna base de datos y desaparecen cuando la sala se cierra (un jugador desconectado se retira a los 2 minutos).',
    pJuegosBase: 'La base legal de estos tratamientos es nuestro <strong>interés legítimo</strong> en ofrecer los juegos que eliges usar, con su clasificación (art. 6.1.f del RGPD). Lo equilibramos pidiendo solo un alias y el nombre del centro. Si quieres que borremos una puntuación, un alias del ranking o una liga, escríbenos a hola@profedeeconomia.es indicando el alias, el instituto y, si la tienes, la fecha o el código de la liga.',

    h2Analitica: '3. Analítica web',
    pAnaliticaVercel: 'Siempre que visitas una página contamos la visita con <strong>Vercel Web Analytics</strong>, de Vercel Inc. Registra la página vista, la página desde la que llegas, el tipo de navegador, sistema operativo y dispositivo, y el país aproximado. <strong>No usa cookies ni guarda tu IP</strong>: distingue visitas con un identificador que se renueva cada día y no permite saber quién eres. Las cifras que vemos son siempre agregadas. Esta medición funciona aunque rechaces Google Analytics; su base legal es nuestro interés legítimo en saber qué materiales se usan (art. 6.1.f del RGPD).',
    pAnalitica1: 'Para tener un análisis más detallado, y solo si lo aceptas, usamos también <strong>Google Analytics 4</strong>, un servicio de Google Ireland Limited. Recoge datos de navegación —páginas vistas, tipo de dispositivo, país aproximado, desde dónde has llegado— y para hacerlo instala cookies en tu navegador.',
    pAnalitica2: '<strong>No se carga nada de Google hasta que lo aceptas.</strong> Si rechazas la analítica, o si simplemente no respondes al aviso, tu navegador no hace ninguna petición a los servidores de Google: ni cookies, ni identificadores, ni las llamadas «señales sin cookies». Rechazar no apaga la medición sin cookies de Vercel descrita arriba. Tampoco usamos la analítica para publicidad: todas las funciones de anuncios y de perfiles publicitarios están desactivadas.',
    pAnalitica3: 'Google actúa como encargado del tratamiento por nuestra cuenta y puede tratar los datos fuera del Espacio Económico Europeo; esas transferencias se amparan en las cláusulas contractuales tipo de la Comisión Europea. En Analytics 4 la dirección IP no se almacena: Google la usa para deducir el país y la descarta. Las métricas que nosotros vemos son siempre agregadas, nunca fichas individuales.',

    h2Cookies: '4. Cookies',
    pCookies1: 'Si aceptas Google Analytics, Google instala estas dos cookies y ninguna más:',
    pCookies2: 'Si lo rechazas, <strong>no se instala ninguna cookie</strong>. El sitio no usa cookies propias, ni de sesión, ni publicitarias, ni de terceros de ningún otro tipo. La medición de Vercel no usa cookies.',
    cookiePurposeBrowser: 'distingue navegadores para no contarte dos veces.',
    cookiePurposeSession: 'mantiene el estado de la visita.',
    cookieTtl: 'Caduca a los 2 años.',

    h2Decision: '5. Tu decisión sobre Google Analytics',
    pDecision: 'Puedes cambiar de opinión cuando quieras. Retirar el consentimiento es tan fácil como darlo:',
    statusLabel: 'Ahora mismo:',
    statusGranted: 'analítica aceptada.',
    statusDenied: 'analítica rechazada.',
    statusUnset: 'todavía no lo has decidido.',
    btnAccept: 'Aceptar analítica',
    btnReject: 'Rechazar analítica',
    pDecision2: 'Tu decisión se guarda en tu propio navegador (en <em>localStorage</em>, con la clave <code>pde:consent</code>), no en ningún servidor. Si borras los datos del sitio, cambias de navegador o usas otro dispositivo, te lo volveremos a preguntar. Al rechazar, las cookies que Google hubiera puesto dejan de usarse; puedes borrarlas desde los ajustes de tu navegador.',
    noJs: 'Estos botones necesitan JavaScript. Sin JavaScript la analítica no se carga en ningún caso.',

    h2Almacenamiento: '6. Almacenamiento en tu navegador',
    pAlmacenamiento: 'Algunas funciones interactivas (la mejor nota de un test, las notas que escribes en una unidad, el progreso de un simulador o de un juego individual) se guardan <strong>localmente en tu propio navegador</strong> mediante <em>localStorage</em>, igual que tu decisión sobre la analítica. Esa información <strong>no sale de tu dispositivo</strong>: no se envía a ningún servidor. Los juegos en línea guardan además, también en tu navegador, el último alias e instituto que usaste y la clave para volver a tu partida o liga; lo que se envía al jugar es lo descrito en el apartado 2. Puedes borrarlo todo en cualquier momento desde los ajustes de tu navegador o con los botones de «borrar progreso» que ofrecen esas funciones.',

    h2Terceros: '7. Contenido de terceros',
    pTerceros: 'El sitio enlaza a recursos externos (fuentes oficiales, vídeos, lecturas) y puede incrustar algún contenido de terceros. Esos servicios se rigen por sus propias políticas de privacidad, que no controlamos. Las tipografías del sitio están alojadas por nosotros, así que cargar una página no comunica tu IP a ningún proveedor externo.',

    h2Derechos: '8. Tus derechos',
    pDerechos1: 'La base legal de Google Analytics es tu <strong>consentimiento</strong> (art. 6.1.a del Reglamento General de Protección de Datos), que puedes retirar cuando quieras desde el apartado 5. Los juegos en línea y la medición sin cookies de Vercel se basan en nuestro interés legítimo (art. 6.1.f), y puedes oponerte a ellos. Los datos de correspondencia por correo se tratan por interés legítimo en responderte.',
    pDerechos2: 'Conforme al RGPD tienes derecho de acceso, rectificación, supresión, oposición, limitación y portabilidad, y a reclamar ante la Agencia Española de Protección de Datos. Como los datos analíticos son agregados y no permiten identificarte, en la práctica esos derechos se ejercen sobre lo que guardamos de los juegos en línea (dinos el alias, el instituto y la fecha o el código de la liga) y sobre la correspondencia que nos hayas enviado. Para cualquier consulta o para pedir que borremos algo, escríbenos a',

    h2Cambios: '9. Cambios',
    pCambios: 'Si el proyecto incorpora funciones nuevas que traten datos personales (por ejemplo, un boletín o un área de usuario), actualizaremos esta política antes de recoger ningún dato.',

    linkAviso: 'Aviso legal',
  },
  ca: {
    inicio: 'Inici',
    pageTitle: 'Política de privacitat',
    description: "Política de privacitat de profedeeconomia.es: quines dades tractem, quines cookies usa l'analítica i com acceptar-la o rebutjar-la en qualsevol moment.",
    h1: 'Política de privacitat',
    updatedLabel: 'Última actualització:',
    updatedDate: '23 de novembre de 2026',
    lede: "En resum: <strong>no et demanem registrar-te, no hi ha publicitat i no venem res</strong>. Per a llegir el material no cal donar-nos cap dada. Només tractem dades en tres casos que t'expliquem a continuació: els jocs en línia (que demanen un àlies), una mesura d'audiència sense cookies i, si l'acceptes, Google Analytics.",

    h2Datos: '1. Quines dades tractem',
    pDatos: "Per a llegir el llibre, les diapositives o les activitats no et demanem registrar-te ni omplir formularis. Com qualsevol web, el servidor que l'allotja (<strong>Vercel Inc.</strong>) rep la teua adreça IP per a poder enviar-te la pàgina. A més, tractem dades en els jocs en línia (apartat 2) i en la mesura d'audiència (apartat 3). Si ens escrius per correu, tractarem el teu missatge únicament per a respondre't i no l'usarem per a cap altra finalitat ni el cedirem a tercers.",

    h2Juegos: '2. Jocs en línia',
    pJuegosMenores: "<strong>Molts jugadors són alumnes menors d'edat.</strong> Per això els jocs demanen un <strong>àlies, mai el nom real</strong>. Si els useu a classe, demaneu als vostres alumnes que trien un àlies que no els identifique (ni nom i cognoms, ni l'usuari de les seues xarxes).",
    pJuegosJocs: "<strong>Jocs Econòmics.</strong> Guardem l'àlies, el nom de l'institut que escriu el jugador, la puntuació, el nombre de preguntes respostes, el temps total, la dificultat assolida i la data de la partida. <strong>L'àlies, l'institut, la puntuació i la data apareixen en el rànquing públic</strong>, i els noms d'institut s'ofereixen com a suggeriment a altres jugadors. Les dades d'una partida en curs (preguntes vistes, vides) s'esborren automàticament en acabar-la o després de 30 minuts sense activitat. Les puntuacions i els instituts <strong>es conserven fins que se'n sol·licite la supressió</strong>: ara mateix no hi ha un esborrat automàtic.",
    pJuegosBg: "<strong>Business Game.</strong> Qui crea una lliga indica el seu nom, l'institut i els paràmetres del mercat. Cada equip indica el nom de l'equip, l'institut i, si vol, una llista d'integrants; en aquest camp <strong>useu àlies o inicials, no noms reals</strong>. Guardem també les decisions i els resultats de cada ronda. La resta de participants de la lliga veuen el nom dels equips, el seu institut i els seus resultats; la llista d'integrants no es mostra a ningú. Per a tornar a la partida, el teu navegador guarda una clau d'accés que caduca als 400 dies. Les lligues i les seues dades <strong>es conserven fins que se'n sol·licite la supressió</strong>.",
    pJuegosProveedor: "Les dades de Jocs Econòmics i de Business Game es guarden en una base de dades de <strong>Supabase Inc.</strong>, que actua com a encarregat del tractament pel nostre compte. Si aquestes dades es tracten fora de l'Espai Econòmic Europeu, la transferència s'empara en les clàusules contractuals tipus de la Comissió Europea. Per a frenar abusos, el servidor usa la teua IP durant un minut per a comptar quantes partides o lligues es creen des de la mateixa xarxa; no la guarda en la base de dades.",
    pJuegosMulti: "<strong>Cajút i Insider.</strong> L'àlies i les respostes de cada jugador passen per un servidor de <strong>PartyKit</strong> (Cloudflare Inc.) que coordina la sala, i els veuen la resta de jugadors d'aquesta sala. Només es mantenen en la memòria de la sala mentre la partida està oberta: no s'escriuen en cap base de dades i desapareixen quan la sala es tanca (un jugador desconnectat es retira als 2 minuts).",
    pJuegosBase: "La base legal d'aquests tractaments és el nostre <strong>interés legítim</strong> a oferir els jocs que tries usar, amb la seua classificació (art. 6.1.f del RGPD). Ho equilibrem demanant només un àlies i el nom del centre. Si vols que esborrem una puntuació, un àlies del rànquing o una lliga, escriu-nos a hola@profedeeconomia.es indicant l'àlies, l'institut i, si el tens, la data o el codi de la lliga.",

    h2Analitica: '3. Analítica web',
    pAnaliticaVercel: "Sempre que visites una pàgina comptem la visita amb <strong>Vercel Web Analytics</strong>, de Vercel Inc. Registra la pàgina vista, la pàgina des de la qual arribes, el tipus de navegador, sistema operatiu i dispositiu, i el país aproximat. <strong>No usa cookies ni guarda la teua IP</strong>: distingeix visites amb un identificador que es renova cada dia i no permet saber qui eres. Les xifres que veiem són sempre agregades. Aquesta mesura funciona encara que rebutges Google Analytics; la seua base legal és el nostre interés legítim a saber quins materials s'usen (art. 6.1.f del RGPD).",
    pAnalitica1: "Per a tindre una anàlisi més detallada, i només si ho acceptes, usem també <strong>Google Analytics 4</strong>, un servei de Google Ireland Limited. Recull dades de navegació —pàgines vistes, tipus de dispositiu, país aproximat, des d'on has arribat— i per a fer-ho instal·la cookies en el teu navegador.",
    pAnalitica2: "<strong>No es carrega res de Google fins que ho acceptes.</strong> Si rebutges l'analítica, o si simplement no respons a l'avís, el teu navegador no fa cap petició als servidors de Google: ni cookies, ni identificadors, ni els anomenats «senyals sense cookies». Rebutjar no apaga la mesura sense cookies de Vercel descrita adés. Tampoc usem l'analítica per a publicitat: totes les funcions d'anuncis i de perfils publicitaris estan desactivades.",
    pAnalitica3: "Google actua com a encarregat del tractament pel nostre compte i pot tractar les dades fora de l'Espai Econòmic Europeu; aquestes transferències s'emparen en les clàusules contractuals tipus de la Comissió Europea. En Analytics 4 l'adreça IP no s'emmagatzema: Google l'usa per a deduir el país i la descarta. Les mètriques que nosaltres veiem són sempre agregades, mai fitxes individuals.",

    h2Cookies: '4. Cookies',
    pCookies1: 'Si acceptes Google Analytics, Google instal·la aquestes dues cookies i cap més:',
    pCookies2: "Si el rebutges, <strong>no s'instal·la cap cookie</strong>. El lloc no usa cookies pròpies, ni de sessió, ni publicitàries, ni de tercers de cap altre tipus. La mesura de Vercel no usa cookies.",
    cookiePurposeBrowser: 'distingeix navegadors per a no comptar-te dues vegades.',
    cookiePurposeSession: 'manté l\'estat de la visita.',
    cookieTtl: 'Caduca als 2 anys.',

    h2Decision: '5. La teua decisió sobre Google Analytics',
    pDecision: 'Pots canviar d\'opinió quan vulgues. Retirar el consentiment és tan fàcil com donar-lo:',
    statusLabel: 'Ara mateix:',
    statusGranted: 'analítica acceptada.',
    statusDenied: 'analítica rebutjada.',
    statusUnset: 'encara no ho has decidit.',
    btnAccept: 'Acceptar analítica',
    btnReject: 'Rebutjar analítica',
    pDecision2: "La teua decisió es guarda en el teu propi navegador (en <em>localStorage</em>, amb la clau <code>pde:consent</code>), no en cap servidor. Si esborres les dades del lloc, canvies de navegador o uses un altre dispositiu, t'ho tornarem a preguntar. En rebutjar, les cookies que Google haguera posat deixen d'usar-se; pots esborrar-les des dels ajustos del teu navegador.",
    noJs: "Aquests botons necessiten JavaScript. Sense JavaScript l'analítica no es carrega en cap cas.",

    h2Almacenamiento: '6. Emmagatzematge en el teu navegador',
    pAlmacenamiento: "Algunes funcions interactives (la millor nota d'un test, les notes que escrius en una unitat, el progrés d'un simulador o d'un joc individual) es guarden <strong>localment en el teu propi navegador</strong> mitjançant <em>localStorage</em>, igual que la teua decisió sobre l'analítica. Aquesta informació <strong>no ix del teu dispositiu</strong>: no s'envia a cap servidor. Els jocs en línia guarden a més, també en el teu navegador, l'últim àlies i institut que vas usar i la clau per a tornar a la teua partida o lliga; el que s'envia en jugar és el que es descriu en l'apartat 2. Pots esborrar-ho tot en qualsevol moment des dels ajustos del teu navegador o amb els botons de «esborrar progrés» que ofereixen aquestes funcions.",

    h2Terceros: '7. Contingut de tercers',
    pTerceros: 'El lloc enllaça a recursos externs (fonts oficials, vídeos, lectures) i pot incrustar algun contingut de tercers. Aquests serveis es regeixen per les seues pròpies polítiques de privacitat, que no controlem. Les tipografies del lloc estan allotjades per nosaltres, així que carregar una pàgina no comunica la teua IP a cap proveïdor extern.',

    h2Derechos: '8. Els teus drets',
    pDerechos1: "La base legal de Google Analytics és el teu <strong>consentiment</strong> (art. 6.1.a del Reglament General de Protecció de Dades), que pots retirar quan vulgues des de l'apartat 5. Els jocs en línia i la mesura sense cookies de Vercel es basen en el nostre interés legítim (art. 6.1.f), i t'hi pots oposar. Les dades de correspondència per correu es tracten per interés legítim a respondre't.",
    pDerechos2: "D'acord amb el RGPD tens dret d'accés, rectificació, supressió, oposició, limitació i portabilitat, i a reclamar davant l'Agència Espanyola de Protecció de Dades. Com que les dades analítiques són agregades i no permeten identificar-te, en la pràctica aquests drets s'exerceixen sobre el que guardem dels jocs en línia (digues-nos l'àlies, l'institut i la data o el codi de la lliga) i sobre la correspondència que ens hages enviat. Per a qualsevol consulta o per a demanar que esborrem alguna cosa, escriu-nos a",

    h2Cambios: '9. Canvis',
    pCambios: "Si el projecte incorpora funcions noves que tracten dades personals (per exemple, un butlletí o una àrea d'usuari), actualitzarem aquesta política abans de recollir cap dada.",

    linkAviso: 'Avís legal',
  },
}[locale];

const cookies = [
  { name: browserCookie, purpose: copy.cookiePurposeBrowser },
  { name: sessionCookie, purpose: copy.cookiePurposeSession },
];
---
<BaseLayout
  title={copy.pageTitle}
  description={copy.description}
  contentLang={locale}
>
  <SectionHeader
    locale={locale}
    meta={`${copy.updatedLabel} ${copy.updatedDate}`}
    crumbs={[
      { name: copy.inicio, path: '/' },
      { name: copy.pageTitle },
    ]}
  >
    <Fragment slot="title">{copy.h1}</Fragment>
    <Fragment slot="lede" set:html={copy.lede} />
  </SectionHeader>

  <div class="container">
    <div class="prose">
      <h2>{copy.h2Datos}</h2>
      <p set:html={copy.pDatos} />

      <h2>{copy.h2Juegos}</h2>
      <p set:html={copy.pJuegosMenores} />
      <p set:html={copy.pJuegosJocs} />
      <p set:html={copy.pJuegosBg} />
      <p set:html={copy.pJuegosProveedor} />
      <p set:html={copy.pJuegosMulti} />
      <p set:html={copy.pJuegosBase} />

      <h2>{copy.h2Analitica}</h2>
      <p set:html={copy.pAnaliticaVercel} />
      <p set:html={copy.pAnalitica1} />
      <p set:html={copy.pAnalitica2} />
      <p set:html={copy.pAnalitica3} />

      <h2>{copy.h2Cookies}</h2>
      <p>{copy.pCookies1}</p>
      <ul class="cookies">
        {cookies.map((cookie) => (
          <li>
            <code>{cookie.name}</code> — {cookie.purpose} {copy.cookieTtl}
          </li>
        ))}
      </ul>
      <p set:html={copy.pCookies2} />

      <h2>{copy.h2Decision}</h2>
      <p>{copy.pDecision}</p>
      <div class="consent-control">
        <p class="consent-status">
          <span class="consent-status__label">{copy.statusLabel}</span>
          <strong id="consent-state" data-granted={copy.statusGranted} data-denied={copy.statusDenied}
            >{copy.statusUnset}</strong
          >
        </p>
        <div class="consent-buttons">
          <button type="button" data-consent="granted">{copy.btnAccept}</button>
          <button type="button" data-consent="denied">{copy.btnReject}</button>
        </div>
        <noscript><p class="consent-nojs">{copy.noJs}</p></noscript>
      </div>
      <p set:html={copy.pDecision2} />

      <h2>{copy.h2Almacenamiento}</h2>
      <p set:html={copy.pAlmacenamiento} />

      <h2>{copy.h2Terceros}</h2>
      <p>{copy.pTerceros}</p>

      <h2>{copy.h2Derechos}</h2>
      <p set:html={copy.pDerechos1} />
      <p>
        {copy.pDerechos2}
        <a class="editorial-link" href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>

      <h2>{copy.h2Cambios}</h2>
      <p>{copy.pCambios}</p>

      <p class="links"><a class="editorial-link" href="/legal/aviso-legal/">{copy.linkAviso}</a></p>
    </div>
  </div>
</BaseLayout>

<script>
  import { readConsent, decideConsent } from '@/lib/consent';

  const state = document.getElementById('consent-state');
  const control = state?.closest('.consent-control');

  /** Reflect the stored decision; the unanswered wording is the server default. */
  function render(): void {
    if (!state) return;
    const current = readConsent();
    if (current === 'granted') state.textContent = state.dataset.granted ?? '';
    else if (current === 'denied') state.textContent = state.dataset.denied ?? '';
  }

  if (state && control) {
    render();
    control.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const choice = target?.closest<HTMLElement>('[data-consent]')?.dataset.consent;
      if (choice !== 'granted' && choice !== 'denied') return;
      decideConsent(choice);
      render();
      // The banner is only shown to undecided visitors, but hide it in case the
      // decision was made here while it was still on screen.
      document.getElementById('consent-banner')?.setAttribute('hidden', '');
    });
  }
</script>

