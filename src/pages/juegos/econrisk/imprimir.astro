---
/**
 * Print-and-play version of Econrisk. Materials are derived from the game's
 * own data (map territories, factions, event cards) so the printed set always
 * matches the digital game. Each `.print-block` is one printable sheet; the
 * @media print stylesheet hides the page chrome and prints only those blocks.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PrintButton from '@components/dinamicas/PrintButton.astro';
import { getLocale } from '@/i18n/locale';
import { TERRITORIES, CONTINENT_BONUS, CONTINENTS } from '@/lib/games/econrisk/map';
import { EVENT_CARDS } from '@/lib/games/econrisk/events';
import { localizeFactions, localizeEventText, localizeTerritoryName } from '@/i18n/games/econrisk-ca';
import type { ContinentId } from '@/lib/games/econrisk/types';

const locale = getLocale(Astro.currentLocale);
const factions = localizeFactions(locale);

// Print-page chrome. Faction/event/territory display text comes from the shared
// econrisk-ca overlay; only the instructional chrome + continent names live here.
const copy = {
  es: {
    metaTitle: 'Econrisk — versión para imprimir',
    metaDesc: 'Print-and-play de Econrisk: mapa de territorios, facciones y cartas de evento listos para imprimir y jugar en clase sin pantallas.',
    bcInicio: 'Inicio', bcJuegos: 'Juegos', bcImprimir: 'Imprimir',
    kicker: 'Versión para imprimir', enPapel: 'en papel',
    ledePre: 'Imprime el mapa, recorta las cartas de evento y conquista el mundo sin pantallas. Cada bloque es una hoja A4. Las reglas completas están en la ',
    ledeLink: 'versión digital', ledePost: '.',
    comoSeJuega: 'Cómo se juega',
    rules: [
      '<strong>Jugadores:</strong> 1 a 4 (humanos o IA). Cada uno controla una <strong>facción</strong>, que representa una escuela de pensamiento económico.',
      '<strong>Objetivo:</strong> conquistar el mapa hasta controlar <strong>18 o más territorios</strong>, o ganar por eliminación de los rivales antes de la ronda 15.',
      '<strong>El turno tiene 4 fases:</strong> primero se roba una carta de <em>evento</em>; después se <em>refuerza</em> colocando unidades nuevas; luego se <em>ataca</em> a territorios adyacentes; y se cierra <em>fortificando</em> moviendo unidades entre territorios propios.',
      '<strong>Combate:</strong> los enfrentamientos se resuelven con <strong>dados</strong>: atacante y defensor comparan tiradas y pierde unidades quien saque menos.',
      '<strong>Continentes:</strong> controlar un continente entero otorga unidades de refuerzo extra cada ronda (ver la leyenda del mapa).',
    ],
    hintStats: '24 territorios · 6 continentes · 4 facciones · 15 cartas',
    hintMaterialPre: 'Material derivado de la ', hintMaterialLink: 'versión digital', hintMaterialPost: ', donde encontrarás las reglas completas.',
    mapa: 'Mapa',
    ariaMapa: 'Mapa de territorios de Econrisk con sus conexiones',
    legendHint: 'El bonus indica las unidades de refuerzo extra por controlar el continente entero.',
    facciones: 'Facciones', cartasEvento: 'Cartas de evento', evento: 'Evento',
  },
  ca: {
    metaTitle: 'Econrisk — versió per a imprimir',
    metaDesc: "Print-and-play d'Econrisk: mapa de territoris, faccions i cartes d'esdeveniment a punt per a imprimir i jugar a classe sense pantalles.",
    bcInicio: 'Inici', bcJuegos: 'Jocs', bcImprimir: 'Imprimir',
    kicker: 'Versió per a imprimir', enPapel: 'en paper',
    ledePre: "Imprimeix el mapa, retalla les cartes d'esdeveniment i conquista el món sense pantalles. Cada bloc és un full A4. Les regles completes estan a la ",
    ledeLink: 'versió digital', ledePost: '.',
    comoSeJuega: 'Com es juga',
    rules: [
      '<strong>Jugadors:</strong> 1 a 4 (humans o IA). Cadascú controla una <strong>facció</strong>, que representa una escola de pensament econòmic.',
      '<strong>Objectiu:</strong> conquistar el mapa fins a controlar <strong>18 o més territoris</strong>, o guanyar per eliminació dels rivals abans de la ronda 15.',
      "<strong>El torn té 4 fases:</strong> primer es roba una carta d'<em>esdeveniment</em>; després es <em>reforça</em> col·locant unitats noves; després s'<em>ataca</em> territoris adjacents; i es tanca <em>fortificant</em>, movent unitats entre territoris propis.",
      '<strong>Combat:</strong> els enfrontaments es resolen amb <strong>daus</strong>: atacant i defensor comparen tirades i perd unitats qui trau menys.',
      '<strong>Continents:</strong> controlar un continent sencer dóna unitats de reforç extra cada ronda (mira la llegenda del mapa).',
    ],
    hintStats: '24 territoris · 6 continents · 4 faccions · 15 cartes',
    hintMaterialPre: 'Material derivat de la ', hintMaterialLink: 'versió digital', hintMaterialPost: ', on trobaràs les regles completes.',
    mapa: 'Mapa',
    ariaMapa: "Mapa de territoris d'Econrisk amb les seues connexions",
    legendHint: 'El bonus indica les unitats de reforç extra per controlar el continent sencer.',
    facciones: 'Faccions', cartasEvento: "Cartes d'esdeveniment", evento: 'Esdeveniment',
  },
}[locale];

const CONTINENT_LABEL: Record<ContinentId, string> = locale === 'ca'
  ? { norteamerica: 'Amèrica del Nord', sudamerica: 'Amèrica del Sud', europa: 'Europa', africa: 'Àfrica', asia: 'Àsia', oceania: 'Oceania' }
  : { norteamerica: 'Norteamérica', sudamerica: 'Sudamérica', europa: 'Europa', africa: 'África', asia: 'Asia', oceania: 'Oceanía' };

const CONTINENT_COLOR: Record<ContinentId, string> = {
  norteamerica: '#C44E2C',
  sudamerica:   '#D4A24C',
  europa:       '#1F6E6E',
  africa:       '#5B3A4E',
  asia:         '#9C3A1C',
  oceania:      '#2E5E3A',
};

// Dedupe edges: only draw each adjacency once (id ordering keeps a < b).
const pos = Object.fromEntries(TERRITORIES.map((t) => [t.id, { x: t.x, y: t.y }]));
const edges: Array<{ x1: number; y1: number; x2: number; y2: number }> = [];
const seen = new Set<string>();
for (const t of TERRITORIES) {
  for (const n of t.adj) {
    const key = t.id < n ? `${t.id}|${n}` : `${n}|${t.id}`;
    if (seen.has(key)) continue;
    seen.add(key);
    const a = pos[t.id];
    const b = pos[n];
    if (a && b) edges.push({ x1: a.x, y1: a.y, x2: b.x, y2: b.y });
  }
}

// viewBox from min/max with ~20 units padding.
const PAD = 20;
const xs = TERRITORIES.map((t) => t.x);
const ys = TERRITORIES.map((t) => t.y);
const minX = Math.min(...xs) - PAD;
const minY = Math.min(...ys) - PAD;
const vbW = Math.max(...xs) - Math.min(...xs) + PAD * 2;
const vbH = Math.max(...ys) - Math.min(...ys) + PAD * 2;
---

<BaseLayout title={copy.metaTitle} description={copy.metaDesc} contentLang={locale} noindex>
  <div class="container">
    <nav class="breadcrumb no-print">
      <a href="/">{copy.bcInicio}</a> <span class="sep">›</span>
      <a href="/juegos/">{copy.bcJuegos}</a> <span class="sep">›</span>
      <a href="/juegos/econrisk/">Econrisk</a> <span class="sep">›</span>
      <span>{copy.bcImprimir}</span>
    </nav>

    <header class="intro no-print">
      <span class="kicker">{copy.kicker}</span>
      <h1>Econrisk <span class="serif-italic-wonk accent">{copy.enPapel}</span></h1>
      <p class="lede">
        {copy.ledePre}<a href="/juegos/econrisk/" class="editorial-link">{copy.ledeLink}</a>{copy.ledePost}
      </p>
      <PrintButton />
    </header>

    <!-- Hoja 1: cómo se juega -->
    <section class="print-block">
      <h2>{copy.comoSeJuega}</h2>
      <ul class="rules">
        {copy.rules.map((r) => <li set:html={r} />)}
      </ul>
      <p class="hint">{copy.hintStats}</p>
      <p class="hint">{copy.hintMaterialPre}<a href="/juegos/econrisk/" class="editorial-link">{copy.hintMaterialLink}</a>{copy.hintMaterialPost}</p>
    </section>

    <!-- Hoja 2: mapa -->
    <section class="print-block">
      <h2>{copy.mapa}</h2>
      <svg
        class="map"
        viewBox={`${minX} ${minY} ${vbW} ${vbH}`}
        role="img"
        aria-label={copy.ariaMapa}
      >
        {edges.map((e) => (
          <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} class="map-edge" />
        ))}
        {TERRITORIES.map((t) => (
          <g class="map-node">
            <circle cx={t.x} cy={t.y} r={9} style={`fill:${CONTINENT_COLOR[t.continent]}`} />
            <text x={t.x} y={t.y - 13} class="map-label">{localizeTerritoryName(t.id, locale)}</text>
          </g>
        ))}
      </svg>
      <ul class="legend">
        {CONTINENTS.map((c) => (
          <li>
            <span class="legend-dot" style={`background:${CONTINENT_COLOR[c]}`}></span>
            <span class="legend-name">{CONTINENT_LABEL[c]}</span>
            <span class="legend-bonus">+{CONTINENT_BONUS[c]}</span>
          </li>
        ))}
      </ul>
      <p class="hint">{copy.legendHint}</p>
    </section>

    <!-- Hoja 3: facciones -->
    <section class="print-block">
      <h2>{copy.facciones} <span class="count">({factions.length})</span></h2>
      <div class="cards">
        {factions.map((f) => (
          <div class="faction-card" style={`border-top-color:${f.color}`}>
            <span class="card-kicker">{f.school}</span>
            <h3 class="faction-name">{f.label}</h3>
            <p class="card-text">{f.power}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Hoja 4+: cartas de evento -->
    <section class="print-block">
      <h2>{copy.cartasEvento} <span class="count">({EVENT_CARDS.length})</span></h2>
      <div class="cards">
        {EVENT_CARDS.map((card) => (
          <div class="card">
            <span class="card-kicker">{copy.evento}</span>
            <p class="card-text">{localizeEventText(card, locale)}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .container { max-width: 920px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem) 4rem; }
  .breadcrumb { font-size: 0.92rem; color: var(--color-ink-mute); margin: 2rem 0; }
  .breadcrumb a { color: var(--color-ink-mute); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-terra); }
  .breadcrumb .sep { margin: 0 0.5em; color: var(--color-mustard); }
  .intro { margin-bottom: 2.5rem; }
  .kicker { font-family: var(--font-sans); font-size: .8rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--color-terra); }
  h1 { margin: .5rem 0 .8rem; }
  .accent { color: var(--color-terra); }
  .lede { font-size: 1.15rem; color: var(--color-ink-soft); line-height: 1.55; max-width: 60ch; }

  .print-block { margin: 0 0 3rem; }
  .print-block h2 { font-family: var(--font-serif); font-size: 1.5rem; font-weight: 500; margin: 0 0 1rem; padding-bottom: .4rem; border-bottom: 2px solid var(--color-terra); }
  .print-block h2 .count, .print-block h2 .kicker { font-size: 1rem; color: var(--color-ink-mute); }

  .rules { list-style: none; padding: 0; margin: 0 0 1rem; display: flex; flex-direction: column; gap: .55rem; }
  .rules li { padding-left: 1.1rem; position: relative; color: var(--color-ink); line-height: 1.5; }
  .rules li::before { content: "→"; position: absolute; left: 0; color: var(--color-mustard); }
  .hint { font-family: var(--font-mono); font-size: .78rem; color: var(--color-ink-mute); margin: .4rem 0 0; }
  .hint a { color: var(--color-terra); }

  /* Schematic territory graph. */
  .map { display: block; width: 100%; max-width: 720px; height: auto; margin: 0 0 1rem; border: 2px solid var(--color-ink); background: #fff; padding: 4px; box-sizing: border-box; }
  .map-edge { stroke: var(--color-line); stroke-width: 1.2; }
  .map-node circle { stroke: var(--color-ink); stroke-width: 1; }
  .map-label { font-family: var(--font-sans); font-size: 7px; font-weight: 600; fill: var(--color-ink); text-anchor: middle; }

  .legend { list-style: none; padding: 0; margin: 0 0 .5rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: .4rem .8rem; }
  .legend li { display: flex; align-items: center; gap: .4em; font-size: .85rem; color: var(--color-ink); }
  .legend-dot { display: inline-block; width: .8em; height: .8em; border-radius: 50%; border: 1px solid var(--color-ink); flex: none; }
  .legend-name { flex: 1; }
  .legend-bonus { font-family: var(--font-mono); font-size: .8rem; color: var(--color-terra); font-weight: 600; }

  /* Cards (factions + events). */
  .cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: .6rem; }
  .card { border: 1.5px dashed var(--color-line); border-radius: 8px; padding: .8rem 1rem; min-height: 90px; display: flex; flex-direction: column; gap: .4rem; }
  .card-kicker { font-family: var(--font-sans); font-size: .68rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--color-mustard-deep); }
  .card-text { margin: 0; font-size: .85rem; line-height: 1.4; color: var(--color-ink); }

  .faction-card { border: 1.5px solid var(--color-line); border-top: 6px solid var(--color-ink); border-radius: 8px; padding: .8rem 1rem; min-height: 90px; display: flex; flex-direction: column; gap: .25rem; }
  .faction-name { font-family: var(--font-serif); font-size: 1.2rem; font-weight: 500; margin: 0; color: var(--color-ink); }

  @media print {
    :global(.site-header), :global(.site-footer), .no-print { display: none !important; }
    .container { max-width: none; padding: 0; }
    .print-block { margin: 0; break-inside: avoid; }
    .print-block + .print-block { break-before: page; }
    .map { max-width: 100%; }
    .card, .faction-card { break-inside: avoid; }
    @page { margin: 1.5cm; }
  }
</style>
