---
import BaseLayout from '@layouts/BaseLayout.astro';
import { JUEGOS } from '@/lib/juegos';
import JuegoCaratula from '@/components/juegos/JuegoCaratula.astro';
import { getLocale } from '@/i18n/locale';
import { localizeJuego } from '@/i18n/juegos-ca';
import { t } from '@/i18n/ui';

const locale = getLocale(Astro.currentLocale);

const NIVEL_LABEL: Record<string, string> = {
  eso: t('nivel.eso', locale),
  bach: t('nivel.bach', locale),
  fp: t('nivel.fp', locale),
};

// Page chrome is localized inline here; the game card grid and the
// «imprimibles» list go through localizeJuego() (src/i18n/juegos-ca.ts),
// which overlays VAL title/descripcion/nota_aula/modo onto the ES registry.
const copy = {
  es: {
    metaTitle: 'Juegos',
    metaDesc:
      'Material transversal: simuladores, dinámicas, parties y un quiz competitivo. Para los días en que la teoría no sostiene la sesión.',
    heroPre: 'Juegos para una',
    heroAccent: 'clase activa',
    ledeIntro: 'Simuladores, juegos de tablero y party para una clase activa. ¿Buscas el concurso competitivo? Está en las',
    ledeLink: 'Olimpiadas de Economía',
    bcInicio: 'Inicio',
    bcCurrent: 'Juegos',
    imprimibles: '¿Sin pantallas? Versiones para imprimir:',
    note: 'El resto de juegos — Playground, Communist — se publicarán a lo largo del 2027.',
  },
  ca: {
    metaTitle: 'Jocs',
    metaDesc:
      "Material transversal: simuladors, dinàmiques, parties i un quiz competitiu. Per als dies en què la teoria no sosté la sessió.",
    heroPre: 'Jocs per a una',
    heroAccent: 'classe activa',
    ledeIntro: 'Simuladors, jocs de taula i party per a una classe activa. Busques el concurs competitiu? Està a les',
    ledeLink: "Olimpíades d'Economia",
    bcInicio: 'Inici',
    bcCurrent: 'Jocs',
    imprimibles: 'Sense pantalles? Versions per a imprimir:',
    note: 'La resta de jocs — Playground, Communist — es publicaran al llarg del 2027.',
  },
}[locale];
---

<BaseLayout
  title={copy.metaTitle}
  description={copy.metaDesc}
  contentLang={locale}
>
  <div class="container">
    <nav class="breadcrumb"><a href="/">{copy.bcInicio}</a> <span class="sep">›</span> <span>{copy.bcCurrent}</span></nav>
  </div>

  <section class="hero">
    <div class="container">
      <h1>{copy.heroPre} <span class="serif-italic-wonk accent">{copy.heroAccent}</span>.</h1>
      <p class="lede">
        {copy.ledeIntro}
        <a href="/jocs-economics/" class="editorial-link">{copy.ledeLink}</a>.
      </p>

      <div class="game-grid">
        {JUEGOS.map((raw) => {
          const j = localizeJuego(raw, locale);
          return (
            <a class={`game-card ${j.estado}`} href={j.href}>
              <JuegoCaratula slug={j.slug} color={j.color} />
              <div class="gc-body">
                <div class="gc-eyebrow">
                  {t(j.estado === 'disponible' ? 'estado.disponible' : 'estado.proximamente', locale)}
                  {j.tipo === 'party' && ` · ${t('meta.multijugador', locale)}`}
                </div>
                <div class="gc-title serif">{j.title}</div>
                <p class="gc-desc">{j.descripcion}</p>
                {j.nota_aula && <p class="gc-note">{j.nota_aula}</p>}
                <span class="gc-meta">{j.nivel.map((n) => NIVEL_LABEL[n]).join(' · ')} · {j.modo}</span>
                <span class="gc-cta">{j.tipo === 'party' ? t('card.abrirSala', locale) : t('card.jugar', locale)}</span>
              </div>
            </a>
          );
        })}
      </div>

      <p class="imprimibles">
        {copy.imprimibles}
        {JUEGOS.filter((j) => j.imprimible).map((raw, i) => {
          const j = localizeJuego(raw, locale);
          return (
            <>{i > 0 && ' · '}<a href={`/juegos/${j.slug}/imprimir/`}>{j.title}</a></>
          );
        })}
      </p>

      <p class="note">
        {copy.note}
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4vw, 3rem);
  }
  .breadcrumb { font-size: 0.92rem; color: var(--color-ink-mute); margin: 2rem 0; }
  .breadcrumb a { color: var(--color-ink-mute); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-terra); }
  .breadcrumb .sep { margin: 0 0.5em; color: var(--color-mustard); }

  .hero { padding: 1rem 0 clamp(3rem, 7vw, 6rem); }
  h1 { max-width: 22ch; margin: 1rem 0 0.6rem; }
  .accent { color: var(--color-terra); }
  .lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--color-ink-soft);
    max-width: 55ch;
    margin: 1.5rem 0;
    line-height: 1.5;
    font-variation-settings: "SOFT" 80;
  }
  .note { color: var(--color-ink-soft); max-width: 60ch; }
  .imprimibles { color: var(--color-ink-soft); max-width: 60ch; margin-top: 1.5rem; }
  .imprimibles a { color: var(--color-terra); font-weight: 600; text-decoration: none; }
  .imprimibles a:hover { text-decoration: underline; }

  .game-grid {
    margin: 2rem 0 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .game-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--color-line);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.18s ease, transform 0.18s ease;
  }
  .game-card:hover {
    box-shadow: 0 8px 26px 0 rgba(44, 31, 24, 0.12);
    transform: translateY(-2px);
  }

  .gc-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem 1.5rem 1.35rem;
  }

  .gc-eyebrow { font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-terra); font-weight: 600; margin-bottom: 0.5rem; }
  .gc-title { font-size: 1.75rem; font-variation-settings: "SOFT" 80; line-height: 1.1; margin-bottom: 0.75rem; }
  .gc-desc { color: var(--color-ink-soft); font-size: 0.95rem; line-height: 1.55; margin-bottom: 1rem; }
  .gc-note { font-size: 0.83rem; color: var(--color-ink-mute); line-height: 1.5; margin-bottom: 0.75rem; border-top: 1px solid var(--color-line); padding-top: 0.6rem; }
  .gc-meta { display: block; font-family: var(--font-mono); font-size: 0.74rem; color: var(--color-ink-mute); margin: 0.3rem 0 0.6rem; }
  .gc-cta { font-size: 0.9rem; font-weight: 600; color: var(--color-terra); }

</style>
