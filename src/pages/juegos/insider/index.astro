---
// src/pages/juegos/insider/index.astro
// Player entry point — students open this on their phones and enter the room code.
import BaseLayout from '@layouts/BaseLayout.astro';
import PlayerApp from '@components/games/insider/PlayerApp.tsx';
import { getLocale } from '@/i18n/locale';

const partykitHost = import.meta.env.PUBLIC_PARTYKIT_HOST ?? '127.0.0.1:1999';
const locale = getLocale(Astro.currentLocale);
const copy = {
  es: { title: 'Insider — jugar', desc: 'Insider, juego de deducción económica multijugador.' },
  ca: { title: 'Insider — jugar', desc: 'Insider, joc de deducció econòmica multijugador.' },
}[locale];
---
<BaseLayout title={copy.title} description={copy.desc} contentLang={locale}>
  <div class="insider-page">
    <PlayerApp client:load partykitHost={partykitHost} locale={locale} />
  </div>
</BaseLayout>

<style>
  .insider-page {
    max-width: 480px;
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 2rem);
  }
</style>
