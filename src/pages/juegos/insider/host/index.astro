---
// src/pages/juegos/insider/host/index.astro
// Host entry point — teacher opens this on the projector.
// Students join via /juegos/insider/ using the 4-char room code displayed here.
import BaseLayout from '@layouts/BaseLayout.astro';
import HostApp from '@components/games/insider/HostApp.tsx';
import { getLocale } from '@/i18n/locale';

const partykitHost = import.meta.env.PUBLIC_PARTYKIT_HOST ?? '127.0.0.1:1999';
const locale = getLocale(Astro.currentLocale);
const copy = {
  es: { title: 'Insider — sala (proyector)', desc: 'Sala de proyector para Insider. El profesor proyecta el código; los alumnos entran en /juegos/insider/.' },
  ca: { title: 'Insider — sala (projector)', desc: 'Sala de projector per a Insider. El professor projecta el codi; els alumnes entren a /juegos/insider/.' },
}[locale];
---
<BaseLayout title={copy.title} description={copy.desc} contentLang={locale}>
  <div class="insider-host-page">
    <HostApp client:load partykitHost={partykitHost} locale={locale} />
  </div>
</BaseLayout>

<style>
  .insider-host-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 2rem);
  }
</style>
