---
// src/pages/juegos/cajut/index.astro
// Player entry point — students open this on their phones and enter the room code.
import BaseLayout from '@layouts/BaseLayout.astro';
import PlayerApp from '@components/games/cajut/PlayerApp';
import { getLocale } from '@/i18n/locale';

const partykitHost = import.meta.env.PUBLIC_PARTYKIT_HOST ?? '127.0.0.1:1999';
const locale = getLocale(Astro.currentLocale);
const copy = {
  es: { title: 'Cajút — sala de alumno', desc: 'Entra en la sala de Cajút con el código del profe.' },
  ca: { title: "Cajút — sala d'alumne", desc: 'Entra a la sala de Cajút amb el codi del profe.' },
}[locale];
---
<BaseLayout title={copy.title} description={copy.desc} contentLang={locale}>
  <div class="cajut-page">
    <PlayerApp client:only="preact" partykitHost={partykitHost} locale={locale} />
  </div>
</BaseLayout>

<style>
  .cajut-page {
    max-width: 480px;
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 2rem);
  }
</style>
