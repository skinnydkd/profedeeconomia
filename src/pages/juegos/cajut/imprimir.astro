---
/**
 * Print-and-play (teacher) version of Cajút. The questions are derived from the
 * shared `tests` content collection so the printed set always matches the
 * digital game. Each `.print-block` is one printable sheet; the @media print
 * stylesheet hides the page chrome and prints only those blocks.
 *
 * IMPORTANT: this is the teacher's sheet — the correct option is marked. It is
 * not meant to be seen by students.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PrintButton from '@components/dinamicas/PrintButton.astro';
import { getCollection } from 'astro:content';
import { ASIGNATURAS, ASIGNATURA_SLUGS, type AsignaturaSlug } from '@/lib/asignaturas';
import { getLocale } from '@/i18n/locale';
import { pickLocalizedEntry } from '@/i18n/content-locale';

const locale = getLocale(Astro.currentLocale);
// Drive the structure off the Spanish tests (one per unit) so the Valencian
// `.ca` siblings never double the sheet, then swap each for its localized
// version under /ca. Filtering by lang is REQUIRED: getCollection returns both
// languages, so an unfiltered query would print every question twice (and mix
// languages on the Spanish sheet).
const allTests = await getCollection('tests');
const caById = new Map(
  allTests.filter((e) => e.data.estado === 'publicado' && e.data.lang === 'ca').map((e) => [e.id, e]),
);
const tests = allTests
  .filter((e) => e.data.estado === 'publicado' && e.data.lang === 'es')
  .map((e) => pickLocalizedEntry(e, caById, locale));

const copy = {
  es: {
    metaTitle: 'Cajút — versión para imprimir (hoja del profe)',
    metaDesc: 'Print-and-play de Cajút: todas las preguntas del concurso por asignatura y unidad, con la respuesta correcta marcada. Hoja del profe para jugar en clase sin pantallas.',
    inicio: 'Inicio', juegos: 'Juegos', imprimir: 'Imprimir',
    kicker: 'Versión para imprimir · hoja del profe', enPapel: 'en papel',
    ledePre: 'Todas las preguntas del concurso, agrupadas por asignatura y unidad, con la respuesta correcta marcada. Esta es la ',
    ledeStrong: 'hoja del profe', ledePost: ': no la repartas al alumnado. Las reglas completas están en la ',
    versionDigital: 'versión digital',
    comoSeJuega: 'Cómo se juega',
    reglas: [
      ['Concurso de aula por equipos.', ' La clase se divide en equipos que compiten por acertar el mayor número de preguntas.'],
      ['Versión normal:', ' el profe proyecta el juego. Esta ', 'versión en papel', ' permite jugar sin pantallas cuando no hay proyector.'],
      ['Turno:', ' el profe lee cada pregunta en voz alta y los equipos eligen una opción (A, B, C o D).'],
      ['Puntuación:', ' se puntúa al equipo más rápido en acertar. Si fallan, el turno pasa al siguiente.'],
      ['Hoja del profe:', ' en estas páginas la opción correcta va marcada con ', '✓', '. El alumnado ', 'no', ' debe ver esta hoja.'],
    ],
    materialPre: 'Material derivado de la versión digital: ', asignaturas: 'asignaturas', preguntas: 'preguntas',
    unidad: 'Unidad',
  },
  ca: {
    metaTitle: 'Cajút — versió per a imprimir (full del profe)',
    metaDesc: 'Print-and-play de Cajút: totes les preguntes del concurs per assignatura i unitat, amb la resposta correcta marcada. Full del profe per jugar a classe sense pantalles.',
    inicio: 'Inici', juegos: 'Jocs', imprimir: 'Imprimir',
    kicker: 'Versió per a imprimir · full del profe', enPapel: 'en paper',
    ledePre: 'Totes les preguntes del concurs, agrupades per assignatura i unitat, amb la resposta correcta marcada. Este és el ',
    ledeStrong: 'full del profe', ledePost: ': no el repartisques a l\'alumnat. Les regles completes estan en la ',
    versionDigital: 'versió digital',
    comoSeJuega: 'Com es juga',
    reglas: [
      ['Concurs d\'aula per equips.', ' La classe es divideix en equips que competeixen per encertar el major nombre de preguntes.'],
      ['Versió normal:', ' el profe projecta el joc. Esta ', 'versió en paper', ' permet jugar sense pantalles quan no hi ha projector.'],
      ['Torn:', ' el profe llig cada pregunta en veu alta i els equips trien una opció (A, B, C o D).'],
      ['Puntuació:', ' es puntua l\'equip més ràpid a encertar. Si fallen, el torn passa al següent.'],
      ['Full del profe:', ' en estes pàgines l\'opció correcta va marcada amb ', '✓', '. L\'alumnat ', 'no', ' ha de veure este full.'],
    ],
    materialPre: 'Material derivat de la versió digital: ', asignaturas: 'assignatures', preguntas: 'preguntes',
    unidad: 'Unitat',
  },
}[locale];

// Group published tests by asignatura, in the canonical asignatura order, and
// sort each group's tests by their related unit number.
type GroupedTest = {
  slug: AsignaturaSlug;
  shortLabel: string;
  title: string;
  tests: typeof tests;
};

const grouped: GroupedTest[] = ASIGNATURA_SLUGS.map((slug) => {
  const own = tests
    .filter((t) => t.data.asignatura === slug)
    .sort((a, b) => a.data.unidad_relacionada - b.data.unidad_relacionada);
  return {
    slug,
    shortLabel: ASIGNATURAS[slug].shortLabel,
    title: ASIGNATURAS[slug].title,
    tests: own,
  };
}).filter((g) => g.tests.length > 0);

const totalAsignaturas = grouped.length;
const totalPreguntas = tests.reduce((acc, t) => acc + t.data.preguntas.length, 0);

// A, B, C, D… labels for the options.
const OPTION_LABELS = ['A', 'B', 'C', 'D', 'E', 'F'];

// Only multiple-choice questions get a printable option list. Typed guard so the
// template narrows to the `opcion-multiple` variant (opciones/correcta present).
type PreguntaTest = (typeof tests)[number]['data']['preguntas'][number];
const esOpcionMultiple = (p: PreguntaTest): p is Extract<PreguntaTest, { tipo: 'opcion-multiple' }> =>
  p.tipo === 'opcion-multiple';
---

<BaseLayout
  title={copy.metaTitle}
  description={copy.metaDesc}
  contentLang={locale}
  noindex
>
  <div class="container">
    <nav class="breadcrumb no-print">
      <a href="/">{copy.inicio}</a> <span class="sep">›</span>
      <a href="/juegos/">{copy.juegos}</a> <span class="sep">›</span>
      <a href="/juegos/cajut/">Cajút</a> <span class="sep">›</span>
      <span>{copy.imprimir}</span>
    </nav>

    <header class="intro no-print">
      <span class="kicker">{copy.kicker}</span>
      <h1>Cajút <span class="serif-italic-wonk accent">{copy.enPapel}</span></h1>
      <p class="lede">
        {copy.ledePre}<strong>{copy.ledeStrong}</strong>{copy.ledePost}
        <a href="/juegos/cajut/" class="editorial-link">{copy.versionDigital}</a>.
      </p>
      <PrintButton />
    </header>

    <!-- Hoja 1: cómo se juega -->
    <section class="print-block">
      <h2>{copy.comoSeJuega}</h2>
      <ul class="rules">
        {copy.reglas.map((r) => (
          <li>{r.map((seg, i) => (i % 2 === 0 ? <strong>{seg}</strong> : <span>{seg}</span>))}</li>
        ))}
      </ul>
      <p class="hint">{copy.materialPre}{totalAsignaturas} {copy.asignaturas} · {totalPreguntas} {copy.preguntas}.</p>
    </section>

    <!-- Una hoja por asignatura -->
    {grouped.map((g) => (
      <section class="print-block">
        <h2>{g.shortLabel} <span class="count">({g.title})</span></h2>
        {g.tests.map((t) => (
          <div class="unit">
            <h3 class="unit-title">{copy.unidad} {t.data.unidad_relacionada} — {t.data.title}</h3>
            <ol class="q-list">
              {t.data.preguntas.filter(esOpcionMultiple).map((p) => (
                <li class="q">
                  <p class="q-text">{p.enunciado}</p>
                  <ol class="q-opts">
                    {p.opciones.map((op, oi) => (
                      <li class={`q-opt${oi === p.correcta ? ' correct' : ''}`}>
                        <span class="q-opt-label">{OPTION_LABELS[oi] ?? String(oi + 1)})</span>
                        {oi === p.correcta ? (
                          <span><strong>{op}</strong> <span class="check">✓</span></span>
                        ) : (
                          <span>{op}</span>
                        )}
                      </li>
                    ))}
                  </ol>
                  {p.explicacion && <p class="q-exp">{p.explicacion}</p>}
                </li>
              ))}
            </ol>
          </div>
        ))}
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .container { max-width: 920px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem) 4rem; }
  .breadcrumb { font-size: 0.92rem; color: var(--color-ink-mute); margin: 2rem 0; }
  .breadcrumb a { color: var(--color-ink-mute); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-terra); }
  .breadcrumb .sep { margin: 0 0.5em; color: var(--color-mustard); }
  .intro { margin-bottom: 2.5rem; }
  .kicker { font-family: var(--font-sans); font-size: .8rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--color-terra); }
  h1 { margin: .5rem 0 .8rem; }
  .accent { color: var(--color-terra); }
  .lede { font-size: 1.15rem; color: var(--color-ink-soft); line-height: 1.55; max-width: 60ch; }

  .print-block { margin: 0 0 3rem; }
  .print-block h2 { font-family: var(--font-serif); font-size: 1.5rem; font-weight: 500; margin: 0 0 1rem; padding-bottom: .4rem; border-bottom: 2px solid var(--color-terra); }
  .print-block h2 .count, .print-block h2 .kicker { font-size: 1rem; color: var(--color-ink-mute); }

  .rules { list-style: none; padding: 0; margin: 0 0 1rem; display: flex; flex-direction: column; gap: .55rem; }
  .rules li { padding-left: 1.1rem; position: relative; color: var(--color-ink); line-height: 1.5; }
  .rules li::before { content: "→"; position: absolute; left: 0; color: var(--color-mustard); }
  .hint { font-family: var(--font-mono); font-size: .78rem; color: var(--color-ink-mute); }

  /* Per-unit grouping inside an asignatura sheet. */
  .unit { margin: 0 0 1.6rem; }
  .unit-title { font-family: var(--font-serif); font-size: 1.1rem; font-weight: 500; color: var(--color-ink); margin: 0 0 .7rem; }

  /* Numbered question list. */
  .q-list { list-style: decimal; padding-left: 1.4rem; margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .q { line-height: 1.5; break-inside: avoid; }
  .q-text { margin: 0 0 .45rem; color: var(--color-ink); font-weight: 500; }
  .q-opts { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .25rem; }
  .q-opt { padding-left: 1.6rem; position: relative; color: var(--color-ink-soft); }
  .q-opt-label { position: absolute; left: 0; font-family: var(--font-mono); font-size: .85rem; color: var(--color-ink-mute); }
  .q-opt.correct { color: var(--color-ink); }
  .q-opt .check { color: var(--color-terra); font-weight: 700; }
  .q-exp { margin: .4rem 0 0; font-size: .85rem; font-style: italic; color: var(--color-ink-mute); line-height: 1.45; }

  @media print {
    :global(.site-header), :global(.site-footer), .no-print { display: none !important; }
    .container { max-width: none; padding: 0; }
    .print-block { margin: 0; break-inside: avoid; }
    .print-block + .print-block { break-before: page; }
    .q { break-inside: avoid; }
    @page { margin: 1.5cm; }
  }
</style>
