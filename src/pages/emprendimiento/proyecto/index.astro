---
/**
 * «De cero a empresa» — project index. Shows the three itineraries, the
 * transversal map, the phase cards, and the workbook PDF download.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import MapaTransversal from '@components/emprendimiento/MapaTransversal.astro';
import { ITINERARIOS } from '@/lib/emprendimiento';
import { getLocale } from '@/i18n/locale';
import { getCollection } from 'astro:content';

const locale = getLocale(Astro.currentLocale);
const esFases = (await getCollection('proyectoTransversal'))
  .filter((e) => e.data.estado === 'publicado' && e.data.lang === 'es')
  .sort((a, b) => a.data.fase - b.data.fase);
// Card fields (fase_label, title, duracion) come from the .ca.mdx sibling under 'ca'.
const caById = new Map(
  (await getCollection('proyectoTransversal'))
    .filter((e) => e.data.estado === 'publicado' && e.data.lang === 'ca')
    .map((e) => [e.id, e.data]),
);
const published = esFases.map((e) => ({
  fase: e.data.fase,
  valiente: e.data.valiente,
  data: locale === 'ca' ? (caById.get(`${e.id}.ca`) ?? e.data) : e.data,
}));

// The ★ "valiente" phase is shown apart, not in the numbered grid/map.
const fasesNumeradas = published.filter((e) => !e.valiente);
const faseValiente = published.find((e) => e.valiente) ?? null;

const fasesForMap = fasesNumeradas.map((e) => ({
  fase: e.fase,
  fase_label: e.data.fase_label,
  nucleo: e.data.nucleo,
  unidades: e.data.unidades_relacionadas,
}));

const caSuffix = locale === 'ca' ? '.ca' : '';
const pdfHref = `/downloads/emprendimiento-proyecto${caSuffix}.pdf`;
const copy = {
  es: {
    metaTitle: 'De cero a empresa — proyecto de emprendimiento transversal',
    metaDesc: 'Un proyecto modular y por niveles: el alumnado crea una empresa que resuelve un problema real, la valida con metodología lean y la pone a prueba. Transversal a todas las asignaturas.',
    bcInicio: 'Inicio', bcEmpr: 'Emprendimiento', bcCurrent: 'De cero a empresa',
    heroA: 'De cero a ', heroAccent: 'empresa', heroB: '.',
    lede: 'En equipo, vuestro alumnado crea una empresa que resuelve un problema real de su entorno, la valida saliendo a la calle y la pone a prueba con datos. Modular: lo montáis a vuestra medida.',
    downloadsLeadA: 'Descargad el ', downloadsLeadStrong: 'cuaderno del equipo', downloadsLeadB: ' y rellenadlo fase a fase, con sus plantillas visuales (Business Model Canvas, punto muerto…).',
    ctaAlumnoT: 'Cuaderno del alumno (para rellenar)', ctaAlumnoS: 'Una hoja por fase con plantilla visual en blanco',
    ctaProfeT: 'Cuaderno del profesor (con orientación)', ctaProfeS: 'El mismo, con orientación docente por fase',
    ctaGuiaT: 'Guía del proyecto en PDF', ctaGuiaS: 'Todas las fases explicadas · para el profe',
    h2Tres: 'Tres maneras de hacerlo', fasesLabel: 'Fases:',
    h2Cruza: 'Cómo cruza las asignaturas', h2Fases: 'Las fases',
    empty: 'Las fases se publicarán según se vayan completando.',
    nucleo: 'Núcleo', profundo: 'Profundización',
    h2Valiente: '¿Os atrevéis a vender de verdad?', valienteLabel: '★ Tier valiente · opcional', valienteCta: 'Ver la fase →',
  },
  ca: {
    metaTitle: 'De zero a empresa — projecte d\'emprenedoria transversal',
    metaDesc: "Un projecte modular i per nivells: l'alumnat crea una empresa que resol un problema real, la valida amb metodologia lean i la posa a prova. Transversal a totes les assignatures.",
    bcInicio: 'Inici', bcEmpr: 'Emprenedoria', bcCurrent: 'De zero a empresa',
    heroA: 'De zero a ', heroAccent: 'empresa', heroB: '.',
    lede: "En equip, el vostre alumnat crea una empresa que resol un problema real del seu entorn, la valida eixint al carrer i la posa a prova amb dades. Modular: ho munteu a la vostra mida.",
    downloadsLeadA: 'Descarregueu el ', downloadsLeadStrong: 'quadern de l\'equip', downloadsLeadB: ' i ompliu-lo fase a fase, amb les seues plantilles visuals (Business Model Canvas, punt mort…).',
    ctaAlumnoT: "Quadern de l'alumne (per a omplir)", ctaAlumnoS: 'Un full per fase amb plantilla visual en blanc',
    ctaProfeT: 'Quadern del professor (amb orientació)', ctaProfeS: 'El mateix, amb orientació docent per fase',
    ctaGuiaT: 'Guia del projecte en PDF', ctaGuiaS: 'Totes les fases explicades · per al profe',
    h2Tres: 'Tres maneres de fer-ho', fasesLabel: 'Fases:',
    h2Cruza: 'Com creua les assignatures', h2Fases: 'Les fases',
    empty: 'Les fases es publicaran a mesura que es completen.',
    nucleo: 'Nucli', profundo: 'Aprofundiment',
    h2Valiente: 'Vos atreviu a vendre de veritat?', valienteLabel: '★ Nivell valent · opcional', valienteCta: 'Veure la fase →',
  },
}[locale];
---

<BaseLayout title={copy.metaTitle} description={copy.metaDesc} contentLang={locale}>
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">{copy.bcInicio}</a> <span class="sep">›</span>
      <a href="/emprendimiento/">{copy.bcEmpr}</a> <span class="sep">›</span>
      <span>{copy.bcCurrent}</span>
    </nav>
  </div>

  <section class="hero">
    <div class="container">
      <h1>{copy.heroA}<span class="serif-italic-wonk accent">{copy.heroAccent}</span>{copy.heroB}</h1>
      <p class="lede">{copy.lede}</p>
      <p class="downloads-lead">{copy.downloadsLeadA}<strong>{copy.downloadsLeadStrong}</strong>{copy.downloadsLeadB}</p>
      <div class="downloads">
        <a class="download-cta download-cta--mustard" href={`/downloads/emprendimiento-cuaderno-alumno${caSuffix}.pdf`} download>
          <span class="download-cta__icon" aria-hidden="true">↓</span>
          <span class="download-cta__text">
            <strong>{copy.ctaAlumnoT}</strong>
            <span class="muted">{copy.ctaAlumnoS}</span>
          </span>
        </a>
        <a class="download-cta download-cta--mustard" href={`/downloads/emprendimiento-cuaderno-profesor${caSuffix}.pdf`} download>
          <span class="download-cta__icon" aria-hidden="true">↓</span>
          <span class="download-cta__text">
            <strong>{copy.ctaProfeT}</strong>
            <span class="muted">{copy.ctaProfeS}</span>
          </span>
        </a>
        <a class="download-cta" href={pdfHref} download>
          <span class="download-cta__icon" aria-hidden="true">↓</span>
          <span class="download-cta__text">
            <strong>{copy.ctaGuiaT}</strong>
            <span class="muted">{copy.ctaGuiaS}</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container container--narrow">
      <h2>{copy.h2Tres}</h2>
      <div class="itin-grid">
        {ITINERARIOS.map((it) => (
          <div class="itin">
            <h3>{it.label}</h3>
            <p>{it.descripcion}</p>
            {it.fases && <span class="itin__fases">{copy.fasesLabel} {it.fases.join(' · ')}</span>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="block block--alt">
    <div class="container container--narrow">
      <h2>{copy.h2Cruza}</h2>
      <MapaTransversal fases={fasesForMap} />
    </div>
  </section>

  <section class="block">
    <div class="container container--narrow">
      <h2>{copy.h2Fases}</h2>
      {fasesNumeradas.length === 0 ? (
        <p class="empty">{copy.empty}</p>
      ) : (
        <ul class="fase-cards">
          {fasesNumeradas.map((e) => (
            <li class={`fase-card ${e.data.nucleo ? 'is-nucleo' : 'is-profundo'}`}>
              <a href={`/emprendimiento/proyecto/${String(e.fase).padStart(2, '0')}`}>
                <span class="fase-card__label">{e.data.fase_label}</span>
                <span class="fase-card__title">{e.data.title}</span>
                <span class="fase-card__meta">{e.data.nucleo ? copy.nucleo : copy.profundo} · {e.data.duracion}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  {faseValiente && (
    <section class="block block--valiente">
      <div class="container container--narrow">
        <h2>{copy.h2Valiente}</h2>
        <a class="valiente-card" href={`/emprendimiento/proyecto/${String(faseValiente.fase).padStart(2, '0')}`}>
          <span class="valiente-card__label">{copy.valienteLabel}</span>
          <span class="valiente-card__title">{faseValiente.data.title}</span>
          <span class="valiente-card__desc">{faseValiente.data.entregable}</span>
          <span class="valiente-card__cta">{copy.valienteCta}</span>
        </a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .container { max-width: 1240px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem); }
  .container--narrow { max-width: 820px; }
  .breadcrumb { font-size: 0.92rem; color: var(--color-ink-mute); margin: 2rem 0; }
  .breadcrumb a { color: var(--color-ink-mute); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-terra); }
  .breadcrumb .sep { margin: 0 0.5em; color: var(--color-mustard); }
  .hero { padding: 1rem 0 clamp(2rem, 5vw, 3.5rem); }
  .kicker { font-family: var(--font-sans); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-terra-deep); }
  h1 { max-width: 18ch; margin: 0.6rem 0 0.8rem; }
  .accent { color: var(--color-terra); }
  .lede { font-family: var(--font-serif); font-style: italic; font-size: 1.35rem; color: var(--color-ink-soft); max-width: 54ch; margin: 1rem 0 1.5rem; line-height: 1.5; font-variation-settings: "SOFT" 80; }
  .downloads { display: flex; flex-wrap: wrap; gap: 1.2rem; }
  .download-cta { display: inline-flex; align-items: center; gap: 1rem; padding: 0.9rem 1.4rem 0.9rem 1.1rem; background: var(--color-terra); color: #fff; text-decoration: none; border-radius: 6px; transition: background .2s var(--ease-soft); }
  .download-cta:hover { background: var(--color-terra-deep); }
  .download-cta__icon { font-family: var(--font-serif); font-style: italic; font-size: 1.7rem; line-height: 1; color: var(--color-mustard-soft); }
  .download-cta__text { display: flex; flex-direction: column; gap: 0.15rem; }
  .download-cta__text strong { font-family: var(--font-sans); font-size: 0.95rem; font-weight: 600; }
  .download-cta__text .muted { font-family: var(--font-sans); font-size: 0.78rem; opacity: 0.75; }
  .download-cta--mustard { background: var(--color-mustard-deep); }
  .download-cta--mustard:hover { background: #8A6420; }
  .downloads-lead { margin: 0 0 1rem; color: var(--color-ink-soft); font-size: 1rem; }
  .block { padding: clamp(2rem, 5vw, 3.5rem) 0; }
  .block--alt { background: var(--color-bg-soft); border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); }
  h2 { margin: 0 0 1.5rem; }
  .itin-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 1.5rem; }
  .itin { background: var(--color-paper); border: 1px solid var(--color-line); border-radius: 6px; padding: 1.3rem 1.4rem; }
  .itin h3 { margin: 0 0 0.5rem; font-size: 1.2rem; }
  .itin p { color: var(--color-ink-soft); font-size: 0.95rem; line-height: 1.55; margin: 0 0 0.7rem; }
  .itin__fases { font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-ink-mute); }
  .block--valiente { background: var(--color-terra-soft); border-top: 1px solid var(--color-line); }
  .valiente-card { display: flex; flex-direction: column; gap: 0.4rem; background: var(--color-paper); border: 1px solid var(--color-line); border-radius: 6px; padding: 1.4rem 1.6rem; text-decoration: none; color: inherit; transition: transform .18s var(--ease-soft), box-shadow .18s var(--ease-soft); }
  .valiente-card:hover { transform: translateY(-2px); box-shadow: 0 4px 16px rgba(42,31,24,0.08); }
  .valiente-card__label { font-family: var(--font-sans); font-size: 0.74rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-terra-deep); }
  .valiente-card__title { font-family: var(--font-serif); font-size: 1.4rem; line-height: 1.2; color: var(--color-ink); }
  .valiente-card__desc { color: var(--color-ink-soft); font-size: 0.98rem; line-height: 1.55; }
  .valiente-card__cta { font-family: var(--font-sans); font-size: 0.9rem; font-weight: 600; color: var(--color-terra); margin-top: 0.2rem; }
  .fase-cards { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr)); gap: 1.2rem; }
  .fase-card a { display: flex; flex-direction: column; gap: 0.35rem; background: var(--color-paper); border: 1px solid var(--color-line); border-radius: 6px; padding: 1.2rem 1.3rem; text-decoration: none; color: inherit; transition: transform .18s var(--ease-soft), box-shadow .18s var(--ease-soft); }
  .fase-card a:hover { transform: translateY(-2px); box-shadow: 0 4px 16px rgba(42,31,24,0.08); }
  .fase-card__label { font-family: var(--font-sans); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-mustard-deep); }
  .fase-card__title { font-family: var(--font-serif); font-size: 1.15rem; line-height: 1.2; color: var(--color-ink); }
  .fase-card__meta { font-family: var(--font-sans); font-size: 0.8rem; color: var(--color-ink-mute); }
  .empty { color: var(--color-ink-soft); font-style: italic; font-family: var(--font-serif); }
</style>
