---
/**
 * Print-ready «Cuaderno del equipo» for «De cero a empresa».
 * Used by pagedjs-cli (scripts/build-cuaderno-pdf.mjs) to produce the dual
 * student/teacher workbook PDFs. Mustard accent (#D4A24C). noindex.
 */
import BloqueCuaderno from '@components/emprendimiento/BloqueCuaderno.astro';
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { getLocale } from '@/i18n/locale';
import { pickLocalizedEntry } from '@/i18n/content-locale';

export const getStaticPaths = (async () => {
  // ES-only print edition; CA .ca.mdx siblings must not double the phases.
  const fases = (await getCollection('proyectoTransversal'))
    .filter((f) => f.data.estado === 'publicado' && f.data.lang === 'es' && f.data.cuaderno)
    .sort((a, b) => a.data.fase - b.data.fase);
  const props = { fases };
  return [
    { params: { modo: 'alumno' }, props },
    { params: { modo: 'profesor' }, props },
  ];
}) satisfies GetStaticPaths;

const locale = getLocale(Astro.currentLocale);
const caById = new Map(
  (await getCollection('proyectoTransversal')).filter((f) => f.data.estado === 'publicado' && f.data.lang === 'ca' && f.data.cuaderno).map((f) => [f.id, f]),
);
const fases = Astro.props.fases.map((f) => pickLocalizedEntry(f, caById, locale));
const esProfesor = Astro.params.modo !== 'alumno';

const copy = {
  es: { edProfesor: 'Profesorado', edAlumno: 'Alumnado', cuadernoDel: 'Cuaderno del', eyebrow: 'De cero a empresa · Cuaderno del equipo', title: 'Vuestro proyecto, paso a paso', edicion: 'Edición', elEquipo: 'El equipo', nombreProyecto: 'Nombre del proyecto:', integrantes: 'Integrantes:', cursoGrupo: 'Curso y grupo:', lasFases: 'Las fases', entregable: 'Entregable:' },
  ca: { edProfesor: 'Professorat', edAlumno: 'Alumnat', cuadernoDel: 'Quadern del', eyebrow: 'De zero a empresa · Quadern de l\'equip', title: 'El vostre projecte, pas a pas', edicion: 'Edició', elEquipo: 'L\'equip', nombreProyecto: 'Nom del projecte:', integrantes: 'Integrants:', cursoGrupo: 'Curs i grup:', lasFases: 'Les fases', entregable: 'Lliurable:' },
}[locale];
const edicion = esProfesor ? copy.edProfesor : copy.edAlumno;
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{copy.eyebrow.split(' · ')[0]} — {copy.cuadernoDel} {edicion}</title>
    <style is:inline>
      @font-face { font-family: 'Fraunces'; src: url('/fonts/fraunces-latin-normal.woff2') format('woff2'); font-weight: 300 700; font-style: normal; font-display: swap; }
      @font-face { font-family: 'Fraunces'; src: url('/fonts/fraunces-latin-italic.woff2') format('woff2'); font-weight: 300 700; font-style: italic; font-display: swap; }
      @font-face { font-family: 'Switzer'; src: url('/fonts/switzer/switzer-400.woff2') format('woff2'); font-weight: 400; font-display: swap; font-style: normal; }
      @font-face { font-family: 'Switzer'; src: url('/fonts/switzer/switzer-500.woff2') format('woff2'); font-weight: 500; font-display: swap; font-style: normal; }
      @font-face { font-family: 'Switzer'; src: url('/fonts/switzer/switzer-600.woff2') format('woff2'); font-weight: 600; font-display: swap; font-style: normal; }
      @font-face { font-family: 'Switzer'; src: url('/fonts/switzer/switzer-700.woff2') format('woff2'); font-weight: 700; font-display: swap; font-style: normal; }
      @font-face { font-family: 'JetBrains Mono'; src: url('/fonts/jetbrains-mono-latin.woff2') format('woff2'); font-weight: 400 500; font-style: normal; font-display: swap; }
      :root {
        --color-bg: #FBF6EC; --color-paper: #FFFFFF; --color-ink: #2A1F18;
        --color-ink-soft: #5C4A3D; --color-ink-mute: #806C5A;
        --color-line: #E5D4BD; --color-line-soft: #EFE2CB;
        --color-mustard: #D4A24C; --color-mustard-deep: #A87A2A; --color-mustard-soft: #F5E5BC;
        --color-terra: #C44E2C;
        --font-serif: "Fraunces", Georgia, serif;
        --font-sans: "Switzer", -apple-system, sans-serif;
        --font-mono: "JetBrains Mono", monospace;
      }
      @page { size: A4; margin: 18mm 16mm 16mm; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: var(--font-sans); color: var(--color-ink); font-size: 10.5pt; line-height: 1.5; background: #fff; }
      .cover { display: flex; flex-direction: column; justify-content: center; height: 244mm; break-after: page; }
      .cover__eyebrow { color: var(--color-mustard-deep); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; font-size: 11pt; }
      .cover__title { font-family: var(--font-serif); font-size: 34pt; line-height: 1.05; margin: 0.4rem 0; }
      .cover__ed { font-style: italic; font-family: var(--font-serif); color: var(--color-ink-soft); font-size: 14pt; }
      .cover__equipo { margin-top: 2.2rem; border: 1.5px solid var(--color-line); border-radius: 6px; padding: 1.1rem 1.3rem; }
      .cover__equipo h3 { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-mustard-deep); margin: 0 0 0.7rem; }
      .cover__field { border-bottom: 1px dashed var(--color-line); height: 1.9rem; margin-bottom: 0.7rem; font-size: 0.9rem; color: var(--color-ink-mute); }
      .toc { break-after: page; }
      .toc h2 { font-family: var(--font-serif); font-size: 22pt; }
      .toc ol { padding-left: 1.3rem; line-height: 1.9; }
      .fase { break-before: page; min-height: 242mm; }
      .fase__label { color: var(--color-mustard-deep); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.78rem; }
      .fase__title { font-family: var(--font-serif); font-size: 20pt; margin: 0.2rem 0; }
      .fase__entregable { color: var(--color-ink-soft); font-style: italic; margin: 0 0 0.6rem; font-size: 0.95rem; }
    </style>
  </head>
  <body>
    <section class="cover">
      <div class="cover__eyebrow">{copy.eyebrow}</div>
      <div class="cover__title">{copy.title}</div>
      <div class="cover__ed">{copy.edicion} · {edicion}</div>
      <div class="cover__equipo">
        <h3>{copy.elEquipo}</h3>
        <div class="cover__field">{copy.nombreProyecto}</div>
        <div class="cover__field">{copy.integrantes}</div>
        <div class="cover__field">{copy.cursoGrupo}</div>
      </div>
    </section>

    <section class="toc">
      <h2>{copy.lasFases}</h2>
      <ol>{fases.map((f) => <li>{f.data.fase_label} — {f.data.title}</li>)}</ol>
    </section>

    {fases.map((f) => (
      <section class="fase">
        <div class="fase__label">{f.data.fase_label}</div>
        <h2 class="fase__title">{f.data.title}</h2>
        <p class="fase__entregable"><strong>{copy.entregable}</strong> {f.data.entregable}</p>
        {f.data.cuaderno && <BloqueCuaderno cuaderno={f.data.cuaderno} modo={esProfesor ? 'profesor' : 'alumno'} locale={locale} />}
      </section>
    ))}
  </body>
</html>
