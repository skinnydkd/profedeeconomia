---
import BaseLayout from '@layouts/BaseLayout.astro';
import { ASIGNATURAS, ASIGNATURA_SLUGS } from '@/lib/asignaturas';
import { ITINERARIOS } from '@/lib/emprendimiento';
import { getCollection } from 'astro:content';
import { getLocale } from '@/i18n/locale';
import { pickLocalizedEntry } from '@/i18n/content-locale';
import { localizeAsignatura } from '@/i18n/asignaturas-ca';
import { localizeItinerario } from '@/i18n/emprendimiento-ca';

const locale = getLocale(Astro.currentLocale);

const gpe = localizeAsignatura(ASIGNATURAS['gpe-bach'], locale);
const edmn = ASIGNATURAS['edmn-2bach'];

// The activity titles under «asignatura por asignatura» come from MDX
// frontmatter and stay ES until the content phase.
const copy = {
  es: {
    metaTitle: 'Emprendimiento',
    metaDesc:
      'La asignatura de emprendimiento puro (GPE) y «De cero a empresa», un proyecto transversal para llevar al aula en cualquier nivel.',
    bcInicio: 'Inicio',
    bcCurrent: 'Emprendimiento',
    heroAccent: 'Emprendimiento',
    heroTail: 'en el aula.',
    lede: 'El emprendimiento atraviesa todas mis asignaturas. Este es el sitio que lo reúne: un proyecto para montar con el alumnado a cualquier nivel, las dos materias que lo trabajan a fondo (GPE y EDMN) y el ángulo emprendedor de cada asignatura, todo enlazado a donde de verdad vive.',
    featEyebrow: 'El proyecto · Proyecto transversal',
    featTitle: 'De cero a empresa',
    featDescPre:
      'En equipo, el alumnado crea una empresa que resuelve un problema real, la valida saliendo a la calle y la pone a prueba con datos. Doce fases con',
    featDescStrong: 'cuaderno del alumno',
    featDescPost:
      'para rellenar —con sus plantillas visuales (Business Model Canvas, punto muerto…)— y los ejemplos, las entrevistas y el kit de actitud tejidos en cada paso.',
    featCta: 'Ver el proyecto y el cuaderno →',
    featAsideH: 'Modular: de un sprint a un curso entero',
    fases: (n: number) => `${n} fases`,
    fasesLibres: 'Las fases que elijas',
    materiasH: 'Las dos materias que lo trabajan a fondo',
    gpeEyebrow: 'Asignatura',
    gpeDesc:
      'La materia de emprendimiento puro de Bachillerato: del equipo y la idea al pitch final, con libro, cuaderno de proyecto, actividades y tests.',
    gpeCta: 'Ir a la asignatura →',
    edmnEyebrow: 'Capstone de 2.º BACH',
    edmnTitle: 'El plan de empresa de EDMN',
    edmnDesc:
      'El proyecto que recorre todo Empresa y Diseño de Modelos de Negocio: seis fases del equipo y el mercado al plan económico-financiero y el pitch, con plantillas para rellenar en cada paso.',
    edmnCta: 'Ver el capstone →',
    recursosH: 'Las herramientas, ya dentro del proyecto',
    recursosLeadPre: 'Estos recursos aparecen',
    recursosLeadStrong: 'integrados en la fase donde se usan',
    recursosLeadPost:
      ': los ejemplos en el modelo de negocio, la entrevista en la validación, el kit de actitud en las primeras fases. Aquí los tenéis también sueltos, como biblioteca de consulta.',
    indiceLead:
      'No reinventamos nada: el emprendimiento ya está dentro de cada materia. Aquí tienes el atajo a su proyecto-capstone y a sus actividades de proyecto, cada una enlazada a su asignatura.',
    recursosCards: [
      {
        href: '/emprendimiento/ejemplos/',
        eyebrow: 'Ejemplos con chispa',
        title: 'Empresas, 4P y BMC en acción',
        desc: 'Casos reales, ficticios divertidos y locales, con su marketing mix o su modelo de negocio rellenado. Espejos para vuestro proyecto.',
        cta: 'Ver ejemplos →',
      },
      {
        href: '/emprendimiento/actividades/',
        eyebrow: 'Kit de actitud',
        title: 'Perder la vergüenza',
        desc: 'Actividades cortas para atreverse a pedir, preguntar y hablar en público: la actitud que más cuesta y más vale al emprender.',
        cta: 'Abrir el kit →',
      },
      {
        href: '/emprendimiento/entrevista-emprendedores/',
        eyebrow: 'Proyecto',
        title: 'Entrevista a emprendedores',
        desc: 'El alumnado sale a la calle a entrevistar a propietarios de negocios locales. Guion, banco de preguntas y plantilla descargable.',
        cta: 'Ver el proyecto →',
      },
    ],
    indiceH: 'El emprendimiento, asignatura por asignatura',
    capstoneLink: 'Cuaderno de proyecto (capstone)',
  },
  ca: {
    metaTitle: 'Emprenedoria',
    metaDesc:
      "L'assignatura d'emprenedoria pura (GPE) i «De zero a empresa», un projecte transversal per a portar a l'aula en qualsevol nivell.",
    bcInicio: 'Inici',
    bcCurrent: 'Emprenedoria',
    heroAccent: 'Emprenedoria',
    heroTail: "a l'aula.",
    lede: "L'emprenedoria travessa totes les meues assignatures. Este és el lloc que la reunix: un projecte per a muntar amb l'alumnat a qualsevol nivell, les dues matèries que la treballen a fons (GPE i EDMN) i l'angle emprenedor de cada assignatura, tot enllaçat a on de veritat viu.",
    featEyebrow: 'El projecte · Projecte transversal',
    featTitle: 'De zero a empresa',
    featDescPre:
      "En equip, l'alumnat crea una empresa que resol un problema real, la valida eixint al carrer i la posa a prova amb dades. Dotze fases amb",
    featDescStrong: "quadern de l'alumne",
    featDescPost:
      'per a omplir —amb les seues plantilles visuals (Business Model Canvas, punt mort…)— i els exemples, les entrevistes i el kit d\'actitud teixits en cada pas.',
    featCta: 'Veure el projecte i el quadern →',
    featAsideH: "Modular: d'un sprint a un curs sencer",
    fases: (n: number) => `${n} fases`,
    fasesLibres: 'Les fases que tries',
    materiasH: 'Les dues matèries que la treballen a fons',
    gpeEyebrow: 'Assignatura',
    gpeDesc:
      "La matèria d'emprenedoria pura de Batxillerat: de l'equip i la idea al pitch final, amb llibre, quadern de projecte, activitats i tests.",
    gpeCta: "Anar a l'assignatura →",
    edmnEyebrow: 'Capstone de 2n BATX',
    edmnTitle: "El pla d'empresa d'EDMN",
    edmnDesc:
      "El projecte que recorre tota Empresa i Disseny de Models de Negoci: sis fases de l'equip i el mercat al pla economicofinancer i el pitch, amb plantilles per a omplir en cada pas.",
    edmnCta: 'Veure el capstone →',
    recursosH: 'Les ferramentes, ja dins del projecte',
    recursosLeadPre: 'Estos recursos apareixen',
    recursosLeadStrong: 'integrats en la fase on s\'usen',
    recursosLeadPost:
      ": els exemples en el model de negoci, l'entrevista en la validació, el kit d'actitud en les primeres fases. Ací els teniu també solts, com a biblioteca de consulta.",
    indiceLead:
      "No reinventem res: l'emprenedoria ja està dins de cada matèria. Ací tens la drecera al seu projecte-capstone i a les seues activitats de projecte, cada una enllaçada a la seua assignatura.",
    recursosCards: [
      {
        href: '/emprendimiento/ejemplos/',
        eyebrow: 'Exemples amb espurna',
        title: 'Empreses, 4P i BMC en acció',
        desc: 'Casos reals, ficticis divertits i locals, amb el seu marketing mix o el seu model de negoci omplit. Espills per al vostre projecte.',
        cta: 'Veure exemples →',
      },
      {
        href: '/emprendimiento/actividades/',
        eyebrow: "Kit d'actitud",
        title: 'Perdre la vergonya',
        desc: "Activitats curtes per a atrevir-se a demanar, preguntar i parlar en públic: l'actitud que més costa i més val en emprendre.",
        cta: 'Obrir el kit →',
      },
      {
        href: '/emprendimiento/entrevista-emprendedores/',
        eyebrow: 'Projecte',
        title: 'Entrevista a emprenedors',
        desc: "L'alumnat ix al carrer a entrevistar propietaris de negocis locals. Guió, banc de preguntes i plantilla descarregable.",
        cta: 'Veure el projecte →',
      },
    ],
    indiceH: "L'emprenedoria, assignatura per assignatura",
    capstoneLink: 'Quadern de projecte (capstone)',
  },
}[locale];

// Inverse index: the emprendimiento angle of every subject. We surface the
// project-type activities and the capstone projects (cuaderno de proyecto) that
// already live inside each asignatura — single source of truth, no duplication.
const actsAll = await getCollection('actividades');
const proyAll = await getCollection('proyecto');
// Drive off the Spanish entries and swap to the CA sibling under /ca — filtering
// by lang is REQUIRED, else both language versions of each project activity are
// listed (the collection holds ES and CA entries).
const actsCaById = new Map(
  actsAll.filter((x) => x.data.tipo === 'proyecto' && x.data.estado === 'publicado' && x.data.lang === 'ca').map((x) => [x.id, x]),
);
const proyectoActs = actsAll
  .filter((x) => x.data.tipo === 'proyecto' && x.data.estado === 'publicado' && x.data.lang === 'es')
  .map((x) => pickLocalizedEntry(x, actsCaById, locale));

const porAsignatura = ASIGNATURA_SLUGS
  .map((slug) => ({
    a: localizeAsignatura(ASIGNATURAS[slug], locale),
    acts: proyectoActs
      .filter((x) => x.data.asignatura === slug)
      .sort((x, y) => x.data.unidad_relacionada - y.data.unidad_relacionada),
    capstone: proyAll.some((x) => x.data.asignatura === slug && x.data.estado === 'publicado'),
  }))
  .filter((x) => x.a.estado === 'publicado' && (x.acts.length > 0 || x.capstone));
---

<BaseLayout
  title={copy.metaTitle}
  description={copy.metaDesc}
  contentLang={locale}
>
  <div class="container">
    <nav class="breadcrumb"><a href="/">{copy.bcInicio}</a> <span class="sep">›</span> <span>{copy.bcCurrent}</span></nav>
  </div>

  <section class="hero">
    <div class="container">
      <h1><span class="serif-italic-wonk accent">{copy.heroAccent}</span> {copy.heroTail}</h1>
      <p class="lede">
        {copy.lede}
      </p>
    </div>
  </section>

  <section class="feature">
    <div class="container">
      <a class="hero-card" href="/emprendimiento/proyecto/">
        <div class="hero-card__main">
          <span class="hero-card__eyebrow">{copy.featEyebrow}</span>
          <h2 class="hero-card__title serif">{copy.featTitle}</h2>
          <p class="hero-card__desc">
            {copy.featDescPre} <strong>{copy.featDescStrong}</strong> {copy.featDescPost}
          </p>
          <span class="hero-card__cta">{copy.featCta}</span>
        </div>
        <div class="hero-card__aside">
          <span class="hero-card__aside-h">{copy.featAsideH}</span>
          <ul class="itinerarios">
            {ITINERARIOS.map((raw) => {
              const it = localizeItinerario(raw, locale);
              return (
                <li class="itinerario">
                  <span class="itinerario__label">{it.label}</span>
                  <span class="itinerario__meta">{it.fases ? copy.fases(it.fases.length) : copy.fasesLibres}</span>
                </li>
              );
            })}
          </ul>
        </div>
      </a>
    </div>
  </section>

  <section class="cards">
    <div class="container">
      <h2 class="cards__h">{copy.materiasH}</h2>
      <div class="card-grid card-grid--2">
        <a class="card card--gpe" href={`/${gpe.slug}/`}>
          <span class="card__eyebrow">{copy.gpeEyebrow}</span>
          <h2 class="card__title serif">{gpe.title}</h2>
          <p class="card__desc">
            {copy.gpeDesc}
          </p>
          <span class="card__cta">{copy.gpeCta}</span>
        </a>

        <a class="card card--edmn" href={`/${edmn.slug}/proyecto/`}>
          <span class="card__eyebrow">{copy.edmnEyebrow}</span>
          <h2 class="card__title serif">{copy.edmnTitle}</h2>
          <p class="card__desc">
            {copy.edmnDesc}
          </p>
          <span class="card__cta">{copy.edmnCta}</span>
        </a>
      </div>
    </div>
  </section>

  <section class="recursos">
    <div class="container">
      <h2 class="recursos__h">{copy.recursosH}</h2>
      <p class="recursos__lead">
        {copy.recursosLeadPre} <strong>{copy.recursosLeadStrong}</strong>{copy.recursosLeadPost}
      </p>
      <div class="card-grid">
        {copy.recursosCards.map((c) => (
          <a class="card card--rec" href={c.href}>
            <span class="card__eyebrow">{c.eyebrow}</span>
            <h3 class="card__title serif">{c.title}</h3>
            <p class="card__desc">{c.desc}</p>
            <span class="card__cta">{c.cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="indice">
    <div class="container">
      <h2 class="indice__h">{copy.indiceH}</h2>
      <p class="indice__lead">
        {copy.indiceLead}
      </p>
      <div class="indice__grid">
        {porAsignatura.map((x) => (
          <div class={`materia c-${x.a.color}`}>
            <a class="materia__name" href={`/${x.a.slug}/`}>{x.a.title}</a>
            <span class="materia__level">{x.a.level}</span>
            <ul class="materia__links">
              {x.capstone && (
                <li><a href={`/${x.a.slug}/proyecto/`}>{copy.capstoneLink}</a></li>
              )}
              {x.acts.map((act) => (
                <li><a href={`/${x.a.slug}/actividades/`}>{act.data.title}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container { max-width: 1240px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem); }
  .breadcrumb { font-size: 0.92rem; color: var(--color-ink-mute); margin: 2rem 0; }
  .breadcrumb a { color: var(--color-ink-mute); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-terra); }
  .breadcrumb .sep { margin: 0 0.5em; color: var(--color-mustard); }
  .hero { padding: 1rem 0 clamp(2rem, 5vw, 3.5rem); }
  h1 { max-width: 22ch; margin: 0.6rem 0 0.8rem; }
  .accent { color: var(--color-terra); }
  .lede { font-family: var(--font-serif); font-style: italic; font-size: 1.4rem; color: var(--color-ink-soft); max-width: 56ch; margin: 1rem 0; line-height: 1.5; font-variation-settings: "SOFT" 80; }
  /* Featured project — «De cero a empresa» pulled out as the protagonist */
  .feature { padding: 0 0 clamp(2.5rem, 6vw, 4.5rem); }
  .hero-card { display: grid; grid-template-columns: 1.6fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: stretch; background: #fff; border: 1px solid var(--color-line); padding: clamp(1.75rem, 4vw, 2.75rem); text-decoration: none; color: inherit; transition: box-shadow 0.18s ease, transform 0.18s ease; }
  .hero-card:hover { box-shadow: 0 8px 30px rgba(42,31,24,0.1); transform: translateY(-2px); }
  .hero-card__eyebrow { font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-terra-ink); font-weight: 600; }
  .hero-card__title { font-size: clamp(2rem, 5vw, 2.9rem); line-height: 1.05; margin: 0.5rem 0 0.9rem; font-variation-settings: "SOFT" 80; }
  .hero-card__desc { color: var(--color-ink-soft); font-size: 1.075rem; line-height: 1.65; margin: 0 0 1.3rem; max-width: 52ch; }
  .hero-card__cta { font-size: 1rem; font-weight: 600; color: var(--color-terra); }
  .hero-card__aside { border-left: 1px solid var(--color-line); padding-left: clamp(1.5rem, 3vw, 2.25rem); display: flex; flex-direction: column; justify-content: center; }
  .hero-card__aside-h { font-family: var(--font-sans); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--color-ink-mute); font-weight: 600; margin-bottom: 1rem; line-height: 1.4; }
  .itinerarios { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.9rem; }
  .itinerario { display: flex; flex-direction: column; gap: 0.1rem; padding-left: 0.95rem; position: relative; }
  .itinerario::before { content: "→"; position: absolute; left: 0; color: var(--color-mustard); }
  .itinerario__label { font-family: var(--font-serif); font-size: 1.1rem; font-weight: 500; color: var(--color-ink); font-variation-settings: "SOFT" 80; }
  .itinerario__meta { font-size: 0.85rem; color: var(--color-ink-mute); }
  @media (max-width: 720px) {
    .hero-card { grid-template-columns: 1fr; }
    .hero-card__aside { border-left: 0; padding-left: 0; border-top: 1px solid var(--color-line); padding-top: 1.5rem; }
  }

  .cards { padding: 0 0 clamp(3rem, 7vw, 6rem); }
  .cards__h { font-size: 1.5rem; margin: 0 0 1.2rem; }
  .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 1.5rem; }
  .card-grid--2 { grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); }
  .card { display: block; background: #fff; border: 1px solid var(--color-line); padding: 1.6rem 1.75rem 1.4rem; text-decoration: none; color: inherit; transition: box-shadow 0.18s ease, transform 0.18s ease, border-color 0.18s ease; }
  .card:hover { box-shadow: 0 4px 18px rgba(42,31,24,0.08); transform: translateY(-2px); }
  .card__eyebrow { font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-mustard-deep); font-weight: 600; }
  .card--gpe .card__eyebrow { color: #8C2F39; }
  .card__title { font-size: 1.6rem; line-height: 1.1; margin: 0.5rem 0 0.75rem; font-variation-settings: "SOFT" 80; }
  .card__desc { color: var(--color-ink-soft); font-size: 1rem; line-height: 1.6; margin: 0 0 1rem; }
  .card__cta { font-size: 0.9rem; font-weight: 600; color: var(--color-terra); }
  .recursos { padding: 0 0 clamp(3rem, 7vw, 6rem); border-top: 1px solid var(--color-line); padding-top: clamp(2.5rem, 5vw, 4rem); }
  .recursos__h { font-size: 1.5rem; margin: 0 0 0.6rem; }
  .recursos__lead { max-width: 60ch; margin: 0 0 1.8rem; color: var(--color-ink-soft); font-size: 1rem; line-height: 1.6; }
  .card--rec .card__eyebrow { color: var(--color-terra-ink); }
  .card--rec .card__title { font-size: 1.35rem; }
  .card--edmn .card__eyebrow { color: var(--color-edmn-ink); }

  /* Inverse index — emprendimiento angle of each subject */
  .indice { padding: 0 0 clamp(3rem, 7vw, 6rem); border-top: 1px solid var(--color-line); padding-top: clamp(2.5rem, 5vw, 4rem); }
  .indice__h { font-size: 1.5rem; margin: 0 0 0.6rem; }
  .indice__lead { max-width: 64ch; margin: 0 0 1.8rem; color: var(--color-ink-soft); font-size: 1rem; line-height: 1.6; }
  .indice__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 1.2rem; }
  .materia { border: 1px solid var(--color-line); border-radius: 8px; padding: 1.1rem 1.3rem; background: var(--color-paper); }
  .materia.c-edmn { --card-color: var(--color-edmn); }
  .materia.c-eco1 { --card-color: var(--color-eco1); }
  .materia.c-eco4 { --card-color: var(--color-eco4); }
  .materia.c-fopp { --card-color: var(--color-fopp); }
  .materia.c-taller3 { --card-color: var(--color-taller3); }
  .materia.c-ipe1 { --card-color: var(--color-ipe1); }
  .materia.c-ipe2 { --card-color: var(--color-ipe2); }
  .materia.c-eeae { --card-color: var(--color-eeae); }
  .materia.c-gpe { --card-color: var(--color-gpe); }
  .materia__name { font-family: var(--font-serif); font-size: 1.15rem; font-weight: 500; color: var(--color-ink); text-decoration: none; display: block; }
  .materia__name:hover { color: var(--card-color); }
  .materia__level { font-family: var(--font-sans); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--color-ink-mute); font-weight: 600; }
  .materia__links { list-style: none; margin: 0.7rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .materia__links a { font-size: 0.92rem; color: var(--color-ink-soft); text-decoration: none; line-height: 1.4; }
  .materia__links a:hover { color: var(--card-color); }
  .materia__links li { padding-left: 0.9rem; position: relative; }
  .materia__links li::before { content: "→"; position: absolute; left: 0; color: var(--card-color); }
</style>
