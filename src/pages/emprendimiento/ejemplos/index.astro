---
import BaseLayout from '@layouts/BaseLayout.astro';
import EjemploEmpresa from '@components/emprendimiento/EjemploEmpresa.astro';
import { getLocale } from '@/i18n/locale';
import { getCollection } from 'astro:content';

const locale = getLocale(Astro.currentLocale);
const esEjemplos = (await getCollection('emprendimientoEjemplos'))
  .filter((e) => e.data.estado === 'publicado' && e.data.lang === 'es')
  .sort((a, b) => a.data.orden - b.data.orden || a.data.nombre.localeCompare(b.data.nombre));
const caById = new Map(
  (await getCollection('emprendimientoEjemplos'))
    .filter((e) => e.data.estado === 'publicado' && e.data.lang === 'ca')
    .map((e) => [e.id, e.data]),
);
const ejemplos = esEjemplos.map((e) => ({
  data: locale === 'ca' ? (caById.get(`${e.id}.ca`) ?? e.data) : e.data,
}));

const copy = {
  es: {
    metaTitle: 'Ejemplos de empresas con chispa',
    metaDesc: 'Casos trabajados de empresas (reales, ficticias y locales) con su marketing mix (4P) o su modelo de negocio (BMC) rellenado, para el proyecto de emprendimiento.',
    bcInicio: 'Inicio', bcEmpr: 'Emprendimiento', bcCurrent: 'Ejemplos con chispa',
    heroH1: 'Empresas con chispa',
    ledeA: 'Casos para ver el ', lede4p: 'marketing mix (4P)', ledeMid: ' y el ', ledeBmc: 'modelo de negocio (BMC)',
    ledeB: ' en acción: empresas reales que reconoces, startups inventadas con gracia y algún negocio del barrio. Úsalos como espejo para vuestro propio proyecto.',
    empty: 'Pronto, una galería de ejemplos con chispa.',
  },
  ca: {
    metaTitle: 'Exemples d\'empreses amb espurna',
    metaDesc: "Casos treballats d'empreses (reals, fictícies i locals) amb el seu marketing mix (4P) o el seu model de negoci (BMC) omplit, per al projecte d'emprenedoria.",
    bcInicio: 'Inici', bcEmpr: 'Emprenedoria', bcCurrent: 'Exemples amb espurna',
    heroH1: 'Empreses amb espurna',
    ledeA: 'Casos per a veure el ', lede4p: 'marketing mix (4P)', ledeMid: ' i el ', ledeBmc: 'model de negoci (BMC)',
    ledeB: ' en acció: empreses reals que reconeixes, startups inventades amb gràcia i algun negoci del barri. Usa\'ls com a espill per al vostre propi projecte.',
    empty: 'Pròximament, una galeria d\'exemples amb espurna.',
  },
}[locale];
---
<BaseLayout
  title={copy.metaTitle}
  description={copy.metaDesc}
  contentLang={locale}
>
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">{copy.bcInicio}</a> <span class="sep">›</span>
      <a href="/emprendimiento/">{copy.bcEmpr}</a> <span class="sep">›</span>
      <span>{copy.bcCurrent}</span>
    </nav>
  </div>

  <section class="hero">
    <div class="container">
      <h1>{copy.heroH1}</h1>
      <p class="lede">
        {copy.ledeA}<strong>{copy.lede4p}</strong>{copy.ledeMid}<strong>{copy.ledeBmc}</strong>{copy.ledeB}
      </p>
    </div>
  </section>

  <section class="grid">
    <div class="container">
      {ejemplos.length === 0
        ? <p class="empty">{copy.empty}</p>
        : ejemplos.map((e) => <EjemploEmpresa ejemplo={e.data} locale={locale} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .container { max-width: 920px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem); }
  .breadcrumb { font-size: 0.92rem; color: var(--color-ink-mute); margin: 2rem 0; }
  .breadcrumb a { color: var(--color-ink-mute); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-terra); }
  .breadcrumb .sep { margin: 0 0.5em; color: var(--color-mustard); }
  .hero { padding: 1rem 0 1rem; }
  .kicker { font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-terra-deep); }
  h1 { margin: 0.6rem 0 0.6rem; }
  .lede { font-family: var(--font-serif); font-style: italic; font-size: 1.3rem; line-height: 1.5; color: var(--color-ink-soft); max-width: 56ch; font-variation-settings: "SOFT" 80; }
  .grid { padding-bottom: clamp(3rem, 7vw, 6rem); }
  .empty { font-family: var(--font-serif); font-style: italic; color: var(--color-ink-mute); }
</style>
