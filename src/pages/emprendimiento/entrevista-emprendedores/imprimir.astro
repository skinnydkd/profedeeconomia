---
import '@/styles/global.css';
import { getLocale } from '@/i18n/locale';

const locale = getLocale(Astro.currentLocale);

// Question bank is content data (not the page's own editorial prose) and
// stays in ES for both locales, per the Fase 1 skeleton plan.
const obligatorias = [
  '¿Qué forma jurídica adoptaste y por qué? (autónomo, SL, SA…)',
  '¿Necesitabas financiación?',
  '¿Cuánta y cómo la conseguiste?',
  '¿Cuál es el coste más importante que tienes?',
  '¿Qué es lo más duro de emprender?',
  '¿Cuántas horas trabajas a la semana?',
  '¿Cuánto tiempo tardaste en obtener beneficios?',
  '¿Qué harías diferente si volvieras a empezar?',
  '¿Tienes alguna anécdota divertida o interesante como emprendedor/a?',
  '¿Qué consejo le darías a alguien que está pensando en emprender?',
];

const copy = {
  es: {
    title: 'Plantilla · Entrevista a emprendedores',
    h1: 'Entrevista a un emprendedor/a',
    sub: 'Economía · proyecto de emprendimiento',
    negocio: 'Nombre del negocio',
    nombreEmprendedor: 'Nombre del emprendedor/a',
    direccion: 'Dirección del negocio',
    alumno1: 'Alumno/a 1',
    alumno2: 'Alumno/a 2',
    h2Obligatorias: 'Preguntas obligatorias',
    h2Optativas: 'Preguntas optativas (elige 5)',
    numPregunta: 'Nº de pregunta: ____ ·',
    numPreguntaMuted: '(escribe la pregunta y la respuesta)',
    footer: 'profedeeconomia.es · material abierto CC BY-NC-SA · ¡gracias por su tiempo!',
  },
  ca: {
    title: 'Plantilla · Entrevista a emprenedors',
    h1: 'Entrevista a un emprenedor/a',
    sub: "Economia · projecte d'emprenedoria",
    negocio: 'Nom del negoci',
    nombreEmprendedor: "Nom de l'emprenedor/a",
    direccion: 'Adreça del negoci',
    alumno1: 'Alumne/a 1',
    alumno2: 'Alumne/a 2',
    h2Obligatorias: 'Preguntes obligatòries',
    h2Optativas: 'Preguntes optatives (tria 5)',
    numPregunta: 'Núm. de pregunta: ____ ·',
    numPreguntaMuted: '(escriu la pregunta i la resposta)',
    footer: 'profedeeconomia.es · material obert CC BY-NC-SA · gràcies pel seu temps!',
  },
}[locale];
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{copy.title}</title>
  </head>
  <body>
    <main class="sheet">
      <header class="head">
        <div class="brand">profedeeconomia.es</div>
        <h1>{copy.h1}</h1>
        <p class="sub">{copy.sub}</p>
      </header>

      <section class="datos">
        <div><span>{copy.negocio}</span><span class="line"></span></div>
        <div><span>{copy.nombreEmprendedor}</span><span class="line"></span></div>
        <div class="full"><span>{copy.direccion}</span><span class="line"></span></div>
        <div><span>{copy.alumno1}</span><span class="line"></span></div>
        <div><span>{copy.alumno2}</span><span class="line"></span></div>
      </section>

      <h2>{copy.h2Obligatorias}</h2>
      <ol class="preg" lang="es">
        {obligatorias.map((q) => (
          <li>
            <p class="q">{q}</p>
            <div class="ans"></div>
          </li>
        ))}
      </ol>

      <h2 class="break">{copy.h2Optativas}</h2>
      <ol class="preg">
        {[1, 2, 3, 4, 5].map(() => (
          <li>
            <p class="q">{copy.numPregunta} <span class="muted">{copy.numPreguntaMuted}</span></p>
            <div class="ans tall"></div>
          </li>
        ))}
      </ol>

      <footer class="foot">{copy.footer}</footer>
    </main>

    <script src="https://unpkg.com/pagedjs/dist/paged.polyfill.js"></script>
  </body>
</html>

<style is:global>
  @page { size: A4; margin: 14mm 15mm; }
  body { background: #fff; color: #2A1F18; margin: 0; font-family: var(--font-sans, system-ui); }
  .sheet { max-width: 180mm; margin: 0 auto; }
  .head { border-bottom: 2px solid var(--color-terra); padding-bottom: 4mm; margin-bottom: 5mm; }
  .brand { font-family: var(--font-mono); font-size: 8pt; letter-spacing: .1em; text-transform: uppercase; color: var(--color-terra); }
  .head h1 { font-family: var(--font-serif); font-size: 19pt; margin: 1mm 0 0; }
  .head .sub { font-size: 9pt; color: #5C4A3D; margin: 0.5mm 0 0; }
  .datos { display: grid; grid-template-columns: 1fr 1fr; gap: 3mm 6mm; margin-bottom: 6mm; }
  .datos .full { grid-column: 1 / -1; }
  .datos > div { display: flex; flex-direction: column; gap: 1mm; }
  .datos span:first-child { font-family: var(--font-mono); font-size: 7.5pt; text-transform: uppercase; letter-spacing: .06em; color: #8A7868; }
  .line { height: 6mm; border-bottom: 1px solid #C9B89E; }
  h2 { font-family: var(--font-serif); font-size: 13pt; color: var(--color-terra-deep); border-bottom: 1px solid #E5D4BD; padding-bottom: 1mm; margin: 6mm 0 3mm; }
  h2.break { break-before: page; }
  .preg { list-style: none; padding: 0; margin: 0; counter-reset: q; }
  .preg li { counter-increment: q; margin-bottom: 4mm; break-inside: avoid; }
  .preg .q { font-size: 10pt; font-weight: 600; margin: 0 0 1.5mm; }
  .preg .q::before { content: counter(q) ". "; color: var(--color-terra); }
  .muted { font-weight: 400; color: #8A7868; }
  .ans { height: 14mm; border: 1px dashed #C9B89E; border-radius: 3px; }
  .ans.tall { height: 20mm; }
  .foot { margin-top: 6mm; font-family: var(--font-mono); font-size: 7.5pt; color: #8A7868; text-align: center; }
</style>
