---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getLocale } from '@/i18n/locale';
import { pickLocalizedEntry } from '@/i18n/content-locale';
import { getCollection, render } from 'astro:content';

const locale = getLocale(Astro.currentLocale);
// ES entries drive order; each renders its CA sibling body inline under 'ca'.
const esEntries = (await getCollection('emprendimientoActividades'))
  .filter((a) => a.data.estado === 'publicado' && a.data.lang === 'es')
  .sort((a, b) => a.data.orden - b.data.orden || a.data.title.localeCompare(b.data.title));
const caById = new Map(
  (await getCollection('emprendimientoActividades'))
    .filter((a) => a.data.estado === 'publicado' && a.data.lang === 'ca')
    .map((a) => [a.id, a]),
);
const entries = esEntries.map((a) => pickLocalizedEntry(a, caById, locale));
const rendered = await Promise.all(entries.map(async (a) => ({ a, Content: (await render(a)).Content })));

const copy = {
  es: {
    metaTitle: 'Kit de actitud emprendedora',
    metaDesc: 'Actividades para trabajar la actitud emprendedora: perder la vergüenza a pedir y a hablar en público, pitch, negociar. Para usar tal cual en clase.',
    bcInicio: 'Inicio', bcEmpr: 'Emprendimiento', bcCurrent: 'Kit de actitud',
    heroH1: 'Perder la vergüenza (y otras valentías)',
    ledeA: 'Emprender es, sobre todo, atreverse: ',
    ledeStrong: 'pedir, preguntar, hablar en público, decir que no, negociar',
    ledeB: '. Estas actividades cortas entrenan esa actitud antes (y durante) el proyecto.',
    trabaja: 'Trabaja:',
    empty: 'Pronto, un kit de actividades para perder la vergüenza.',
  },
  ca: {
    metaTitle: "Kit d'actitud emprenedora",
    metaDesc: "Activitats per a treballar l'actitud emprenedora: perdre la vergonya a demanar i a parlar en públic, pitch, negociar. Per a usar tal qual a classe.",
    bcInicio: 'Inici', bcEmpr: 'Emprenedoria', bcCurrent: "Kit d'actitud",
    heroH1: 'Perdre la vergonya (i altres valenties)',
    ledeA: 'Emprendre és, sobretot, atrevir-se: ',
    ledeStrong: 'demanar, preguntar, parlar en públic, dir que no, negociar',
    ledeB: '. Estes activitats curtes entrenen eixa actitud abans (i durant) el projecte.',
    trabaja: 'Treballa:',
    empty: "Pròximament, un kit d'activitats per a perdre la vergonya.",
  },
}[locale];
---
<BaseLayout
  title={copy.metaTitle}
  description={copy.metaDesc}
  contentLang={locale}
>
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">{copy.bcInicio}</a> <span class="sep">›</span>
      <a href="/emprendimiento/">{copy.bcEmpr}</a> <span class="sep">›</span>
      <span>{copy.bcCurrent}</span>
    </nav>
  </div>

  <section class="hero">
    <div class="container">
      <h1>{copy.heroH1}</h1>
      <p class="lede">
        {copy.ledeA}<strong>{copy.ledeStrong}</strong>{copy.ledeB}
      </p>
    </div>
  </section>

  <section class="list">
    <div class="container">
      {rendered.length === 0
        ? <p class="empty">{copy.empty}</p>
        : rendered.map(({ a, Content }) => (
          <article class="act">
            <h2 class="act__title">{a.data.title}</h2>
            <p class="act__meta">
              <strong>{copy.trabaja}</strong> {a.data.objetivo}
              {a.data.duracion && <> · {a.data.duracion}</>}
              {a.data.agrupacion && <> · {a.data.agrupacion}</>}
            </p>
            <div class="act__body"><Content /></div>
          </article>
        ))}
    </div>
  </section>
</BaseLayout>

<style>
  .container { max-width: 760px; margin: 0 auto; padding: 0 clamp(1.5rem, 4vw, 3rem); }
  .breadcrumb { font-size: 0.92rem; color: var(--color-ink-mute); margin: 2rem 0; }
  .breadcrumb a { color: var(--color-ink-mute); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-terra); }
  .breadcrumb .sep { margin: 0 0.5em; color: var(--color-mustard); }
  .hero { padding: 1rem 0 1rem; }
  .kicker { font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-terra-deep); }
  h1 { margin: 0.6rem 0 0.6rem; }
  .lede { font-family: var(--font-serif); font-style: italic; font-size: 1.3rem; line-height: 1.5; color: var(--color-ink-soft); max-width: 52ch; font-variation-settings: "SOFT" 80; }
  .list { padding-bottom: clamp(3rem, 7vw, 6rem); }
  .act { border-top: 1px solid var(--color-line); padding: 2rem 0; }
  .act__title { font-size: 1.5rem; margin: 0 0 0.4rem; }
  .act__meta { font-family: var(--font-sans); font-size: 0.92rem; color: var(--color-ink-mute); margin: 0 0 1rem; }
  .act__meta strong { color: var(--color-terra-deep); }
  .act__body { font-size: 1.08rem; line-height: 1.7; }
  .empty { font-family: var(--font-serif); font-style: italic; color: var(--color-ink-mute); }
</style>
