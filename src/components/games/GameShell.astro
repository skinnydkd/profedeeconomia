---
import BaseLayout from '@layouts/BaseLayout.astro';
import PuenteUnidades from '@components/emprendimiento/PuenteUnidades.astro';
import { JUEGOS } from '@/lib/juegos';
import { getLocale } from '@/i18n/locale';
interface Props { title: string; wide?: boolean; slug?: string; }
const { title, wide = false, slug } = Astro.props;
const juego = slug ? JUEGOS.find((j) => j.slug === slug) : undefined;
const locale = getLocale(Astro.currentLocale);
// Shell chrome is localized here. The curricular panel (PuenteUnidades unit
// titles) stays ES for now — it derives from book content (later phase).
const copy = {
  es: { desc: `${title} — juego de profedeeconomia.es`, back: '← Volver a Juegos', paraProfe: 'Para el profe', compClave: 'Competencias clave:', imprimir: 'Versión para imprimir →' },
  ca: { desc: `${title} — joc de profedeeconomia.es`, back: '← Torna a Jocs', paraProfe: 'Per al profe', compClave: 'Competències clau:', imprimir: 'Versió per a imprimir →' },
}[locale];
---
<BaseLayout title={title} description={copy.desc} contentLang={locale}>
  <div class={`game-shell${wide ? ' game-shell--wide' : ''}`}>
    <a class="game-exit" href="/juegos/">{copy.back}</a>
    <slot />
    {juego && (
      <section class="game-ficha">
        <h2>{copy.paraProfe}</h2>
        <PuenteUnidades unidades={juego.unidades_relacionadas} />
        {juego.competencias_clave.length > 0 && (
          <p class="game-comp"><strong>{copy.compClave}</strong> {juego.competencias_clave.join(' · ')}</p>
        )}
        {juego.imprimible && (
          <p class="game-print"><a href={`/juegos/${juego.slug}/imprimir/`}>{copy.imprimir}</a></p>
        )}
      </section>
    )}
  </div>
</BaseLayout>
<style>
  .game-shell { max-width: 720px; margin: 0 auto; padding: 1rem clamp(1rem, 4vw, 2rem) 4rem; }
  .game-shell--wide { max-width: 1180px; }
  .game-exit { display: inline-block; margin: 1rem 0; color: var(--color-ink-mute); text-decoration: none; font-size: .92rem; }
  .game-exit:hover { color: var(--color-terra); }
  .game-ficha { max-width: 820px; margin: 3rem auto 0; padding-top: 1.5rem; border-top: 1px solid var(--color-line); }
  .game-ficha h2 { font-family: var(--font-serif); font-size: 1.4rem; font-weight: 500; margin: 0 0 0.5rem; }
  .game-comp { color: var(--color-ink-soft); margin-top: 0.8rem; }
  .game-print { margin-top: 1rem; }
  .game-print a { color: var(--color-terra); font-weight: 600; text-decoration: none; }
  .game-print a:hover { text-decoration: underline; }
</style>
