---
/**
 * Rubric an activity hands out: one row per criterion, one column per level.
 * It sits inside `.prose` on the web and `.act__body` in the printable
 * workbook, which already style tables; the screen rule below only keeps five
 * columns readable in the narrow reading column.
 */
import type { Locale } from '@/i18n/locale';
interface Props { rubrica: { criterio: string; niveles: string[] }[]; locale?: Locale }
const { rubrica, locale = 'es' } = Astro.props;
const copy = {
  es: { titulo: 'Rúbrica', criterio: 'Criterio', niveles: ['Insuficiente', 'Suficiente', 'Notable', 'Excelente'] },
  ca: { titulo: 'Rúbrica', criterio: 'Criteri', niveles: ['Insuficient', 'Suficient', 'Notable', 'Excel·lent'] },
}[locale];
---
{rubrica.length > 0 && (
  <>
    <h2>{copy.titulo}</h2>
    <div class="tabla-scroll" role="region" tabindex="0" aria-label={copy.titulo}>
      <table class="rubrica-niveles">
        <thead>
          <tr><th scope="col">{copy.criterio}</th>{copy.niveles.map((n) => <th scope="col">{n}</th>)}</tr>
        </thead>
        <tbody>
          {rubrica.map((r) => (
            <tr><th scope="row">{r.criterio}</th>{r.niveles.map((n) => <td>{n}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>
  </>
)}
<style>
  @media screen {
    .rubrica-niveles { font-size: 0.82em; line-height: 1.45; min-width: 38rem; }
    .rubrica-niveles :is(th, td) { padding: 0.55em 0.65em; }
    .rubrica-niveles tbody th { text-transform: none; letter-spacing: 0; font-size: inherit; }
  }
</style>
