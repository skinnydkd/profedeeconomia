---
/**
 * Wrapper for any inline SVG / illustration with caption and optional
 * source attribution. Used to keep figures consistent across units.
 *
 *   <Diagram caption="Las cuatro funciones de la empresa" source="LOMLOE RD 243/2022">
 *     <PorterForces />
 *   </Diagram>
 */
type Props = {
  caption: string;
  source?: string;
  /** "default" centers the figure with full width; "tight" keeps it within text width. */
  variant?: 'default' | 'tight';
  /** Stable id used by capture-diagrams.mjs to name the PNG for slide output. */
  id?: string;
};

import { getLocale } from '@/i18n/locale';
import { t } from '@/i18n/ui';

const { caption, source, variant = 'default', id } = Astro.props;
const locale = getLocale(Astro.currentLocale);
---

<figure
  class:list={['diagram', `diagram--${variant}`]}
  data-slide-diagram={id ?? ''}
>
  {/* Focusable so the keyboard can scroll it when it is enlarged on a phone. */}
  <div class="diagram__inner" tabindex="0" role="group" aria-label={caption}>
    <slot />
  </div>
  <button
    type="button"
    class="diagram__zoom"
    data-diagram-zoom
    aria-expanded="false"
    data-open={t('libro.ampliar', locale)}
    data-close={t('libro.cerrarGrafico', locale)}
  >{t('libro.ampliar', locale)}</button>
  <figcaption class="diagram__caption">
    <span class="diagram__caption-text">{caption}</span>
    {source && <span class="diagram__caption-source">{t('libro.fuente', locale)} {source}</span>}
  </figcaption>
</figure>

<style>
  .diagram {
    margin: 2.6rem 0;
    padding: 1.5rem 1.6rem 1.2rem;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 6px;
    box-shadow: 0 1px 2px rgba(42, 31, 24, 0.04), 0 4px 14px rgba(42, 31, 24, 0.05);
  }
  .diagram--tight { max-width: var(--measure-prose); }

  .diagram__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow-x: auto;
  }
  .diagram__inner :global(svg) {
    width: 100%;
    height: auto;
    max-width: 100%;
    display: block;
  }

  .diagram__caption {
    margin-top: 0.9rem;
    padding-top: 0.7rem;
    border-top: 1px dashed var(--color-line);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--color-ink-soft);
    text-align: center;
    font-variation-settings: "SOFT" 80;
  }
  .diagram__caption-text { display: block; }
  .diagram__caption-source {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.78rem;
    color: var(--color-ink-mute);
    font-style: italic;
  }

  .diagram__zoom { display: none; }

  /* On a phone the drawing fits the screen whole, so the model reads at a
     glance; its 780–880-unit viewBox leaves the labels small, so a button opens
     it full screen at a readable width, scrolling both ways. Screen only: the
     A5 book PDF is narrower than 600 px and must not get the button. */
  @media screen and (max-width: 600px) {
    .diagram { padding: 0.75rem 0.75rem 0.9rem; }
    .diagram__zoom {
      display: block;
      margin: 0.6rem 0 0 auto;
      min-height: 44px;
      padding: 0 0.9rem;
      font-family: var(--font-sans);
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--color-terra-deep);
      background: var(--color-paper);
      border: 1px solid var(--color-line);
      border-radius: 4px;
      cursor: pointer;
    }
    .diagram__zoom:active { background: var(--color-bg-soft); }

    .diagram.is-zoomed {
      position: fixed;
      inset: 0;
      z-index: 1000;
      margin: 0;
      border: 0;
      border-radius: 0;
      display: flex;
      flex-direction: column;
      padding: 0.75rem;
      padding-top: calc(0.75rem + env(safe-area-inset-top, 0px));
      background: var(--color-paper);
    }
    .diagram.is-zoomed .diagram__inner {
      flex: 1;
      overflow: auto;
      justify-content: flex-start;
      align-items: flex-start;
    }
    .diagram.is-zoomed .diagram__inner :global(svg) { min-width: 820px; max-width: none; }
    .diagram.is-zoomed .diagram__zoom { order: -1; margin: 0 0 0.6rem auto; }
    .diagram.is-zoomed .diagram__caption { margin-top: 0.5rem; font-size: 0.85rem; }
  }

  @media print {
    .diagram__zoom { display: none; }
    .diagram {
      box-shadow: none;
      break-inside: avoid;
      page-break-inside: avoid;
    }
  }
</style>

<script>
  // One listener for every diagram on the page: the button toggles the full-screen view.
  function setZoom(fig: Element, on: boolean) {
    const btn = fig.querySelector<HTMLButtonElement>('[data-diagram-zoom]');
    if (!btn) return;
    fig.classList.toggle('is-zoomed', on);
    btn.setAttribute('aria-expanded', String(on));
    btn.textContent = (on ? btn.dataset.close : btn.dataset.open) ?? '';
    document.documentElement.style.overflow = on ? 'hidden' : '';
    if (!on) fig.scrollIntoView({ block: 'nearest' });
  }
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element | null)?.closest('[data-diagram-zoom]');
    const fig = btn?.closest('.diagram');
    if (fig) setZoom(fig, !fig.classList.contains('is-zoomed'));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const fig = document.querySelector('.diagram.is-zoomed');
    if (fig) setZoom(fig, false);
  });
</script>
