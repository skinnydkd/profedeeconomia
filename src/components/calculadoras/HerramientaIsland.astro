---
/**
 * Renders the interactive island that matches `componente`. Single source of the
 * island dispatch, shared by the per-asignatura recurso page and the transversal
 * «Herramientas» toolbox detail page. Add new identifiers here as components ship.
 */
import PuntoMuertoCalc from '@components/calculadoras/PuntoMuertoCalc.tsx';
import VANTIRCalc from '@components/calculadoras/VANTIRCalc.tsx';
import RatiosCalc from '@components/calculadoras/RatiosCalc.tsx';
import ADASSimulator from '@components/calculadoras/ADASSimulator.tsx';
import InteresCompuestoCalc from '@components/calculadoras/InteresCompuestoCalc.tsx';
import CalculadoraNominaESO from '@components/calculadoras/CalculadoraNominaESO.tsx';
import CalculadoraPresupuesto503020 from '@components/calculadoras/CalculadoraPresupuesto503020.tsx';
import BuscadorItinerarios from '@components/calculadoras/BuscadorItinerarios.tsx';
import GeneradorCVEuropass from '@components/calculadoras/GeneradorCVEuropass.tsx';
import DCFCalc from '@components/calculadoras/DCFCalc.tsx';
import RatiosBenchmark from '@components/calculadoras/RatiosBenchmark.tsx';
import ElasticidadCalc from '@components/calculadoras/ElasticidadCalc.tsx';
import MultiplicadorGasto from '@components/calculadoras/MultiplicadorGasto.tsx';
import IRPFDeclaracion from '@components/calculadoras/IRPFDeclaracion.tsx';
import CocheVsAlternativa from '@components/calculadoras/CocheVsAlternativa.tsx';
import RIASECTest from '@components/calculadoras/RIASECTest.tsx';
import PresupuestoUni from '@components/calculadoras/PresupuestoUni.tsx';
import ProductividadCalc from '@components/calculadoras/ProductividadCalc.tsx';
import EquilibrioCalc from '@components/calculadoras/EquilibrioCalc.tsx';
import DAFOCanvas from '@components/calculadoras/DAFOCanvas.tsx';
import BusinessModelCanvas from '@components/calculadoras/BusinessModelCanvas.tsx';
import MatrizBCG from '@components/calculadoras/MatrizBCG.tsx';
import TasasEPACalc from '@components/calculadoras/TasasEPACalc.tsx';
import MatrizDecision from '@components/calculadoras/MatrizDecision.tsx';

import { getLocale, type Locale } from '@/i18n/locale';
import { t } from '@/i18n/ui';

/**
 * `locale` defaults to the locale of the page the island is on. Most call
 * sites are `<HerramientaIsland componente="…" />` inside a unit body, which
 * cannot reach `Astro.currentLocale` itself, so without this a Valencian unit
 * rendered a Spanish tool. Pass the prop explicitly to override — the slide
 * decks never mount this component, so nothing depends on the old ES default.
 */
interface Props { componente?: string; locale?: Locale }
const { componente, locale = getLocale(Astro.currentLocale) } = Astro.props;
---
<div class="hi__web">
{componente === 'PuntoMuerto' && <PuntoMuertoCalc client:load locale={locale} />}
{componente === 'VANTIR' && <VANTIRCalc client:load locale={locale} />}
{componente === 'Ratios' && <RatiosCalc client:load locale={locale} />}
{componente === 'ADASSimulator' && <ADASSimulator client:load locale={locale} />}
{componente === 'InteresCompuesto' && <InteresCompuestoCalc client:load locale={locale} />}
{componente === 'NominaESO' && <CalculadoraNominaESO client:load locale={locale} />}
{componente === 'Presupuesto503020' && <CalculadoraPresupuesto503020 client:load locale={locale} />}
{componente === 'BuscadorItinerarios' && <BuscadorItinerarios client:load locale={locale} />}
{componente === 'GeneradorCVEuropass' && <GeneradorCVEuropass client:load locale={locale} />}
{componente === 'DCF' && <DCFCalc client:load locale={locale} />}
{componente === 'RatiosBenchmark' && <RatiosBenchmark client:load locale={locale} />}
{componente === 'Elasticidad' && <ElasticidadCalc client:load locale={locale} />}
{componente === 'MultiplicadorGasto' && <MultiplicadorGasto client:load locale={locale} />}
{componente === 'IRPFDeclaracion' && <IRPFDeclaracion client:load locale={locale} />}
{componente === 'CocheVsAlternativa' && <CocheVsAlternativa client:load locale={locale} />}
{componente === 'RIASEC' && <RIASECTest client:load locale={locale} />}
{componente === 'PresupuestoUni' && <PresupuestoUni client:load locale={locale} />}
{componente === 'Productividad' && <ProductividadCalc client:load locale={locale} />}
{componente === 'EquilibrioMercado' && <EquilibrioCalc client:load locale={locale} />}
{componente === 'DAFO' && <DAFOCanvas client:load locale={locale} />}
{componente === 'CanvasBM' && <BusinessModelCanvas client:load locale={locale} />}
{componente === 'BCG' && <MatrizBCG client:load locale={locale} />}
{componente === 'TasasEPA' && <TasasEPACalc client:load locale={locale} />}
{componente === 'MatrizDecision' && <MatrizDecision client:load locale={locale} />}
</div>
<p class="hi__print">{t('island.print', locale)}</p>

<style>
  .hi__print { display: none; }
  @media print {
    .hi__web { display: none !important; }
    .hi__print { display: block; font-family: var(--font-sans); font-style: italic; font-size: 9pt; color: var(--color-ink-mute); margin: 2mm 0; padding-left: 3mm; border-left: 2pt solid var(--color-mustard); }
  }
</style>
