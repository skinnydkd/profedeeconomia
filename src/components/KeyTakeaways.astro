---
import { getLocale } from '@/i18n/locale';
import { t } from '@/i18n/ui';
const locale = getLocale(Astro.currentLocale);
/**
 * Visual block to summarise key takeaways at the end of a long section
 * or before moving to the next concept. Encourages the reader to stop
 * and consolidate before continuing.
 *
 *   <KeyTakeaways title="En resumen">
 *     - Punto uno
 *     - Punto dos
 *     - Punto tres
 *   </KeyTakeaways>
 */
type Props = {
  title?: string;
  /** "key", "warning" or "checklist". Default key. */
  variant?: 'key' | 'warning' | 'checklist';
};

const { title, variant = 'key' } = Astro.props;
---

<div class:list={['takeaways', `takeaways--${variant}`]}>
  {/* Only functional signs: the decorative ✱ of the key variant is gone (de-slop rule 4). */}
  {variant !== 'key' && (
    <span class="takeaways__icon" aria-hidden="true">{variant === 'warning' ? '!' : '✓'}</span>
  )}
  <span class="takeaways__label">{title ?? t('libro.enResumen', locale)}</span>
  <div class="takeaways__body">
    <slot />
  </div>
</div>

<style>
  .takeaways {
    margin: 2.6rem 0;
    padding: 1.4rem 1.7rem 1.5rem 4rem;
    background: var(--caja-definicion);
    border-radius: 6px;
    position: relative;
  }
  .takeaways--key { padding-left: 1.7rem; }
  .takeaways--warning { background: var(--caja-aviso); }
  .takeaways--checklist { background: var(--caja-practica); border: 1px solid var(--caja-practica-borde); }

  .takeaways__icon {
    position: absolute;
    top: 1.4rem;
    left: 1.4rem;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-terra-deep);
    color: var(--color-paper);
    border-radius: 50%;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1rem;
    font-weight: 600;
    font-variation-settings: "SOFT" 100, "WONK" 1;
  }

  .takeaways__label {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-terra-deep);
    font-weight: 700;
    display: block;
    margin-bottom: 0.5rem;
  }

  .takeaways__body {
    font-family: var(--font-sans);
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--color-ink);
  }
  .takeaways__body :global(ul) {
    list-style: none;
    padding-left: 0;
    margin: 0;
  }
  .takeaways__body :global(ul li) {
    position: relative;
    padding: 0.3rem 0 0.3rem 1.2rem;
    border-bottom: 1px dashed var(--color-line);
  }
  .takeaways__body :global(ul li:last-child) { border-bottom: none; }
  .takeaways__body :global(ul li::before) {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-mustard-deep);
    font-weight: 600;
  }
  .takeaways--warning .takeaways__body :global(ul li::before) { color: var(--color-terra); }
  .takeaways--checklist .takeaways__body :global(ul li::before) { content: "✓"; color: #4F8C3F; }

  .takeaways__body :global(p) { margin: 0 0 0.7em; }
  .takeaways__body :global(p:last-child) { margin-bottom: 0; }
  .takeaways__body :global(strong) { color: var(--color-ink); }

  /* No drop cap */
  .takeaways__body :global(p::first-letter) {
    font-family: inherit;
    font-weight: inherit;
    font-size: inherit;
    line-height: inherit;
    float: none;
    padding: 0;
    color: inherit;
  }

  /* Phones: reclaim width from the box padding. Screen only so the A5 PDF is untouched. */
  @media screen and (max-width: 600px) {
    .takeaways { padding: 1.1rem 1rem 1.1rem 3.4rem; }
    .takeaways--key { padding-left: 1rem; }
    .takeaways__icon { top: 1.1rem; left: 0.8rem; }
  }
  @media print {
    .takeaways { break-inside: avoid; page-break-inside: avoid; }
  }
</style>
