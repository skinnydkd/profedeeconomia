---
/**
 * Comparative advantage and gains from trade (Eco 1BACH · SolvedExercise 12.1).
 *
 * Part A: a 2x2 table of HOURS needed to produce one unit (lower = more
 * efficient) for Norpaís and Surpaís across two goods (trigo, tela).
 *   Norpaís: trigo 2 h, tela 4 h   ·   Surpaís: trigo 5 h, tela 6 h.
 * Norpaís has an ABSOLUTE advantage in both (2<5, 4<6), yet COMPARATIVE
 * advantage splits the goods: the opportunity cost of 1 t de trigo is
 * 2/4 = 0,5 m de tela in Norpaís vs 5/6 ≈ 0,83 m de tela in Surpaís, so
 * Norpaís specialises in trigo and Surpaís in tela. Those cells are
 * highlighted in the table.
 * Part B: two stacked horizontal bars comparing total trigo output (100 h per
 * country) without trade (50/50 split) vs. with full specialisation + trade;
 * the extra output (gain from trade) is shaded.
 *
 * Used in Eco 1BACH · Unit 12 (globalización, comercio internacional).
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    ventajaComparativa: 'Ventaja comparativa',
    norpaisNecesitaMenosHoras: 'Norpaís necesita menos horas que Surpaís para producir tanto trigo como tela, así que tiene ventaja absoluta en ambos bienes. Pero lo que decide la especialización es la ventaja comparativa: Norpaís renuncia a menos tela por cada unidad de trigo (0,5 m frente a 0,83 m), de modo que se especializa en trigo y Surpaís en tela. Al intercambiar, el total producido aumenta: esa es la ganancia del comercio.',
    horasPorUnidadProducida: 'Horas por unidad producida',
    menosHorasSignificaMas: 'Menos horas significa más eficiente',
    trigo: 'Trigo',
    tela: 'Tela',
    norpais: 'Norpaís',
    surpais: 'Surpaís',
    ventajaComparativa2: 'ventaja comparativa',
    horas: 'horas',
    horas2: 'horas',
    horas3: 'horas',
    ventajaComparativa3: 'ventaja comparativa',
    horas4: 'horas',
    cadaPaisSeEspecializa: 'Cada país se especializa donde su coste de oportunidad es menor: 1 t de trigo cuesta 0,5 m de tela en Norpaís y 0,83 m en Surpaís.',
    trigoTotal100Horas: 'Trigo total (100 horas por país)',
    elTotalCreceCon: 'El total crece con la especialización',
    sinComercio: 'Sin comercio',
    repartoAMedias: 'reparto a medias',
    conEspecializacion: 'Con especialización',
    comercio: '+ comercio',
    gananciaDelComercio: 'ganancia del comercio',
  },
  ca: {
    ventajaComparativa: 'Avantatge comparatiu',
    norpaisNecesitaMenosHoras: "Nordpaís necessita menys hores que Sudpaís per a produir tant blat com tela, així que té avantatge absolut en els dos béns. Però el que decidix l'especialització és l'avantatge comparatiu: Nordpaís renuncia a menys tela per cada unitat de blat (0,5 m enfront de 0,83 m), de manera que s'especialitza en blat i Sudpaís en tela. En intercanviar, el total produït augmenta: eixe és el guany del comerç.",
    horasPorUnidadProducida: 'Hores per unitat produïda',
    menosHorasSignificaMas: 'Menys hores significa més eficient',
    trigo: 'Blat',
    tela: 'Tela',
    norpais: 'Nordpaís',
    surpais: 'Sudpaís',
    ventajaComparativa2: 'avantatge comparatiu',
    horas: 'hores',
    horas2: 'hores',
    horas3: 'hores',
    ventajaComparativa3: 'avantatge comparatiu',
    horas4: 'hores',
    cadaPaisSeEspecializa: "Cada país s'especialitza on el seu cost d'oportunitat és menor: 1 t de blat costa 0,5 m de tela a Nordpaís i 0,83 m a Sudpaís.",
    trigoTotal100Horas: 'Blat total (100 hores per país)',
    elTotalCreceCon: "El total creix amb l'especialització",
    sinComercio: 'Sense comerç',
    repartoAMedias: 'repartiment a mitges',
    conEspecializacion: 'Amb especialització',
    comercio: '+ comerç',
    gananciaDelComercio: 'guany del comerç',
  },
} as const;
const t = COPY[locale];
---
<svg class="d-ventaja-comparativa" viewBox="0 0 860 470" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="vc-title vc-desc">
  <title id="vc-title">{t.ventajaComparativa}</title>
  <desc id="vc-desc">{t.norpaisNecesitaMenosHoras}</desc>
  <defs>
    <style>
      .d-ventaja-comparativa .bg { fill: #FBF6EC; }
      .d-ventaja-comparativa .section-title { font-family: 'Fraunces', serif; font-size: 19px; font-weight: 500; font-style: italic; fill: #2A1F18; }
      .d-ventaja-comparativa .eyebrow { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; fill: #C44E2C; }
      .d-ventaja-comparativa .col-head { font-family: 'Switzer', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; fill: #5C4A3D; text-anchor: middle; }
      .d-ventaja-comparativa .row-head { font-family: 'Switzer', sans-serif; font-size: 13px; font-weight: 700; fill: #2A1F18; }
      .d-ventaja-comparativa .cell-line { stroke: #E5D4BD; stroke-width: 1.5; }
      .d-ventaja-comparativa .cell-rule { stroke: #5C4A3D; stroke-width: 1.5; }
      .d-ventaja-comparativa .cell-va { fill: #FBE3D6; }
      .d-ventaja-comparativa .cell-vb { fill: #F5E5BC; }
      .d-ventaja-comparativa .num { font-family: 'JetBrains Mono', monospace; font-size: 22px; font-weight: 500; fill: #2A1F18; text-anchor: middle; }
      .d-ventaja-comparativa .num-unit { font-family: 'JetBrains Mono', monospace; font-size: 10px; fill: #8A7868; text-anchor: middle; }
      .d-ventaja-comparativa .tag { font-family: 'Switzer', sans-serif; font-size: 9.5px; font-weight: 700; letter-spacing: 0.6px; text-transform: uppercase; text-anchor: middle; }
      .d-ventaja-comparativa .tag-a { fill: #9C3A1C; }
      .d-ventaja-comparativa .tag-b { fill: #A87A2A; }
      .d-ventaja-comparativa .caption { font-family: 'Fraunces', serif; font-size: 13px; font-style: italic; fill: #5C4A3D; }
      .d-ventaja-comparativa .bar-label { font-family: 'Switzer', sans-serif; font-size: 12px; font-weight: 700; fill: #2A1F18; }
      .d-ventaja-comparativa .bar-sub { font-family: 'Switzer', sans-serif; font-size: 10.5px; font-weight: 500; fill: #8A7868; }
      .d-ventaja-comparativa .bar-total { font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 500; fill: #2A1F18; }
      .d-ventaja-comparativa .gain-label { font-family: 'Switzer', sans-serif; font-size: 10.5px; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; fill: #9C3A1C; text-anchor: middle; }
      .d-ventaja-comparativa .divider { stroke: #EFE2CB; stroke-width: 1.5; }
    </style>
    <marker id="vc-arrow" markerWidth="9" markerHeight="9" refX="8" refY="3" orient="auto">
      <polygon points="0 0, 9 3, 0 6" fill="#9C3A1C"/>
    </marker>
  </defs>
  <rect class="bg" x="0" y="0" width="860" height="470"/>

  <!-- =================== PART A: hours table =================== -->
  <text class="eyebrow" x="40" y="40">{t.horasPorUnidadProducida}</text>
  <text class="section-title" x="40" y="64">{t.menosHorasSignificaMas}</text>

  <!-- Table geometry: cols at trigo [300..480], tela [480..660]; rows Norpaís [98..158], Surpaís [158..212] -->
  <!-- Column headers -->
  <text class="col-head" x="390" y="86">{t.trigo}</text>
  <text class="col-head" x="570" y="86">{t.tela}</text>

  <!-- Highlighted comparative-advantage cells: Norpaís→trigo (terracota), Surpaís→tela (mostaza) -->
  <rect class="cell-va" x="300" y="98" width="180" height="60"/>
  <rect class="cell-vb" x="480" y="158" width="180" height="54"/>

  <!-- Grid lines -->
  <line class="cell-line" x1="300" y1="98"  x2="660" y2="98"/>
  <line class="cell-line" x1="300" y1="158" x2="660" y2="158"/>
  <line class="cell-line" x1="300" y1="212" x2="660" y2="212"/>
  <line class="cell-line" x1="480" y1="98"  x2="480" y2="212"/>
  <line class="cell-rule" x1="300" y1="98"  x2="300" y2="212"/>
  <line class="cell-rule" x1="660" y1="98"  x2="660" y2="212"/>

  <!-- Row headers -->
  <text class="row-head" x="60" y="135">{t.norpais}</text>
  <text class="row-head" x="60" y="191">{t.surpais}</text>

  <!-- Norpaís hours: Trigo 2 (ventaja comparativa), Tela 4 -->
  <text class="tag tag-a" x="390" y="116">{t.ventajaComparativa2}</text>
  <text class="num" x="390" y="138">2</text>
  <text class="num-unit" x="390" y="152">{t.horas}</text>
  <text class="num" x="570" y="133">4</text>
  <text class="num-unit" x="570" y="147">{t.horas2}</text>

  <!-- Surpaís hours: Trigo 5, Tela 6 (ventaja comparativa) -->
  <text class="num" x="390" y="193">5</text>
  <text class="num-unit" x="390" y="207">{t.horas3}</text>
  <text class="tag tag-b" x="570" y="176">{t.ventajaComparativa3}</text>
  <text class="num" x="570" y="190">6</text>
  <text class="num-unit" x="570" y="204">{t.horas4}</text>

  <!-- Caption: opportunity cost -->
  <text class="caption" x="40" y="244">{t.cadaPaisSeEspecializa}</text>

  <!-- Divider between parts -->
  <line class="divider" x1="40" y1="266" x2="820" y2="266"/>

  <!-- =================== PART B: output bars =================== -->
  <text class="eyebrow" x="40" y="296">{t.trigoTotal100Horas}</text>
  <text class="section-title" x="40" y="320">{t.elTotalCreceCon}</text>

  <!-- Bar geometry: bars start x=300; scale: 1 t de trigo = 6px. Sin comercio 35 t -> 210px; con especialización 50 t -> 300px (gain 15 t = 90px) -->
  <!-- Sin comercio: reparto 50/50 -> Norpaís 25 t + Surpaís 10 t = 35 t -->
  <text class="bar-label" x="40" y="356">{t.sinComercio}</text>
  <text class="bar-sub"   x="40" y="372">{t.repartoAMedias}</text>
  <rect x="300" y="340" width="210" height="34" rx="3" fill="#D4A24C" fill-opacity="0.55" stroke="#A87A2A" stroke-width="1.5"/>
  <text class="bar-total" x="522" y="362">35 t</text>

  <!-- Con especialización + comercio: Norpaís 100 h en trigo -> 50 t -->
  <text class="bar-label" x="40" y="416">{t.conEspecializacion}</text>
  <text class="bar-sub"   x="40" y="432">{t.comercio}</text>
  <rect x="300" y="400" width="210" height="34" rx="3" fill="#D4A24C" fill-opacity="0.55" stroke="#A87A2A" stroke-width="1.5"/>
  <!-- gain segment (15 extra t de trigo = 90px) -->
  <rect x="510" y="400" width="90" height="34" rx="3" fill="#FBE3D6" stroke="#9C3A1C" stroke-width="1.5"/>
  <text class="bar-total" x="612" y="422">50 t</text>

  <!-- Gain-from-trade callout -->
  <line x1="555" y1="394" x2="555" y2="382" stroke="#9C3A1C" stroke-width="1.5" marker-start="url(#vc-arrow)"/>
  <text class="gain-label" x="555" y="392">{t.gananciaDelComercio}</text>
</svg>
