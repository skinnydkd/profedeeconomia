---
/**
 * STAR technique for behavioural interview answers: Situación, Tarea, Acción,
 * Resultado, drawn as a four-step horizontal flow with a sample interview
 * question and a worked example beneath each step.
 *
 * Used in FOPP 4ESO · Unit 9 (buscar empleo: CV, marca personal y entrevista).
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    elMetodoStarPara: 'El método STAR para entrevistas',
    cuatroPasosParaResponder: 'Cuatro pasos para responder a preguntas conductuales en una entrevista: Situación, Tarea, Acción y Resultado, con una pregunta tipo de ejemplo.',
    preguntaTipoDelEntrevistador: 'Pregunta tipo del entrevistador',
    describeUnaSituacionEn: '«Describe una situación en la que tuviste que resolver un conflicto en equipo.»',
    seBreveDosFrases: 'Sé breve: dos frases para situar al entrevistador. No te enrolles aquí; lo importante viene en la Acción y el Resultado.',
    situacion: 'Situación',
    contextoBreve: 'Contexto breve:',
    cuandoYDonde: 'cuándo y dónde.',
    enUnTrabajo: '«En un trabajo',
    deGrupoDe4: 'de grupo de 4.º…»',
    aclaraCualEraTu: 'Aclara cuál era TU objetivo o reto, no el del grupo entero. Así el entrevistador entiende qué se esperaba de ti en concreto.',
    tarea: 'Tarea',
    tuResponsabilidad: 'Tu responsabilidad',
    concreta: 'concreta.',
    yoCoordinaba: '«Yo coordinaba',
    laEntrega: 'la entrega…»',
    esLaParteMas: 'Es la parte más importante: usa «yo», no «nosotros». El entrevistador quiere saber qué aportaste tú, no qué hizo el equipo.',
    accion: 'Acción',
    queHicisteTu: 'Qué hiciste TÚ,',
    noElEquipo: 'no el equipo.',
    propuseRepartir: '«Propuse repartir',
    tareasPorEscrito: 'tareas por escrito…»',
    cierraConUnDato: 'Cierra con un dato concreto siempre que puedas (una nota, un porcentaje, un plazo cumplido). Lo medible convence mucho más que «salió bien».',
    resultado: 'Resultado',
    elDesenlaceCon: 'El desenlace, con',
    datosSiSePuede: 'datos si se puede.',
    entregamosA: '«Entregamos a',
    tiempoYSacamos9: 'tiempo y sacamos 9.»',
    unaRespuestaStarCompleta: 'Una respuesta STAR completa dura entre 90 segundos y 2 minutos',
  },
  ca: {
    elMetodoStarPara: 'El mètode STAR per a entrevistes',
    cuatroPasosParaResponder: "Quatre passos per a respondre preguntes conductuals en una entrevista: Situació, Tasca, Acció i Resultat, amb una pregunta tipus d'exemple.",
    preguntaTipoDelEntrevistador: "Pregunta tipus de l'entrevistador",
    describeUnaSituacionEn: '«Descriu una situació en què vas haver de resoldre un conflicte en equip.»',
    seBreveDosFrases: "Sigues breu: dues frases per a situar l'entrevistador. No t'allargues ací; l'important ve en l'Acció i el Resultat.",
    situacion: 'Situació',
    contextoBreve: 'Context breu:',
    cuandoYDonde: 'quan i on.',
    enUnTrabajo: '«En un treball',
    deGrupoDe4: 'de grup de 4t…»',
    aclaraCualEraTu: "Aclarix quin era el TEU objectiu o repte, no el del grup sencer. Així l'entrevistador entén què s'esperava de tu en concret.",
    tarea: 'Tasca',
    tuResponsabilidad: 'La teua responsabilitat',
    concreta: 'concreta.',
    yoCoordinaba: '«Jo coordinava',
    laEntrega: "l'entrega…»",
    esLaParteMas: "És la part més important: usa «jo», no «nosaltres». L'entrevistador vol saber què hi vas aportar tu, no què va fer l'equip.",
    accion: 'Acció',
    queHicisteTu: 'Què vas fer TU,',
    noElEquipo: "no l'equip.",
    propuseRepartir: '«Vaig proposar repartir',
    tareasPorEscrito: 'tasques per escrit…»',
    cierraConUnDato: 'Tanca amb una dada concreta sempre que pugues (una nota, un percentatge, un termini complit). El que és mesurable convenç molt més que «va eixir bé».',
    resultado: 'Resultat',
    elDesenlaceCon: 'El desenllaç, amb',
    datosSiSePuede: 'dades si es pot.',
    entregamosA: '«Vam entregar a',
    tiempoYSacamos9: 'temps i vam traure un 9.»',
    unaRespuestaStarCompleta: 'Una resposta STAR completa dura entre 90 segons i 2 minuts',
  },
} as const;
const t = COPY[locale];
---
<svg viewBox="0 0 880 480" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="star-title star-desc">
  <title id="star-title">{t.elMetodoStarPara}</title>
  <desc id="star-desc">{t.cuatroPasosParaResponder}</desc>
  <defs>
    <style>
      .bg { fill: #FBF6EC; }
      .q-box { fill: #FFFFFF; stroke: #5B3A4E; stroke-width: 2; }
      .q-tag { font-family: 'Switzer', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; fill: #5B3A4E; }
      .q-text { font-family: 'Fraunces', serif; font-style: italic; font-size: 16px; font-weight: 500; fill: #2A1F18; }
      .step { stroke-width: 2; }
      .step-s { fill: #FBE3D6; stroke: #C44E2C; }
      .step-t { fill: #F5E5BC; stroke: #A87A2A; }
      .step-a { fill: #ECDCE5; stroke: #5B3A4E; }
      .step-r { fill: #DBEDED; stroke: #1F6E6E; }
      .step-letter { font-family: 'Fraunces', serif; font-style: italic; font-size: 46px; font-weight: 600; text-anchor: middle; }
      .step-name { font-family: 'Switzer', sans-serif; font-size: 14px; font-weight: 700; letter-spacing: 0.6px; fill: #2A1F18; text-anchor: middle; }
      .step-def { font-family: 'Switzer', sans-serif; font-size: 11.5px; fill: #5C4A3D; text-anchor: middle; }
      .arrow { fill: none; stroke: #8A7868; stroke-width: 2.2; marker-end: url(#star-arrow); }
      .note { font-family: 'Switzer', sans-serif; font-style: italic; font-size: 11px; fill: #8A7868; text-anchor: middle; }
      .has-tip { cursor: help; }
    </style>
    <marker id="star-arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#8A7868"/>
    </marker>
  </defs>
  <rect class="bg" x="0" y="0" width="880" height="480"/>

  <!-- Sample question banner -->
  <rect class="q-box" x="40" y="40" width="800" height="68" rx="8"/>
  <text class="q-tag" x="64" y="68">{t.preguntaTipoDelEntrevistador}</text>
  <text class="q-text" x="64" y="93">{t.describeUnaSituacionEn}</text>

  <!-- Four steps, width 180, gap, y=170 height=210 -->
  <!-- S -->
  <rect class="step step-s has-tip" x="40" y="170" width="180" height="200" rx="8"><title>{t.seBreveDosFrases}</title></rect>
  <text class="step-letter" x="130" y="232" fill="#C44E2C">S</text>
  <text class="step-name" x="130" y="262">{t.situacion}</text>
  <text class="step-def" x="130" y="292">{t.contextoBreve}</text>
  <text class="step-def" x="130" y="310">{t.cuandoYDonde}</text>
  <text class="step-def" x="130" y="342" font-style="italic" font-family="Fraunces, serif" fill="#9C3A1C">{t.enUnTrabajo}</text>
  <text class="step-def" x="130" y="358" font-style="italic" font-family="Fraunces, serif" fill="#9C3A1C">{t.deGrupoDe4}</text>

  <!-- T -->
  <rect class="step step-t has-tip" x="240" y="170" width="180" height="200" rx="8"><title>{t.aclaraCualEraTu}</title></rect>
  <text class="step-letter" x="330" y="232" fill="#A87A2A">T</text>
  <text class="step-name" x="330" y="262">{t.tarea}</text>
  <text class="step-def" x="330" y="292">{t.tuResponsabilidad}</text>
  <text class="step-def" x="330" y="310">{t.concreta}</text>
  <text class="step-def" x="330" y="342" font-style="italic" font-family="Fraunces, serif" fill="#A87A2A">{t.yoCoordinaba}</text>
  <text class="step-def" x="330" y="358" font-style="italic" font-family="Fraunces, serif" fill="#A87A2A">{t.laEntrega}</text>

  <!-- A -->
  <rect class="step step-a has-tip" x="440" y="170" width="180" height="200" rx="8"><title>{t.esLaParteMas}</title></rect>
  <text class="step-letter" x="530" y="232" fill="#5B3A4E">A</text>
  <text class="step-name" x="530" y="262">{t.accion}</text>
  <text class="step-def" x="530" y="292">{t.queHicisteTu}</text>
  <text class="step-def" x="530" y="310">{t.noElEquipo}</text>
  <text class="step-def" x="530" y="342" font-style="italic" font-family="Fraunces, serif" fill="#5B3A4E">{t.propuseRepartir}</text>
  <text class="step-def" x="530" y="358" font-style="italic" font-family="Fraunces, serif" fill="#5B3A4E">{t.tareasPorEscrito}</text>

  <!-- R -->
  <rect class="step step-r has-tip" x="640" y="170" width="180" height="200" rx="8"><title>{t.cierraConUnDato}</title></rect>
  <text class="step-letter" x="730" y="232" fill="#1F6E6E">R</text>
  <text class="step-name" x="730" y="262">{t.resultado}</text>
  <text class="step-def" x="730" y="292">{t.elDesenlaceCon}</text>
  <text class="step-def" x="730" y="310">{t.datosSiSePuede}</text>
  <text class="step-def" x="730" y="342" font-style="italic" font-family="Fraunces, serif" fill="#1F6E6E">{t.entregamosA}</text>
  <text class="step-def" x="730" y="358" font-style="italic" font-family="Fraunces, serif" fill="#1F6E6E">{t.tiempoYSacamos9}</text>

  <!-- arrows between steps -->
  <path class="arrow" d="M 222 270 L 238 270"/>
  <path class="arrow" d="M 422 270 L 438 270"/>
  <path class="arrow" d="M 622 270 L 638 270"/>

  <!-- footer -->
  <text class="note" x="440" y="412">{t.unaRespuestaStarCompleta}</text>
</svg>
