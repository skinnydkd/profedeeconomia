---
/**
 * Porter's Five Forces diagram. Central node = competitive rivalry,
 * surrounded by the four forces that shape it.
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    lasCincoFuerzasCompetitivas: 'Las cinco fuerzas competitivas de Porter',
    k3Amenaza: '3 · AMENAZA',
    nuevosEntrantes: 'Nuevos entrantes',
    barrerasDeEntradaAl: 'Barreras de entrada al sector',
    k4Amenaza: '4 · AMENAZA',
    productosSustitutivos: 'Productos sustitutivos',
    alternativasQueCubrenLa: 'Alternativas que cubren la misma función',
    k2PoderDe: '2 · PODER DE',
    proveedores: 'Proveedores',
    siSonPocosY: 'Si son pocos y críticos,',
    imponenCondiciones: 'imponen condiciones.',
    k1PoderDe: '1 · PODER DE',
    clientes: 'Clientes',
    siPuedenCompararY: 'Si pueden comparar y',
    cambiarPresionanPrecios: 'cambiar, presionan precios.',
    k5Rivalidad: '5 · RIVALIDAD',
    enElSector: 'en el sector',
  },
  ca: {
    lasCincoFuerzasCompetitivas: 'Les cinc forces competitives de Porter',
    k3Amenaza: '3 · AMENAÇA',
    nuevosEntrantes: 'Nous entrants',
    barrerasDeEntradaAl: "Barreres d'entrada al sector",
    k4Amenaza: '4 · AMENAÇA',
    productosSustitutivos: 'Productes substitutius',
    alternativasQueCubrenLa: 'Alternatives que cobrixen la mateixa funció',
    k2PoderDe: '2 · PODER DE',
    proveedores: 'Proveïdors',
    siSonPocosY: 'Si són pocs i crítics,',
    imponenCondiciones: 'imposen condicions.',
    k1PoderDe: '1 · PODER DE',
    clientes: 'Clients',
    siPuedenCompararY: 'Si poden comparar i',
    cambiarPresionanPrecios: 'canviar, pressionen els preus.',
    k5Rivalidad: '5 · RIVALITAT',
    enElSector: 'en el sector',
  },
} as const;
const t = COPY[locale];
---
<svg class="d-porter-forces" viewBox="0 0 720 540" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={t.lasCincoFuerzasCompetitivas}>
  <defs>
    <style>
      .d-porter-forces .bg { fill: #FBF6EC; }
      .d-porter-forces .center { fill: #C44E2C; }
      .d-porter-forces .center-stroke { fill: none; stroke: #9C3A1C; stroke-width: 1.5; }
      .d-porter-forces .force { fill: #FFFFFF; stroke: #D4A24C; stroke-width: 2; }
      .d-porter-forces .force-rect { fill: #FFFFFF; stroke: #1F6E6E; stroke-width: 2; }
      .d-porter-forces .arrow { fill: none; stroke: #5C4A3D; stroke-width: 1.8; marker-end: url(#arrowhead); }
      .d-porter-forces .label-eyebrow { font-family: 'Switzer', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; }
      .d-porter-forces .label-title { font-family: 'Fraunces', serif; font-size: 14px; font-weight: 500; fill: #2A1F18; }
      .d-porter-forces .label-body { font-family: 'Switzer', sans-serif; font-size: 10.5px; fill: #5C4A3D; }
      .d-porter-forces .center-label-1 { font-family: 'Switzer', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; fill: #FBE3D6; text-anchor: middle; }
      .d-porter-forces .center-label-2 { font-family: 'Fraunces', serif; font-style: italic; font-size: 18px; font-weight: 500; fill: #FFFFFF; text-anchor: middle; }
    </style>
    <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#5C4A3D"/>
    </marker>
  </defs>
  <rect class="bg" x="0" y="0" width="720" height="540"/>

  <!-- Arrows pointing to center -->
  <line class="arrow" x1="360" y1="100" x2="360" y2="220"/>
  <line class="arrow" x1="360" y1="440" x2="360" y2="320"/>
  <line class="arrow" x1="180" y1="270" x2="290" y2="270"/>
  <line class="arrow" x1="540" y1="270" x2="430" y2="270"/>

  <!-- Top: Nuevos entrantes -->
  <g>
    <rect class="force" x="220" y="30" width="280" height="70" rx="6"/>
    <text class="label-eyebrow" x="360" y="55" fill="#A87A2A" text-anchor="middle">{t.k3Amenaza}</text>
    <text class="label-title" x="360" y="78" text-anchor="middle">{t.nuevosEntrantes}</text>
    <text class="label-body" x="360" y="93" text-anchor="middle">{t.barrerasDeEntradaAl}</text>
  </g>

  <!-- Bottom: Sustitutivos -->
  <g>
    <rect class="force" x="220" y="440" width="280" height="70" rx="6"/>
    <text class="label-eyebrow" x="360" y="465" fill="#A87A2A" text-anchor="middle">{t.k4Amenaza}</text>
    <text class="label-title" x="360" y="488" text-anchor="middle">{t.productosSustitutivos}</text>
    <text class="label-body" x="360" y="503" text-anchor="middle">{t.alternativasQueCubrenLa}</text>
  </g>

  <!-- Left: Proveedores -->
  <g>
    <rect class="force-rect" x="20" y="225" width="160" height="90" rx="6"/>
    <text class="label-eyebrow" x="100" y="250" fill="#1F6E6E" text-anchor="middle">{t.k2PoderDe}</text>
    <text class="label-title" x="100" y="275" text-anchor="middle">{t.proveedores}</text>
    <text class="label-body" x="100" y="293" text-anchor="middle">{t.siSonPocosY}</text>
    <text class="label-body" x="100" y="307" text-anchor="middle">{t.imponenCondiciones}</text>
  </g>

  <!-- Right: Clientes -->
  <g>
    <rect class="force-rect" x="540" y="225" width="160" height="90" rx="6"/>
    <text class="label-eyebrow" x="620" y="250" fill="#1F6E6E" text-anchor="middle">{t.k1PoderDe}</text>
    <text class="label-title" x="620" y="275" text-anchor="middle">{t.clientes}</text>
    <text class="label-body" x="620" y="293" text-anchor="middle">{t.siPuedenCompararY}</text>
    <text class="label-body" x="620" y="307" text-anchor="middle">{t.cambiarPresionanPrecios}</text>
  </g>

  <!-- Center: Rivalidad -->
  <ellipse class="center-stroke" cx="360" cy="270" rx="90" ry="58"/>
  <ellipse class="center" cx="360" cy="270" rx="84" ry="52"/>
  <text class="center-label-1" x="360" y="262">{t.k5Rivalidad}</text>
  <text class="center-label-2" x="360" y="285">{t.enElSector}</text>
</svg>
