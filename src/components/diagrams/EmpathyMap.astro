---
/**
 * Empathy Map with six quadrants arranged around a central persona
 * silhouette. Layout based on XPLANE's canonical version.
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    mapaDeEmpatiaSeis: 'Mapa de empatía: seis cuadrantes alrededor del cliente',
    quePiensaYSiente: '¿Qué piensa y siente?',
    susMotivacionesProfundasPreo: 'Sus motivaciones profundas, preocupaciones,',
    aspiracionesMiedosNoExpresad: 'aspiraciones, miedos no expresados.',
    queOye: '¿Qué oye?',
    loQueLeDicen: 'Lo que le dicen amigos,',
    familiaJefesRedes: 'familia, jefes, redes',
    socialesInfluencers: 'sociales, influencers.',
    queMediosConsume: 'Qué medios consume.',
    queAutoridadesRespeta: 'Qué autoridades respeta.',
    queVe: '¿Qué ve?',
    suEntornoFisico: 'Su entorno físico,',
    laOfertaDelMercado: 'la oferta del mercado,',
    susReferentesVisuales: 'sus referentes visuales.',
    queCompitePorSu: 'Qué compite por su',
    atencionYSuTiempo: 'atención y su tiempo.',
    clienteObjetivo: 'CLIENTE OBJETIVO',
    personaConcreta: 'Persona concreta',
    noUnSegmentoAbstracto: '— no un segmento abstracto —',
    queDiceYQue: '¿Qué dice y qué hace?',
    suDiscursoPublicoVs: 'Su discurso público vs. su comportamiento.',
    queLeDuele: '¿Qué le duele?',
    frustracionesMiedos: 'Frustraciones, miedos,',
    obstaculosFriccion: 'obstáculos, fricción.',
    loQueQuerriaEvitar: 'Lo que querría evitar',
    siPudiera: 'si pudiera.',
    queGana: '¿Qué gana?',
    necesidadesReales: 'Necesidades reales,',
    deseosMetricasPropias: 'deseos, métricas propias',
    deExitoLoQue: 'de éxito. Lo que de',
    verdadLeImporta: 'verdad le importa.',
  },
  ca: {
    mapaDeEmpatiaSeis: "Mapa d'empatia: sis quadrants al voltant del client",
    quePiensaYSiente: 'Què pensa i sent?',
    susMotivacionesProfundasPreo: 'Les seues motivacions profundes, preocupacions,',
    aspiracionesMiedosNoExpresad: 'aspiracions, pors no expressades.',
    queOye: 'Què escolta?',
    loQueLeDicen: 'El que li diuen amics,',
    familiaJefesRedes: 'família, caps, xarxes',
    socialesInfluencers: 'socials, influencers.',
    queMediosConsume: 'Quins mitjans consumix.',
    queAutoridadesRespeta: 'Quines autoritats respecta.',
    queVe: 'Què veu?',
    suEntornoFisico: 'El seu entorn físic,',
    laOfertaDelMercado: "l'oferta del mercat,",
    susReferentesVisuales: 'els seus referents visuals.',
    queCompitePorSu: 'Què competix per la seua',
    atencionYSuTiempo: 'atenció i el seu temps.',
    clienteObjetivo: 'CLIENT OBJECTIU',
    personaConcreta: 'Persona concreta',
    noUnSegmentoAbstracto: '— no un segment abstracte —',
    queDiceYQue: 'Què diu i què fa?',
    suDiscursoPublicoVs: 'El seu discurs públic vs. el seu comportament.',
    queLeDuele: 'Què li fa mal?',
    frustracionesMiedos: 'Frustracions, pors,',
    obstaculosFriccion: 'obstacles, fricció.',
    loQueQuerriaEvitar: 'El que voldria evitar',
    siPudiera: 'si poguera.',
    queGana: 'Què hi guanya?',
    necesidadesReales: 'Necessitats reals,',
    deseosMetricasPropias: 'desitjos, mètriques pròpies',
    deExitoLoQue: "d'èxit. El que de",
    verdadLeImporta: 'veritat li importa.',
  },
} as const;
const t = COPY[locale];
---
<svg class="d-empathy-map" viewBox="0 0 760 540" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={t.mapaDeEmpatiaSeis}>
  <defs>
    <style>
      .d-empathy-map .bg { fill: #FBF6EC; }
      .d-empathy-map .quad { fill: #FFFFFF; stroke: #E5D4BD; stroke-width: 1.5; }
      .d-empathy-map .quad-top { stroke: #C44E2C; }
      .d-empathy-map .quad-side-l { stroke: #D4A24C; }
      .d-empathy-map .quad-side-r { stroke: #1F6E6E; }
      .d-empathy-map .quad-bottom-pain { stroke: #B83A3A; }
      .d-empathy-map .quad-bottom-gain { stroke: #4F8C3F; }
      .d-empathy-map .num { font-family: 'Fraunces', serif; font-style: italic; font-size: 13px; font-weight: 500; fill: #A87A2A; }
      .d-empathy-map .title { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; fill: #2A1F18; }
      .d-empathy-map .question { font-family: 'Fraunces', serif; font-style: italic; font-size: 11.5px; fill: #5C4A3D; }
      .d-empathy-map .persona-circle { fill: #FBE3D6; stroke: #C44E2C; stroke-width: 2; }
      .d-empathy-map .persona-label { font-family: 'Switzer', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; fill: #9C3A1C; text-anchor: middle; }
      .d-empathy-map .persona-name { font-family: 'Fraunces', serif; font-style: italic; font-size: 18px; font-weight: 500; fill: #2A1F18; text-anchor: middle; }
    </style>
  </defs>
  <rect class="bg" x="0" y="0" width="760" height="540"/>

  <!-- Top: Piensa y siente -->
  <g>
    <rect class="quad quad-top" x="180" y="40" width="400" height="100" rx="6"/>
    <text class="num" x="200" y="62">01</text>
    <text class="title" x="200" y="84">{t.quePiensaYSiente}</text>
    <text class="question" x="200" y="106">{t.susMotivacionesProfundasPreo}</text>
    <text class="question" x="200" y="120">{t.aspiracionesMiedosNoExpresad}</text>
  </g>

  <!-- Left: Oye -->
  <g>
    <rect class="quad quad-side-l" x="40" y="160" width="190" height="220" rx="6"/>
    <text class="num" x="55" y="182">02</text>
    <text class="title" x="55" y="204">{t.queOye}</text>
    <text class="question" x="55" y="226">{t.loQueLeDicen}</text>
    <text class="question" x="55" y="240">{t.familiaJefesRedes}</text>
    <text class="question" x="55" y="254">{t.socialesInfluencers}</text>
    <text class="question" x="55" y="278">{t.queMediosConsume}</text>
    <text class="question" x="55" y="292">{t.queAutoridadesRespeta}</text>
  </g>

  <!-- Right: Ve -->
  <g>
    <rect class="quad quad-side-r" x="530" y="160" width="190" height="220" rx="6"/>
    <text class="num" x="545" y="182">03</text>
    <text class="title" x="545" y="204">{t.queVe}</text>
    <text class="question" x="545" y="226">{t.suEntornoFisico}</text>
    <text class="question" x="545" y="240">{t.laOfertaDelMercado}</text>
    <text class="question" x="545" y="254">{t.susReferentesVisuales}</text>
    <text class="question" x="545" y="278">{t.queCompitePorSu}</text>
    <text class="question" x="545" y="292">{t.atencionYSuTiempo}</text>
  </g>

  <!-- Center: Persona -->
  <ellipse class="persona-circle" cx="380" cy="270" rx="130" ry="90"/>
  <text class="persona-label" x="380" y="248">{t.clienteObjetivo}</text>
  <text class="persona-name" x="380" y="274">{t.personaConcreta}</text>
  <text class="question" x="380" y="298" text-anchor="middle">{t.noUnSegmentoAbstracto}</text>

  <!-- Bottom-center: Dice y hace -->
  <g>
    <rect class="quad" x="240" y="400" width="280" height="80" rx="6"/>
    <text class="num" x="260" y="422">04</text>
    <text class="title" x="260" y="444">{t.queDiceYQue}</text>
    <text class="question" x="260" y="466">{t.suDiscursoPublicoVs}</text>
  </g>

  <!-- Bottom-left: Le duele -->
  <g>
    <rect class="quad quad-bottom-pain" x="40" y="400" width="190" height="120" rx="6"/>
    <text class="num" x="55" y="422" fill="#702020">05</text>
    <text class="title" x="55" y="444" fill="#702020">{t.queLeDuele}</text>
    <text class="question" x="55" y="466">{t.frustracionesMiedos}</text>
    <text class="question" x="55" y="480">{t.obstaculosFriccion}</text>
    <text class="question" x="55" y="500">{t.loQueQuerriaEvitar}</text>
    <text class="question" x="55" y="514">{t.siPudiera}</text>
  </g>

  <!-- Bottom-right: Qué gana -->
  <g>
    <rect class="quad quad-bottom-gain" x="530" y="400" width="190" height="120" rx="6"/>
    <text class="num" x="545" y="422" fill="#2A5A1F">06</text>
    <text class="title" x="545" y="444" fill="#2A5A1F">{t.queGana}</text>
    <text class="question" x="545" y="466">{t.necesidadesReales}</text>
    <text class="question" x="545" y="480">{t.deseosMetricasPropias}</text>
    <text class="question" x="545" y="500">{t.deExitoLoQue}</text>
    <text class="question" x="545" y="514">{t.verdadLeImporta}</text>
  </g>
</svg>
