---
/**
 * Ikigai Venn diagram: four overlapping circles (lo que amas, en lo que eres
 * bueno, lo que el mundo necesita, por lo que te pueden pagar) whose central
 * intersection is the ikigai, with the four intermediate intersections
 * labelled pasión, misión, profesión and vocación.
 *
 * Used in FOPP 4ESO · Unit 1 (autoconocimiento e identidad personal).
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    diagramaDelIkigai: 'Diagrama del ikigai',
    cuatroCirculosQueSe: 'Cuatro círculos que se solapan: lo que amas, en lo que eres bueno, lo que el mundo necesita y aquello por lo que te pueden pagar. Sus intersecciones forman la pasión, la misión, la profesión y la vocación, y en el centro está el ikigai.',
    tusAficionesYAquello: 'Tus aficiones y aquello que harías aunque no te pagaran. Pregúntate: ¿qué actividad hace que pierdas la noción del tiempo?',
    tusTalentosYHabilidades: 'Tus talentos y habilidades, los tengas por naturaleza o por práctica. Pregúntate: ¿qué te piden los demás que les ayudes a hacer?',
    aquelloQueTieneMercado: 'Aquello que tiene mercado: alguien está dispuesto a pagarte por ello. Conecta tus talentos con una salida laboral real.',
    losProblemasSocialesO: 'Los problemas sociales o necesidades de tu entorno que podrías ayudar a resolver. Es lo que da sentido y utilidad a tu trabajo.',
    loQueAmas: 'Lo que AMAS',
    enLoQue: 'En lo que',
    eresBueno: 'eres BUENO',
    porLoQueTe: 'Por lo que te pueden PAGAR',
    loQueEl: 'Lo que el',
    mundoNecesita: 'mundo NECESITA',
    mision: 'Misión',
    pasion: 'Pasión',
    vocacion: 'Vocación',
    profesion: 'Profesión',
    tu: 'Tu',
    ikigai: 'ikigai',
  },
  ca: {
    diagramaDelIkigai: "Diagrama de l'ikigai",
    cuatroCirculosQueSe: "Quatre cercles que se solapen: el que estimes, en què eres bo, el que el món necessita i allò pel qual et poden pagar. Les seues interseccions formen la passió, la missió, la professió i la vocació, i al centre està l'ikigai.",
    tusAficionesYAquello: "Les teues aficions i allò que faries encara que no et pagaren. Pregunta't: quina activitat fa que perdes la noció del temps?",
    tusTalentosYHabilidades: "Els teus talents i habilitats, els tingues per naturalesa o per pràctica. Pregunta't: què et demanen els altres que els ajudes a fer?",
    aquelloQueTieneMercado: 'Allò que té mercat: algú està disposat a pagar-te per això. Connecta els teus talents amb una eixida laboral real.',
    losProblemasSocialesO: 'Els problemes socials o necessitats del teu entorn que podries ajudar a resoldre. És el que dona sentit i utilitat a la teua faena.',
    loQueAmas: 'El que ESTIMES',
    enLoQue: 'En què',
    eresBueno: 'eres BO',
    porLoQueTe: 'Pel que et poden PAGAR',
    loQueEl: 'El que el',
    mundoNecesita: 'món NECESSITA',
    mision: 'Missió',
    pasion: 'Passió',
    vocacion: 'Vocació',
    profesion: 'Professió',
    tu: 'El teu',
    ikigai: 'ikigai',
  },
} as const;
const t = COPY[locale];
---
<svg class="d-ikigai" viewBox="0 0 760 720" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="ikigai-title ikigai-desc">
  <title id="ikigai-title">{t.diagramaDelIkigai}</title>
  <desc id="ikigai-desc">{t.cuatroCirculosQueSe}</desc>
  <defs>
    <style>
      .d-ikigai .bg { fill: #FBF6EC; }
      .d-ikigai .circle { fill-opacity: 0.42; stroke-width: 2; }
      .d-ikigai .c-amas { fill: #FBE3D6; stroke: #C44E2C; }
      .d-ikigai .c-bueno { fill: #F5E5BC; stroke: #A87A2A; }
      .d-ikigai .c-necesita { fill: #DBEDED; stroke: #1F6E6E; }
      .d-ikigai .c-pagan { fill: #ECDCE5; stroke: #5B3A4E; }
      .d-ikigai .ring-label { font-family: 'Switzer', sans-serif; font-size: 13px; font-weight: 700; letter-spacing: 0.4px; fill: #2A1F18; text-anchor: middle; }
      .d-ikigai .inter-label { font-family: 'Fraunces', serif; font-style: italic; font-size: 15px; font-weight: 500; fill: #5C4A3D; text-anchor: middle; }
      .d-ikigai .center-1 { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; fill: #5B3A4E; text-anchor: middle; }
      .d-ikigai .center-2 { font-family: 'Fraunces', serif; font-style: italic; font-size: 26px; font-weight: 600; fill: #5B3A4E; text-anchor: middle; }
      .d-ikigai .has-tip { cursor: help; }
    </style>
  </defs>
  <rect class="bg" x="0" y="0" width="760" height="720"/>

  <!-- Four circles, radius 195, arranged in a diamond around center (380,360).
       Ring order amas → bueno → pagan → necesita so that every adjacent pair is
       a canonical ikigai region (see intersection labels below). -->
  <!-- top -->
  <circle class="circle c-amas has-tip" cx="380" cy="240" r="195"><title>{t.tusAficionesYAquello}</title></circle>
  <!-- right -->
  <circle class="circle c-bueno has-tip" cx="500" cy="360" r="195"><title>{t.tusTalentosYHabilidades}</title></circle>
  <!-- bottom -->
  <circle class="circle c-pagan has-tip" cx="380" cy="480" r="195"><title>{t.aquelloQueTieneMercado}</title></circle>
  <!-- left -->
  <circle class="circle c-necesita has-tip" cx="260" cy="360" r="195"><title>{t.losProblemasSocialesO}</title></circle>

  <!-- Outer ring labels -->
  <text class="ring-label" x="380" y="95">{t.loQueAmas}</text>
  <text class="ring-label" x="648" y="364">{t.enLoQue}</text>
  <text class="ring-label" x="648" y="382">{t.eresBueno}</text>
  <text class="ring-label" x="380" y="640">{t.porLoQueTe}</text>
  <text class="ring-label" x="112" y="364">{t.loQueEl}</text>
  <text class="ring-label" x="112" y="382">{t.mundoNecesita}</text>

  <!-- Pairwise intersections of adjacent circles (canonical ikigai) -->
  <text class="inter-label" x="290" y="270">{t.mision}</text>      <!-- amas ∩ necesita (top-left) -->
  <text class="inter-label" x="478" y="270">{t.pasion}</text>      <!-- amas ∩ bueno (top-right) -->
  <text class="inter-label" x="288" y="465">{t.vocacion}</text>    <!-- pagan ∩ necesita (bottom-left) -->
  <text class="inter-label" x="478" y="465">{t.profesion}</text>   <!-- pagan ∩ bueno (bottom-right) -->

  <!-- Center: ikigai -->
  <text class="center-1" x="380" y="350">{t.tu}</text>
  <text class="center-2" x="380" y="382">{t.ikigai}</text>
</svg>
