---
/**
 * Fondo de maniobra. Dos barras verticales enfrentadas: a la izquierda el
 * activo (no corriente abajo, corriente arriba) y a la derecha el patrimonio
 * neto más el pasivo (no corriente abajo, corriente arriba). Cuando el
 * activo corriente supera al pasivo corriente, la diferencia es el fondo de
 * maniobra, financiado con recursos permanentes. Equilibrio financiero.
 *
 * Used in EDMN 2BACH · Unit 11 (análisis de estados financieros).
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    fondoDeManiobra: 'Fondo de maniobra',
    elActivoCorrienteSupera: 'El activo corriente supera al pasivo corriente; esa diferencia es el fondo de maniobra positivo, que indica que parte del activo a corto plazo se financia con recursos permanentes (patrimonio neto y pasivo no corriente). Es señal de equilibrio financiero.',
    activo: 'ACTIVO',
    patrimonioNetoPasivo: 'PATRIMONIO NETO + PASIVO',
    bienesYDerechosQue: 'Bienes y derechos que se convierten en dinero en menos de un año. Es la parte del activo con la que la empresa hace frente a sus pagos más inmediatos.',
    activoCorriente: 'Activo corriente',
    existenciasRealizable: 'Existencias · Realizable',
    disponible: 'Disponible',
    inversionesQuePermanecenEn: 'Inversiones que permanecen en la empresa más de un año. Por su carácter estable, deben financiarse con recursos también permanentes, no con deuda a corto plazo.',
    activoNoCorriente: 'Activo no corriente',
    inmovilizadoMaterial: 'Inmovilizado material',
    eIntangible: 'e intangible',
    deudasQueVencenEn: 'Deudas que vencen en menos de un año. Que el activo corriente sea mayor que esta masa es lo que garantiza que la empresa pueda pagar sin agobios.',
    pasivoCorriente: 'Pasivo corriente',
    proveedoresAcreedores: 'Proveedores · Acreedores',
    deudasACortoPlazo: 'Deudas a corto plazo',
    patrimonioNetoMasPasivo: 'Patrimonio neto más pasivo no corriente: la financiación estable de la empresa. Cuando supera al activo no corriente, el sobrante financia parte del corriente y crea el fondo de maniobra.',
    recursosPermanentes: 'Recursos permanentes',
    patrimonioNeto: 'Patrimonio neto',
    pasivoNoCorriente: '+ Pasivo no corriente',
    fondoDe: 'FONDO DE',
    maniobra: 'MANIOBRA',
    fmActivoCorrientePasivo: 'FM = Activo corriente − Pasivo corriente = 110.000 − 70.000 = 40.000 €',
    fm0LaEmpresa: 'FM > 0 · la empresa tiene un colchón financiero a corto plazo',
  },
  ca: {
    fondoDeManiobra: 'Fons de maniobra',
    elActivoCorrienteSupera: "L'actiu corrent supera el passiu corrent; eixa diferència és el fons de maniobra positiu, que indica que part de l'actiu a curt termini es finança amb recursos permanents (patrimoni net i passiu no corrent). És senyal d'equilibri financer.",
    activo: 'ACTIU',
    patrimonioNetoPasivo: 'PATRIMONI NET + PASSIU',
    bienesYDerechosQue: "Béns i drets que es convertixen en diners en menys d'un any. És la part de l'actiu amb què l'empresa fa front als seus pagaments més immediats.",
    activoCorriente: 'Actiu corrent',
    existenciasRealizable: 'Existències · Realitzable',
    disponible: 'Disponible',
    inversionesQuePermanecenEn: "Inversions que romanen en l'empresa més d'un any. Pel seu caràcter estable, han de finançar-se amb recursos també permanents, no amb deute a curt termini.",
    activoNoCorriente: 'Actiu no corrent',
    inmovilizadoMaterial: 'Immobilitzat material',
    eIntangible: 'i intangible',
    deudasQueVencenEn: "Deutes que vencen en menys d'un any. Que l'actiu corrent siga major que esta massa és el que garantix que l'empresa puga pagar sense angoixes.",
    pasivoCorriente: 'Passiu corrent',
    proveedoresAcreedores: 'Proveïdors · Creditors',
    deudasACortoPlazo: 'Deutes a curt termini',
    patrimonioNetoMasPasivo: "Patrimoni net més passiu no corrent: el finançament estable de l'empresa. Quan supera l'actiu no corrent, el sobrant finança part del corrent i crea el fons de maniobra.",
    recursosPermanentes: 'Recursos permanents',
    patrimonioNeto: 'Patrimoni net',
    pasivoNoCorriente: '+ Passiu no corrent',
    fondoDe: 'FONS DE',
    maniobra: 'MANIOBRA',
    fmActivoCorrientePasivo: 'FM = Actiu corrent − Passiu corrent = 110.000 − 70.000 = 40.000 €',
    fm0LaEmpresa: "FM > 0 · l'empresa té un matalàs financer a curt termini",
  },
} as const;
const t = COPY[locale];
---
<svg viewBox="0 0 800 520" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="fm-title fm-desc">
  <title id="fm-title">{t.fondoDeManiobra}</title>
  <desc id="fm-desc">{t.elActivoCorrienteSupera}</desc>
  <defs>
    <style>
      .bg { fill: #FBF6EC; }
      .anc { fill: #F5E5BC; stroke: #D4A24C; stroke-width: 1.6; }
      .ac  { fill: #FBE3D6; stroke: #C44E2C; stroke-width: 1.6; }
      .rp  { fill: #FFFFFF; stroke: #5C4A3D; stroke-width: 1.6; }
      .pc  { fill: #DBEDED; stroke: #1F6E6E; stroke-width: 1.6; }
      .col-head { font-family: 'Switzer', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; fill: #2A1F18; text-anchor: middle; }
      .masa-title { font-family: 'Switzer', sans-serif; font-size: 12px; font-weight: 700; fill: #2A1F18; text-anchor: middle; }
      .masa-sub { font-family: 'Switzer', sans-serif; font-size: 9.5px; fill: #5C4A3D; text-anchor: middle; }
      .masa-num { font-family: 'JetBrains Mono', monospace; font-size: 11px; fill: #2A1F18; text-anchor: middle; }
      .fm-brace { fill: none; stroke: #9C3A1C; stroke-width: 2; }
      .fm-label { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; fill: #9C3A1C; }
      .fm-formula { font-family: 'Fraunces', serif; font-style: italic; font-size: 14px; fill: #5C4A3D; }
      .guide { stroke: #9C3A1C; stroke-width: 1.2; stroke-dasharray: 5 4; }
      .has-tip { cursor: help; }
    </style>
  </defs>
  <rect class="bg" x="0" y="0" width="800" height="520"/>

  <!-- Headers -->
  <text class="col-head" x="200" y="42">{t.activo}</text>
  <text class="col-head" x="500" y="42">{t.patrimonioNetoPasivo}</text>

  <!-- LEFT BAR (Activo). Bar x 120..280 width 160. Total height 380, y=60..440. -->
  <!-- Activo corriente (arriba, larger 55%) -->
  <rect class="ac has-tip" x="120" y="60" width="160" height="210" rx="4"><title>{t.bienesYDerechosQue}</title></rect>
  <text class="masa-title" x="200" y="150">{t.activoCorriente}</text>
  <text class="masa-sub" x="200" y="170">{t.existenciasRealizable}</text>
  <text class="masa-sub" x="200" y="184">{t.disponible}</text>
  <text class="masa-num" x="200" y="240">110.000 €</text>
  <!-- Activo no corriente (abajo) -->
  <rect class="anc has-tip" x="120" y="270" width="160" height="170" rx="4"><title>{t.inversionesQuePermanecenEn}</title></rect>
  <text class="masa-title" x="200" y="345">{t.activoNoCorriente}</text>
  <text class="masa-sub" x="200" y="365">{t.inmovilizadoMaterial}</text>
  <text class="masa-sub" x="200" y="379">{t.eIntangible}</text>
  <text class="masa-num" x="200" y="415">90.000 €</text>

  <!-- RIGHT BAR (PN + Pasivo). Bar x 420..580 width 160. -->
  <!-- Pasivo corriente (arriba, smaller than AC) -->
  <rect class="pc has-tip" x="420" y="60" width="160" height="130" rx="4"><title>{t.deudasQueVencenEn}</title></rect>
  <text class="masa-title" x="500" y="105">{t.pasivoCorriente}</text>
  <text class="masa-sub" x="500" y="125">{t.proveedoresAcreedores}</text>
  <text class="masa-sub" x="500" y="139">{t.deudasACortoPlazo}</text>
  <text class="masa-num" x="500" y="170">70.000 €</text>
  <!-- Recursos permanentes (PN + PNC) abajo, larger -->
  <rect class="rp has-tip" x="420" y="190" width="160" height="250" rx="4"><title>{t.patrimonioNetoMasPasivo}</title></rect>
  <text class="masa-title" x="500" y="280">{t.recursosPermanentes}</text>
  <text class="masa-sub" x="500" y="300">{t.patrimonioNeto}</text>
  <text class="masa-sub" x="500" y="314">{t.pasivoNoCorriente}</text>
  <text class="masa-num" x="500" y="345">130.000 €</text>

  <!-- Guide line: bottom of AC (left, y=270) vs bottom of PC (right, y=190) -->
  <line class="guide" x1="280" y1="190" x2="420" y2="190"/>
  <line class="guide" x1="280" y1="270" x2="420" y2="270"/>

  <!-- Brace highlighting the FM gap on the right bar between PC bottom (190) and the AC level (270) -->
  <path class="fm-brace" d="M 600 190 q 12 0 12 12 v 28 q 0 12 12 12 q -12 0 -12 12 v 28 q 0 12 -12 12"/>
  <text class="fm-label" x="630" y="226">{t.fondoDe}</text>
  <text class="fm-label" x="630" y="242">{t.maniobra}</text>
  <text class="masa-num" x="630" y="262" text-anchor="start">40.000 €</text>

  <!-- Footer formulas -->
  <line x1="120" y1="465" x2="680" y2="465" stroke="#E5D4BD" stroke-width="1.5"/>
  <text class="fm-formula" x="120" y="490">{t.fmActivoCorrientePasivo}</text>
  <text class="fm-formula" x="120" y="510">{t.fm0LaEmpresa}</text>
</svg>
