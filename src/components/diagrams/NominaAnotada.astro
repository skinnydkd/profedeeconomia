---
/**
 * Annotated Spanish payslip: visual breakdown from bruto to líquido
 * for an example auxiliar administrativo earning 1.500€/mes. Three
 * vertical sections — devengos, deducciones, líquido — with arrows
 * explaining each deduction.
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    anatomiaDeUnaNomina: 'Anatomía de una nómina española',
    esquemaDeUnaNomina: 'Esquema de una nómina dividida en devengos (lo que ganas), deducciones (IRPF y Seguridad Social) y líquido (lo que cobras), con un ejemplo numérico de 1.500€ brutos.',
    ejemploAuxiliarAdministrativ: 'EJEMPLO · AUXILIAR ADMINISTRATIVO · 1.500 € BRUTOS/MES',
    k1LoQueGanas: '1 · LO QUE GANAS',
    devengos: 'Devengos',
    salarioBase: 'Salario base',
    complementos: 'Complementos',
    prorrateoPagasExtras: 'Prorrateo pagas extras',
    totalBruto: 'Total bruto',
    k2LoQueTe: '2 · LO QUE TE QUITAN',
    deducciones: 'Deducciones',
    irpf10: 'IRPF (≈ 10 %)',
    ssTrabajador635: 'SS trabajador (6,35 %)',
    aCuentaDeHacienda: 'A cuenta de Hacienda',
    yDeTuJubilacion: 'y de tu jubilación',
    totalDeducciones: 'Total deducciones',
    k3LoQueCobras: '3 · LO QUE COBRAS',
    liquidoAPercibir: 'LÍQUIDO A PERCIBIR',
    elIrpfEsUn: 'El IRPF es un anticipo. En la declaración de la renta',
    deJunioSeAjusta: 'de junio se ajusta y puede salir a devolver o a pagar.',
    laSsNoTe: 'La SS no te la devuelven. Va al fondo común que',
    pagaPensionesParoY: 'paga pensiones, paro y baja por enfermedad.',
    laDiferenciaEntreBruto: 'La diferencia entre bruto y líquido suele ser del 15-25 %.',
    cuandoUnAnuncioDice: 'Cuando un anuncio dice "1.500 €/mes" casi siempre se refiere al bruto. Lo que ingresas es menos.',
  },
  ca: {
    anatomiaDeUnaNomina: "Anatomia d'una nòmina espanyola",
    esquemaDeUnaNomina: "Esquema d'una nòmina dividida en meritacions (el que guanyes), deduccions (IRPF i Seguretat Social) i líquid (el que cobres), amb un exemple numèric de 1.500 € bruts.",
    ejemploAuxiliarAdministrativ: 'EXEMPLE · AUXILIAR ADMINISTRATIU · 1.500 € BRUTS/MES',
    k1LoQueGanas: '1 · EL QUE GUANYES',
    devengos: 'Meritacions',
    salarioBase: 'Salari base',
    complementos: 'Complements',
    prorrateoPagasExtras: 'Prorrateig pagues extres',
    totalBruto: 'Total brut',
    k2LoQueTe: '2 · EL QUE ET LLEVEN',
    deducciones: 'Deduccions',
    irpf10: 'IRPF (≈ 10 %)',
    ssTrabajador635: 'SS treballador (6,35 %)',
    aCuentaDeHacienda: "A compte d'Hisenda",
    yDeTuJubilacion: 'i de la teua jubilació',
    totalDeducciones: 'Total deduccions',
    k3LoQueCobras: '3 · EL QUE COBRES',
    liquidoAPercibir: 'LÍQUID A PERCEBRE',
    elIrpfEsUn: "L'IRPF és una bestreta. En la declaració de la renda",
    deJunioSeAjusta: "de juny s'ajusta i pot eixir a tornar o a pagar.",
    laSsNoTe: 'La SS no te la tornen. Va al fons comú que',
    pagaPensionesParoY: 'paga pensions, atur i baixa per malaltia.',
    laDiferenciaEntreBruto: 'La diferència entre brut i líquid sol ser del 15-25 %.',
    cuandoUnAnuncioDice: 'Quan un anunci diu "1.500 €/mes" quasi sempre es referix al brut. El que ingresses és menys.',
  },
} as const;
const t = COPY[locale];
---
<svg viewBox="0 0 800 520" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="nomina-title nomina-desc">
  <title id="nomina-title">{t.anatomiaDeUnaNomina}</title>
  <desc id="nomina-desc">{t.esquemaDeUnaNomina}</desc>
  <defs>
    <style>
      .bg { fill: #FBF6EC; }
      .section-devengos { fill: #FBE3D6; stroke: #C44E2C; stroke-width: 2; }
      .section-deducciones { fill: #F5E5BC; stroke: #D4A24C; stroke-width: 2; }
      .section-liquido { fill: #2A1F18; stroke: #2A1F18; stroke-width: 2; }
      .row-line { stroke: #C8B79A; stroke-width: 1; stroke-dasharray: 2 3; }
      .eyebrow { font-family: 'Switzer', sans-serif; font-size: 10.5px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; text-anchor: middle; }
      .section-title { font-family: 'Fraunces', serif; font-size: 16px; font-weight: 500; text-anchor: middle; }
      .item-name { font-family: 'Switzer', sans-serif; font-size: 12px; fill: #2A1F18; }
      .item-amount { font-family: 'JetBrains Mono', monospace; font-size: 12px; fill: #2A1F18; text-anchor: end; }
      .item-amount-neg { fill: #9C3A1C; }
      .total-name { font-family: 'Switzer', sans-serif; font-size: 12px; font-weight: 700; fill: #2A1F18; }
      .total-amount { font-family: 'Fraunces', serif; font-style: italic; font-size: 16px; font-weight: 500; fill: #2A1F18; text-anchor: end; }
      .liquido-label { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; fill: #FBE3D6; text-anchor: middle; }
      .liquido-amount { font-family: 'Fraunces', serif; font-style: italic; font-size: 32px; font-weight: 500; fill: #FFFFFF; text-anchor: middle; }
      .note { font-family: 'Switzer', sans-serif; font-size: 10.5px; fill: #5C4A3D; }
      .arrow { fill: none; stroke: #8A7868; stroke-width: 1.4; marker-end: url(#nomarrow); }
      .header { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; fill: #8A7868; }
      .footer { font-family: 'Fraunces', serif; font-style: italic; font-size: 13px; fill: #5C4A3D; text-anchor: middle; }
    </style>
    <marker id="nomarrow" markerWidth="9" markerHeight="9" refX="8" refY="3" orient="auto">
      <polygon points="0 0, 9 3, 0 6" fill="#8A7868"/>
    </marker>
  </defs>
  <rect class="bg" x="0" y="0" width="800" height="520"/>

  <!-- Header -->
  <text class="header" x="40" y="35">{t.ejemploAuxiliarAdministrativ}</text>

  <!-- Section 1: DEVENGOS (top-left) -->
  <g>
    <rect class="section-devengos" x="40" y="55" width="340" height="170" rx="6"/>
    <text class="eyebrow" x="210" y="80" fill="#9C3A1C">{t.k1LoQueGanas}</text>
    <text class="section-title" x="210" y="102" fill="#9C3A1C">{t.devengos}</text>

    <line class="row-line" x1="55" y1="118" x2="365" y2="118"/>
    <text class="item-name" x="55" y="138">{t.salarioBase}</text>
    <text class="item-amount" x="365" y="138">1.200,00 €</text>

    <text class="item-name" x="55" y="158">{t.complementos}</text>
    <text class="item-amount" x="365" y="158">175,00 €</text>

    <text class="item-name" x="55" y="178">{t.prorrateoPagasExtras}</text>
    <text class="item-amount" x="365" y="178">125,00 €</text>

    <line class="row-line" x1="55" y1="190" x2="365" y2="190"/>
    <text class="total-name" x="55" y="212">{t.totalBruto}</text>
    <text class="total-amount" x="365" y="212">1.500,00 €</text>
  </g>

  <!-- Section 2: DEDUCCIONES (top-right) -->
  <g>
    <rect class="section-deducciones" x="420" y="55" width="340" height="170" rx="6"/>
    <text class="eyebrow" x="590" y="80" fill="#A87A2A">{t.k2LoQueTe}</text>
    <text class="section-title" x="590" y="102" fill="#A87A2A">{t.deducciones}</text>

    <line class="row-line" x1="435" y1="118" x2="745" y2="118"/>
    <text class="item-name" x="435" y="138">{t.irpf10}</text>
    <text class="item-amount item-amount-neg" x="745" y="138">− 150,00 €</text>

    <text class="item-name" x="435" y="158">{t.ssTrabajador635}</text>
    <text class="item-amount item-amount-neg" x="745" y="158">− 95,25 €</text>

    <text class="note" x="435" y="178">{t.aCuentaDeHacienda}</text>
    <text class="note" x="435" y="194">{t.yDeTuJubilacion}</text>

    <line class="row-line" x1="435" y1="200" x2="745" y2="200"/>
    <text class="total-name" x="435" y="218">{t.totalDeducciones}</text>
    <text class="total-amount" x="745" y="218">− 245,25 €</text>
  </g>

  <!-- Arrows from devengos and deducciones to liquido -->
  <line class="arrow" x1="210" y1="230" x2="380" y2="305"/>
  <line class="arrow" x1="590" y1="230" x2="420" y2="305"/>

  <!-- Section 3: LIQUIDO (bottom center) -->
  <g>
    <rect class="section-liquido" x="200" y="310" width="400" height="130" rx="6"/>
    <text class="liquido-label" x="400" y="340">{t.k3LoQueCobras}</text>
    <text class="liquido-label" x="400" y="358" fill="#F5E5BC">{t.liquidoAPercibir}</text>
    <text class="liquido-amount" x="400" y="410">1.254,75 €</text>
  </g>

  <!-- Side annotations -->
  <text class="note" x="40" y="260">{t.elIrpfEsUn}</text>
  <text class="note" x="40" y="275">{t.deJunioSeAjusta}</text>

  <text class="note" x="760" y="260" text-anchor="end">{t.laSsNoTe}</text>
  <text class="note" x="760" y="275" text-anchor="end">{t.pagaPensionesParoY}</text>

  <!-- Footer -->
  <text class="footer" x="400" y="475">{t.laDiferenciaEntreBruto}</text>
  <text class="footer" x="400" y="495">{t.cuandoUnAnuncioDice}</text>
</svg>
