    unoPorComunidadAutonomaAquiE: 'Uno por comunidad autónoma; aquí, el de la Comunitat Valenciana.',
    culminaLaOrganizacionJudicia: 'Culmina la organización judicial en su territorio.',
    salaDeLoCivilYPenalContencio: 'Sala de lo Civil y Penal · Contencioso-administrativo · Social',
    audienciaProvincial: 'Audiencia Provincial',
    resuelveLasApelacionesCivile: 'Resuelve las apelaciones civiles y penales de su provincia y juzga',
    enPrimeraInstanciaLosDelitos: 'en primera instancia los delitos más graves, con jurado si procede.',
    civilPenal: 'Civil · Penal',
    tribunalDeInstancia: 'Tribunal de Instancia',
    dondeEmpiezaCasiTodoUnoPorPa: 'Donde empieza casi todo. Uno por partido judicial, dividido en',
