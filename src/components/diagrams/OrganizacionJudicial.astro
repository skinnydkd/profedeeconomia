    internaEsDelConsejoDe: "interna. És del Consell",
    europaNoDeLaUnion: "d'Europa, no de la Unió.",
    elErrorClasicoCreerQueEstosT: "L'error clàssic: creure que estos tres són «l'escaló següent» si perds al Suprem.",
    noLoSonNingunoVuelveAJuzgarT: "No ho són. Cap no torna a jutjar el teu cas: revisen una altra cosa, i cadascun s'obri per una porta distinta.",
  },
} as const;

const t = COPY[locale];
---

<svg viewBox="0 0 820 620" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="organizacionjudicial-t organizacionjudicial-d">
  <title id="organizacionjudicial-t">{t.quienJuzgaQueYEnQueOrden}</title>
  <desc id="organizacionjudicial-d">{t.laPiramideJudicialOrdinariaT}</desc>
  <defs>
    <style>
      .bg { fill: #FBF6EC; }
      .lvl { fill: #FFFFFF; stroke: #1F6E6E; stroke-width: 1.8; }
      .lvl-top { fill: #DBEDED; stroke: #1F6E6E; stroke-width: 2.2; }
      .out { fill: #FFFFFF; stroke: #4A3B8F; stroke-width: 1.6; stroke-dasharray: 5 3; }
      .foot { fill: #F5EDD9; stroke: #8A7868; stroke-width: 1.4; }
      .name { font-family: 'Fraunces', serif; font-size: 17px; font-weight: 500; fill: #2A1F18; }
      .name-s { font-family: 'Fraunces', serif; font-size: 14px; font-weight: 500; fill: #2A1F18; }
      .txt { font-family: 'Switzer', sans-serif; font-size: 10.5px; fill: #5C4A3D; }
      .chips { font-family: 'Switzer', sans-serif; font-size: 9.5px; font-style: italic; fill: #8A7868; }
      .band { font-family: 'Switzer', sans-serif; font-size: 9px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase; fill: #8A7868; }
      .rise { fill: none; stroke: #C44E2C; stroke-width: 2; marker-end: url(#oj-arrow); }
      .rise-t { font-family: 'Fraunces', serif; font-style: italic; font-size: 12px; fill: #C44E2C; }
      .note-t { font-family: 'Switzer', sans-serif; font-size: 10.5px; fill: #5C4A3D; }
      .note-b { font-family: 'Switzer', sans-serif; font-size: 10.5px; font-weight: 700; fill: #2A1F18; }
    </style>
    <marker id="oj-arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#C44E2C" />
    </marker>
  </defs>

  <rect class="bg" x="0" y="0" width="820" height="620" />

  <text class="band" x="66" y="30">{t.laJurisdiccionOrdinaria}</text>
  <text class="band" x="584" y="30">{t.fueraDeLaPiramide}</text>

  <!-- Rising arrow -->
  <path class="rise" d="M 50 500 L 50 60" />
  <text class="rise-t" x="46" y="300" transform="rotate(-90 46 300)" text-anchor="middle">{t.losRecursosSuben}</text>

  <!-- Level 5: Supreme Court -->
  <rect class="lvl-top" x="66" y="46" width="494" height="80" rx="4" />
  <text class="name" x="86" y="74">{t.tribunalSupremo}</text>
  <text class="txt" x="86" y="94">{t.cuspideDeTodosLosOrdenesEnCa}</text>
  <text class="txt" x="86" y="110">{t.fijaComoDebeInterpretarseLaL}</text>
  <text class="chips" x="86" y="122">{t.civilPenalContenciosoAdminis}</text>

  <!-- Level 4: Audiencia Nacional -->
  <rect class="lvl" x="66" y="138" width="494" height="80" rx="4" />
  <text class="name" x="86" y="166">{t.audienciaNacional}</text>
  <text class="txt" x="86" y="186">{t.noEstaPorEncimaDeLosTsjTiene}</text>
  <text class="txt" x="86" y="202">{t.espanaComoTerrorismoODelitos}</text>
  <text class="chips" x="86" y="214">{t.penalContenciosoAdministrati}</text>

  <!-- Level 3: TSJ -->
  <rect class="lvl" x="66" y="230" width="494" height="80" rx="4" />
  <text class="name" x="86" y="258">{t.tribunalSuperiorDeJusticia}</text>
  <text class="txt" x="86" y="278">{t.unoPorComunidadAutonomaAquiE}</text>
  <text class="txt" x="86" y="294">{t.culminaLaOrganizacionJudicia}</text>
  <text class="chips" x="86" y="306">{t.salaDeLoCivilYPenalContencio}</text>

  <!-- Level 2: Audiencia Provincial -->
  <rect class="lvl" x="66" y="322" width="494" height="80" rx="4" />
  <text class="name" x="86" y="350">{t.audienciaProvincial}</text>
  <text class="txt" x="86" y="370">{t.resuelveLasApelacionesCivile}</text>
  <text class="txt" x="86" y="386">{t.enPrimeraInstanciaLosDelitos}</text>
  <text class="chips" x="86" y="398">{t.civilPenal}</text>

  <!-- Level 1: Tribunal de Instancia -->
  <rect class="lvl" x="66" y="414" width="494" height="80" rx="4" />
  <text class="name" x="86" y="442">{t.tribunalDeInstancia}</text>
  <text class="txt" x="86" y="462">{t.dondeEmpiezaCasiTodoUnoPorPa}</text>
  <text class="txt" x="86" y="478">{t.seccionesPorMateriaAntesSeLl}</text>
  <text class="chips" x="86" y="490">{t.civilInstruccionPenalContenc}</text>

  <!-- Footnote strip -->
  <rect class="foot" x="66" y="506" width="494" height="46" rx="4" />
  <text class="name-s" x="86" y="528">{t.juzgadosDePaz}</text>
  <text class="txt" x="192" y="528">{t.enMunicipiosSinPartidoJudici}</text>
  <text class="txt" x="86" y="544">{t.deEscasaCuantiaActosDeConcil}</text>

  <!-- Outside the pyramid -->
  <rect class="out" x="584" y="46" width="196" height="120" rx="4" />
  <text class="name-s" x="602" y="72">{t.tribunal}</text>
  <text class="name-s" x="602" y="90">{t.constitucional}</text>
  <text class="txt" x="602" y="112">{t.noEsUnaInstanciaMas}</text>
  <text class="txt" x="602" y="128">{t.recursoDeAmparoSoloPor}</text>
  <text class="txt" x="602" y="144">{t.derechosFundamentalesY}</text>
  <text class="txt" x="602" y="160">{t.agotadaLaViaJudicial}</text>

  <rect class="out" x="584" y="178" width="196" height="120" rx="4" />
  <text class="name-s" x="602" y="204">{t.tribunalDeJusticia}</text>
  <text class="name-s" x="602" y="222">{t.deLaUnionEuropea}</text>
  <text class="txt" x="602" y="244">{t.noLlegasTuLlegaTuCaso}</text>
  <text class="txt" x="602" y="260">{t.siElJuezEspanolPlantea}</text>
  <text class="txt" x="602" y="276">{t.unaCuestionPrejudicial}</text>
  <text class="txt" x="602" y="292">{t.sobreUnaNormaEuropea}</text>

  <rect class="out" x="584" y="310" width="196" height="120" rx="4" />
  <text class="name-s" x="602" y="336">{t.tribunalEuropeoDe}</text>
  <text class="name-s" x="602" y="354">{t.derechosHumanos}</text>
  <text class="txt" x="602" y="376">{t.demandaPropiaContraEl}</text>
  <text class="txt" x="602" y="392">{t.estadoAgotadaLaVia}</text>
  <text class="txt" x="602" y="408">{t.internaEsDelConsejoDe}</text>
  <text class="txt" x="602" y="424">{t.europaNoDeLaUnion}</text>

  <!-- Bottom note -->
  <text class="note-b" x="66" y="582">{t.elErrorClasicoCreerQueEstosT}</text>
  <text class="note-t" x="66" y="602">{t.noLoSonNingunoVuelveAJuzgarT}</text>
</svg>
