    deLaUnionEuropea: 'de la Unió Europea',
    noLlegasTuLlegaTuCaso: 'No hi arribes tu: hi arriba el teu cas,',
    siElJuezEspanolPlantea: 'si el jutge espanyol planteja',
    unaCuestionPrejudicial: 'una qüestió prejudicial',
    sobreUnaNormaEuropea: 'sobre una norma europea.',
    tribunalEuropeoDe: 'Tribunal Europeu de',
    derechosHumanos: 'Drets Humans',
    demandaPropiaContraEl: 'Demanda pròpia contra',
