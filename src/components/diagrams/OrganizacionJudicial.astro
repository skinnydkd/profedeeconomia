    civilInstruccionPenalContenc: 'Civil · Instrucción · Penal · Contencioso · Social · Menores · Violencia sobre la mujer',
    juzgadosDePaz: 'Juzgados de Paz',
    enMunicipiosSinPartidoJudici: 'en municipios sin partido judicial propio: asuntos civiles',
    deEscasaCuantiaActosDeConcil: 'de escasa cuantía, actos de conciliación y funciones de registro civil.',
    tribunal: 'Tribunal',
    constitucional: 'Constitucional',
    noEsUnaInstanciaMas: 'No es una instancia más.',
    recursoDeAmparoSoloPor: 'Recurso de amparo, solo por',
    derechosFundamentalesY: 'derechos fundamentales y',
    agotadaLaViaJudicial: 'agotada la vía judicial.',
    tribunalDeJusticia: 'Tribunal de Justicia',
    deLaUnionEuropea: 'de la Unión Europea',
    noLlegasTuLlegaTuCaso: 'No llegas tú: llega tu caso,',
    siElJuezEspanolPlantea: 'si el juez español plantea',
    unaCuestionPrejudicial: 'una cuestión prejudicial',
    sobreUnaNormaEuropea: 'sobre una norma europea.',
    tribunalEuropeoDe: 'Tribunal Europeo de',
    derechosHumanos: 'Derechos Humanos',
    demandaPropiaContraEl: 'Demanda propia contra el',
    estadoAgotadaLaVia: 'Estado, agotada la vía',
    internaEsDelConsejoDe: 'interna. Es del Consejo de',
    europaNoDeLaUnion: 'Europa, no de la Unión.',
    elErrorClasicoCreerQueEstosT: 'El error clásico: creer que estos tres son «el siguiente escalón» si pierdes en el Supremo.',
