---
/**
 * Branching tree of the main itineraries after 4.º ESO: Bachillerato
 * (→ Universidad / FP Superior), FP Grado Medio (→ FP Superior / empleo),
 * FP Grado Básico (→ FP Grado Medio) and the labour market. Arrows show the
 * bifurcations and where each branch can lead.
 *
 * Used in FOPP 4ESO · Unit 5 (el sistema educativo y los itinerarios).
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    itinerariosPrincipalesDespue: 'Itinerarios principales después de 4.º ESO',
    arbolDeBifurcacionesDesde: 'Árbol de bifurcaciones desde 4.º ESO hacia Bachillerato, FP de Grado Medio, FP de Grado Básico y el mundo laboral, con flechas que muestran a dónde puede conducir cada vía.',
    puntoDePartida: 'Punto de partida',
    k4OEso: '4.º ESO',
    laViaAcademicaMas: 'La vía académica más teórica. Tiene cuatro modalidades (Ciencias, Humanidades y CC. Sociales, Artes, General) y es la ruta natural hacia la universidad vía EBAU.',
    bachillerato: 'Bachillerato',
    k2CursosAcademico: '2 cursos · académico',
    formacionPracticaOrientadaA: 'Formación práctica orientada a una profesión, con prácticas en empresa (FCT). Permite trabajar al titular o seguir a un Grado Superior. No es una vía «de segunda»: tiene alta inserción laboral.',
    fpGradoMedio: 'FP Grado Medio',
    tecnicoAProfesional: 'Técnico/a profesional',
    pensadoParaQuienNo: 'Pensado para quien no obtiene el título de ESO. Dura dos años, da un perfil profesional básico y, al superarlo, equivale al título de ESO y permite pasar a un Grado Medio.',
    fpGradoBasico: 'FP Grado Básico',
    recuperaElTituloDe: 'Recupera el título de ESO',
    empezarATrabajarAl: 'Empezar a trabajar al acabar la ESO es legal a partir de los 16 años, pero sin titulación el acceso es a empleos poco cualificados. Siempre puedes retomar los estudios más adelante.',
    mundoLaboral: 'Mundo laboral',
    empleoDesdeYa: 'Empleo desde ya',
    estudiosSuperioresDeMayor: 'Estudios superiores de mayor recorrido teórico. Se accede desde Bachillerato (vía EBAU) o desde un Grado Superior de FP, que reserva una cuota de plazas.',
    universidad: 'Universidad',
    gradoMasterDoctorado: 'Grado, máster, doctorado',
    elNivelMasAlto: 'El nivel más alto de FP. Da el título de Técnico Superior, muy valorado en el empleo, y también permite acceder a la universidad convalidando parte del grado.',
    fpGradoSuperior: 'FP Grado Superior',
    tecnicoASuperior: 'Técnico/a superior',
    conUnTituloDe: 'Con un título de FP se accede a empleos con mejores condiciones y sueldos que sin titulación, en oficios que el mercado laboral demanda de forma estable.',
    empleoCualificado: 'Empleo cualificado',
    conTituloDeTecnico: 'Con título de técnico/a',
    viaEbau: 'vía EBAU',
    accesoDirecto: 'acceso directo',
    prueba: 'prueba',
    alTitular: 'al titular',
    titulaYEnlaza: 'titula y enlaza',
  },
  ca: {
    itinerariosPrincipalesDespue: 'Itineraris principals després de 4t ESO',
    arbolDeBifurcacionesDesde: 'Arbre de bifurcacions des de 4t ESO cap a Batxillerat, FP de Grau Mitjà, FP de Grau Bàsic i el món laboral, amb fletxes que mostren on pot conduir cada via.',
    puntoDePartida: 'Punt de partida',
    k4OEso: '4t ESO',
    laViaAcademicaMas: 'La via acadèmica més teòrica. Té quatre modalitats (Ciències, Humanitats i CC. Socials, Arts, General) i és la ruta natural cap a la universitat via EBAU.',
    bachillerato: 'Batxillerat',
    k2CursosAcademico: '2 cursos · acadèmic',
    formacionPracticaOrientadaA: 'Formació pràctica orientada a una professió, amb pràctiques en empresa (FCT). Permet treballar en titular o seguir cap a un Grau Superior. No és una via «de segona»: té alta inserció laboral.',
    fpGradoMedio: 'FP Grau Mitjà',
    tecnicoAProfesional: 'Tècnic/a professional',
    pensadoParaQuienNo: "Pensat per a qui no obté el títol d'ESO. Dura dos anys, dona un perfil professional bàsic i, en superar-lo, equival al títol d'ESO i permet passar a un Grau Mitjà.",
    fpGradoBasico: 'FP Grau Bàsic',
    recuperaElTituloDe: "Recupera el títol d'ESO",
    empezarATrabajarAl: "Començar a treballar en acabar l'ESO és legal a partir dels 16 anys, però sense titulació l'accés és a faenes poc qualificades. Sempre pots reprendre els estudis més avant.",
    mundoLaboral: 'Món laboral',
    empleoDesdeYa: 'Faena des de ja',
    estudiosSuperioresDeMayor: "Estudis superiors de major recorregut teòric. S'hi accedix des de Batxillerat (via EBAU) o des d'un Grau Superior d'FP, que reserva una quota de places.",
    universidad: 'Universitat',
    gradoMasterDoctorado: 'Grau, màster, doctorat',
    elNivelMasAlto: "El nivell més alt d'FP. Dona el títol de Tècnic Superior, molt valorat en la faena, i també permet accedir a la universitat convalidant part del grau.",
    fpGradoSuperior: 'FP Grau Superior',
    tecnicoASuperior: 'Tècnic/a superior',
    conUnTituloDe: "Amb un títol d'FP s'accedix a faenes amb millors condicions i sous que sense titulació, en oficis que el mercat laboral demana de manera estable.",
    empleoCualificado: 'Faena qualificada',
    conTituloDeTecnico: 'Amb títol de tècnic/a',
    viaEbau: 'via EBAU',
    accesoDirecto: 'accés directe',
    prueba: 'prova',
    alTitular: 'en titular',
    titulaYEnlaza: 'titula i enllaça',
  },
} as const;
const t = COPY[locale];
---
<svg viewBox="0 0 880 560" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="itin-title itin-desc">
  <title id="itin-title">{t.itinerariosPrincipalesDespue}</title>
  <desc id="itin-desc">{t.arbolDeBifurcacionesDesde}</desc>
  <defs>
    <style>
      .bg { fill: #FBF6EC; }
      .root { fill: #5B3A4E; stroke: #2A1F18; stroke-width: 2; }
      .node { fill: #FFFFFF; stroke-width: 2; }
      .n-bach { stroke: #C44E2C; }
      .n-medio { stroke: #A87A2A; }
      .n-basico { stroke: #8A7868; }
      .n-dest { fill: #ECDCE5; stroke: #5B3A4E; }
      .n-laboral { fill: #DBEDED; stroke: #1F6E6E; }
      .edge { fill: none; stroke: #5C4A3D; stroke-width: 1.8; marker-end: url(#itin-arrow); }
      .root-tag { font-family: 'Switzer', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; fill: #ECDCE5; text-anchor: middle; }
      .root-name { font-family: 'Fraunces', serif; font-style: italic; font-size: 22px; font-weight: 600; fill: #FFFFFF; text-anchor: middle; }
      .node-title { font-family: 'Fraunces', serif; font-size: 15px; font-weight: 500; fill: #2A1F18; text-anchor: middle; }
      .node-sub { font-family: 'Switzer', sans-serif; font-size: 11px; fill: #5C4A3D; text-anchor: middle; }
      .edge-label { font-family: 'Switzer', sans-serif; font-size: 9.5px; font-weight: 700; letter-spacing: 0.6px; text-transform: uppercase; fill: #8A7868; text-anchor: middle; }
      .has-tip { cursor: help; }
    </style>
    <marker id="itin-arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#5C4A3D"/>
    </marker>
  </defs>
  <rect class="bg" x="0" y="0" width="880" height="560"/>

  <!-- Root: 4.º ESO (left, centered vertically) -->
  <rect class="root" x="30" y="240" width="160" height="80" rx="10"/>
  <text class="root-tag" x="110" y="270">{t.puntoDePartida}</text>
  <text class="root-name" x="110" y="298">{t.k4OEso}</text>

  <!-- Level-1 branches (column 2) -->
  <!-- Bachillerato -->
  <rect class="node n-bach has-tip" x="290" y="40" width="200" height="74" rx="8"><title>{t.laViaAcademicaMas}</title></rect>
  <text class="node-title" x="390" y="72">{t.bachillerato}</text>
  <text class="node-sub" x="390" y="92">{t.k2CursosAcademico}</text>
  <!-- FP Grado Medio -->
  <rect class="node n-medio has-tip" x="290" y="160" width="200" height="74" rx="8"><title>{t.formacionPracticaOrientadaA}</title></rect>
  <text class="node-title" x="390" y="192">{t.fpGradoMedio}</text>
  <text class="node-sub" x="390" y="212">{t.tecnicoAProfesional}</text>
  <!-- FP Grado Básico -->
  <rect class="node n-basico has-tip" x="290" y="300" width="200" height="74" rx="8"><title>{t.pensadoParaQuienNo}</title></rect>
  <text class="node-title" x="390" y="332">{t.fpGradoBasico}</text>
  <text class="node-sub" x="390" y="352">{t.recuperaElTituloDe}</text>
  <!-- Mundo laboral -->
  <rect class="node n-laboral has-tip" x="290" y="430" width="200" height="74" rx="8"><title>{t.empezarATrabajarAl}</title></rect>
  <text class="node-title" x="390" y="462">{t.mundoLaboral}</text>
  <text class="node-sub" x="390" y="482">{t.empleoDesdeYa}</text>

  <!-- Edges from root to level-1 -->
  <path class="edge" d="M 190 260 Q 240 200 288 90"/>
  <path class="edge" d="M 190 275 Q 240 240 288 197"/>
  <path class="edge" d="M 190 295 Q 240 320 288 337"/>
  <path class="edge" d="M 190 312 Q 240 420 288 467"/>

  <!-- Level-2 destinations (column 3) -->
  <!-- Universidad -->
  <rect class="node n-dest has-tip" x="610" y="30" width="230" height="64" rx="8"><title>{t.estudiosSuperioresDeMayor}</title></rect>
  <text class="node-title" x="725" y="58">{t.universidad}</text>
  <text class="node-sub" x="725" y="78">{t.gradoMasterDoctorado}</text>
  <!-- FP Grado Superior -->
  <rect class="node n-dest has-tip" x="610" y="160" width="230" height="64" rx="8"><title>{t.elNivelMasAlto}</title></rect>
  <text class="node-title" x="725" y="188">{t.fpGradoSuperior}</text>
  <text class="node-sub" x="725" y="208">{t.tecnicoASuperior}</text>
  <!-- Empleo cualificado -->
  <rect class="node n-laboral has-tip" x="610" y="330" width="230" height="64" rx="8"><title>{t.conUnTituloDe}</title></rect>
  <text class="node-title" x="725" y="358">{t.empleoCualificado}</text>
  <text class="node-sub" x="725" y="378">{t.conTituloDeTecnico}</text>

  <!-- Edges from Bachillerato -->
  <path class="edge" d="M 490 64 L 608 60"/>
  <path class="edge" d="M 490 96 Q 560 140 608 178"/>
  <!-- Edges from FP Grado Medio -->
  <path class="edge" d="M 490 188 Q 560 192 608 192"/>
  <path class="edge" d="M 490 212 Q 560 300 608 352"/>
  <!-- Edge from FP Grado Básico → FP Grado Medio -->
  <path class="edge" d="M 490 320 Q 520 270 470 238"/>

  <!-- Edge labels -->
  <text class="edge-label" x="548" y="48">{t.viaEbau}</text>
  <text class="edge-label" x="548" y="128">{t.accesoDirecto}</text>
  <text class="edge-label" x="548" y="178">{t.prueba}</text>
  <text class="edge-label" x="548" y="290">{t.alTitular}</text>
  <text class="edge-label" x="525" y="262">{t.titulaYEnlaza}</text>
</svg>
