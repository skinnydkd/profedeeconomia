---
/**
 * Separation of powers in Spain, drawn as a circuit (CJD Bach, unit 3).
 *
 * Two things students routinely miss and this figure makes explicit:
 *  - the chain of legitimacy runs upward from the electorate, so the
 *    Government is not elected directly but invested by Congress;
 *  - control runs the other way, and the Constitutional Court sits outside
 *    the three powers rather than on top of the judiciary.
 * The Crown is drawn to the side with its countersignature requirement,
 * because "arbitrates and moderates" without "is not accountable" is the
 * half-explanation that leaves the institution incomprehensible.
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    circuitoDelPoderEnEspanaLaCi: 'Circuito del poder en España. La ciudadanía elige las Cortes Generales, que ejercen el poder legislativo y además inviste al presidente del Gobierno, que ejerce el ejecutivo. El poder judicial aplica la ley y controla la actuación de la Administración. El Tribunal Constitucional queda fuera de los tres poderes y puede anular leyes. La Corona ejerce funciones de representación y arbitraje, siempre con refrendo de otro órgano, que asume la responsabilidad.',
    quienEligeAQuienYQuienContro: 'Quién elige a quién y quién controla a quién',
    ciudadania: 'Ciudadanía',
    laSoberaniaNacionalResideEnE: 'La soberanía nacional reside en el pueblo',
    art12Ce: 'art. 1.2 CE',
    elige: 'elige',
    cortesGenerales: 'Cortes Generales',
    congresoDeLosDiputadosYSenad: 'Congreso de los Diputados y Senado',
    poderLegislativoApruebanLasL: 'Poder legislativo: aprueban las leyes',
    inviste: 'inviste',
    gobierno: 'Gobierno',
    poderEjecutivoDirigeLaAdmini: 'Poder ejecutivo. Dirige la Administración',
    yEjerceLaPotestadReglamentar: 'y ejerce la potestad reglamentaria',
    poderJudicial: 'Poder judicial',
    juecesYMagistrados: 'Jueces y magistrados,',
    independientesEInamovibles: 'independientes e inamovibles',
    controla: 'controla',
    tribunalConstitucional: 'Tribunal Constitucional',
    fueraDeLosTresPoderes: 'Fuera de los tres poderes.',
    puedeAnularUnaLey: 'Puede anular una ley.',
    anulaNormas: 'anula normas',
    inconstitucionales: 'inconstitucionales',
    laCorona: 'La Corona',
    jefaturaDelEstado: 'Jefatura del Estado.',
    arbitraYModeraNoGobierna: 'Arbitra y modera; no gobierna.',
    laPiezaQueExplicaALaCoronaEl: 'La pieza que explica a la Corona: el refrendo.',
    losActosDelReyDebenIrRefrend: 'Los actos del Rey deben ir refrendados por el presidente del Gobierno o el ministro competente,',
    queAsumeLaResponsabilidadPor: 'que asume la responsabilidad. Por eso el Rey no responde políticamente: porque tampoco decide.',
    flechasContinuas: 'Flechas continuas',
    cadenaDeLegitimidadDeDondeVi: 'cadena de legitimidad: de dónde viene el poder de cada órgano.',
    flechasDiscontinuas: 'Flechas discontinuas',
    cadenaDeControlQuienVigilaAQ: 'cadena de control: quién vigila a quién.',
    fijateEnQueElGobiernoNoLoEli: 'Fíjate en que el Gobierno no lo elige la ciudadanía directamente: lo inviste el Congreso, y ante el Congreso responde.',
  },
  ca: {
    circuitoDelPoderEnEspanaLaCi: "Circuit del poder a Espanya. La ciutadania elegix les Corts Generals, que exercixen el poder legislatiu i a més investixen el president del Govern, que exercix l'executiu. El poder judicial aplica la llei i controla l'actuació de l'Administració. El Tribunal Constitucional queda fora dels tres poders i pot anul·lar lleis. La Corona exercix funcions de representació i arbitratge, sempre amb referendament d'un altre òrgan, que assumix la responsabilitat.",
    quienEligeAQuienYQuienContro: 'Qui elegix qui i qui controla qui',
    ciudadania: 'Ciutadania',
    laSoberaniaNacionalResideEnE: 'La sobirania nacional residix en el poble',
    art12Ce: 'art. 1.2 CE',
    elige: 'elegix',
    cortesGenerales: 'Corts Generals',
    congresoDeLosDiputadosYSenad: 'Congrés dels Diputats i Senat',
    poderLegislativoApruebanLasL: 'Poder legislatiu: aproven les lleis',
    inviste: 'investix',
    gobierno: 'Govern',
    poderEjecutivoDirigeLaAdmini: "Poder executiu. Dirigix l'Administració",
    yEjerceLaPotestadReglamentar: 'i exercix la potestat reglamentària',
    poderJudicial: 'Poder judicial',
    juecesYMagistrados: 'Jutges i magistrats,',
    independientesEInamovibles: 'independents i inamovibles',
    controla: 'controla',
    tribunalConstitucional: 'Tribunal Constitucional',
    fueraDeLosTresPoderes: 'Fora dels tres poders.',
    puedeAnularUnaLey: 'Pot anul·lar una llei.',
    anulaNormas: 'anul·la normes',
    inconstitucionales: 'inconstitucionals',
    laCorona: 'La Corona',
    jefaturaDelEstado: "Prefectura de l'Estat.",
    arbitraYModeraNoGobierna: 'Arbitra i modera; no governa.',
