const t = COPY[locale];
---
<svg class="d-tipos-contrato" viewBox="0 0 800 470" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="contrato-title contrato-desc">
  <title id="contrato-title">{t.losCuatroTiposDe}</title>
  <desc id="contrato-desc">{t.cuatroTarjetasComparanLos}</desc>
  <defs>
    <style>
      .d-tipos-contrato .bg { fill: #FBF6EC; }
      .d-tipos-contrato .card { fill: #FFFFFF; stroke-width: 1.8; }
      .d-tipos-contrato .card-1 { stroke: #C44E2C; }
      .d-tipos-contrato .card-2 { stroke: #D4A24C; }
      .d-tipos-contrato .card-3 { stroke: #1F6E6E; }
      .d-tipos-contrato .card-4 { stroke: #5B3A4E; }
      .d-tipos-contrato .tab-1 { fill: #C44E2C; }
      .d-tipos-contrato .tab-2 { fill: #D4A24C; }
      .d-tipos-contrato .tab-3 { fill: #1F6E6E; }
      .d-tipos-contrato .tab-4 { fill: #5B3A4E; }
      .d-tipos-contrato .tab-text { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; fill: #FFFFFF; text-anchor: middle; }
      .d-tipos-contrato .card-title { font-family: 'Fraunces', serif; font-size: 16px; font-weight: 500; text-anchor: middle; }
      .d-tipos-contrato .card-line { font-family: 'Switzer', sans-serif; font-size: 11px; fill: #5C4A3D; }
      .d-tipos-contrato .card-key { font-family: 'Switzer', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 0.6px; text-transform: uppercase; fill: #8A7868; }
      .d-tipos-contrato .header { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; fill: #8A7868; text-anchor: middle; }
      .d-tipos-contrato .footer { font-family: 'Fraunces', serif; font-style: italic; font-size: 13px; fill: #5C4A3D; text-anchor: middle; }
      .d-tipos-contrato .has-tip { cursor: help; }
    </style>
  </defs>
  <rect class="bg" x="0" y="0" width="800" height="470"/>

  <text class="header" x="400" y="38">{t.contratosLaboralesEnEspana}</text>

  <!-- Card 1: Indefinido (x 30, width 175) -->
  <rect class="card card-1 has-tip" x="30" y="65" width="175" height="320" rx="7"><title>{t.esElContratoNormal}</title></rect>
  <rect class="tab-1" x="30" y="65" width="175" height="30" rx="7"/>
  <rect class="tab-1" x="30" y="80" width="175" height="15"/>
  <text class="tab-text" x="117" y="85">{t.porDefecto}</text>
  <text class="card-title" x="117" y="125" fill="#9C3A1C">{t.indefinido}</text>
  <text class="card-key" x="48" y="160">{t.duracion}</text>
  <text class="card-line" x="48" y="177">{t.sinFechaDeFin}</text>
  <text class="card-key" x="48" y="208">{t.paraQuien}</text>
  <text class="card-line" x="48" y="225">{t.laReglaGeneral}</text>
  <text class="card-line" x="48" y="240">{t.desdeLaReforma}</text>
  <text class="card-key" x="48" y="271">{t.clave}</text>
  <text class="card-line" x="48" y="288">{t.indemnizacionDe}</text>
  <text class="card-line" x="48" y="303">{t.k33DiasAno}</text>
  <text class="card-line" x="48" y="318">{t.derechoPlenoAl}</text>
  <text class="card-line" x="48" y="333">{t.paroYEstabilidad}</text>
  <text class="card-line" x="48" y="362">{t.paraCreditos}</text>

  <!-- Card 2: Temporal (x 215) -->
  <rect class="card card-2 has-tip" x="215" y="65" width="175" height="320" rx="7"><title>{t.trasLaReformaDe}</title></rect>
  <rect class="tab-2" x="215" y="65" width="175" height="30" rx="7"/>
  <rect class="tab-2" x="215" y="80" width="175" height="15"/>
  <text class="tab-text" x="302" y="85">{t.soloConCausa}</text>
  <text class="card-title" x="302" y="125" fill="#A87A2A">{t.temporal}</text>
  <text class="card-key" x="233" y="160">{t.duracion2}</text>
  <text class="card-line" x="233" y="177">{t.k6Meses12Por}</text>
  <text class="card-line" x="233" y="192">{t.convenio}</text>
  <text class="card-key" x="233" y="223">{t.paraQuien2}</text>
  <text class="card-line" x="233" y="240">{t.sustitucionDeBaja}</text>
  <text class="card-line" x="233" y="255">{t.oPicoDeProduccion}</text>
  <text class="card-key" x="233" y="286">{t.clave2}</text>
  <text class="card-line" x="233" y="303">{t.sinCausaRealEs}</text>
  <text class="card-line" x="233" y="318">{t.fraudePasaASer}</text>
  <text class="card-line" x="233" y="333">{t.indefinido2}</text>

  <!-- Card 3: Formación en alternancia (x 400) -->
  <rect class="card card-3 has-tip" x="400" y="65" width="175" height="320" rx="7"><title>{t.esLaBaseDe}</title></rect>
  <rect class="tab-3" x="400" y="65" width="175" height="30" rx="7"/>
  <rect class="tab-3" x="400" y="80" width="175" height="15"/>
  <text class="tab-text" x="487" y="85">{t.formativo}</text>
  <text class="card-title" x="487" y="118" fill="#0E4040">{t.formacionEn}</text>
  <text class="card-title" x="487" y="137" fill="#0E4040">{t.alternancia}</text>
  <text class="card-key" x="418" y="170">{t.duracion3}</text>
  <text class="card-line" x="418" y="187">{t.k3Meses2Anos}</text>
  <text class="card-key" x="418" y="218">{t.paraQuien3}</text>
  <text class="card-line" x="418" y="235">{t.k16A30Anos}</text>
  <text class="card-line" x="418" y="250">{t.sinTituloPrevio}</text>
  <text class="card-key" x="418" y="281">{t.clave3}</text>
  <text class="card-line" x="418" y="298">{t.combinaTrabajoY}</text>
  <text class="card-line" x="418" y="313">{t.estudioSalario}</text>
  <text class="card-line" x="418" y="328">{t.segunJornada}</text>
  <text class="card-line" x="418" y="343">{t.nuncaBajoElSmi}</text>

  <!-- Card 4: En prácticas (x 585) -->
  <rect class="card card-4 has-tip" x="585" y="65" width="185" height="320" rx="7"><title>{t.sirveParaCogerExperiencia}</title></rect>
  <rect class="tab-4" x="585" y="65" width="185" height="30" rx="7"/>
  <rect class="tab-4" x="585" y="80" width="185" height="15"/>
  <text class="tab-text" x="677" y="85">{t.formativo2}</text>
  <text class="card-title" x="677" y="125" fill="#5B3A4E">{t.enPracticas}</text>
  <text class="card-key" x="603" y="160">{t.duracion4}</text>
  <text class="card-line" x="603" y="177">{t.k6Meses1Ano}</text>
  <text class="card-key" x="603" y="208">{t.paraQuien4}</text>
  <text class="card-line" x="603" y="225">{t.conTituloDeFp}</text>
  <text class="card-line" x="603" y="240">{t.universidadReciente}</text>
  <text class="card-line" x="603" y="255">{t.ultimos3Anos}</text>
  <text class="card-key" x="603" y="286">{t.clave4}</text>
  <text class="card-line" x="603" y="303">{t.salarioIntegroDe}</text>
  <text class="card-line" x="603" y="318">{t.convenioSinRecorte}</text>
  <text class="card-line" x="603" y="333">{t.porSerPracticas}</text>

  <!-- Footer note -->
  <text class="footer" x="400" y="425">{t.trasLaReformaDe2}</text>
  <text class="footer" x="400" y="447">{t.cuidadoConElFalso}</text>
</svg>
