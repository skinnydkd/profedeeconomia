---
/**
 * Monetary aggregates ordered by liquidity as nested layers M0 ⊂ M1 ⊂ M2 ⊂ M3.
 * Concentric rounded rectangles: the innermost (M0, cash) is the most liquid,
 * and each larger aggregate contains the previous one and adds less liquid
 * instruments. A side axis marks the liquidity gradient.
 *
 * Used in Eco 1BACH · Unit 10 (financial system and money).
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    agregadosMonetarios: 'Agregados monetarios',
    losAgregadosMonetariosOrdena: 'Los agregados monetarios ordenan el dinero por liquidez: M0 es el efectivo y cada agregado mayor incluye al anterior añadiendo instrumentos menos líquidos.',
    masLiquido: 'Más líquido',
    menosLiquido: 'Menos líquido',
    m2OtrosInstrumentosA: 'M2 + otros instrumentos a más plazo (repos, etc.)',
    m1DepositosDeAhorro: 'M1 + depósitos de ahorro a corto plazo',
    m0DepositosALa: 'M0 + depósitos a la vista',
    efectivoBilletesYMonedas: 'Efectivo: billetes y monedas',
    elNucleoMasLiquido: 'El núcleo más líquido del dinero.',
  },
  ca: {
    agregadosMonetarios: 'Agregats monetaris',
    losAgregadosMonetariosOrdena: "Els agregats monetaris ordenen els diners per liquiditat: M0 és l'efectiu i cada agregat major inclou l'anterior afegint instruments menys líquids.",
    masLiquido: 'Més líquid',
    menosLiquido: 'Menys líquid',
    m2OtrosInstrumentosA: 'M2 + altres instruments a més termini (repos, etc.)',
    m1DepositosDeAhorro: "M1 + depòsits d'estalvi a curt termini",
    m0DepositosALa: 'M0 + depòsits a la vista',
    efectivoBilletesYMonedas: 'Efectiu: bitllets i monedes',
    elNucleoMasLiquido: 'El nucli més líquid dels diners.',
  },
} as const;
const t = COPY[locale];
---
<svg class="d-agregados-monetarios" viewBox="0 0 820 480" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="am-title am-desc">
  <title id="am-title">{t.agregadosMonetarios}</title>
  <desc id="am-desc">{t.losAgregadosMonetariosOrdena}</desc>
  <defs>
    <style>
      .d-agregados-monetarios .bg { fill: #FBF6EC; }
      .d-agregados-monetarios .band { stroke: #E5D4BD; stroke-width: 1.5; }
      .d-agregados-monetarios .band-m3 { fill: #F5EDD9; }
      .d-agregados-monetarios .band-m2 { fill: #DBEDED; }
      .d-agregados-monetarios .band-m1 { fill: #F5E5BC; }
      .d-agregados-monetarios .band-m0 { fill: #FBE3D6; }
      .d-agregados-monetarios .tag { font-family: 'Fraunces', serif; font-size: 22px; font-weight: 600; font-style: italic; }
      .d-agregados-monetarios .tag-m0 { fill: #9C3A1C; }
      .d-agregados-monetarios .tag-m1 { fill: #A87A2A; }
      .d-agregados-monetarios .tag-m2 { fill: #1F6E6E; }
      .d-agregados-monetarios .tag-m3 { fill: #5C4A3D; }
      .d-agregados-monetarios .content { font-family: 'Switzer', sans-serif; font-size: 13px; font-weight: 500; fill: #5C4A3D; }
      .d-agregados-monetarios .axis-label { font-family: 'Switzer', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; fill: #5C4A3D; }
      .d-agregados-monetarios .axis-line { stroke: #8A7868; stroke-width: 1.5; fill: none; }
    </style>
    <marker id="am-arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#8A7868"/>
    </marker>
  </defs>
  <rect class="bg" x="0" y="0" width="820" height="480"/>

  <!-- Liquidity axis on the left: top = más líquido, bottom = menos líquido -->
  <line class="axis-line" x1="40" y1="60" x2="40" y2="430" marker-start="url(#am-arrow)" marker-end="url(#am-arrow)"/>
  <text class="axis-label" x="28" y="100" text-anchor="middle" transform="rotate(-90 28 100)">{t.masLiquido}</text>
  <text class="axis-label" x="28" y="395" text-anchor="middle" transform="rotate(-90 28 395)">{t.menosLiquido}</text>

  <!-- Nested aggregates. Outer M3 → inner M0. Each band's label sits in its own ring (top of band). -->
  <!-- M3: outer -->
  <rect class="band band-m3" x="100" y="40" width="690" height="410" rx="14"/>
  <text class="tag tag-m3" x="124" y="74">M3</text>
  <text class="content" x="168" y="71">{t.m2OtrosInstrumentosA}</text>

  <!-- M2 -->
  <rect class="band band-m2" x="140" y="100" width="610" height="310" rx="12"/>
  <text class="tag tag-m2" x="164" y="134">M2</text>
  <text class="content" x="208" y="131">{t.m1DepositosDeAhorro}</text>

  <!-- M1 -->
  <rect class="band band-m1" x="180" y="160" width="530" height="210" rx="10"/>
  <text class="tag tag-m1" x="204" y="194">M1</text>
  <text class="content" x="248" y="191">{t.m0DepositosALa}</text>

  <!-- M0: innermost, most liquid -->
  <rect class="band band-m0" x="220" y="220" width="450" height="110" rx="8"/>
  <text class="tag tag-m0" x="244" y="262">M0</text>
  <text class="content" x="288" y="259">{t.efectivoBilletesYMonedas}</text>
  <text class="content" x="244" y="298">{t.elNucleoMasLiquido}</text>
</svg>
