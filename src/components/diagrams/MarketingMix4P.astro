---
/**
 * Marketing mix 4P diagram: four interlocking quadrants around a
 * central target customer node.
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    elMarketingMixLas: 'El marketing mix: las 4P (Producto, Precio, Plaza, Promoción)',
    producto: 'PRODUCTO',
    queVendemos: '¿Qué vendemos?',
    disenoCalidadGama: '· Diseño, calidad, gama',
    marcaYPackaging: '· Marca y packaging',
    garantiaYPostventa: '· Garantía y postventa',
    serviciosComplementarios: '· Servicios complementarios',
    precio: 'PRECIO',
    cuantoCuesta: '¿Cuánto cuesta?',
    estrategiaPremiumParidad: '· Estrategia (premium, paridad...)',
    descuentosYPromociones: '· Descuentos y promociones',
    formasDePago: '· Formas de pago',
    condicionesDeCredito: '· Condiciones de crédito',
    plaza: 'PLAZA',
    dondeSeVende: '¿Dónde se vende?',
    canalesDirectoCortoLargo: '· Canales (directo, corto, largo)',
    coberturaGeografica: '· Cobertura geográfica',
    inventarioYTransporte: '· Inventario y transporte',
    puntoDeVentaFisico: '· Punto de venta físico/digital',
    promocion: 'PROMOCIÓN',
    comoSeComunica: '¿Cómo se comunica?',
    publicidad: '· Publicidad',
    relacionesPublicas: '· Relaciones públicas',
    ventaPersonal: '· Venta personal',
    marketingDigitalYRedes: '· Marketing digital y redes',
    cliente: 'CLIENTE',
    objetivo: 'objetivo',
  },
  ca: {
    elMarketingMixLas: 'El màrqueting mix: les 4P (Producte, Preu, Plaça, Promoció)',
    producto: 'PRODUCTE',
    queVendemos: 'Què venem?',
    disenoCalidadGama: '· Disseny, qualitat, gamma',
    marcaYPackaging: '· Marca i packaging',
    garantiaYPostventa: '· Garantia i postvenda',
    serviciosComplementarios: '· Serveis complementaris',
    precio: 'PREU',
    cuantoCuesta: 'Quant costa?',
    estrategiaPremiumParidad: '· Estratègia (premium, paritat...)',
    descuentosYPromociones: '· Descomptes i promocions',
    formasDePago: '· Formes de pagament',
    condicionesDeCredito: '· Condicions de crèdit',
    plaza: 'PLAÇA',
    dondeSeVende: 'On es ven?',
    canalesDirectoCortoLargo: '· Canals (directe, curt, llarg)',
    coberturaGeografica: '· Cobertura geogràfica',
    inventarioYTransporte: '· Inventari i transport',
    puntoDeVentaFisico: '· Punt de venda físic/digital',
    promocion: 'PROMOCIÓ',
    comoSeComunica: 'Com es comunica?',
    publicidad: '· Publicitat',
    relacionesPublicas: '· Relacions públiques',
    ventaPersonal: '· Venda personal',
    marketingDigitalYRedes: '· Màrqueting digital i xarxes',
    cliente: 'CLIENT',
    objetivo: 'objectiu',
  },
} as const;
const t = COPY[locale];
---
<svg class="d-marketing-mix4-p" viewBox="0 0 720 480" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={t.elMarketingMixLas}>
  <defs>
    <style>
      .d-marketing-mix4-p .bg { fill: #FBF6EC; }
      .d-marketing-mix4-p .quad-prod { fill: #FBE3D6; stroke: #C44E2C; stroke-width: 2; }
      .d-marketing-mix4-p .quad-price { fill: #F5E5BC; stroke: #D4A24C; stroke-width: 2; }
      .d-marketing-mix4-p .quad-place { fill: #DBEDED; stroke: #1F6E6E; stroke-width: 2; }
      .d-marketing-mix4-p .quad-promo { fill: #ECDCE5; stroke: #5B3A4E; stroke-width: 2; }
      .d-marketing-mix4-p .center { fill: #2A1F18; stroke: #FFFFFF; stroke-width: 3; }
      .d-marketing-mix4-p .center-label-1 { font-family: 'Switzer', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; fill: #F5E5BC; text-anchor: middle; }
      .d-marketing-mix4-p .center-label-2 { font-family: 'Fraunces', serif; font-style: italic; font-size: 18px; font-weight: 500; fill: #FFFFFF; text-anchor: middle; }
      .d-marketing-mix4-p .letter { font-family: 'Fraunces', serif; font-style: italic; font-size: 56px; font-weight: 500; }
      .d-marketing-mix4-p .quad-name { font-family: 'Switzer', sans-serif; font-size: 13px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; }
      .d-marketing-mix4-p .quad-q { font-family: 'Fraunces', serif; font-style: italic; font-size: 13px; fill: #2A1F18; }
      .d-marketing-mix4-p .quad-bullet { font-family: 'Switzer', sans-serif; font-size: 11px; fill: #5C4A3D; }
    </style>
  </defs>
  <rect class="bg" x="0" y="0" width="720" height="480"/>

  <!-- Top-left: Producto -->
  <g>
    <rect class="quad-prod" x="40" y="40" width="290" height="180" rx="6"/>
    <text class="letter" x="290" y="100" fill="#9C3A1C" text-anchor="end">P</text>
    <text class="quad-name" x="60" y="62" fill="#9C3A1C">{t.producto}</text>
    <text class="quad-q" x="60" y="115">{t.queVendemos}</text>
    <text class="quad-bullet" x="60" y="142">{t.disenoCalidadGama}</text>
    <text class="quad-bullet" x="60" y="158">{t.marcaYPackaging}</text>
    <text class="quad-bullet" x="60" y="174">{t.garantiaYPostventa}</text>
    <text class="quad-bullet" x="60" y="200">{t.serviciosComplementarios}</text>
  </g>

  <!-- Top-right: Precio -->
  <g>
    <rect class="quad-price" x="390" y="40" width="290" height="180" rx="6"/>
    <text class="letter" x="640" y="100" fill="#A87A2A" text-anchor="end">P</text>
    <text class="quad-name" x="410" y="62" fill="#A87A2A">{t.precio}</text>
    <text class="quad-q" x="410" y="115">{t.cuantoCuesta}</text>
    <text class="quad-bullet" x="410" y="142">{t.estrategiaPremiumParidad}</text>
    <text class="quad-bullet" x="410" y="158">{t.descuentosYPromociones}</text>
    <text class="quad-bullet" x="410" y="174">{t.formasDePago}</text>
    <text class="quad-bullet" x="410" y="200">{t.condicionesDeCredito}</text>
  </g>

  <!-- Bottom-left: Plaza -->
  <g>
    <rect class="quad-place" x="40" y="260" width="290" height="180" rx="6"/>
    <text class="letter" x="290" y="320" fill="#1F6E6E" text-anchor="end">P</text>
    <text class="quad-name" x="60" y="282" fill="#1F6E6E">{t.plaza}</text>
    <text class="quad-q" x="60" y="335">{t.dondeSeVende}</text>
    <text class="quad-bullet" x="60" y="362">{t.canalesDirectoCortoLargo}</text>
    <text class="quad-bullet" x="60" y="378">{t.coberturaGeografica}</text>
    <text class="quad-bullet" x="60" y="394">{t.inventarioYTransporte}</text>
    <text class="quad-bullet" x="60" y="420">{t.puntoDeVentaFisico}</text>
  </g>

  <!-- Bottom-right: Promoción -->
  <g>
    <rect class="quad-promo" x="390" y="260" width="290" height="180" rx="6"/>
    <text class="letter" x="640" y="320" fill="#5B3A4E" text-anchor="end">P</text>
    <text class="quad-name" x="410" y="282" fill="#5B3A4E">{t.promocion}</text>
    <text class="quad-q" x="410" y="335">{t.comoSeComunica}</text>
    <text class="quad-bullet" x="410" y="362">{t.publicidad}</text>
    <text class="quad-bullet" x="410" y="378">{t.relacionesPublicas}</text>
    <text class="quad-bullet" x="410" y="394">{t.ventaPersonal}</text>
    <text class="quad-bullet" x="410" y="420">{t.marketingDigitalYRedes}</text>
  </g>

  <!-- Center: cliente objetivo -->
  <circle class="center" cx="360" cy="240" r="42"/>
  <text class="center-label-1" x="360" y="232">{t.cliente}</text>
  <text class="center-label-2" x="360" y="256">{t.objetivo}</text>
</svg>
