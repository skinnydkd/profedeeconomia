---
/**
 * Comparativa de los cuatro tipos de proceso productivo, situados en una
 * matriz volumen (eje horizontal) frente a variedad (eje vertical):
 * por proyecto, por lotes, en masa y continuo. A más volumen, menos
 * variedad, y viceversa: la clásica relación inversa producto-proceso.
 *
 * Used in EDMN 2BACH · Unit 7 (función productiva).
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    tiposDeProcesoProductivo: 'Tipos de proceso productivo',
    losCuatroTiposDe: 'Los cuatro tipos de proceso productivo —por proyecto, por lotes, en masa y continuo— se ordenan en una diagonal: a poco volumen y mucha variedad corresponde la producción por proyecto; a mucho volumen y poca variedad, la producción continua.',
    volumenDeProduccion: 'VOLUMEN DE PRODUCCIÓN  →',
    variedadDelProducto: 'VARIEDAD DEL PRODUCTO  →',
    bajoVolumen: 'bajo volumen',
    altoVolumen: 'alto volumen',
    costeUnitarioMuyAlto: 'Coste unitario muy alto y mano de obra muy cualificada. Cada encargo es distinto, así que es difícil aprovechar economías de escala.',
    porProyecto: 'Por proyecto',
    unaUnidadUnica: 'Una unidad única,',
    aMedidaDelCliente: 'a medida del cliente',
    unPuenteUnBarco: 'un puente, un barco,',
    unaBoda: 'una boda',
    equilibrioEntreVariedadY: 'Equilibrio entre variedad y volumen. Permite cambiar de modelo entre tandas, pero cada cambio de lote tiene un coste de preparación de la maquinaria.',
    porLotesBatch: 'Por lotes (batch)',
    tandasDeProducto: 'Tandas de producto',
    queSeRepiten: 'que se repiten',
    panaderiaRopaPor: 'panadería, ropa por',
    coleccionesMuebles: 'colecciones, muebles',
    aprovechaAlMaximoLas: 'Aprovecha al máximo las economías de escala: el coste por unidad cae mucho. A cambio, es muy rígido ante cambios en el producto. Es la cadena de montaje de Ford.',
    enMasaCadena: 'En masa (cadena)',
    granVolumenDeUn: 'Gran volumen de un',
    productoEstandar: 'producto estándar',
    automoviles: 'automóviles,',
    electrodomesticos: 'electrodomésticos',
    noParaNuncaPorque: 'No para nunca porque arrancar y detener la planta es carísimo o técnicamente imposible. Produce un único producto homogéneo de forma ininterrumpida.',
    continuo: 'Continuo',
    flujoIninterrumpido: 'Flujo ininterrumpido',
    k24HorasSinParadas: '24 horas, sin paradas',
    refineriaCentral: 'refinería, central',
    electricaCementera: 'eléctrica, cementera',
  },
  ca: {
    tiposDeProcesoProductivo: 'Tipus de procés productiu',
    losCuatroTiposDe: "Els quatre tipus de procés productiu —per projecte, per lots, en massa i continu— s'ordenen en una diagonal: a poc volum i molta varietat correspon la producció per projecte; a molt volum i poca varietat, la producció contínua.",
    volumenDeProduccion: 'VOLUM DE PRODUCCIÓ  →',
    variedadDelProducto: 'VARIETAT DEL PRODUCTE  →',
    bajoVolumen: 'poc volum',
    altoVolumen: 'molt volum',
    costeUnitarioMuyAlto: "Cost unitari molt alt i mà d'obra molt qualificada. Cada encàrrec és diferent, així que és difícil aprofitar economies d'escala.",
    porProyecto: 'Per projecte',
    unaUnidadUnica: 'Una unitat única,',
    aMedidaDelCliente: 'a mida del client',
    unPuenteUnBarco: 'un pont, un vaixell,',
    unaBoda: 'una boda',
    equilibrioEntreVariedadY: 'Equilibri entre varietat i volum. Permet canviar de model entre tandes, però cada canvi de lot té un cost de preparació de la maquinària.',
    porLotesBatch: 'Per lots (batch)',
    tandasDeProducto: 'Tandes de producte',
    queSeRepiten: 'que es repetixen',
    panaderiaRopaPor: 'forn, roba per',
    coleccionesMuebles: 'col·leccions, mobles',
    aprovechaAlMaximoLas: "Aprofita al màxim les economies d'escala: el cost per unitat cau molt. A canvi, és molt rígid davant de canvis en el producte. És la cadena de muntatge de Ford.",
    enMasaCadena: 'En massa (cadena)',
    granVolumenDeUn: "Gran volum d'un",
    productoEstandar: 'producte estàndard',
    automoviles: 'automòbils,',
    electrodomesticos: 'electrodomèstics',
    noParaNuncaPorque: 'No para mai perquè arrancar i detindre la planta és caríssim o tècnicament impossible. Produïx un únic producte homogeni de manera ininterrompuda.',
    continuo: 'Continu',
    flujoIninterrumpido: 'Flux ininterromput',
    k24HorasSinParadas: '24 hores, sense parades',
    refineriaCentral: 'refineria, central',
    electricaCementera: 'elèctrica, cimentera',
  },
} as const;
const t = COPY[locale];
---
<svg viewBox="0 0 880 520" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="procprod-title procprod-desc">
  <title id="procprod-title">{t.tiposDeProcesoProductivo}</title>
  <desc id="procprod-desc">{t.losCuatroTiposDe}</desc>
  <defs>
    <style>
      .bg { fill: #FBF6EC; }
      .axis { stroke: #5C4A3D; stroke-width: 1.5; }
      .grid { stroke: #E5D4BD; stroke-width: 1; stroke-dasharray: 2 4; }
      .axis-label { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; fill: #5C4A3D; }
      .diag { stroke: #D4A24C; stroke-width: 2; stroke-dasharray: 7 5; fill: none; }
      .card { stroke-width: 2; }
      .card-1 { fill: #FBE3D6; stroke: #C44E2C; }
      .card-2 { fill: #F5E5BC; stroke: #D4A24C; }
      .card-3 { fill: #F5E5BC; stroke: #D4A24C; }
      .card-4 { fill: #FBE3D6; stroke: #C44E2C; }
      .card-name { font-family: 'Switzer', sans-serif; font-size: 13px; font-weight: 700; fill: #2A1F18; text-anchor: middle; }
      .card-sub { font-family: 'Switzer', sans-serif; font-size: 10px; fill: #5C4A3D; text-anchor: middle; }
      .card-ex { font-family: 'Fraunces', serif; font-style: italic; font-size: 10.5px; fill: #9C3A1C; text-anchor: middle; }
      .has-tip { cursor: help; }
    </style>
  </defs>
  <rect class="bg" x="0" y="0" width="880" height="520"/>

  <!-- Axes: x 90..820, y 60..430 -->
  <line class="grid" x1="90" y1="245" x2="820" y2="245"/>
  <line class="grid" x1="455" y1="60" x2="455" y2="430"/>
  <line class="axis" x1="90" y1="430" x2="830" y2="430"/>
  <line class="axis" x1="90" y1="50" x2="90" y2="430"/>

  <!-- Axis titles -->
  <text class="axis-label" x="455" y="465" text-anchor="middle">{t.volumenDeProduccion}</text>
  <text class="axis-label" x="40" y="245" text-anchor="middle" transform="rotate(-90 40 245)">{t.variedadDelProducto}</text>
  <text class="axis-label" x="120" y="80" fill="#8A7868">{t.bajoVolumen}</text>
  <text class="axis-label" x="790" y="80" fill="#8A7868" text-anchor="end">{t.altoVolumen}</text>

  <!-- Diagonal trend (top-left high variety/low volume → bottom-right low variety/high volume) -->
  <line class="diag" x1="150" y1="90" x2="760" y2="400"/>

  <!-- Card 1: Por proyecto (top-left: mucha variedad, poco volumen) -->
  <rect class="card card-1 has-tip" x="100" y="75" width="190" height="120" rx="8"><title>{t.costeUnitarioMuyAlto}</title></rect>
  <text class="card-name" x="195" y="102">{t.porProyecto}</text>
  <text class="card-sub" x="195" y="122">{t.unaUnidadUnica}</text>
  <text class="card-sub" x="195" y="137">{t.aMedidaDelCliente}</text>
  <text class="card-ex" x="195" y="165">{t.unPuenteUnBarco}</text>
  <text class="card-ex" x="195" y="180">{t.unaBoda}</text>

  <!-- Card 2: Por lotes (center-upper) -->
  <rect class="card card-2 has-tip" x="290" y="165" width="190" height="120" rx="8"><title>{t.equilibrioEntreVariedadY}</title></rect>
  <text class="card-name" x="385" y="192">{t.porLotesBatch}</text>
  <text class="card-sub" x="385" y="212">{t.tandasDeProducto}</text>
  <text class="card-sub" x="385" y="227">{t.queSeRepiten}</text>
  <text class="card-ex" x="385" y="255">{t.panaderiaRopaPor}</text>
  <text class="card-ex" x="385" y="270">{t.coleccionesMuebles}</text>

  <!-- Card 3: En masa / cadena (center-lower) -->
  <rect class="card card-3 has-tip" x="430" y="245" width="190" height="120" rx="8"><title>{t.aprovechaAlMaximoLas}</title></rect>
  <text class="card-name" x="525" y="272">{t.enMasaCadena}</text>
  <text class="card-sub" x="525" y="292">{t.granVolumenDeUn}</text>
  <text class="card-sub" x="525" y="307">{t.productoEstandar}</text>
  <text class="card-ex" x="525" y="335">{t.automoviles}</text>
  <text class="card-ex" x="525" y="350">{t.electrodomesticos}</text>

  <!-- Card 4: Continuo (bottom-right: poca variedad, mucho volumen) -->
  <rect class="card card-4 has-tip" x="620" y="305" width="190" height="120" rx="8"><title>{t.noParaNuncaPorque}</title></rect>
  <text class="card-name" x="715" y="332">{t.continuo}</text>
  <text class="card-sub" x="715" y="352">{t.flujoIninterrumpido}</text>
  <text class="card-sub" x="715" y="367">{t.k24HorasSinParadas}</text>
  <text class="card-ex" x="715" y="395">{t.refineriaCentral}</text>
  <text class="card-ex" x="715" y="410">{t.electricaCementera}</text>
</svg>
