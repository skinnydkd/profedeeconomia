  },
} as const;
const t = COPY[locale];
---
<svg class="d-business-model-canvas" viewBox="0 0 900 480" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={t.businessModelCanvasLas}>
  <defs>
    <style>
      .d-business-model-canvas .bg { fill: #FBF6EC; }
      .d-business-model-canvas .block { fill: #FFFFFF; stroke: #E5D4BD; stroke-width: 1.5; }
      .d-business-model-canvas .block-vp { fill: #FBE3D6; stroke: #C44E2C; stroke-width: 2; }
      .d-business-model-canvas .block-customer { fill: #DBEDED; stroke: #1F6E6E; stroke-width: 1.5; }
      .d-business-model-canvas .block-internal { fill: #F5E5BC; stroke: #D4A24C; stroke-width: 1.5; }
      .d-business-model-canvas .block-costs { fill: #FBE3D6; stroke: #C44E2C; stroke-width: 1.5; }
      .d-business-model-canvas .block-rev { fill: #DBEDED; stroke: #1F6E6E; stroke-width: 1.5; }
      .d-business-model-canvas .num { font-family: 'Fraunces', serif; font-style: italic; font-size: 13px; font-weight: 500; fill: #A87A2A; }
      .d-business-model-canvas .num-vp { fill: #9C3A1C; }
      .d-business-model-canvas .title { font-family: 'Switzer', sans-serif; font-size: 10.5px; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; fill: #2A1F18; }
      .d-business-model-canvas .title-vp { fill: #9C3A1C; }
      .d-business-model-canvas .question { font-family: 'Fraunces', serif; font-style: italic; font-size: 11px; fill: #5C4A3D; }
      .d-business-model-canvas .question-vp { fill: #9C3A1C; }
      .d-business-model-canvas .strip-label { font-family: 'Switzer', sans-serif; font-size: 9.5px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; fill: #8A7868; }
    </style>
  </defs>
  <rect class="bg" x="0" y="0" width="900" height="480"/>

  <!-- Top strip labels -->
  <text class="strip-label" x="170" y="30">{t.loQueLaEmpresa}</text>
  <text class="strip-label" x="460" y="30" text-anchor="middle">{t.elOfrecimiento}</text>
  <text class="strip-label" x="730" y="30" text-anchor="end">{t.loQueElCliente}</text>

  <!-- Row 1 (top half): 7 internal blocks + propuesta de valor center + 3 cliente blocks -->
  <!-- 8. Asociaciones clave (top-left) -->
  <g>
    <rect class="block" x="40" y="50" width="160" height="170" rx="6"/>
    <text class="num" x="55" y="73">08</text>
    <text class="title" x="55" y="96">{t.asociacionesClave}</text>
    <text class="question" x="55" y="125">{t.quienesSonLos}</text>
    <text class="question" x="55" y="140">{t.aliadosEstrategicos}</text>
    <text class="question" x="55" y="155">{t.sinLosQueEl}</text>
    <text class="question" x="55" y="170">{t.noFuncionaria}</text>
  </g>

  <!-- 7. Actividades clave (top center-left) -->
  <g>
    <rect class="block block-internal" x="210" y="50" width="160" height="85" rx="6"/>
    <text class="num" x="225" y="73">07</text>
    <text class="title" x="225" y="96">{t.actividadesClave}</text>
    <text class="question" x="225" y="115">{t.queHacemosCadaDia}</text>
    <text class="question" x="225" y="128">{t.queNoPodemosDelegar}</text>
  </g>

  <!-- 6. Recursos clave (middle center-left) -->
  <g>
    <rect class="block block-internal" x="210" y="140" width="160" height="80" rx="6"/>
    <text class="num" x="225" y="163">06</text>
    <text class="title" x="225" y="186">{t.recursosClave}</text>
    <text class="question" x="225" y="205">{t.queRecursosCriticos}</text>
    <text class="question" x="225" y="218">{t.necesitamos}</text>
  </g>

  <!-- 2. Propuesta de valor (center) -->
  <g>
    <rect class="block-vp" x="380" y="50" width="160" height="170" rx="6"/>
    <text class="num num-vp" x="395" y="73">02</text>
    <text class="title title-vp" x="395" y="96">{t.propuestaDeValor}</text>
    <text class="question question-vp" x="395" y="125">{t.queProblema}</text>
    <text class="question question-vp" x="395" y="140">{t.resolvemosOQue}</text>
    <text class="question question-vp" x="395" y="155">{t.necesidadCubrimos}</text>
    <text class="question question-vp" x="395" y="180">{t.porQueSomos}</text>
    <text class="question question-vp" x="395" y="195">{t.diferentesDeLas}</text>
    <text class="question question-vp" x="395" y="210">{t.alternativas}</text>
  </g>

  <!-- 4. Relaciones con clientes (top center-right) -->
  <g>
    <rect class="block block-customer" x="550" y="50" width="160" height="85" rx="6"/>
    <text class="num" x="565" y="73">04</text>
    <text class="title" x="565" y="96">{t.relacionesConClientes}</text>
    <text class="question" x="565" y="115">{t.queTipoDeRelacion}</text>
    <text class="question" x="565" y="128">{t.mantenemosConCadaUno}</text>
  </g>

  <!-- 3. Canales (middle center-right) -->
  <g>
    <rect class="block block-customer" x="550" y="140" width="160" height="80" rx="6"/>
    <text class="num" x="565" y="163">03</text>
    <text class="title" x="565" y="186">{t.canales}</text>
    <text class="question" x="565" y="205">{t.porQueCanalesLlega}</text>
    <text class="question" x="565" y="218">{t.nuestraPropuesta}</text>
  </g>

  <!-- 1. Segmentos de clientes (top-right) -->
  <g>
    <rect class="block block-customer" x="720" y="50" width="140" height="170" rx="6"/>
    <text class="num" x="735" y="73">01</text>
    <text class="title" x="735" y="96">{t.segmentosDeClientes}</text>
    <text class="question" x="735" y="125">{t.paraQuienCreamos}</text>
    <text class="question" x="735" y="140">{t.valor}</text>
    <text class="question" x="735" y="165">{t.quienesSonNuestros}</text>
    <text class="question" x="735" y="180">{t.clientesMasImportantes}</text>
  </g>

  <!-- Bottom row: costes (left) + ingresos (right) -->
  <!-- 9. Estructura de costes -->
  <g>
    <rect class="block block-costs" x="40" y="240" width="410" height="120" rx="6"/>
    <text class="num num-vp" x="55" y="263">09</text>
    <text class="title title-vp" x="55" y="286">{t.estructuraDeCostes}</text>
    <text class="question question-vp" x="55" y="310">{t.enQueGastaLa}</text>
    <text class="question question-vp" x="55" y="325">{t.queCostesSonFijos}</text>
    <text class="question question-vp" x="55" y="345">{t.hayEconomiasDeEscala}</text>
  </g>

  <!-- 5. Fuentes de ingresos -->
  <g>
    <rect class="block block-rev" x="460" y="240" width="400" height="120" rx="6"/>
    <text class="num" x="475" y="263">05</text>
    <text class="title" x="475" y="286">{t.fuentesDeIngresos}</text>
    <text class="question" x="475" y="310">{t.comoYPorQue}</text>
    <text class="question" x="475" y="325">{t.esVentaUnitariaSuscripcion}</text>
    <text class="question" x="475" y="345">{t.quePesoTieneCada}</text>
  </g>

  <!-- Footer legend -->
  <text class="strip-label" x="40" y="395" fill="#A87A2A">{t.internoLoQueGastamos}</text>
  <text class="strip-label" x="860" y="395" fill="#0E4040" text-anchor="end">{t.clienteLoQueCobramos}</text>

  <text x="450" y="445" font-family="Fraunces" font-style="italic" font-size="13" fill="#5C4A3D" text-anchor="middle">{t.las9AreasSe}</text>
  <text x="450" y="463" font-family="Fraunces" font-style="italic" font-size="13" fill="#5C4A3D" text-anchor="middle">{t.laPropuestaDeValor}</text>
</svg>
