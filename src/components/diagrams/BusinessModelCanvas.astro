    internoLoQueGastamos: 'INTERNO · LO QUE GASTAMOS',
    clienteLoQueCobramos: 'CLIENTE · LO QUE COBRAMOS',
    las9AreasSe: 'Las 9 áreas se distribuyen en una página: cinco áreas miran al cliente (derecha) y cuatro al interior (izquierda).',
    laPropuestaDeValor: 'La propuesta de valor (centro) es lo que las conecta.',
  },
  ca: {
    businessModelCanvasLas: 'Business Model Canvas: les nou àrees',
    loQueLaEmpresa: "EL QUE FA L'EMPRESA",
    elOfrecimiento: "L'OFERIMENT",
    loQueElCliente: 'EL QUE EXPERIMENTA EL CLIENT',
    asociacionesClave: 'Associacions clau',
    quienesSonLos: 'Qui són els',
    aliadosEstrategicos: 'aliats estratègics',
    sinLosQueEl: 'sense els quals el model',
    noFuncionaria: 'no funcionaria?',
    actividadesClave: 'Activitats clau',
    queHacemosCadaDia: 'Què fem cada dia',
    queNoPodemosDelegar: 'que no podem delegar?',
    recursosClave: 'Recursos clau',
    queRecursosCriticos: 'Quins recursos crítics',
    necesitamos: 'necessitem?',
    propuestaDeValor: 'Proposta de valor',
    queProblema: 'Quin problema',
    resolvemosOQue: 'resolem o quina',
    necesidadCubrimos: 'necessitat cobrim?',
    porQueSomos: 'Per què som',
    diferentesDeLas: 'diferents de les',
    alternativas: 'alternatives?',
    relacionesConClientes: 'Relacions amb clients',
    queTipoDeRelacion: 'Quin tipus de relació',
    mantenemosConCadaUno: 'mantenim amb cada un?',
    canales: 'Canals',
    porQueCanalesLlega: 'Per quins canals arriba',
    nuestraPropuesta: 'la nostra proposta?',
    segmentosDeClientes: 'Segments de clients',
    paraQuienCreamos: 'Per a qui creem',
