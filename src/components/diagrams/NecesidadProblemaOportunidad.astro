---
/**
 * Embudo necesidad → problema → oportunidad. Tres etapas en cascada que
 * estrechan: no toda necesidad genera problema y no todo problema genera
 * oportunidad. La oportunidad solo aparece donde convergen necesidad real,
 * problema mal resuelto y solución viable.
 *
 * Used in Eco 4ESO · Unit 4 (el entorno: detectar oportunidades).
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    deLaNecesidadA: 'De la necesidad a la oportunidad',
    embudoDeTresEtapas: 'Embudo de tres etapas que se estrecha: la necesidad es universal y amplia, el problema es la dificultad concreta al cubrirla y la oportunidad, mucho más estrecha, solo aparece cuando coinciden una necesidad real, un problema mal resuelto y una solución viable. Ejemplo: desplazarse por la ciudad, atascos y contaminación, y BlaBlaCar o el patinete eléctrico de alquiler.',
    elEmbudoQueSepara: 'EL EMBUDO QUE SEPARA UNA INTUICIÓN DE UN NEGOCIO',
    esLaBandaMas: 'Es la banda más ancha porque las necesidades son muchas y comunes a casi todos. Por sí sola no es negocio: todo el mundo las tiene, pero nadie paga por la necesidad en abstracto.',
    necesidad: 'Necesidad',
    algoQueLasPersonas: 'Algo que las personas requieren para vivir. Es universal y casi no cambia.',
    ejemploDesplazarsePorLa: 'Ejemplo: desplazarse por la ciudad para ir al trabajo o al instituto.',
    aquiSeEstrechaEl: 'Aquí se estrecha el embudo: no toda necesidad genera un problema sin resolver. Como los problemas cambian con la tecnología y la sociedad, surgen oportunidades nuevas constantemente.',
    problema: 'Problema',
    laDificultadConcretaAl: 'La dificultad concreta al cubrir esa necesidad. Sí cambia con el tiempo.',
    ejemploAtascosContaminacionA: 'Ejemplo: atascos, contaminación, aparcamiento imposible, taxi caro.',
    laBandaMasEstrecha: 'La banda más estrecha: solo unos pocos problemas se pueden resolver de forma viable y rentable. Aquí es donde de verdad nace una idea de negocio.',
    oportunidad: 'Oportunidad',
    formaNuevaMejorO: 'Forma nueva, mejor o más barata de resolver el problema.',
    ejemploBlablacarValenbisiPat: 'Ejemplo: BlaBlaCar, Valenbisi, patinete eléctrico de alquiler.',
    laOportunidadSoloExiste: 'La oportunidad solo existe donde coinciden necesidad real + problema mal resuelto + solución viable.',
    siNoSabesDescribir: 'Si no sabes describir la necesidad y el problema con frases enteras, tienes una intuición, no una oportunidad.',
  },
  ca: {
    deLaNecesidadA: 'De la necessitat a la oportunitat',
    embudoDeTresEtapas: "Embut de tres etapes que s'estreny: la necessitat és universal i àmplia, el problema és la dificultat concreta a cobrir-la i l'oportunitat, molt més estreta, només apareix quan coincidixen una necessitat real, un problema mal resolt i una solució viable. Exemple: desplaçar-se per la ciutat, embussos i contaminació, i BlaBlaCar o el patinet elèctric de lloguer.",
    elEmbudoQueSepara: "L'EMBUT QUE SEPARA UNA INTUÏCIÓ D'UN NEGOCI",
    esLaBandaMas: 'És la banda més ampla perquè les necessitats són moltes i comunes a quasi tots. Per si sola no és negoci: tot el món les té, però ningú paga per la necessitat en abstracte.',
    necesidad: 'Necessitat',
    algoQueLasPersonas: 'Alguna cosa que les persones requerixen per a viure. És universal i quasi no canvia.',
    ejemploDesplazarsePorLa: "Exemple: desplaçar-se per la ciutat per a anar a la faena o a l'institut.",
    aquiSeEstrechaEl: "Ací s'estreny l'embut: no tota necessitat genera un problema sense resoldre. Com que els problemes canvien amb la tecnologia i la societat, sorgixen oportunitats noves constantment.",
    problema: 'Problema',
    laDificultadConcretaAl: 'La dificultat concreta a cobrir eixa necessitat. Sí que canvia amb el temps.',
    ejemploAtascosContaminacionA: 'Exemple: embussos, contaminació, aparcament impossible, taxi car.',
    laBandaMasEstrecha: 'La banda més estreta: només uns pocs problemes es poden resoldre de manera viable i rendible. Ací és on de veritat naix una idea de negoci.',
    oportunidad: 'Oportunitat',
    formaNuevaMejorO: 'Forma nova, millor o més barata de resoldre el problema.',
    ejemploBlablacarValenbisiPat: 'Exemple: BlaBlaCar, Valenbisi, patinet elèctric de lloguer.',
    laOportunidadSoloExiste: "L'oportunitat només existix on coincidixen necessitat real + problema mal resolt + solució viable.",
    siNoSabesDescribir: 'Si no saps descriure la necessitat i el problema amb frases senceres, tens una intuïció, no una oportunitat.',
  },
} as const;
const t = COPY[locale];
---
<svg class="d-necesidad-problema-oportunidad" viewBox="0 0 800 480" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="npo-title npo-desc">
  <title id="npo-title">{t.deLaNecesidadA}</title>
  <desc id="npo-desc">{t.embudoDeTresEtapas}</desc>
  <defs>
    <style>
      .d-necesidad-problema-oportunidad .bg { fill: #FBF6EC; }
      .d-necesidad-problema-oportunidad .band { stroke: #2A1F18; stroke-width: 1.4; }
      .d-necesidad-problema-oportunidad .band-1 { fill: #F5E5BC; }
      .d-necesidad-problema-oportunidad .band-2 { fill: #D4A24C; }
      .d-necesidad-problema-oportunidad .band-3 { fill: #C44E2C; }
      .d-necesidad-problema-oportunidad .band-title { font-family: 'Fraunces', serif; font-size: 20px; font-weight: 500; text-anchor: middle; }
      .d-necesidad-problema-oportunidad .band-def { font-family: 'Switzer', sans-serif; font-size: 12px; text-anchor: middle; }
      .d-necesidad-problema-oportunidad .band-ex { font-family: 'Switzer', sans-serif; font-size: 11px; font-style: italic; text-anchor: middle; }
      .d-necesidad-problema-oportunidad .arrow { fill: #8A7868; }
      .d-necesidad-problema-oportunidad .header { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; fill: #8A7868; text-anchor: middle; }
      .d-necesidad-problema-oportunidad .ejemplo-tag { font-family: 'Switzer', sans-serif; font-size: 9.5px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; }
      .d-necesidad-problema-oportunidad .footer { font-family: 'Fraunces', serif; font-style: italic; font-size: 13px; fill: #5C4A3D; text-anchor: middle; }
      .d-necesidad-problema-oportunidad .has-tip { cursor: help; }
    </style>
  </defs>
  <rect class="bg" x="0" y="0" width="800" height="480"/>

  <text class="header" x="400" y="38">{t.elEmbudoQueSepara}</text>

  <!-- Band 1: Necesidad (widest trapezoid) -->
  <polygon class="band band-1 has-tip" points="120,70 680,70 620,160 180,160"><title>{t.esLaBandaMas}</title></polygon>
  <text class="band-title" x="400" y="105" fill="#A87A2A">{t.necesidad}</text>
  <text class="band-def" x="400" y="128" fill="#5C4A3D">{t.algoQueLasPersonas}</text>
  <text class="band-ex" x="400" y="148" fill="#8A7868">{t.ejemploDesplazarsePorLa}</text>

  <!-- Arrow down 1 -->
  <polygon class="arrow" points="385,168 415,168 400,184"/>

  <!-- Band 2: Problema (narrower) -->
  <polygon class="band band-2 has-tip" points="180,192 620,192 565,282 235,282"><title>{t.aquiSeEstrechaEl}</title></polygon>
  <text class="band-title" x="400" y="227" fill="#9C3A1C">{t.problema}</text>
  <text class="band-def" x="400" y="250" fill="#2A1F18">{t.laDificultadConcretaAl}</text>
  <text class="band-ex" x="400" y="270" fill="#5C4A3D">{t.ejemploAtascosContaminacionA}</text>

  <!-- Arrow down 2 -->
  <polygon class="arrow" points="385,290 415,290 400,306"/>

  <!-- Band 3: Oportunidad (narrowest) -->
  <polygon class="band band-3 has-tip" points="235,314 565,314 510,400 290,400"><title>{t.laBandaMasEstrecha}</title></polygon>
  <text class="band-title" x="400" y="349" fill="#FFFFFF">{t.oportunidad}</text>
  <text class="band-def" x="400" y="372" fill="#FBE3D6">{t.formaNuevaMejorO}</text>
  <text class="band-ex" x="400" y="391" fill="#FBE3D6">{t.ejemploBlablacarValenbisiPat}</text>

  <!-- Footer -->
  <text class="footer" x="400" y="438">{t.laOportunidadSoloExiste}</text>
  <text class="footer" x="400" y="460">{t.siNoSabesDescribir}</text>
</svg>
