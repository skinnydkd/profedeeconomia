---
/**
 * Ruta de reclamación del consumidor en España: escalera de pasos
 * desde el primer contacto a la empresa hasta la vía judicial, mostrando
 * que la mayoría de casos legítimos se resuelven en los primeros peldaños.
 *
 * Used in Eco 4ESO · Unit 5 (consumo inteligente y derechos del consumidor).
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    rutaDeReclamacionDel: 'Ruta de reclamación del consumidor, paso a paso',
    escaleraAscendenteDeSiete: 'Escalera ascendente de siete peldaños: primer contacto por escrito a la empresa, hoja de reclamaciones, OMIC o Consumo, asociación de consumidores como OCU o FACUA, arbitraje de consumo, AECOSAN para casos de seguridad y, como último recurso, la vía judicial. La mayoría de reclamaciones legítimas se resuelven en los cuatro primeros pasos.',
    comoReclamarEnEspana: 'CÓMO RECLAMAR EN ESPAÑA · DEL PELDAÑO 1 AL 7',
    hazloSiemprePorEscrito: 'Hazlo siempre por escrito y guarda copia: ese documento es la prueba de que reclamaste y de la fecha. Por teléfono no queda constancia.',
    contactoALaEmpresa: 'Contacto a la empresa por escrito',
    emailOBurofaxExpon: 'Email o burofax. Expón hechos y lo que pides, con plazo.',
    todoComercioEstaObligado: 'Todo comercio está obligado a tenerlas y a dártelas. Te quedas una copia y otra va a la administración, que puede sancionar a la empresa.',
    hojaDeReclamaciones: 'Hoja de reclamaciones',
    documentoOficialObligatorioR: 'Documento oficial obligatorio. Rellénala por triplicado.',
    omicOficinaMunicipalDe: 'OMIC = Oficina Municipal de Información al Consumidor. Es gratuita y la hay en muchos ayuntamientos: media en tu nombre frente a la empresa.',
    omicDireccionGeneralDe: 'OMIC / Dirección General de Consumo',
    gratisTienenObligacionDe: 'Gratis. Tienen obligación de mediar entre tú y la empresa.',
    organizacionesQueDefiendenA: 'Organizaciones que defienden a los consumidores. La orientación suele ser gratuita; si te asocias, pueden incluso llevar tu caso por ti.',
    asociacionDeConsumidores: 'Asociación de consumidores',
    ocuFacuaAdicaeTe: 'OCU, FACUA, ADICAE. Te orientan gratis o llevan tu caso.',
    esGratisYLa: 'Es gratis y la resolución (el «laudo») obliga a las dos partes, como una sentencia, pero sin ir a juicio. Solo funciona si la empresa está adherida al sistema arbitral.',
    arbitrajeDeConsumo: 'Arbitraje de consumo',
    siLaEmpresaEsta: 'Si la empresa está adherida. Laudo vinculante y rápido.',
    paraProblemasQueAfectan: 'Para problemas que afectan a la salud o la seguridad (un alimento en mal estado, un juguete peligroso). Aquí no se busca tu reembolso, sino proteger a todos los consumidores.',
    aecosanMinisterioDeConsumo: 'AECOSAN / Ministerio de Consumo',
    paraCasosGravesDe: 'Para casos graves de seguridad alimentaria o de producto.',
    elUltimoRecursoLento: 'El último recurso, lento y costoso. Pero en reclamaciones de menos de 2.000 € no hace falta abogado ni procurador, y existe un juicio verbal simplificado.',
    viaJudicial: 'Vía judicial',
    ultimoRecursoMenosDe: 'Último recurso. Menos de 2.000 € no necesitan abogado.',
    seResuelveAquiEl: 'SE RESUELVE AQUÍ EL 80 %',
    casosGraves: 'CASOS GRAVES',
    reclamarFuncionaLaMayoria: 'Reclamar funciona: la mayoría de casos legítimos se resuelven entre los pasos 1 y 4.',
    aLasEmpresasLes: 'A las empresas les sale más caro pelear que reembolsar. Quien insiste, gana.',
  },
  ca: {
    rutaDeReclamacionDel: 'Ruta de reclamació del consumidor, pas a pas',
    escaleraAscendenteDeSiete: "Escala ascendent de set escalons: primer contacte per escrit a l'empresa, full de reclamacions, OMIC o Consum, associació de consumidors com OCU o FACUA, arbitratge de consum, AECOSAN per a casos de seguretat i, com a últim recurs, la via judicial. La majoria de reclamacions legítimes es resolen en els quatre primers passos.",
    comoReclamarEnEspana: "COM RECLAMAR A ESPANYA · DE L'ESCALÓ 1 AL 7",
    hazloSiemprePorEscrito: 'Fes-ho sempre per escrit i guarda-ne còpia: eixe document és la prova que vas reclamar i de la data. Per telèfon no en queda constància.',
    contactoALaEmpresa: "Contacte a l'empresa per escrit",
    emailOBurofaxExpon: 'Correu o burofax. Exposa els fets i el que demanes, amb termini.',
    todoComercioEstaObligado: "Tot comerç està obligat a tindre'n i a donar-te'n. Et quedes una còpia i una altra va a l'administració, que pot sancionar l'empresa.",
    hojaDeReclamaciones: 'Full de reclamacions',
    documentoOficialObligatorioR: 'Document oficial obligatori. Ompli-la per triplicat.',
    omicOficinaMunicipalDe: "OMIC = Oficina Municipal d'Informació al Consumidor. És gratuïta i n'hi ha en molts ajuntaments: media en el teu nom davant de l'empresa.",
    omicDireccionGeneralDe: 'OMIC / Direcció General de Consum',
    gratisTienenObligacionDe: "Gratis. Tenen obligació de mediar entre tu i l'empresa.",
    organizacionesQueDefiendenA: "Organitzacions que defenen els consumidors. L'orientació sol ser gratuïta; si t'hi associes, poden fins i tot portar el teu cas per tu.",
    asociacionDeConsumidores: 'Associació de consumidors',
    ocuFacuaAdicaeTe: "OCU, FACUA, ADICAE. T'orienten gratis o porten el teu cas.",
    esGratisYLa: "És gratis i la resolució (el «laude») obliga les dues parts, com una sentència, però sense anar a judici. Només funciona si l'empresa està adherida al sistema arbitral.",
    arbitrajeDeConsumo: 'Arbitratge de consum',
    siLaEmpresaEsta: "Si l'empresa hi està adherida. Laude vinculant i ràpid.",
    paraProblemasQueAfectan: 'Per a problemes que afecten la salut o la seguretat (un aliment en mal estat, una joguina perillosa). Ací no es busca el teu reembossament, sinó protegir tots els consumidors.',
    aecosanMinisterioDeConsumo: 'AECOSAN / Ministeri de Consum',
    paraCasosGravesDe: 'Per a casos greus de seguretat alimentària o de producte.',
    elUltimoRecursoLento: "L'últim recurs, lent i costós. Però en reclamacions de menys de 2.000 € no cal advocat ni procurador, i existix un judici verbal simplificat.",
    viaJudicial: 'Via judicial',
    ultimoRecursoMenosDe: 'Últim recurs. Menys de 2.000 € no necessiten advocat.',
    seResuelveAquiEl: 'ACÍ ES RESOL EL 80 %',
    casosGraves: 'CASOS GREUS',
    reclamarFuncionaLaMayoria: 'Reclamar funciona: la majoria de casos legítims es resolen entre els passos 1 i 4.',
    aLasEmpresasLes: 'A les empreses els ix més car barallar-se que reembossar. Qui insistix, guanya.',
  },
} as const;
const t = COPY[locale];
---
<svg class="d-ruta-reclamacion" viewBox="0 0 800 520" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="reclama-title reclama-desc">
  <title id="reclama-title">{t.rutaDeReclamacionDel}</title>
  <desc id="reclama-desc">{t.escaleraAscendenteDeSiete}</desc>
  <defs>
    <style>
      .d-ruta-reclamacion .bg { fill: #FBF6EC; }
      .d-ruta-reclamacion .step { stroke: #2A1F18; stroke-width: 1.4; }
      .d-ruta-reclamacion .step-soft { fill: #F5E5BC; }
      .d-ruta-reclamacion .step-mid { fill: #D4A24C; }
      .d-ruta-reclamacion .step-strong { fill: #C44E2C; }
      .d-ruta-reclamacion .arrow { fill: none; stroke: #9C3A1C; stroke-width: 2; marker-end: url(#rec-arrow); }
      .d-ruta-reclamacion .num { font-family: 'Fraunces', serif; font-style: italic; font-size: 22px; font-weight: 500; fill: #2A1F18; text-anchor: middle; }
      .d-ruta-reclamacion .num-light { fill: #FFFFFF; }
      .d-ruta-reclamacion .step-title { font-family: 'Switzer', sans-serif; font-size: 13px; font-weight: 700; fill: #2A1F18; }
      .d-ruta-reclamacion .step-desc { font-family: 'Switzer', sans-serif; font-size: 11px; fill: #5C4A3D; }
      .d-ruta-reclamacion .step-desc-light { font-family: 'Switzer', sans-serif; font-size: 11px; fill: #FBE3D6; }
      .d-ruta-reclamacion .step-title-light { font-family: 'Switzer', sans-serif; font-size: 13px; font-weight: 700; fill: #FFFFFF; }
      .d-ruta-reclamacion .header { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; fill: #8A7868; text-anchor: middle; }
      .d-ruta-reclamacion .zone { font-family: 'Switzer', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; text-anchor: middle; }
      .d-ruta-reclamacion .footer { font-family: 'Fraunces', serif; font-style: italic; font-size: 13px; fill: #5C4A3D; text-anchor: middle; }
      .d-ruta-reclamacion .has-tip { cursor: help; }
    </style>
    <marker id="rec-arrow" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto">
      <polygon points="0 0, 9 3, 0 6" fill="#9C3A1C"/>
    </marker>
  </defs>
  <rect class="bg" x="0" y="0" width="800" height="520"/>

  <text class="header" x="400" y="36">{t.comoReclamarEnEspana}</text>

  <!-- Seven steps, each a rounded bar. Width 540, height 42, x=120.
       Ascending: y goes from 410 (step1) up to 80 (step7), step ~52px. -->

  <!-- Step 1 -->
  <rect class="step step-soft has-tip" x="120" y="404" width="540" height="42" rx="5"><title>{t.hazloSiemprePorEscrito}</title></rect>
  <text class="num" x="145" y="431">1</text>
  <text class="step-title" x="175" y="424">{t.contactoALaEmpresa}</text>
  <text class="step-desc" x="175" y="439">{t.emailOBurofaxExpon}</text>

  <!-- Step 2 -->
  <rect class="step step-soft has-tip" x="120" y="352" width="540" height="42" rx="5"><title>{t.todoComercioEstaObligado}</title></rect>
  <text class="num" x="145" y="379">2</text>
  <text class="step-title" x="175" y="372">{t.hojaDeReclamaciones}</text>
  <text class="step-desc" x="175" y="387">{t.documentoOficialObligatorioR}</text>

  <!-- Step 3 -->
  <rect class="step step-mid has-tip" x="120" y="300" width="540" height="42" rx="5"><title>{t.omicOficinaMunicipalDe}</title></rect>
  <text class="num" x="145" y="327">3</text>
  <text class="step-title" x="175" y="320">{t.omicDireccionGeneralDe}</text>
  <text class="step-desc" x="175" y="335">{t.gratisTienenObligacionDe}</text>

  <!-- Step 4 -->
  <rect class="step step-mid has-tip" x="120" y="248" width="540" height="42" rx="5"><title>{t.organizacionesQueDefiendenA}</title></rect>
  <text class="num" x="145" y="275">4</text>
  <text class="step-title" x="175" y="268">{t.asociacionDeConsumidores}</text>
  <text class="step-desc" x="175" y="283">{t.ocuFacuaAdicaeTe}</text>

  <!-- Step 5 -->
  <rect class="step step-strong has-tip" x="120" y="196" width="540" height="42" rx="5"><title>{t.esGratisYLa}</title></rect>
  <text class="num num-light" x="145" y="223">5</text>
  <text class="step-title-light" x="175" y="216">{t.arbitrajeDeConsumo}</text>
  <text class="step-desc-light" x="175" y="231">{t.siLaEmpresaEsta}</text>

  <!-- Step 6 -->
  <rect class="step step-strong has-tip" x="120" y="144" width="540" height="42" rx="5"><title>{t.paraProblemasQueAfectan}</title></rect>
  <text class="num num-light" x="145" y="171">6</text>
  <text class="step-title-light" x="175" y="164">{t.aecosanMinisterioDeConsumo}</text>
  <text class="step-desc-light" x="175" y="179">{t.paraCasosGravesDe}</text>

  <!-- Step 7 -->
  <rect class="step step-strong has-tip" x="120" y="92" width="540" height="42" rx="5"><title>{t.elUltimoRecursoLento}</title></rect>
  <text class="num num-light" x="145" y="119">7</text>
  <text class="step-title-light" x="175" y="112">{t.viaJudicial}</text>
  <text class="step-desc-light" x="175" y="127">{t.ultimoRecursoMenosDe}</text>

  <!-- Ascending arrow on the left -->
  <line class="arrow" x1="95" y1="446" x2="95" y2="92"/>

  <!-- Zone labels on the right -->
  <text class="zone" x="710" y="380" fill="#A87A2A" transform="rotate(90 710 380)">{t.seResuelveAquiEl}</text>
  <text class="zone" x="710" y="160" fill="#9C3A1C" transform="rotate(90 710 160)">{t.casosGraves}</text>

  <!-- Footer -->
  <text class="footer" x="400" y="478">{t.reclamarFuncionaLaMayoria}</text>
  <text class="footer" x="400" y="500">{t.aLasEmpresasLes}</text>
</svg>
