---
/**
 * Escalating route a worker can follow to claim a violated labour right:
 * detección → comunicación interna/RRHH → representación sindical →
 * Inspección de Trabajo → papeleta de conciliación (SMAC) → vía judicial
 * (Juzgado de lo Social). Drawn as ascending stepped blocks.
 *
 * Distinct from RutaReclamacion.astro (consumer route, Eco 4ESO).
 * Used in FOPP 4ESO · Unit 8 (tus derechos como trabajador).
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    rutaParaReclamarUn: 'Ruta para reclamar un derecho laboral',
    escaleraAscendenteDeSeis: 'Escalera ascendente de seis peldaños para reclamar un derecho laboral vulnerado: detectar el problema, comunicarlo a la empresa o a recursos humanos, acudir a la representación sindical, denunciar ante la Inspección de Trabajo, presentar papeleta de conciliación en el SMAC y, por último, acudir al Juzgado de lo Social.',
    derechoVulneradoDelPeldano: 'DERECHO VULNERADO · DEL PELDAÑO 1 AL 6',
    guardaPruebasDesdeEl: 'Guarda pruebas desde el primer día: nóminas, horarios, mensajes de WhatsApp del jefe. Sin pruebas, una reclamación posterior es tu palabra contra la de la empresa.',
    deteccionDelProblema: 'Detección del problema',
    documentaTodoContratoNominas: 'Documenta todo: contrato, nóminas, mensajes, cuadrantes.',
    muchosProblemasSonErrores: 'Muchos problemas son errores, no mala fe, y se arreglan hablando. Hacerlo por escrito deja constancia de que avisaste, por si hay que dar pasos más serios.',
    comunicacionInternaRrhh: 'Comunicación interna / RRHH',
    plantealoPorEscritoA: 'Plantéalo por escrito a la empresa y da un plazo para corregir.',
    losSindicatosDefiendenA: 'Los sindicatos defienden a los trabajadores y ofrecen asesoría jurídica gratuita a sus afiliados. No hace falta que en tu empresa haya comité para acudir a uno.',
    representacionComiteOSindica: 'Representación: comité o sindicato',
    medianYDanAsesoria: 'Median y dan asesoría legal gratuita (CCOO, UGT, sector).',
    itssInspeccionDeTrabajo: 'ITSS = Inspección de Trabajo y Seguridad Social. La denuncia es gratuita y puede ser anónima: investiga la empresa y puede multarla y obligarla a corregir la irregularidad.',
    inspeccionDeTrabajoItss: 'Inspección de Trabajo (ITSS)',
    denunciaGratuitaYAnonima: 'Denuncia gratuita y anónima; sanciona y obliga a regularizar.',
    smacServicioDeMediacion: 'SMAC = Servicio de Mediación, Arbitraje y Conciliación. Es un intento obligatorio de acuerdo antes de demandar; muchos casos se resuelven aquí sin llegar al juez.',
    papeletaDeConciliacionSmac: 'Papeleta de conciliación (SMAC)',
    tramitePrevioGratuitoY: 'Trámite previo, gratuito y obligatorio antes de demandar.',
    elUltimoPasoPara: 'El último paso. Para el trabajador es gratuito (no paga tasas). Ojo al plazo: para un despido solo hay 20 días hábiles para demandar, así que no conviene dejarlo pasar.',
    viaJudicialJuzgadoDe: 'Vía judicial: Juzgado de lo Social',
    gratuitoParaElTrabajador: 'Gratuito para el trabajador. Plazo: 20 días hábiles.',
    casiSiempreBastaAqui: 'CASI SIEMPRE BASTA AQUÍ',
    viaFormalYJudicial: 'VÍA FORMAL Y JUDICIAL',
    reclamarEsGratuitoY: 'Reclamar es gratuito y, en la Inspección, puede ser anónimo. La mayoría se resuelve sin llegar al juzgado.',
  },
  ca: {
    rutaParaReclamarUn: 'Ruta per a reclamar un dret laboral',
    escaleraAscendenteDeSeis: "Escala ascendent de sis escalons per a reclamar un dret laboral vulnerat: detectar el problema, comunicar-lo a l'empresa o a recursos humans, acudir a la representació sindical, denunciar davant de la Inspecció de Treball, presentar papereta de conciliació al SMAC i, finalment, acudir al Jutjat social.",
    derechoVulneradoDelPeldano: "DRET VULNERAT · DE L'ESCALÓ 1 AL 6",
    guardaPruebasDesdeEl: "Guarda proves des del primer dia: nòmines, horaris, missatges de WhatsApp del cap. Sense proves, una reclamació posterior és la teua paraula contra la de l'empresa.",
    deteccionDelProblema: 'Detecció del problema',
    documentaTodoContratoNominas: 'Documenta-ho tot: contracte, nòmines, missatges, quadrants.',
    muchosProblemasSonErrores: "Molts problemes són errors, no mala fe, i s'arreglen parlant. Fer-ho per escrit deixa constància que vas avisar, per si cal fer passos més seriosos.",
    comunicacionInternaRrhh: 'Comunicació interna / RRHH',
    plantealoPorEscritoA: "Planteja-ho per escrit a l'empresa i dona un termini per a corregir.",
    losSindicatosDefiendenA: 'Els sindicats defenen els treballadors i oferixen assessoria jurídica gratuïta als seus afiliats. No cal que en la teua empresa hi haja comité per a acudir-ne a un.',
    representacionComiteOSindica: 'Representació: comité o sindicat',
    medianYDanAsesoria: 'Medien i donen assessoria legal gratuïta (CCOO, UGT, sector).',
    itssInspeccionDeTrabajo: "ITSS = Inspecció de Treball i Seguretat Social. La denúncia és gratuïta i pot ser anònima: investiga l'empresa i pot multar-la i obligar-la a corregir la irregularitat.",
    inspeccionDeTrabajoItss: 'Inspecció de Treball (ITSS)',
    denunciaGratuitaYAnonima: 'Denúncia gratuïta i anònima; sanciona i obliga a regularitzar.',
    smacServicioDeMediacion: "SMAC = Servei de Mediació, Arbitratge i Conciliació. És un intent obligatori d'acord abans de demandar; molts casos es resolen ací sense arribar al jutge.",
    papeletaDeConciliacionSmac: 'Papereta de conciliació (SMAC)',
    tramitePrevioGratuitoY: 'Tràmit previ, gratuït i obligatori abans de demandar.',
    elUltimoPasoPara: "L'últim pas. Per al treballador és gratuït (no paga taxes). Compte amb el termini: per a un acomiadament només hi ha 20 dies hàbils per a demandar, així que no convé deixar-ho passar.",
    viaJudicialJuzgadoDe: 'Via judicial: Jutjat social',
    gratuitoParaElTrabajador: 'Gratuït per al treballador. Termini: 20 dies hàbils.',
    casiSiempreBastaAqui: 'QUASI SEMPRE EN TENS PROU ACÍ',
    viaFormalYJudicial: 'VIA FORMAL I JUDICIAL',
    reclamarEsGratuitoY: 'Reclamar és gratuït i, a la Inspecció, pot ser anònim. La majoria es resol sense arribar al jutjat.',
  },
} as const;
const t = COPY[locale];
---
<svg viewBox="0 0 800 540" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="ruta-lab-title ruta-lab-desc">
  <title id="ruta-lab-title">{t.rutaParaReclamarUn}</title>
  <desc id="ruta-lab-desc">{t.escaleraAscendenteDeSeis}</desc>
  <defs>
    <style>
      .bg { fill: #FBF6EC; }
      .step { stroke: #2A1F18; stroke-width: 1.4; }
      .step-soft { fill: #F5EDD9; }
      .step-mid { fill: #D4A24C; }
      .step-strong { fill: #C44E2C; }
      .step-judicial { fill: #5B3A4E; }
      .arrow { fill: none; stroke: #9C3A1C; stroke-width: 2; marker-end: url(#ruta-lab-arrow); }
      .num { font-family: 'Fraunces', serif; font-style: italic; font-size: 22px; font-weight: 500; fill: #2A1F18; text-anchor: middle; }
      .num-light { fill: #FFFFFF; }
      .step-title { font-family: 'Switzer', sans-serif; font-size: 13px; font-weight: 700; fill: #2A1F18; }
      .step-desc { font-family: 'Switzer', sans-serif; font-size: 11px; fill: #5C4A3D; }
      .step-desc-light { font-family: 'Switzer', sans-serif; font-size: 11px; fill: #FBE3D6; }
      .step-title-light { font-family: 'Switzer', sans-serif; font-size: 13px; font-weight: 700; fill: #FFFFFF; }
      .header { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; fill: #8A7868; text-anchor: middle; }
      .zone { font-family: 'Switzer', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; text-anchor: middle; }
      .footer { font-family: 'Fraunces', serif; font-style: italic; font-size: 13px; fill: #5C4A3D; text-anchor: middle; }
      .has-tip { cursor: help; }
    </style>
    <marker id="ruta-lab-arrow" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto">
      <polygon points="0 0, 9 3, 0 6" fill="#9C3A1C"/>
    </marker>
  </defs>
  <rect class="bg" x="0" y="0" width="800" height="540"/>

  <text class="header" x="400" y="36">{t.derechoVulneradoDelPeldano}</text>

  <!-- Six ascending steps. Width 540, height 48, x=120.
       Ascending: y from 420 (step1) up to 90 (step6), step ~66px. -->

  <!-- Step 1 -->
  <rect class="step step-soft has-tip" x="120" y="420" width="540" height="48" rx="5"><title>{t.guardaPruebasDesdeEl}</title></rect>
  <text class="num" x="146" y="450">1</text>
  <text class="step-title" x="178" y="442">{t.deteccionDelProblema}</text>
  <text class="step-desc" x="178" y="459">{t.documentaTodoContratoNominas}</text>

  <!-- Step 2 -->
  <rect class="step step-soft has-tip" x="120" y="354" width="540" height="48" rx="5"><title>{t.muchosProblemasSonErrores}</title></rect>
  <text class="num" x="146" y="384">2</text>
  <text class="step-title" x="178" y="376">{t.comunicacionInternaRrhh}</text>
  <text class="step-desc" x="178" y="393">{t.plantealoPorEscritoA}</text>

  <!-- Step 3 -->
  <rect class="step step-mid has-tip" x="120" y="288" width="540" height="48" rx="5"><title>{t.losSindicatosDefiendenA}</title></rect>
  <text class="num" x="146" y="318">3</text>
  <text class="step-title" x="178" y="310">{t.representacionComiteOSindica}</text>
  <text class="step-desc" x="178" y="327">{t.medianYDanAsesoria}</text>

  <!-- Step 4 -->
  <rect class="step step-strong has-tip" x="120" y="222" width="540" height="48" rx="5"><title>{t.itssInspeccionDeTrabajo}</title></rect>
  <text class="num num-light" x="146" y="252">4</text>
  <text class="step-title-light" x="178" y="244">{t.inspeccionDeTrabajoItss}</text>
  <text class="step-desc-light" x="178" y="261">{t.denunciaGratuitaYAnonima}</text>

  <!-- Step 5 -->
  <rect class="step step-strong has-tip" x="120" y="156" width="540" height="48" rx="5"><title>{t.smacServicioDeMediacion}</title></rect>
  <text class="num num-light" x="146" y="186">5</text>
  <text class="step-title-light" x="178" y="178">{t.papeletaDeConciliacionSmac}</text>
  <text class="step-desc-light" x="178" y="195">{t.tramitePrevioGratuitoY}</text>

  <!-- Step 6 -->
  <rect class="step step-judicial has-tip" x="120" y="90" width="540" height="48" rx="5"><title>{t.elUltimoPasoPara}</title></rect>
  <text class="num num-light" x="146" y="120">6</text>
  <text class="step-title-light" x="178" y="112">{t.viaJudicialJuzgadoDe}</text>
  <text class="step-desc-light" x="178" y="129">{t.gratuitoParaElTrabajador}</text>

  <!-- Ascending arrow on the left -->
  <line class="arrow" x1="95" y1="468" x2="95" y2="90"/>

  <!-- Zone labels on the right -->
  <text class="zone" x="700" y="394" fill="#A87A2A" transform="rotate(90 700 394)">{t.casiSiempreBastaAqui}</text>
  <text class="zone" x="700" y="160" fill="#9C3A1C" transform="rotate(90 700 160)">{t.viaFormalYJudicial}</text>

  <!-- Footer -->
  <text class="footer" x="400" y="500">{t.reclamarEsGratuitoY}</text>
</svg>
