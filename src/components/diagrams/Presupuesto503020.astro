---
/**
 * Horizontal stacked bar chart visualising Elizabeth Warren's 50/30/20
 * budgeting rule. Three segments + example breakdown below each one.
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    regla503020: 'Regla 50-30-20 para presupuestar el sueldo',
    barraHorizontalDivididaEn: 'Barra horizontal dividida en tres segmentos: 50% necesidades, 30% deseos y 20% ahorro/inversión, con ejemplos de gasto debajo de cada bloque.',
    repartoMensualDelSueldo: 'REPARTO MENSUAL DEL SUELDO NETO',
    k100SueldoNeto: '100 % = SUELDO NETO',
    necesidades: 'NECESIDADES',
    deseos: 'DESEOS',
    ahorro: 'AHORRO',
    necesidades2: 'Necesidades',
    alquilerOHipoteca: 'Alquiler o hipoteca',
    comidaBasica: 'Comida básica',
    suministrosYTransporte: 'Suministros y transporte',
    movilEInternet: 'Móvil e internet',
    segurosObligatorios: 'Seguros obligatorios',
    deseos2: 'Deseos',
    ocioYRestaurantes: 'Ocio y restaurantes',
    ropaNoEsencial: 'Ropa no esencial',
    suscripcionesNetflix: 'Suscripciones (Netflix...)',
    viajes: 'Viajes',
    caprichoDelMes: 'Capricho del mes',
    ahorro2: 'Ahorro',
    fondoEmergencia: 'Fondo emergencia',
    inversionALargo: 'Inversión a largo',
    amortizarDeudas: 'Amortizar deudas',
    objetivosVitales: 'Objetivos vitales',
    cocheMaster: '(coche, máster...)',
    siLosGastosFijos: 'Si los gastos fijos se comen más del 50 %, no es problema de presupuesto: es problema de ingresos o de vivienda.',
    sinEl20De: 'Sin el 20 % de ahorro, cualquier imprevisto se convierte en deuda.',
  },
  ca: {
    regla503020: 'Regla 50-30-20 per a pressupostar el sou',
    barraHorizontalDivididaEn: 'Barra horitzontal dividida en tres segments: 50 % necessitats, 30 % desitjos i 20 % estalvi/inversió, amb exemples de despesa davall de cada bloc.',
    repartoMensualDelSueldo: 'REPARTIMENT MENSUAL DEL SOU NET',
    k100SueldoNeto: '100 % = SOU NET',
    necesidades: 'NECESSITATS',
    deseos: 'DESITJOS',
    ahorro: 'ESTALVI',
    necesidades2: 'Necessitats',
    alquilerOHipoteca: 'Lloguer o hipoteca',
    comidaBasica: 'Menjar bàsic',
    suministrosYTransporte: 'Subministraments i transport',
    movilEInternet: 'Mòbil i internet',
    segurosObligatorios: 'Assegurances obligatòries',
    deseos2: 'Desitjos',
    ocioYRestaurantes: 'Oci i restaurants',
    ropaNoEsencial: 'Roba no essencial',
    suscripcionesNetflix: 'Subscripcions (Netflix...)',
    viajes: 'Viatges',
    caprichoDelMes: 'Capritx del mes',
    ahorro2: 'Estalvi',
    fondoEmergencia: 'Fons emergència',
    inversionALargo: 'Inversió a llarg',
    amortizarDeudas: 'Amortitzar deutes',
    objetivosVitales: 'Objectius vitals',
    cocheMaster: '(cotxe, màster...)',
    siLosGastosFijos: "Si les despeses fixes es mengen més del 50 %, no és problema de pressupost: és problema d'ingressos o d'habitatge.",
    sinEl20De: "Sense el 20 % d'estalvi, qualsevol imprevist es convertix en deute.",
  },
} as const;
const t = COPY[locale];
---
<svg class="d-presupuesto503020" viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="presup-title presup-desc">
  <title id="presup-title">{t.regla503020}</title>
  <desc id="presup-desc">{t.barraHorizontalDivididaEn}</desc>
  <defs>
    <style>
      .d-presupuesto503020 .bg { fill: #FBF6EC; }
      .d-presupuesto503020 .seg-necesidades { fill: #C44E2C; }
      .d-presupuesto503020 .seg-deseos { fill: #D4A24C; }
      .d-presupuesto503020 .seg-ahorro { fill: #5C4A3D; }
      .d-presupuesto503020 .seg-stroke { fill: none; stroke: #2A1F18; stroke-width: 1.5; }
      .d-presupuesto503020 .axis { fill: none; stroke: #8A7868; stroke-width: 1.5; }
      .d-presupuesto503020 .tick { font-family: 'Switzer', sans-serif; font-size: 11px; fill: #8A7868; text-anchor: middle; }
      .d-presupuesto503020 .pct { font-family: 'Fraunces', serif; font-style: italic; font-size: 36px; font-weight: 500; fill: #FFFFFF; text-anchor: middle; }
      .d-presupuesto503020 .seg-label { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; fill: #FBE3D6; text-anchor: middle; }
      .d-presupuesto503020 .col-title { font-family: 'Fraunces', serif; font-size: 16px; font-weight: 500; text-anchor: middle; }
      .d-presupuesto503020 .col-item { font-family: 'Switzer', sans-serif; font-size: 12px; fill: #5C4A3D; text-anchor: middle; }
      .d-presupuesto503020 .header { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; fill: #8A7868; text-anchor: middle; }
      .d-presupuesto503020 .footer { font-family: 'Fraunces', serif; font-style: italic; font-size: 13px; fill: #5C4A3D; text-anchor: middle; }
      .d-presupuesto503020 .salary-base { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; fill: #2A1F18; }
    </style>
  </defs>
  <rect class="bg" x="0" y="0" width="800" height="500"/>

  <!-- Header -->
  <text class="header" x="400" y="45">{t.repartoMensualDelSueldo}</text>
  <text class="salary-base" x="50" y="90">{t.k100SueldoNeto}</text>

  <!-- Stacked bar (total width 700, x: 50..750) -->
  <!-- 50%: x=50..400 -->
  <rect class="seg-necesidades" x="50" y="105" width="350" height="100"/>
  <!-- 30%: x=400..610 -->
  <rect class="seg-deseos" x="400" y="105" width="210" height="100"/>
  <!-- 20%: x=610..750 -->
  <rect class="seg-ahorro" x="610" y="105" width="140" height="100"/>
  <rect class="seg-stroke" x="50" y="105" width="700" height="100"/>

  <!-- Percentage labels on segments -->
  <text class="pct" x="225" y="160">50 %</text>
  <text class="seg-label" x="225" y="185">{t.necesidades}</text>

  <text class="pct" x="505" y="160">30 %</text>
  <text class="seg-label" x="505" y="185">{t.deseos}</text>

  <text class="pct" x="680" y="160">20 %</text>
  <text class="seg-label" x="680" y="185">{t.ahorro}</text>

  <!-- Axis with ticks at 0/50/80/100% -->
  <line class="axis" x1="50" y1="220" x2="750" y2="220"/>
  <line class="axis" x1="50" y1="215" x2="50" y2="225"/>
  <line class="axis" x1="400" y1="215" x2="400" y2="225"/>
  <line class="axis" x1="610" y1="215" x2="610" y2="225"/>
  <line class="axis" x1="750" y1="215" x2="750" y2="225"/>
  <text class="tick" x="50" y="240">0 %</text>
  <text class="tick" x="400" y="240">50 %</text>
  <text class="tick" x="610" y="240">80 %</text>
  <text class="tick" x="750" y="240">100 %</text>

  <!-- Three columns of detail -->
  <!-- Col 1: Necesidades -->
  <g>
    <text class="col-title" x="225" y="290" fill="#9C3A1C">{t.necesidades2}</text>
    <text class="col-item" x="225" y="315">{t.alquilerOHipoteca}</text>
    <text class="col-item" x="225" y="333">{t.comidaBasica}</text>
    <text class="col-item" x="225" y="351">{t.suministrosYTransporte}</text>
    <text class="col-item" x="225" y="369">{t.movilEInternet}</text>
    <text class="col-item" x="225" y="387">{t.segurosObligatorios}</text>
  </g>

  <!-- Col 2: Deseos -->
  <g>
    <text class="col-title" x="505" y="290" fill="#A87A2A">{t.deseos2}</text>
    <text class="col-item" x="505" y="315">{t.ocioYRestaurantes}</text>
    <text class="col-item" x="505" y="333">{t.ropaNoEsencial}</text>
    <text class="col-item" x="505" y="351">{t.suscripcionesNetflix}</text>
    <text class="col-item" x="505" y="369">{t.viajes}</text>
    <text class="col-item" x="505" y="387">{t.caprichoDelMes}</text>
  </g>

  <!-- Col 3: Ahorro -->
  <g>
    <text class="col-title" x="680" y="290" fill="#2A1F18">{t.ahorro2}</text>
    <text class="col-item" x="680" y="315">{t.fondoEmergencia}</text>
    <text class="col-item" x="680" y="333">{t.inversionALargo}</text>
    <text class="col-item" x="680" y="351">{t.amortizarDeudas}</text>
    <text class="col-item" x="680" y="369">{t.objetivosVitales}</text>
    <text class="col-item" x="680" y="387">{t.cocheMaster}</text>
  </g>

  <!-- Footer note -->
  <text class="footer" x="400" y="445">{t.siLosGastosFijos}</text>
  <text class="footer" x="400" y="465">{t.sinEl20De}</text>
</svg>
