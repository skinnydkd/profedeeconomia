---
/**
 * The six data-subject rights and the route to exercise them (CJD Bach, unit 7).
 *
 * The rights are widely quoted and almost never used, so the figure pairs each
 * one with the sentence a student would actually write, and puts the procedure
 * underneath: free, unmotivated, one month, then a free complaint to the AEPD.
 * The learning situation for this block is an article 15 access request, and
 * this is the sheet it is run from.
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    seisDerechosReconocidosPorEl: 'Seis derechos reconocidos por el Reglamento General de Protección de Datos: acceso, rectificación, supresión, oposición, limitación y portabilidad. Para ejercerlos se envía una solicitud al responsable del tratamiento, sin necesidad de motivarla y sin coste; el responsable dispone de un mes para responder, ampliable a dos; y si no responde o deniega, se puede reclamar gratuitamente ante la Agencia Española de Protección de Datos.',
    tusSeisDerechosSobreTusDatos: 'Tus seis derechos sobre tus datos, y cómo usarlos',
    seisDerechosQueCasiNadieEjer: 'Seis derechos que casi nadie ejerce',
    acceso: 'Acceso',
    art15Rgpd: 'art. 15 RGPD',
    queDatosMiosTeneis: 'Qué datos míos tenéis',
    enviadmeCopiaDeTodo: '«Enviadme copia de todo.»',
    rectificacion: 'Rectificación',
    art16Rgpd: 'art. 16 RGPD',
    unDatoMioEsIncorrecto: 'Un dato mío es incorrecto',
    corregidlo: '«Corregidlo.»',
    supresion: 'Supresión',
    art17Rgpd: 'art. 17 RGPD',
    yaNoTeneisMotivoParaTenerlos: 'Ya no tenéis motivo para tenerlos',
    borradlos: '«Borradlos.»',
    oposicion: 'Oposición',
    art21Rgpd: 'art. 21 RGPD',
    noQuieroEsteTratamiento: 'No quiero este tratamiento',
    dejadDeUsarlosParaEsto: '«Dejad de usarlos para esto.»',
    limitacion: 'Limitación',
    art18Rgpd: 'art. 18 RGPD',
    mientrasSeAclaraLaDiscusion: 'Mientras se aclara la discusión',
    congeladlosNoLosUseis: '«Congeladlos, no los uséis.»',
    portabilidad: 'Portabilidad',
    art20Rgpd: 'art. 20 RGPD',
    meVoyAOtroServicio: 'Me voy a otro servicio',
    dadmelosEnFormatoReutilizabl: '«Dádmelos en formato reutilizable.»',
    comoSeEjercenEnTresPasos: 'Cómo se ejercen, en tres pasos',
    solicitudAlResponsable: 'Solicitud al responsable',
    porEscritoAdjuntandoTuDni: 'Por escrito, adjuntando tu DNI.',
    gratisYSinExplicarPorQue: 'Gratis y sin explicar por qué.',
    unMesParaResponder: 'Un mes para responder',
    ampliableADosSiEsComplejo: 'Ampliable a dos si es complejo,',
    avisandoteDentroDelPrimerMes: 'avisándote dentro del primer mes.',
    reclamacionAnteLaAepd: 'Reclamación ante la AEPD',
    siNoContestaODeniega: 'Si no contesta o deniega.',
    tambienGratisYSinAbogado: 'También gratis y sin abogado.',
    elSilencioTambienEsUnaRespue: 'El silencio también es una respuesta, y es una respuesta que pierde.',
    siPasaElPlazoSinContestacion: 'Si pasa el plazo sin contestación, ya puedes reclamar ante la Agencia Española de Protección de Datos, que puede',
    investigarYSancionarNoNecesi: 'investigar y sancionar. No necesitas abogado, no cuesta dinero y la reclamación se presenta por internet.',
    estosDerechosValenFrenteACua: 'Estos derechos valen frente a cualquiera que trate tus datos: una red social, tu banco, tu gimnasio o tu instituto.',
  },
  ca: {
    seisDerechosReconocidosPorEl: "Sis drets reconeguts pel Reglament General de Protecció de Dades: accés, rectificació, supressió, oposició, limitació i portabilitat. Per exercir-los s'envia una sol·licitud al responsable del tractament, sense necessitat de motivar-la i sense cost; el responsable disposa d'un mes per respondre, ampliable a dos; i si no respon o denega, es pot reclamar gratuïtament davant de l'Agència Espanyola de Protecció de Dades.",
    tusSeisDerechosSobreTusDatos: 'Els teus sis drets sobre les teues dades, i com usar-los',
    seisDerechosQueCasiNadieEjer: 'Sis drets que quasi ningú no exercix',
    acceso: 'Accés',
    art15Rgpd: 'art. 15 RGPD',
    queDatosMiosTeneis: 'Quines dades meues teniu',
    enviadmeCopiaDeTodo: '«Envieu-me còpia de tot.»',
    rectificacion: 'Rectificació',
    art16Rgpd: 'art. 16 RGPD',
    unDatoMioEsIncorrecto: 'Una dada meua és incorrecta',
    corregidlo: '«Corregiu-la.»',
    supresion: 'Supressió',
    art17Rgpd: 'art. 17 RGPD',
    yaNoTeneisMotivoParaTenerlos: 'Ja no teniu motiu per tindre-les',
    borradlos: '«Esborreu-les.»',
    oposicion: 'Oposició',
    art21Rgpd: 'art. 21 RGPD',
