    dejadDeUsarlosParaEsto: "«Deixeu d'usar-les per a això.»",
    limitacion: 'Limitació',
    art18Rgpd: 'art. 18 RGPD',
    mientrasSeAclaraLaDiscusion: "Mentre s'aclarix la discussió",
    congeladlosNoLosUseis: '«Congeleu-les, no les useu.»',
    portabilidad: 'Portabilitat',
    art20Rgpd: 'art. 20 RGPD',
    meVoyAOtroServicio: "Me'n vaig a un altre servei",
    dadmelosEnFormatoReutilizabl: '«Doneu-me-les en format reutilitzable.»',
    comoSeEjercenEnTresPasos: "Com s'exercixen, en tres passos",
    solicitudAlResponsable: 'Sol·licitud al responsable',
    porEscritoAdjuntandoTuDni: 'Per escrit, adjuntant el teu DNI.',
    gratisYSinExplicarPorQue: 'De franc i sense explicar per què.',
    unMesParaResponder: 'Un mes per respondre',
    ampliableADosSiEsComplejo: 'Ampliable a dos si és complex,',
    avisandoteDentroDelPrimerMes: 'avisant-te dins del primer mes.',
    reclamacionAnteLaAepd: "Reclamació davant de l'AEPD",
    siNoContestaODeniega: 'Si no contesta o denega.',
    tambienGratisYSinAbogado: 'També de franc i sense advocat.',
    elSilencioTambienEsUnaRespue: 'El silenci també és una resposta, i és una resposta que perd.',
    siPasaElPlazoSinContestacion: "Si passa el termini sense contestació, ja pots reclamar davant de l'Agència Espanyola de Protecció de Dades, que pot",
    investigarYSancionarNoNecesi: 'investigar i sancionar. No necessites advocat, no costa diners i la reclamació es presenta per internet.',
    estosDerechosValenFrenteACua: 'Estos drets valen davant de qualsevol que tracte les teues dades: una xarxa social, el teu banc, el teu gimnàs o el teu institut.',
  },
} as const;

const t = COPY[locale];
---

<svg viewBox="0 0 820 520" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="derechosrgpd-t derechosrgpd-d">
  <title id="derechosrgpd-t">{t.tusSeisDerechosSobreTusDatos}</title>
  <desc id="derechosrgpd-d">{t.seisDerechosReconocidosPorEl}</desc>
  <defs>
    <style>
      .bg { fill: #FBF6EC; }
      .right { fill: #FFFFFF; stroke: #4A3B8F; stroke-width: 1.8; }
      .letter { font-family: 'Fraunces', serif; font-style: italic; font-size: 26px; fill: #E0DCF0; }
      .name { font-family: 'Fraunces', serif; font-size: 17px; font-weight: 500; fill: #2A1F18; }
      .art { font-family: 'Switzer', sans-serif; font-size: 9px; font-style: italic; fill: #8A7868; }
      .txt { font-family: 'Switzer', sans-serif; font-size: 10.5px; fill: #5C4A3D; }
      .say { font-family: 'Fraunces', serif; font-style: italic; font-size: 11px; fill: #4A3B8F; }
      .step { fill: #E0DCF0; stroke: #4A3B8F; stroke-width: 2; }
      .step-n { font-family: 'Fraunces', serif; font-style: italic; font-size: 20px; fill: #4A3B8F; }
      .step-t { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; fill: #2A1F18; }
      .step-d { font-family: 'Switzer', sans-serif; font-size: 10px; fill: #5C4A3D; }
      .band { font-family: 'Switzer', sans-serif; font-size: 9px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase; fill: #8A7868; }
      .arrow { fill: none; stroke: #4A3B8F; stroke-width: 2; marker-end: url(#rgpd-arrow); }
      .note-t { font-family: 'Switzer', sans-serif; font-size: 10.5px; fill: #5C4A3D; }
      .note-b { font-family: 'Switzer', sans-serif; font-size: 10.5px; font-weight: 700; fill: #2A1F18; }
    </style>
    <marker id="rgpd-arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#4A3B8F" />
    </marker>
  </defs>

  <rect class="bg" x="0" y="0" width="820" height="520" />

  <text class="band" x="40" y="28">{t.seisDerechosQueCasiNadieEjer}</text>

  <!-- Row 1 -->
  <rect class="right" x="40" y="42" width="236" height="96" rx="4" />
  <text class="letter" x="248" y="72">A</text>
  <text class="name" x="58" y="70">{t.acceso}</text>
  <text class="art" x="58" y="86">{t.art15Rgpd}</text>
  <text class="txt" x="58" y="108">{t.queDatosMiosTeneis}</text>
  <text class="say" x="58" y="126">{t.enviadmeCopiaDeTodo}</text>

  <rect class="right" x="292" y="42" width="236" height="96" rx="4" />
  <text class="letter" x="500" y="72">R</text>
  <text class="name" x="310" y="70">{t.rectificacion}</text>
  <text class="art" x="310" y="86">{t.art16Rgpd}</text>
  <text class="txt" x="310" y="108">{t.unDatoMioEsIncorrecto}</text>
  <text class="say" x="310" y="126">{t.corregidlo}</text>

  <rect class="right" x="544" y="42" width="236" height="96" rx="4" />
  <text class="letter" x="752" y="72">S</text>
  <text class="name" x="562" y="70">{t.supresion}</text>
  <text class="art" x="562" y="86">{t.art17Rgpd}</text>
  <text class="txt" x="562" y="108">{t.yaNoTeneisMotivoParaTenerlos}</text>
  <text class="say" x="562" y="126">{t.borradlos}</text>

  <!-- Row 2 -->
  <rect class="right" x="40" y="152" width="236" height="96" rx="4" />
  <text class="letter" x="248" y="182">O</text>
  <text class="name" x="58" y="180">{t.oposicion}</text>
  <text class="art" x="58" y="196">{t.art21Rgpd}</text>
  <text class="txt" x="58" y="218">{t.noQuieroEsteTratamiento}</text>
  <text class="say" x="58" y="236">{t.dejadDeUsarlosParaEsto}</text>

  <rect class="right" x="292" y="152" width="236" height="96" rx="4" />
  <text class="letter" x="500" y="182">L</text>
  <text class="name" x="310" y="180">{t.limitacion}</text>
  <text class="art" x="310" y="196">{t.art18Rgpd}</text>
  <text class="txt" x="310" y="218">{t.mientrasSeAclaraLaDiscusion}</text>
  <text class="say" x="310" y="236">{t.congeladlosNoLosUseis}</text>

  <rect class="right" x="544" y="152" width="236" height="96" rx="4" />
  <text class="letter" x="752" y="182">P</text>
  <text class="name" x="562" y="180">{t.portabilidad}</text>
  <text class="art" x="562" y="196">{t.art20Rgpd}</text>
  <text class="txt" x="562" y="218">{t.meVoyAOtroServicio}</text>
  <text class="say" x="562" y="236">{t.dadmelosEnFormatoReutilizabl}</text>

  <!-- Route -->
  <text class="band" x="40" y="288">{t.comoSeEjercenEnTresPasos}</text>

  <rect class="step" x="40" y="302" width="236" height="84" rx="4" />
  <text class="step-n" x="58" y="330">1</text>
  <text class="step-t" x="82" y="328">{t.solicitudAlResponsable}</text>
  <text class="step-d" x="58" y="352">{t.porEscritoAdjuntandoTuDni}</text>
  <text class="step-d" x="58" y="368">{t.gratisYSinExplicarPorQue}</text>

  <rect class="step" x="292" y="302" width="236" height="84" rx="4" />
  <text class="step-n" x="310" y="330">2</text>
  <text class="step-t" x="334" y="328">{t.unMesParaResponder}</text>
  <text class="step-d" x="310" y="352">{t.ampliableADosSiEsComplejo}</text>
  <text class="step-d" x="310" y="368">{t.avisandoteDentroDelPrimerMes}</text>

  <rect class="step" x="544" y="302" width="236" height="84" rx="4" />
  <text class="step-n" x="562" y="330">3</text>
  <text class="step-t" x="586" y="328">{t.reclamacionAnteLaAepd}</text>
  <text class="step-d" x="562" y="352">{t.siNoContestaODeniega}</text>
  <text class="step-d" x="562" y="368">{t.tambienGratisYSinAbogado}</text>

  <path class="arrow" d="M 278 344 L 288 344" />
  <path class="arrow" d="M 530 344 L 540 344" />

  <!-- Note -->
  <text class="note-b" x="40" y="424">{t.elSilencioTambienEsUnaRespue}</text>
  <text class="note-t" x="40" y="446">{t.siPasaElPlazoSinContestacion}</text>
  <text class="note-t" x="40" y="462">{t.investigarYSancionarNoNecesi}</text>
  <text class="note-t" x="40" y="484">{t.estosDerechosValenFrenteACua}</text>
</svg>
