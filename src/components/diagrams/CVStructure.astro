---
<svg class="d-cv-structure" viewBox="0 0 880 620" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={t.anatomiaDeUnCurriculum}>
  <title>{t.estructuraRecomendadaDeUn}</title>
  <desc>{t.representacionVisualDeUn}</desc>
  <defs>
    <style>
      .d-cv-structure .bg { fill: #FBF6EC; }
      .d-cv-structure .page { fill: #FFFFFF; stroke: #E5D4BD; stroke-width: 2; }
      .d-cv-structure .section { stroke-width: 1.5; }
      .d-cv-structure .sec-header { fill: #FBE3D6; stroke: #C44E2C; }
      .d-cv-structure .sec-resumen { fill: #F5E5BC; stroke: #D4A24C; }
      .d-cv-structure .sec-experiencia { fill: #FFFFFF; stroke: #5B3A4E; }
      .d-cv-structure .sec-formacion { fill: #FFFFFF; stroke: #1F6E6E; }
      .d-cv-structure .sec-idiomas { fill: #DBEDED; stroke: #1F6E6E; }
      .d-cv-structure .sec-digital { fill: #ECDCE5; stroke: #5B3A4E; }
      .d-cv-structure .sec-extras { fill: #F5EDD9; stroke: #8A7868; }
      .d-cv-structure .sec-label { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; fill: #2A1F18; }
      .d-cv-structure .sec-meta { font-family: 'Switzer', sans-serif; font-size: 10px; fill: #5C4A3D; }
      .d-cv-structure .sec-name { font-family: 'Fraunces', serif; font-size: 14px; font-weight: 500; fill: #2A1F18; }
      .d-cv-structure .photo { fill: #F5EDD9; stroke: #8A7868; stroke-width: 1.5; stroke-dasharray: 3 2; }
      .d-cv-structure .photo-label { font-family: 'Switzer', sans-serif; font-size: 9px; fill: #8A7868; text-anchor: middle; }
      .d-cv-structure .tag { fill: #C44E2C; }
      .d-cv-structure .tag-text { font-family: 'Switzer', sans-serif; font-size: 9.5px; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; fill: #FFFFFF; text-anchor: middle; }
      .d-cv-structure .note-line { stroke: #C44E2C; stroke-width: 1; fill: none; stroke-dasharray: 3 2; }
      .d-cv-structure .note-text { font-family: 'Fraunces', serif; font-style: italic; font-size: 11.5px; fill: #2A1F18; }
      .d-cv-structure .note-emph { font-family: 'Switzer', sans-serif; font-size: 10px; font-weight: 700; fill: #C44E2C; letter-spacing: 0.6px; text-transform: uppercase; }
      .d-cv-structure .title-top { font-family: 'Switzer', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; fill: #5C4A3D; }
    </style>
  </defs>
  <rect class="bg" x="0" y="0" width="880" height="620"/>

  <!-- Top title -->
  <text class="title-top" x="290" y="30" text-anchor="middle">{t.paginaA4UnaSola}</text>

  <!-- "Page" outer rectangle -->
  <rect class="page" x="220" y="45" width="380" height="540" rx="3"/>

  <!-- 1. Header (datos + foto opcional) -->
  <g>
    <rect class="section sec-header" x="235" y="60" width="350" height="80" rx="4"/>
    <text class="sec-label" x="250" y="82">{t.k1Header}</text>
    <text class="sec-name" x="250" y="105">{t.nombreApellidos}</text>
    <text class="sec-meta" x="250" y="122">{t.emailTelefonoLinkedinCiudad}</text>
    <!-- Foto -->
    <rect class="photo" x="510" y="72" width="60" height="60" rx="3"/>
    <text class="photo-label" x="540" y="100">{t.foto}</text>
    <text class="photo-label" x="540" y="115">{t.opcional}</text>
  </g>

  <!-- 2. Resumen -->
  <g>
    <rect class="section sec-resumen" x="235" y="150" width="350" height="60" rx="4"/>
    <text class="sec-label" x="250" y="172">{t.k2Resumen}</text>
    <text class="sec-meta" x="250" y="190">{t.k34LineasQuien}</text>
    <text class="sec-meta" x="250" y="203">{t.queAportas}</text>
  </g>

  <!-- 3. Experiencia (con tag) -->
  <g>
    <rect class="section sec-experiencia" x="235" y="220" width="350" height="100" rx="4"/>
    <text class="sec-label" x="250" y="242">{t.k3Experiencia}</text>
    <text class="sec-meta" x="250" y="262">{t.puestoEmpresaFechas}</text>
    <text class="sec-meta" x="250" y="278">{t.logro1ConResultado}</text>
    <text class="sec-meta" x="250" y="294">{t.logro2ConResultado}</text>
    <text class="sec-meta" x="250" y="310">{t.logro3ConResultado}</text>
    <!-- Tag -->
    <rect class="tag" x="450" y="232" width="130" height="18" rx="9"/>
    <text class="tag-text" x="515" y="245">{t.verbosResultados}</text>
  </g>

  <!-- 4. Formación -->
  <g>
    <rect class="section sec-formacion" x="235" y="330" width="350" height="70" rx="4"/>
    <text class="sec-label" x="250" y="352">{t.k4Formacion}</text>
    <text class="sec-meta" x="250" y="372">{t.tituloCentroFechas}</text>
    <text class="sec-meta" x="250" y="388">{t.enOrdenCronologicoInverso}</text>
  </g>

  <!-- 5. Idiomas -->
  <g>
    <rect class="section sec-idiomas" x="235" y="410" width="170" height="65" rx="4"/>
    <text class="sec-label" x="250" y="432">{t.k5Idiomas}</text>
    <text class="sec-meta" x="250" y="452">{t.castellanoC2}</text>
    <text class="sec-meta" x="250" y="467">{t.inglesB2Cambridge}</text>
  </g>

  <!-- 6. Habilidades digitales -->
  <g>
    <rect class="section sec-digital" x="415" y="410" width="170" height="65" rx="4"/>
    <text class="sec-label" x="430" y="432">{t.k6Digital}</text>
    <text class="sec-meta" x="430" y="452">{t.excelCanvaCapcut}</text>
    <text class="sec-meta" x="430" y="467">{t.pythonBasicoIa}</text>
  </g>

  <!-- 7. Extras -->
  <g>
    <rect class="section sec-extras" x="235" y="485" width="350" height="85" rx="4"/>
    <text class="sec-label" x="250" y="507">{t.k7VoluntariadoExtras}</text>
    <text class="sec-meta" x="250" y="527">{t.voluntariadoProyectosPersona}</text>
    <text class="sec-meta" x="250" y="543">{t.aficionesQueAportenContexto}</text>
    <text class="sec-meta" x="250" y="559">{t.premiosOReconocimientos}</text>
  </g>

  <!-- LEFT ANNOTATIONS -->
  <g>
    <text class="note-emph" x="20" y="100">{t.consejo1}</text>
    <text class="note-text" x="20" y="118">{t.sinFotoSiDudas}</text>
    <text class="note-text" x="20" y="132">{t.evitaSesgosDel}</text>
    <text class="note-text" x="20" y="146">{t.reclutador}</text>
    <line class="note-line" x1="140" y1="100" x2="510" y2="100"/>
  </g>

  <g>
    <text class="note-emph" x="20" y="190">{t.consejo2}</text>
    <text class="note-text" x="20" y="208">{t.elResumenEsEl}</text>
    <text class="note-text" x="20" y="222">{t.trailerDelCv}</text>
    <text class="note-text" x="20" y="236">{t.decisivoEn6Seg}</text>
    <line class="note-line" x1="140" y1="180" x2="235" y2="180"/>
  </g>

  <g>
    <text class="note-emph" x="20" y="290">{t.consejo3}</text>
    <text class="note-text" x="20" y="308">{t.coordineEquipo}</text>
    <text class="note-text" x="20" y="322">{t.de4YSubimos}</text>
    <text class="note-text" x="20" y="336">{t.ventasUn20}</text>
    <text class="note-text" x="20" y="350">{t.noResponsable}</text>
    <text class="note-text" x="20" y="364">{t.deVentas}</text>
    <line class="note-line" x1="140" y1="290" x2="235" y2="290"/>
  </g>

  <!-- RIGHT ANNOTATIONS -->
  <g>
    <text class="note-emph" x="620" y="180">{t.consejo4}</text>
    <text class="note-text" x="620" y="198">{t.personalizarElCv}</text>
    <text class="note-text" x="620" y="212">{t.porOfertaCada}</text>
    <text class="note-text" x="620" y="226">{t.envioAdaptaEl}</text>
    <text class="note-text" x="620" y="240">{t.resumenYOrden}</text>
    <line class="note-line" x1="600" y1="180" x2="615" y2="180"/>
  </g>

  <g>
    <text class="note-emph" x="620" y="440">{t.consejo5}</text>
    <text class="note-text" x="620" y="458">{t.idiomasConNivel}</text>
    <text class="note-text" x="620" y="472">{t.mcerA1C2}</text>
    <text class="note-text" x="620" y="486">{t.noFluidoO}</text>
    <text class="note-text" x="620" y="500">{t.medioAlto}</text>
    <line class="note-line" x1="585" y1="442" x2="615" y2="442"/>
  </g>

  <g>
    <text class="note-emph" x="620" y="530">{t.consejo6}</text>
    <text class="note-text" x="620" y="548">{t.k1PaginaMax}</text>
    <text class="note-text" x="620" y="562">{t.paraPerfilJunior}</text>
    <text class="note-text" x="620" y="576">{t.masAllaSeDiluye}</text>
    <line class="note-line" x1="585" y1="530" x2="615" y2="530"/>
  </g>
</svg>
