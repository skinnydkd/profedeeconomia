---
/**
 * Two-column comparison of fixed mindset vs growth mindset (Carol Dweck):
 * a left panel listing fixed-mindset attitudes (intelligence is innate,
 * failure defines you) against a right panel with the contrasting
 * growth-mindset attitudes (abilities are trained, failure teaches),
 * closing with the unit's takeaway.
 *
 * Used in Eco 4ESO (mentalidad de crecimiento y actitud emprendedora).
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    mentalidadFijaFrenteA: 'Mentalidad fija frente a mentalidad de crecimiento',
    comparacionEntreLaMentalidad: 'Comparación entre la mentalidad fija (la inteligencia es innata, el fallo define) y la mentalidad de crecimiento (las capacidades se entrenan, el fallo enseña), según Carol Dweck.',
    mentalidad: 'Mentalidad',
    fija: 'fija',
    laInteligenciaEsAlgo: 'La inteligencia es algo',
    conLoQueSe: 'con lo que se nace',
    evitoLosRetosPor: 'Evito los retos por',
    miedoAFallar: 'miedo a fallar',
    siFalloEsQue: 'Si fallo, es que no valgo',
    lasCriticasMeHunden: 'Las críticas me hunden',
    elEsfuerzoEsPara: 'El esfuerzo es para los',
    queNoTienenTalento: 'que no tienen talento',
    mentalidadDe: 'Mentalidad de',
    crecimiento: 'crecimiento',
    laInteligenciaSe: 'La inteligencia se',
    entrenaConEsfuerzo: 'entrena con esfuerzo',
    buscoLosRetosComo: 'Busco los retos como',
    oportunidadDeAprender: 'oportunidad de aprender',
    siFalloAprendoY: 'Si fallo, aprendo y',
    vuelvoAIntentarlo: 'vuelvo a intentarlo',
    lasCriticasMe: 'Las críticas me',
    ayudanAMejorar: 'ayudan a mejorar',
    elEsfuerzoEsEl: 'El esfuerzo es el camino para mejorar',
    noNacesEmprendedorTe: 'No naces emprendedor: te entrenas para serlo.',
  },
  ca: {
    mentalidadFijaFrenteA: 'Mentalitat fixa enfront de mentalitat de creixement',
    comparacionEntreLaMentalidad: "Comparació entre la mentalitat fixa (la intel·ligència és innata, l'error defineix) i la mentalitat de creixement (les capacitats s'entrenen, l'error ensenya), segons Carol Dweck.",
    mentalidad: 'Mentalitat',
    fija: 'fixa',
    laInteligenciaEsAlgo: 'La intel·ligència és una cosa',
    conLoQueSe: 'amb què es naix',
    evitoLosRetosPor: 'Evite els reptes per',
    miedoAFallar: 'por a fallar',
    siFalloEsQue: 'Si falle, és que no valc',
    lasCriticasMeHunden: "Les crítiques m'enfonsen",
    elEsfuerzoEsPara: "L'esforç és per als",
    queNoTienenTalento: 'que no tenen talent',
    mentalidadDe: 'Mentalitat de',
    crecimiento: 'creixement',
    laInteligenciaSe: "La intel·ligència s'",
    entrenaConEsfuerzo: 'entrena amb esforç',
    buscoLosRetosComo: 'Busque els reptes com a',
    oportunidadDeAprender: "oportunitat d'aprendre",
    siFalloAprendoY: 'Si falle, aprenc i',
    vuelvoAIntentarlo: 'torne a intentar-ho',
    lasCriticasMe: 'Les crítiques em',
    ayudanAMejorar: 'ajuden a millorar',
    elEsfuerzoEsEl: "L'esforç és el camí per a millorar",
    noNacesEmprendedorTe: "No naixes emprenedor: t'entrenes per a ser-ho.",
  },
} as const;
const t = COPY[locale];
---
<svg class="d-mentalidad-crecimiento" viewBox="0 0 860 460" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="mc-title mc-desc">
  <title id="mc-title">{t.mentalidadFijaFrenteA}</title>
  <desc id="mc-desc">{t.comparacionEntreLaMentalidad}</desc>
  <defs>
    <style>
      .d-mentalidad-crecimiento .bg { fill: #FBF6EC; }
      .d-mentalidad-crecimiento .panel { fill: #FFFFFF; stroke: #E5D4BD; stroke-width: 1.5; }
      .d-mentalidad-crecimiento .head-fija { fill: #F5E5BC; }
      .d-mentalidad-crecimiento .head-crec { fill: #FBE3D6; }
      .d-mentalidad-crecimiento .head-line-fija { fill: #D4A24C; }
      .d-mentalidad-crecimiento .head-line-crec { fill: #C44E2C; }
      .d-mentalidad-crecimiento .head-text { font-family: 'Fraunces', serif; font-style: italic; font-size: 22px; font-weight: 600; fill: #2A1F18; text-anchor: middle; }
      .d-mentalidad-crecimiento .eyebrow { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; text-anchor: middle; }
      .d-mentalidad-crecimiento .eyebrow-fija { fill: #A87A2A; }
      .d-mentalidad-crecimiento .eyebrow-crec { fill: #9C3A1C; }
      .d-mentalidad-crecimiento .item { font-family: 'Switzer', sans-serif; font-size: 14.5px; font-weight: 500; fill: #5C4A3D; }
      .d-mentalidad-crecimiento .mark-fija { fill: #A87A2A; font-family: 'Switzer', sans-serif; font-size: 15px; font-weight: 700; }
      .d-mentalidad-crecimiento .mark-crec { fill: #C44E2C; font-family: 'Switzer', sans-serif; font-size: 15px; font-weight: 700; }
      .d-mentalidad-crecimiento .divider { stroke: #E5D4BD; stroke-width: 1.5; stroke-dasharray: 4 5; }
      .d-mentalidad-crecimiento .take-strip { fill: #2A1F18; }
      .d-mentalidad-crecimiento .take-text { font-family: 'Fraunces', serif; font-style: italic; font-size: 19px; font-weight: 600; fill: #FBF6EC; text-anchor: middle; }
    </style>
  </defs>
  <rect class="bg" x="0" y="0" width="860" height="460"/>

  <!-- ============ LEFT PANEL — Mentalidad fija ============ -->
  <rect class="panel" x="36" y="32" width="378" height="320" rx="8"/>
  <!-- header -->
  <path class="head-fija" d="M36 40 a8 8 0 0 1 8 -8 h362 a8 8 0 0 1 8 8 v44 h-378 z"/>
  <rect class="head-line-fija" x="36" y="84" width="378" height="3"/>
  <text class="eyebrow eyebrow-fija" x="225" y="55">{t.mentalidad}</text>
  <text class="head-text" x="225" y="78">{t.fija}</text>

  <!-- items -->
  <text class="mark-fija" x="58" y="124">·</text>
  <text class="item" x="74" y="124">{t.laInteligenciaEsAlgo}</text>
  <text class="item" x="74" y="143">{t.conLoQueSe}</text>

  <text class="mark-fija" x="58" y="178">·</text>
  <text class="item" x="74" y="178">{t.evitoLosRetosPor}</text>
  <text class="item" x="74" y="197">{t.miedoAFallar}</text>

  <text class="mark-fija" x="58" y="232">·</text>
  <text class="item" x="74" y="232">{t.siFalloEsQue}</text>

  <text class="mark-fija" x="58" y="276">·</text>
  <text class="item" x="74" y="276">{t.lasCriticasMeHunden}</text>

  <text class="mark-fija" x="58" y="320">·</text>
  <text class="item" x="74" y="320">{t.elEsfuerzoEsPara}</text>
  <text class="item" x="74" y="339">{t.queNoTienenTalento}</text>

  <!-- ============ CENTRAL DIVIDER ============ -->
  <line class="divider" x1="430" y1="40" x2="430" y2="344"/>

  <!-- ============ RIGHT PANEL — Mentalidad de crecimiento ============ -->
  <rect class="panel" x="446" y="32" width="378" height="320" rx="8"/>
  <!-- header -->
  <path class="head-crec" d="M446 40 a8 8 0 0 1 8 -8 h362 a8 8 0 0 1 8 8 v44 h-378 z"/>
  <rect class="head-line-crec" x="446" y="84" width="378" height="3"/>
  <text class="eyebrow eyebrow-crec" x="635" y="55">{t.mentalidadDe}</text>
  <text class="head-text" x="635" y="78">{t.crecimiento}</text>

  <!-- items -->
  <text class="mark-crec" x="468" y="124">→</text>
  <text class="item" x="490" y="124">{t.laInteligenciaSe}</text>
  <text class="item" x="490" y="143">{t.entrenaConEsfuerzo}</text>

  <text class="mark-crec" x="468" y="178">→</text>
  <text class="item" x="490" y="178">{t.buscoLosRetosComo}</text>
  <text class="item" x="490" y="197">{t.oportunidadDeAprender}</text>

  <text class="mark-crec" x="468" y="232">→</text>
  <text class="item" x="490" y="232">{t.siFalloAprendoY}</text>
  <text class="item" x="490" y="251">{t.vuelvoAIntentarlo}</text>

  <text class="mark-crec" x="468" y="296">→</text>
  <text class="item" x="490" y="296">{t.lasCriticasMe}</text>
  <text class="item" x="490" y="315">{t.ayudanAMejorar}</text>

  <text class="mark-crec" x="468" y="339">→</text>
  <text class="item" x="490" y="339">{t.elEsfuerzoEsEl}</text>

  <!-- ============ BOTTOM TAKEAWAY STRIP ============ -->
  <rect class="take-strip" x="36" y="386" width="788" height="44" rx="8"/>
  <text class="take-text" x="430" y="414">{t.noNacesEmprendedorTe}</text>
</svg>
