---
/**
 * A land-registry "nota simple" with its parts called out: which registry,
 * the property's number, its description, who owns it and by what title, the
 * charges on it, pending entries and the notice that it only informs (art.
 * 222.5 of the Ley Hipotecaria). Registry, property, owner and bank are
 * invented: it is a teaching sample, not a real record.
 *
 * Used in CJD · Unit 4 (civil law: person, family, property).
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    title: 'Una nota simple, parte a parte',
    desc: 'Ejemplo inventado de nota simple informativa de un Registro de la Propiedad, de 12 de marzo de 2026. Finca número 4.812 con su código registral único. Descripción: vivienda urbana en calle Mayor, 14, 2.º B, de 78 metros cuadrados construidos, con su referencia catastral. Titularidad: Lucía M. P., 100 % del pleno dominio por compraventa, escritura de 14 de mayo de 2019, inscripción 4.ª. Cargas: hipoteca a favor de Banco Ejemplo, S.A., por 96.000 euros de principal, a 25 años. Sin documentos pendientes de despacho. Al pie, el aviso de que la nota tiene valor informativo y no da fe del contenido de los asientos.',
    mast: 'REGISTRO DE LA PROPIEDAD DE ALMARA N.º 1',
    sub: 'Nota simple informativa · 12/03/2026',
    finca: 'Finca n.º 4.812',
    cru: 'CRU 99001000481200',
    sDes: 'DESCRIPCIÓN',
    d1: 'Urbana. Vivienda en calle Mayor, 14, 2.º B.',
    d2: 'Superficie construida: 78 m².',
    d3: 'Ref. catastral: 0000000XX0000X0001XX',
    sTit: 'TITULARIDAD',
    t1: 'Lucía M. P., 100 % del pleno dominio,',
    t2: 'por compraventa. Escritura de 14/05/2019.',
    t3: 'Inscripción 4.ª · Tomo 1.210, libro 96, folio 33.',
    sCar: 'CARGAS',
    g1: 'Hipoteca a favor de Banco Ejemplo, S.A.,',
    g2: 'por 96.000,00 € de principal. Plazo: 25 años.',
    sPen: 'ASIENTOS PENDIENTES',
    p1: 'Sin documentos pendientes de despacho.',
    f1: 'Valor informativo: esta nota no da fe del',
    f2: 'contenido de los asientos.',
    cReg: 'Qué Registro',
    cRegN: 'el de la zona donde está la finca',
    cDes: 'Descripción',
    cDesN: 'qué es, dónde está y cuánto mide',
    cTit: 'Titular',
    cTitN: 'quién puede vender o hipotecar',
    cCar: 'Cargas',
    cCarN: 'pesan sobre la finca, no sobre el dueño',
    cInf: 'Solo informa',
    cInfN: 'la que da fe es la certificación',
    cFec: 'Fecha',
    cFecN: 'vale para ese día, no para después',
    cNum: 'Número de finca y CRU',
    cNumN: 'su identidad en el Registro',
    cCat: 'Referencia catastral',
    cCatN: 'la enlaza con el Catastro',
    cIns: 'Título e inscripción',
    cInsN: 'cómo se adquirió y dónde consta',
    cPen: 'Asientos pendientes',
    cPenN: 'avisan de cambios en trámite',
  },
  ca: {
    title: 'Una nota simple, part a part',
    desc: "Exemple inventat de nota simple informativa d'un Registre de la Propietat, de 12 de març de 2026. Finca número 4.812 amb el seu codi registral únic. Descripció: vivenda urbana al carrer Major, 14, 2n B, de 78 metres quadrats construïts, amb la seua referència cadastral. Titularitat: Lucía M. P., 100 % del ple domini per compravenda, escriptura de 14 de maig de 2019, inscripció 4a. Càrregues: hipoteca a favor de Banco Ejemplo, S.A., per 96.000 euros de principal, a 25 anys. Sense documents pendents de despatx. Al peu, l'avís que la nota té valor informatiu i no dona fe del contingut dels assentaments.",
    mast: "REGISTRE DE LA PROPIETAT D'ALMARA NÚM. 1",
    sub: 'Nota simple informativa · 12/03/2026',
    finca: 'Finca núm. 4.812',
    cru: 'CRU 99001000481200',
    sDes: 'DESCRIPCIÓ',
    d1: 'Urbana. Vivenda al carrer Major, 14, 2n B.',
    d2: 'Superfície construïda: 78 m².',
    d3: 'Ref. cadastral: 0000000XX0000X0001XX',
    sTit: 'TITULARITAT',
    t1: 'Lucía M. P., 100 % del ple domini,',
    t2: 'per compravenda. Escriptura de 14/05/2019.',
    t3: 'Inscripció 4a · Tom 1.210, llibre 96, foli 33.',
    sCar: 'CÀRREGUES',
    g1: 'Hipoteca a favor de Banco Ejemplo, S.A.,',
    g2: 'per 96.000,00 € de principal. Termini: 25 anys.',
    sPen: 'ASSENTAMENTS PENDENTS',
    p1: 'Sense documents pendents de despatx.',
    f1: 'Valor informatiu: esta nota no dona fe del',
    f2: 'contingut dels assentaments.',
    cReg: 'Quin Registre',
    cRegN: 'el de la zona on està la finca',
    cDes: 'Descripció',
    cDesN: 'què és, on està i quant fa',
    cTit: 'Titular',
    cTitN: 'qui pot vendre o hipotecar',
    cCar: 'Càrregues',
    cCarN: "pesen sobre la finca, no sobre l'amo",
    cInf: 'Només informa',
    cInfN: 'la que dona fe és la certificació',
    cFec: 'Data',
    cFecN: 'val per a eixe dia, no per a després',
    cNum: 'Número de finca i CRU',
    cNumN: 'la seua identitat al Registre',
    cCat: 'Referència cadastral',
    cCatN: "l'enllaça amb el Cadastre",
    cIns: 'Títol i inscripció',
    cInsN: 'com es va adquirir i on consta',
    cPen: 'Assentaments pendents',
    cPenN: 'avisen de canvis en tràmit',
  },
} as const;
const t = COPY[locale];

/** Section headings and body lines: text, y. */
const secciones: [string, number][] = [
  [t.sDes, 132], [t.sTit, 222], [t.sCar, 312], [t.sPen, 386],
];
const lineas: [string, number][] = [
  [t.d1, 150], [t.d2, 166], [t.d3, 182],
  [t.t1, 240], [t.t2, 256], [t.t3, 272],
  [t.g1, 330], [t.g2, 346],
  [t.p1, 404],
];
---
<svg class="d-nota-simple" viewBox="0 0 800 520" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="ns-title ns-desc">
  <title id="ns-title">{t.title}</title>
  <desc id="ns-desc">{t.desc}</desc>
  <defs>
    <style>
      .d-nota-simple .bg { fill: #FBF6EC; }
      .d-nota-simple .doc { fill: #FFFFFF; stroke: #2A1F18; stroke-width: 1.5; }
      .d-nota-simple .band { fill: #F5EDD9; }
      .d-nota-simple .rule { stroke: #E5D4BD; stroke-width: 1; }
      .d-nota-simple .rule-ink { stroke: #2A1F18; stroke-width: 1; }
      .d-nota-simple .mast { font-family: 'Fraunces', serif; font-size: 11.5px; font-weight: 700; letter-spacing: 0.02em; fill: #2A1F18; text-anchor: middle; }
      .d-nota-simple .sub { font-family: 'Switzer', sans-serif; font-size: 10.5px; fill: #2A1F18; text-anchor: middle; }
      .d-nota-simple .head { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; fill: #2A1F18; }
      .d-nota-simple .mono { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; fill: #2A1F18; text-anchor: end; }
      .d-nota-simple .sec { font-family: 'Switzer', sans-serif; font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; fill: #5C4A3D; }
      .d-nota-simple .p { font-family: 'Switzer', sans-serif; font-size: 11px; fill: #2A1F18; }
      .d-nota-simple .foot { font-family: 'Switzer', sans-serif; font-size: 10.5px; font-style: italic; fill: #5C4A3D; }
      .d-nota-simple .lead { stroke: #9C3A1C; stroke-width: 1.2; fill: none; }
      .d-nota-simple .lead-dot { fill: #9C3A1C; }
      .d-nota-simple .call { font-family: 'Switzer', sans-serif; font-size: 12px; font-weight: 700; fill: #9C3A1C; }
      .d-nota-simple .call-note { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 500; fill: #5C4A3D; }
      .d-nota-simple .r { text-anchor: end; }
    </style>
  </defs>
  <rect class="bg" x="0" y="0" width="800" height="520"/>

  <!-- The note -->
  <rect class="doc" x="250" y="26" width="310" height="470" rx="4"/>
  <rect class="band" x="251" y="27" width="308" height="50"/>
  <text class="mast" x="405" y="48">{t.mast}</text>
  <text class="sub" x="405" y="66">{t.sub}</text>
  <line class="rule-ink" x1="251" y1="77" x2="559" y2="77"/>

  <text class="head" x="262" y="100">{t.finca}</text>
  <text class="mono" x="548" y="100">{t.cru}</text>
  <line class="rule" x1="251" y1="112" x2="559" y2="112"/>
  <line class="rule" x1="251" y1="202" x2="559" y2="202"/>
  <line class="rule" x1="251" y1="292" x2="559" y2="292"/>
  <line class="rule" x1="251" y1="366" x2="559" y2="366"/>

  {secciones.map(([txt, y]) => <text class="sec" x="262" y={y}>{txt}</text>)}
  {lineas.map(([txt, y]) => <text class="p" x="262" y={y}>{txt}</text>)}

  <line class="rule-ink" x1="262" y1="440" x2="548" y2="440"/>
  <text class="foot" x="262" y="460">{t.f1}</text>
  <text class="foot" x="262" y="475">{t.f2}</text>

  <!-- Call-outs on the left -->
  <path class="lead" d="M 250 44 H 226"/><circle class="lead-dot" cx="250" cy="44" r="3"/>
  <text class="call r" x="220" y="41">{t.cReg}</text>
  <text class="call-note r" x="220" y="57">{t.cRegN}</text>

  <path class="lead" d="M 250 148 H 226"/><circle class="lead-dot" cx="250" cy="148" r="3"/>
  <text class="call r" x="220" y="145">{t.cDes}</text>
  <text class="call-note r" x="220" y="161">{t.cDesN}</text>

  <path class="lead" d="M 250 236 H 226"/><circle class="lead-dot" cx="250" cy="236" r="3"/>
  <text class="call r" x="220" y="233">{t.cTit}</text>
  <text class="call-note r" x="220" y="249">{t.cTitN}</text>

  <path class="lead" d="M 250 334 H 226"/><circle class="lead-dot" cx="250" cy="334" r="3"/>
  <text class="call r" x="220" y="331">{t.cCar}</text>
  <text class="call-note r" x="220" y="347">{t.cCarN}</text>

  <path class="lead" d="M 250 462 H 226"/><circle class="lead-dot" cx="250" cy="462" r="3"/>
  <text class="call r" x="220" y="459">{t.cInf}</text>
  <text class="call-note r" x="220" y="475">{t.cInfN}</text>

  <!-- Call-outs on the right -->
  <path class="lead" d="M 560 62 H 584"/><circle class="lead-dot" cx="560" cy="62" r="3"/>
  <text class="call" x="590" y="59">{t.cFec}</text>
  <text class="call-note" x="590" y="75">{t.cFecN}</text>

  <path class="lead" d="M 560 96 V 112 H 584"/><circle class="lead-dot" cx="560" cy="96" r="3"/>
  <text class="call" x="590" y="109">{t.cNum}</text>
  <text class="call-note" x="590" y="125">{t.cNumN}</text>

  <path class="lead" d="M 560 178 H 584"/><circle class="lead-dot" cx="560" cy="178" r="3"/>
  <text class="call" x="590" y="175">{t.cCat}</text>
  <text class="call-note" x="590" y="191">{t.cCatN}</text>

  <path class="lead" d="M 560 264 H 584"/><circle class="lead-dot" cx="560" cy="264" r="3"/>
  <text class="call" x="590" y="261">{t.cIns}</text>
  <text class="call-note" x="590" y="277">{t.cInsN}</text>

  <path class="lead" d="M 560 400 H 584"/><circle class="lead-dot" cx="560" cy="400" r="3"/>
  <text class="call" x="590" y="397">{t.cPen}</text>
  <text class="call-note" x="590" y="413">{t.cPenN}</text>
</svg>
