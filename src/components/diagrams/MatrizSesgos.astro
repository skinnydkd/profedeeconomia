---
/**
 * 2x2 matrix of the four key cognitive biases covered in the unit, placed on
 * two axes: nature of the trap (mira al pasado / mira al futuro) and where it
 * acts (sobre los datos / sobre la valoración). Each cell names a bias and
 * gives a one-line definition.
 *
 * Used in FOPP 4ESO · Unit 4 (cómo tomamos decisiones).
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    cuatroSesgosCognitivosEn: 'Cuatro sesgos cognitivos en la toma de decisiones',
    matrizDeCuatroCasillas: 'Matriz de cuatro casillas con los sesgos de anclaje, confirmación, coste hundido y sesgo del presente, organizados según actúen sobre los datos o sobre la valoración y según miren al pasado o al futuro.',
    distorsionaLosDatos: 'Distorsiona los DATOS',
    distorsionaLaValoracion: 'Distorsiona la VALORACIÓN',
    miraAlPasado: 'Mira al PASADO',
    miraAlPresente: 'Mira al PRESENTE',
    ejemploLeesSoloLas: 'Ejemplo: lees solo las reseñas de 5 estrellas del móvil que ya quieres comprar. Es el sesgo que más alimentan las redes sociales con su «burbuja» de contenido afín.',
    sesgoSobreLaInformacion: 'Sesgo · sobre la información',
    confirmacion: 'Confirmación',
    soloBuscasDatosQue: 'Solo buscas datos que apoyan',
    loQueYaPensabas: 'lo que ya pensabas y filtras,',
    sinQuererLoQue: 'sin querer, lo que te contradice.',
    antidotoBuscaDosOpiniones: 'Antídoto: busca dos opiniones',
    contrariasAntesDeDecidir: 'contrarias antes de decidir.',
    ejemploAntes100Ahora: 'Ejemplo: «antes 100 €, ahora 60 €» te parece una ganga porque el 100 € es el ancla, aunque el producto valga 50 €. El comercio lo usa a diario en sus descuentos.',
    sesgoSobreLaCantidad: 'Sesgo · sobre la cantidad',
    anclaje: 'Anclaje',
    elPrimerNumeroQue: 'El primer número que ves se',
    quedaComoReferenciaAunque: 'queda como referencia, aunque',
    seaArbitrarioYNo: 'sea arbitrario y no tenga sentido.',
    antidotoCuantoPagariasTu: 'Antídoto: ¿cuánto pagarías tú',
    sinSaberEsePrecio: 'sin saber ese precio?',
    ejemploTerminasUnaPeli: 'Ejemplo: terminas una peli que no te gusta «porque ya he visto media hora». Ese tiempo está perdido igual; lo racional es decidir solo según lo que te queda por delante.',
    sesgoSobreElEsfuerzo: 'Sesgo · sobre el esfuerzo',
    costeHundido: 'Coste hundido',
    llevoMuchoTiempoNo: '«Llevo mucho tiempo, no puedo',
    dejarloLoYaGastado: 'dejarlo». Lo ya gastado no vuelve,',
    decidasLoQueDecidas: 'decidas lo que decidas hoy.',
    antidotoSiEmpezarasHoy: 'Antídoto: si empezaras hoy',
    desdeCeroLoElegirias: 'desde cero, ¿lo elegirías?',
    ejemploGastasLaPaga: 'Ejemplo: gastas la paga hoy en vez de ahorrar para algo mejor el mes que viene. Explica por qué cuesta tanto estudiar a tiempo o empezar a ahorrar pronto.',
    sesgoSobreElTiempo: 'Sesgo · sobre el tiempo',
    delPresente: 'Del presente',
    prefieresLoInmediato10: 'Prefieres lo inmediato (10 € hoy)',
    aunqueSalgaPeor15: 'aunque salga peor (15 € en un mes):',
    elCerebroInfravaloraEl: 'el cerebro infravalora el futuro.',
    antidotoHazVisibleAhora: 'Antídoto: haz visible ahora el',
    beneficioFuturoCalendarioMet: 'beneficio futuro (calendario, meta).',
    conocerlosNoLosElimina: 'Conocerlos no los elimina · sirve para detectarlos a tiempo',
  },
  ca: {
    cuatroSesgosCognitivosEn: 'Quatre biaixos cognitius en la presa de decisions',
    matrizDeCuatroCasillas: "Matriu de quatre caselles amb els biaixos d'ancoratge, confirmació, cost enfonsat i biaix del present, organitzats segons actuen sobre les dades o sobre la valoració i segons miren al passat o al futur.",
    distorsionaLosDatos: 'Distorsiona les DADES',
    distorsionaLaValoracion: 'Distorsiona la VALORACIÓ',
    miraAlPasado: 'Mira al PASSAT',
    miraAlPresente: 'Mira al PRESENT',
    ejemploLeesSoloLas: 'Exemple: llegixes només les ressenyes de 5 estreles del mòbil que ja vols comprar. És el biaix que més alimenten les xarxes socials amb la seua «bambolla» de contingut afí.',
    sesgoSobreLaInformacion: 'Biaix · sobre la informació',
    confirmacion: 'Confirmació',
    soloBuscasDatosQue: 'Només busques dades que recolzen',
    loQueYaPensabas: 'el que ja pensaves i filtres,',
    sinQuererLoQue: 'sense voler, el que et contradiu.',
    antidotoBuscaDosOpiniones: 'Antídot: busca dues opinions',
    contrariasAntesDeDecidir: 'contràries abans de decidir.',
    ejemploAntes100Ahora: "Exemple: «abans 100 €, ara 60 €» et pareix una ganga perquè el 100 € és l'àncora, encara que el producte valga 50 €. El comerç ho usa cada dia en els seus descomptes.",
    sesgoSobreLaCantidad: 'Biaix · sobre la quantitat',
    anclaje: 'Ancoratge',
    elPrimerNumeroQue: 'El primer número que veus es',
    quedaComoReferenciaAunque: 'queda com a referència, encara que',
    seaArbitrarioYNo: 'siga arbitrari i no tinga sentit.',
    antidotoCuantoPagariasTu: 'Antídot: quant pagaries tu',
    sinSaberEsePrecio: 'sense saber eixe preu?',
    ejemploTerminasUnaPeli: "Exemple: acabes una peli que no t'agrada «perquè ja n'he vist mitja hora». Eixe temps està perdut igualment; el racional és decidir només segons el que et queda per davant.",
    sesgoSobreElEsfuerzo: "Biaix · sobre l'esforç",
    costeHundido: 'Cost enfonsat',
    llevoMuchoTiempoNo: '«Fa molt de temps que hi estic, no puc',
    dejarloLoYaGastado: 'deixar-ho». El ja gastat no torna,',
    decidasLoQueDecidas: 'decidisques el que decidisques hui.',
    antidotoSiEmpezarasHoy: 'Antídot: si començares hui',
    desdeCeroLoElegirias: 'des de zero, ho triaries?',
    ejemploGastasLaPaga: "Exemple: gastes la paga hui en compte d'estalviar per a alguna cosa millor el mes que ve. Explica per què costa tant estudiar a temps o començar a estalviar prompte.",
    sesgoSobreElTiempo: 'Biaix · sobre el temps',
    delPresente: 'Del present',
    prefieresLoInmediato10: "Preferixes l'immediat (10 € hui)",
    aunqueSalgaPeor15: 'encara que isca pitjor (15 € en un mes):',
    elCerebroInfravaloraEl: 'el cervell infravalora el futur.',
    antidotoHazVisibleAhora: 'Antídot: fes visible ara el',
    beneficioFuturoCalendarioMet: 'benefici futur (calendari, meta).',
    conocerlosNoLosElimina: 'Conéixer-los no els elimina · servix per a detectar-los a temps',
  },
} as const;
const t = COPY[locale];
---
<svg class="d-matriz-sesgos" viewBox="0 0 820 620" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="sesgos-title sesgos-desc">
  <title id="sesgos-title">{t.cuatroSesgosCognitivosEn}</title>
  <desc id="sesgos-desc">{t.matrizDeCuatroCasillas}</desc>
  <defs>
    <style>
      .d-matriz-sesgos .bg { fill: #FBF6EC; }
      .d-matriz-sesgos .cell { stroke-width: 2; rx: 8; }
      .d-matriz-sesgos .cell-a { fill: #FBE3D6; stroke: #C44E2C; }
      .d-matriz-sesgos .cell-b { fill: #F5E5BC; stroke: #A87A2A; }
      .d-matriz-sesgos .cell-c { fill: #ECDCE5; stroke: #5B3A4E; }
      .d-matriz-sesgos .cell-d { fill: #DBEDED; stroke: #1F6E6E; }
      .d-matriz-sesgos .cell-tag { font-family: 'Switzer', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; }
      .d-matriz-sesgos .cell-title { font-family: 'Fraunces', serif; font-size: 19px; font-weight: 500; fill: #2A1F18; }
      .d-matriz-sesgos .cell-def { font-family: 'Switzer', sans-serif; font-size: 12px; fill: #5C4A3D; }
      .d-matriz-sesgos .axis-label { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; fill: #8A7868; text-anchor: middle; }
      .d-matriz-sesgos .has-tip { cursor: help; }
    </style>
  </defs>
  <rect class="bg" x="0" y="0" width="820" height="620"/>

  <!-- Column axis labels (top) -->
  <text class="axis-label" x="290" y="48">{t.distorsionaLosDatos}</text>
  <text class="axis-label" x="610" y="48">{t.distorsionaLaValoracion}</text>

  <!-- Row axis labels (left, rotated) -->
  <text class="axis-label" x="32" y="195" transform="rotate(-90 32 195)">{t.miraAlPasado}</text>
  <text class="axis-label" x="32" y="455" transform="rotate(-90 32 455)">{t.miraAlPresente}</text>

  <!-- Cell A: top-left -->
  <rect class="cell cell-a has-tip" x="80" y="70" width="340" height="220" rx="8"><title>{t.ejemploLeesSoloLas}</title></rect>
  <text class="cell-tag" x="102" y="100" fill="#9C3A1C">{t.sesgoSobreLaInformacion}</text>
  <text class="cell-title" x="102" y="128">{t.confirmacion}</text>
  <text class="cell-def" x="102" y="160">{t.soloBuscasDatosQue}</text>
  <text class="cell-def" x="102" y="178">{t.loQueYaPensabas}</text>
  <text class="cell-def" x="102" y="196">{t.sinQuererLoQue}</text>
  <text class="cell-def" x="102" y="232" font-style="italic" font-family="Fraunces, serif" fill="#9C3A1C">{t.antidotoBuscaDosOpiniones}</text>
  <text class="cell-def" x="102" y="250" font-style="italic" font-family="Fraunces, serif" fill="#9C3A1C">{t.contrariasAntesDeDecidir}</text>

  <!-- Cell B: top-right -->
  <rect class="cell cell-b has-tip" x="450" y="70" width="340" height="220" rx="8"><title>{t.ejemploAntes100Ahora}</title></rect>
  <text class="cell-tag" x="472" y="100" fill="#A87A2A">{t.sesgoSobreLaCantidad}</text>
  <text class="cell-title" x="472" y="128">{t.anclaje}</text>
  <text class="cell-def" x="472" y="160">{t.elPrimerNumeroQue}</text>
  <text class="cell-def" x="472" y="178">{t.quedaComoReferenciaAunque}</text>
  <text class="cell-def" x="472" y="196">{t.seaArbitrarioYNo}</text>
  <text class="cell-def" x="472" y="232" font-style="italic" font-family="Fraunces, serif" fill="#A87A2A">{t.antidotoCuantoPagariasTu}</text>
  <text class="cell-def" x="472" y="250" font-style="italic" font-family="Fraunces, serif" fill="#A87A2A">{t.sinSaberEsePrecio}</text>

  <!-- Cell C: bottom-left -->
  <rect class="cell cell-c has-tip" x="80" y="330" width="340" height="220" rx="8"><title>{t.ejemploTerminasUnaPeli}</title></rect>
  <text class="cell-tag" x="102" y="360" fill="#5B3A4E">{t.sesgoSobreElEsfuerzo}</text>
  <text class="cell-title" x="102" y="388">{t.costeHundido}</text>
  <text class="cell-def" x="102" y="420">{t.llevoMuchoTiempoNo}</text>
  <text class="cell-def" x="102" y="438">{t.dejarloLoYaGastado}</text>
  <text class="cell-def" x="102" y="456">{t.decidasLoQueDecidas}</text>
  <text class="cell-def" x="102" y="492" font-style="italic" font-family="Fraunces, serif" fill="#5B3A4E">{t.antidotoSiEmpezarasHoy}</text>
  <text class="cell-def" x="102" y="510" font-style="italic" font-family="Fraunces, serif" fill="#5B3A4E">{t.desdeCeroLoElegirias}</text>

  <!-- Cell D: bottom-right -->
  <rect class="cell cell-d has-tip" x="450" y="330" width="340" height="220" rx="8"><title>{t.ejemploGastasLaPaga}</title></rect>
  <text class="cell-tag" x="472" y="360" fill="#1F6E6E">{t.sesgoSobreElTiempo}</text>
  <text class="cell-title" x="472" y="388">{t.delPresente}</text>
  <text class="cell-def" x="472" y="420">{t.prefieresLoInmediato10}</text>
  <text class="cell-def" x="472" y="438">{t.aunqueSalgaPeor15}</text>
  <text class="cell-def" x="472" y="456">{t.elCerebroInfravaloraEl}</text>
  <text class="cell-def" x="472" y="492" font-style="italic" font-family="Fraunces, serif" fill="#1F6E6E">{t.antidotoHazVisibleAhora}</text>
  <text class="cell-def" x="472" y="510" font-style="italic" font-family="Fraunces, serif" fill="#1F6E6E">{t.beneficioFuturoCalendarioMet}</text>

  <!-- Footer note -->
  <text class="axis-label" x="435" y="595" fill="#8A7868">{t.conocerlosNoLosElimina}</text>
</svg>
