---
/**
 * Value Proposition Canvas de Osterwalder. A la izquierda, el cuadrado de
 * la propuesta de valor (productos y servicios, aliviadores de frustraciones
 * y creadores de alegrías). A la derecha, el círculo del perfil del cliente
 * (trabajos del cliente, frustraciones y alegrías). El encaje (fit) se da
 * cuando lo que ofrecemos responde a lo que el cliente necesita.
 *
 * Used in EDMN 2BACH · Unit 5 (diseño creativo de modelos de negocio).
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    valuePropositionCanvas: 'Value Proposition Canvas',
    elCuadradoDeLa: 'El cuadrado de la propuesta de valor recoge productos y servicios, aliviadores de frustraciones y creadores de alegrías. El círculo del perfil del cliente recoge sus trabajos, sus frustraciones y sus alegrías. Hay encaje cuando la propuesta responde al perfil.',
    propuestaDeValor: 'PROPUESTA DE VALOR',
    perfilDelCliente: 'PERFIL DEL CLIENTE',
    esLaParteQue: 'Es la parte que controla la empresa: lo que diseña y ofrece. Se rellena DESPUÉS del perfil del cliente, nunca al revés, para no enamorarse de un producto que nadie pide.',
    productosYServicios: 'Productos y servicios',
    loQueLaEmpresa: 'Lo que la empresa ofrece:',
    laListaDeProductos: 'la lista de productos y',
    serviciosEnLosQue: 'servicios en los que se apoya',
    laPropuestaDeValor: 'la propuesta de valor.',
    aliviadores: 'Aliviadores',
    comoElProducto: 'Cómo el producto',
    eliminaOReduce: 'elimina o reduce',
    aquelloQueMolesta: 'aquello que molesta',
    oFrenaAlCliente: 'o frena al cliente.',
    creadores: 'Creadores',
    comoElProducto2: 'Cómo el producto',
    generaBeneficiosY: 'genera beneficios y',
    resultadosQueEl: 'resultados que el',
    clienteDesea: 'cliente desea.',
    esLaParteQue2: 'Es la parte que la empresa NO controla: hay que investigarla observando y hablando con clientes reales. Es el punto de partida de todo el lienzo.',
    trabajosDelCliente: 'Trabajos del cliente',
    lasTareasQueIntenta: 'Las tareas que intenta',
    resolverFuncionales: 'resolver: funcionales,',
    socialesYEmocionales: 'sociales y emocionales.',
    frustraciones: 'Frustraciones',
    riesgosObstaculos: 'Riesgos, obstáculos',
    yMalosResultados: 'y malos resultados',
    queTeme: 'que teme.',
    alegrias: 'Alegrías',
    beneficiosQueEspera: 'Beneficios que espera,',
    deseaOLeSorprenden: 'desea o le sorprenden',
    gratamente: 'gratamente.',
    hayEncajeFitCuando: 'Hay encaje (fit) cuando los aliviadores y creadores responden a las frustraciones, alegrías y trabajos del cliente.',
  },
  ca: {
    valuePropositionCanvas: 'Value Proposition Canvas',
    elCuadradoDeLa: "El quadrat de la proposta de valor arreplega productes i serveis, alleujadors de frustracions i creadors d'alegries. El cercle del perfil del client arreplega les seues tasques, les seues frustracions i les seues alegries. Hi ha encaix quan la proposta respon al perfil.",
    propuestaDeValor: 'PROPOSTA DE VALOR',
    perfilDelCliente: 'PERFIL DEL CLIENT',
    esLaParteQue: "És la part que controla l'empresa: el que dissenya i oferix. S'ompli DESPRÉS del perfil del client, mai al revés, per a no enamorar-se d'un producte que ningú demana.",
    productosYServicios: 'Productes i serveis',
    loQueLaEmpresa: "El que oferix l'empresa:",
    laListaDeProductos: 'la llista de productes i',
    serviciosEnLosQue: 'serveis en què es recolza',
    laPropuestaDeValor: 'la proposta de valor.',
    aliviadores: 'Alleujadors',
    comoElProducto: 'Com el producte',
    eliminaOReduce: 'elimina o reduïx',
    aquelloQueMolesta: 'allò que molesta',
    oFrenaAlCliente: 'o frena el client.',
    creadores: 'Creadors',
    comoElProducto2: 'Com el producte',
    generaBeneficiosY: 'genera beneficis i',
    resultadosQueEl: 'resultats que el',
    clienteDesea: 'client desitja.',
    esLaParteQue2: "És la part que l'empresa NO controla: cal investigar-la observant i parlant amb clients reals. És el punt de partida de tot el llenç.",
    trabajosDelCliente: 'Tasques del client',
    lasTareasQueIntenta: 'Les tasques que intenta',
    resolverFuncionales: 'resoldre: funcionals,',
    socialesYEmocionales: 'socials i emocionals.',
    frustraciones: 'Frustracions',
    riesgosObstaculos: 'Riscos, obstacles',
    yMalosResultados: 'i mals resultats',
    queTeme: 'que tem.',
    alegrias: 'Alegries',
    beneficiosQueEspera: 'Beneficis que espera,',
    deseaOLeSorprenden: 'desitja o el sorprenen',
    gratamente: 'gratament.',
    hayEncajeFitCuando: 'Hi ha encaix (fit) quan els alleujadors i creadors responen a les frustracions, alegries i tasques del client.',
  },
} as const;
const t = COPY[locale];
---
<svg class="d-value-proposition-canvas" viewBox="0 0 900 480" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="vpc-title vpc-desc">
  <title id="vpc-title">{t.valuePropositionCanvas}</title>
  <desc id="vpc-desc">{t.elCuadradoDeLa}</desc>
  <defs>
    <style>
      .d-value-proposition-canvas .bg { fill: #FBF6EC; }
      .d-value-proposition-canvas .square { fill: #FBE3D6; stroke: #C44E2C; stroke-width: 2; }
      .d-value-proposition-canvas .circle-out { fill: #DBEDED; stroke: #1F6E6E; stroke-width: 2; }
      .d-value-proposition-canvas .seg { fill: none; stroke: #1F6E6E; stroke-width: 1.4; }
      .d-value-proposition-canvas .seg-square { fill: none; stroke: #C44E2C; stroke-width: 1.4; }
      .d-value-proposition-canvas .side-head { font-family: 'Switzer', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; text-anchor: middle; }
      .d-value-proposition-canvas .head-vp { fill: #9C3A1C; }
      .d-value-proposition-canvas .head-cust { fill: #0E4040; }
      .d-value-proposition-canvas .seg-title { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; fill: #2A1F18; }
      .d-value-proposition-canvas .seg-sub { font-family: 'Switzer', sans-serif; font-size: 9.5px; fill: #5C4A3D; }
      .d-value-proposition-canvas .fit { font-family: 'Fraunces', serif; font-style: italic; font-size: 13px; fill: #5C4A3D; text-anchor: middle; }
      .d-value-proposition-canvas .fit-arrow { stroke: #D4A24C; stroke-width: 2.5; fill: none; marker-end: url(#vpc-arrow); }
      .d-value-proposition-canvas .has-tip { cursor: help; }
    </style>
    <marker id="vpc-arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#D4A24C"/>
    </marker>
  </defs>
  <rect class="bg" x="0" y="0" width="900" height="480"/>

  <!-- Side headers -->
  <text class="side-head head-vp" x="225" y="40">{t.propuestaDeValor}</text>
  <text class="side-head head-cust" x="675" y="40">{t.perfilDelCliente}</text>

  <!-- LEFT: square divided. Square at x=60..390, y=70..400 (330x330). -->
  <!-- A square split by a diagonal so it interlocks with the circle visually. -->
  <rect class="square has-tip" x="60" y="70" width="330" height="330" rx="10"><title>{t.esLaParteQue}</title></rect>
  <!-- Internal divisions: top half (productos), bottom-left (aliviadores), bottom-right (creadores) -->
  <line class="seg-square" x1="60" y1="200" x2="390" y2="200"/>
  <line class="seg-square" x1="225" y1="200" x2="225" y2="400"/>

  <!-- Productos y servicios (top) -->
  <text class="seg-title" x="80" y="100">{t.productosYServicios}</text>
  <text class="seg-sub" x="80" y="120">{t.loQueLaEmpresa}</text>
  <text class="seg-sub" x="80" y="136">{t.laListaDeProductos}</text>
  <text class="seg-sub" x="80" y="152">{t.serviciosEnLosQue}</text>
  <text class="seg-sub" x="80" y="168">{t.laPropuestaDeValor}</text>

  <!-- Aliviadores de frustraciones (bottom-left) -->
  <text class="seg-title" x="80" y="226">{t.aliviadores}</text>
  <text class="seg-sub" x="80" y="244">{t.comoElProducto}</text>
  <text class="seg-sub" x="80" y="260">{t.eliminaOReduce}</text>
  <text class="seg-sub" x="80" y="276">{t.aquelloQueMolesta}</text>
  <text class="seg-sub" x="80" y="292">{t.oFrenaAlCliente}</text>

  <!-- Creadores de alegrías (bottom-right) -->
  <text class="seg-title" x="245" y="226">{t.creadores}</text>
  <text class="seg-sub" x="245" y="244">{t.comoElProducto2}</text>
  <text class="seg-sub" x="245" y="260">{t.generaBeneficiosY}</text>
  <text class="seg-sub" x="245" y="276">{t.resultadosQueEl}</text>
  <text class="seg-sub" x="245" y="292">{t.clienteDesea}</text>

  <!-- RIGHT: circle. Center (675, 235), r 165. -->
  <circle class="circle-out has-tip" cx="675" cy="235" r="165"><title>{t.esLaParteQue2}</title></circle>
  <!-- Divisions: vertical line splitting right circle, and a horizontal on the left part -->
  <line class="seg" x1="675" y1="70" x2="675" y2="400"/>
  <line class="seg" x1="510" y1="235" x2="675" y2="235"/>

  <!-- Trabajos del cliente (right half) -->
  <text class="seg-title" x="695" y="180">{t.trabajosDelCliente}</text>
  <text class="seg-sub" x="695" y="200">{t.lasTareasQueIntenta}</text>
  <text class="seg-sub" x="695" y="216">{t.resolverFuncionales}</text>
  <text class="seg-sub" x="695" y="232">{t.socialesYEmocionales}</text>

  <!-- Frustraciones (left-top) -->
  <text class="seg-title" x="540" y="150">{t.frustraciones}</text>
  <text class="seg-sub" x="540" y="170">{t.riesgosObstaculos}</text>
  <text class="seg-sub" x="540" y="186">{t.yMalosResultados}</text>
  <text class="seg-sub" x="540" y="202">{t.queTeme}</text>

  <!-- Alegrías (left-bottom) -->
  <text class="seg-title" x="540" y="290">{t.alegrias}</text>
  <text class="seg-sub" x="540" y="310">{t.beneficiosQueEspera}</text>
  <text class="seg-sub" x="540" y="326">{t.deseaOLeSorprenden}</text>
  <text class="seg-sub" x="540" y="342">{t.gratamente}</text>

  <!-- Fit arrows between square and circle -->
  <path class="fit-arrow" d="M 395 200 H 470"/>
  <path class="fit-arrow" d="M 505 270 H 430" />

  <!-- Footnote -->
  <text class="fit" x="450" y="445">{t.hayEncajeFitCuando}</text>
</svg>
