---
/**
 * Visual map of the six blocks of the FOPP 4ESO book.
 * 3x2 grid of cards with roman numeral, title, color-coded
 * by thematic register, and a one-line description each.
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    losSeisBloquesDel: 'Los seis bloques del libro de FOPP 4.º ESO',
    losSeisBloquesDel2: 'Los seis bloques del libro',
    mapaVisualDeLos: 'Mapa visual de los seis bloques del libro de Formación y Orientación Personal y Profesional: del autoconocimiento a la inserción laboral.',
    deDentroHaciaFuera: 'De dentro hacia fuera: del yo al mundo laboral',
    bloqueA: 'BLOQUE A',
    conocete: 'Conócete',
    identidadEmociones: 'Identidad, emociones,',
    autoestimaYSaludMental: 'autoestima y salud mental.',
    unidades1Y2: 'Unidades 1 y 2',
    bloqueB: 'BLOQUE B',
    tuEntorno: 'Tu entorno',
    familiaAmistadesRedes: 'Familia, amistades, redes',
    yHuellaDigital: 'y huella digital.',
    unidad3: 'Unidad 3',
    bloqueC: 'BLOQUE C',
    decisiones: 'Decisiones',
    comoElegirBienMetodo: 'Cómo elegir bien: método,',
    sesgosYOpciones: 'sesgos y opciones.',
    unidad4: 'Unidad 4',
    bloqueD: 'BLOQUE D',
    itinerarios: 'Itinerarios',
    sistemaEducativoFp: 'Sistema educativo, FP,',
    universidadYBecas: 'universidad y becas.',
    unidades5Y6: 'Unidades 5 y 6',
    bloqueE: 'BLOQUE E',
    mundoLaboral: 'Mundo laboral',
    mercadoLaboralContratos: 'Mercado laboral, contratos',
    yDerechos: 'y derechos.',
    unidades7Y8: 'Unidades 7 y 8',
    bloqueF: 'BLOQUE F',
    buscarEmpleo: 'Buscar empleo',
    cvMarcaPersonalY: 'CV, marca personal y',
    proyectoDeVida: 'proyecto de vida.',
    unidades9Y10: 'Unidades 9 y 10',
    delAutoconocimientoYoA: 'Del autoconocimiento (yo) a la inserción laboral (proyecto)',
  },
  ca: {
    losSeisBloquesDel: 'Els sis blocs del llibre de FOPP 4t ESO',
    losSeisBloquesDel2: 'Els sis blocs del llibre',
    mapaVisualDeLos: "Mapa visual dels sis blocs del llibre de Formació i Orientació Personal i Professional: de l'autoconeixement a la inserció laboral.",
    deDentroHaciaFuera: 'De dins cap a fora: del jo al món laboral',
    bloqueA: 'BLOC A',
    conocete: 'Coneix-te',
    identidadEmociones: 'Identitat, emocions,',
    autoestimaYSaludMental: 'autoestima i salut mental.',
    unidades1Y2: 'Unitats 1 i 2',
    bloqueB: 'BLOC B',
    tuEntorno: 'El teu entorn',
    familiaAmistadesRedes: 'Família, amistats, xarxes',
    yHuellaDigital: 'i empremta digital.',
    unidad3: 'Unitat 3',
    bloqueC: 'BLOC C',
    decisiones: 'Decisions',
    comoElegirBienMetodo: 'Com triar bé: mètode,',
    sesgosYOpciones: 'biaixos i opcions.',
    unidad4: 'Unitat 4',
    bloqueD: 'BLOC D',
    itinerarios: 'Itineraris',
    sistemaEducativoFp: 'Sistema educatiu, FP,',
    universidadYBecas: 'universitat i beques.',
    unidades5Y6: 'Unitats 5 i 6',
    bloqueE: 'BLOC E',
    mundoLaboral: 'Món laboral',
    mercadoLaboralContratos: 'Mercat laboral, contractes',
    yDerechos: 'i drets.',
    unidades7Y8: 'Unitats 7 i 8',
    bloqueF: 'BLOC F',
    buscarEmpleo: 'Buscar faena',
    cvMarcaPersonalY: 'CV, marca personal i',
    proyectoDeVida: 'projecte de vida.',
    unidades9Y10: 'Unitats 9 i 10',
    delAutoconocimientoYoA: "De l'autoconeixement (jo) a la inserció laboral (projecte)",
  },
} as const;
const t = COPY[locale];
---
<svg viewBox="0 0 820 520" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={t.losSeisBloquesDel}>
  <title>{t.losSeisBloquesDel2}</title>
  <desc>{t.mapaVisualDeLos}</desc>
  <defs>
    <style>
      .bg { fill: #FBF6EC; }
      .card { stroke-width: 2; }
      .card-a { fill: #FBE3D6; stroke: #C44E2C; }
      .card-b { fill: #F5E5BC; stroke: #D4A24C; }
      .card-c { fill: #DBEDED; stroke: #1F6E6E; }
      .card-d { fill: #ECDCE5; stroke: #5B3A4E; }
      .card-e { fill: #F5DDD0; stroke: #9C3A1C; }
      .card-f { fill: #F0DDB8; stroke: #A87A2A; }
      .roman { font-family: 'Fraunces', serif; font-style: italic; font-size: 48px; font-weight: 500; text-anchor: middle; }
      .roman-a { fill: #9C3A1C; }
      .roman-b { fill: #A87A2A; }
      .roman-c { fill: #0E4040; }
      .roman-d { fill: #4A2B3F; }
      .roman-e { fill: #6B1E08; }
      .roman-f { fill: #8A5E18; }
      .block-eyebrow { font-family: 'Switzer', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; fill: #5C4A3D; }
      .block-title { font-family: 'Fraunces', serif; font-size: 17px; font-weight: 500; fill: #2A1F18; }
      .block-desc { font-family: 'Switzer', sans-serif; font-size: 11px; fill: #5C4A3D; }
      .arrow-flow { fill: none; stroke: #C44E2C; stroke-width: 1.5; stroke-dasharray: 4 3; marker-end: url(#flow-arrow); }
      .flow-label { font-family: 'Fraunces', serif; font-style: italic; font-size: 11px; fill: #C44E2C; text-anchor: middle; }
    </style>
    <marker id="flow-arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#C44E2C"/>
    </marker>
  </defs>
  <rect class="bg" x="0" y="0" width="820" height="520"/>

  <!-- Top label -->
  <text class="flow-label" x="410" y="30" font-size="13">{t.deDentroHaciaFuera}</text>

  <!-- Row 1: Bloques A, B, C -->
  <!-- Bloque A: Conócete -->
  <g>
    <rect class="card card-a" x="40" y="60" width="240" height="180" rx="8"/>
    <text class="roman roman-a" x="80" y="115">I</text>
    <text class="block-eyebrow" x="120" y="92">{t.bloqueA}</text>
    <text class="block-title" x="120" y="115">{t.conocete}</text>
    <text class="block-desc" x="60" y="160">{t.identidadEmociones}</text>
    <text class="block-desc" x="60" y="176">{t.autoestimaYSaludMental}</text>
    <text class="block-desc" x="60" y="208" font-style="italic" fill="#9C3A1C">{t.unidades1Y2}</text>
  </g>

  <!-- Bloque B: Tu entorno -->
  <g>
    <rect class="card card-b" x="290" y="60" width="240" height="180" rx="8"/>
    <text class="roman roman-b" x="330" y="115">II</text>
    <text class="block-eyebrow" x="375" y="92">{t.bloqueB}</text>
    <text class="block-title" x="375" y="115">{t.tuEntorno}</text>
    <text class="block-desc" x="310" y="160">{t.familiaAmistadesRedes}</text>
    <text class="block-desc" x="310" y="176">{t.yHuellaDigital}</text>
    <text class="block-desc" x="310" y="208" font-style="italic" fill="#A87A2A">{t.unidad3}</text>
  </g>

  <!-- Bloque C: Decisiones -->
  <g>
    <rect class="card card-c" x="540" y="60" width="240" height="180" rx="8"/>
    <text class="roman roman-c" x="580" y="115">III</text>
    <text class="block-eyebrow" x="635" y="92">{t.bloqueC}</text>
    <text class="block-title" x="635" y="115">{t.decisiones}</text>
    <text class="block-desc" x="560" y="160">{t.comoElegirBienMetodo}</text>
    <text class="block-desc" x="560" y="176">{t.sesgosYOpciones}</text>
    <text class="block-desc" x="560" y="208" font-style="italic" fill="#0E4040">{t.unidad4}</text>
  </g>

  <!-- Arrow row 1 → row 2 (central) -->
  <line class="arrow-flow" x1="410" y1="250" x2="410" y2="280"/>

  <!-- Row 2: Bloques D, E, F -->
  <!-- Bloque D: Itinerarios -->
  <g>
    <rect class="card card-d" x="40" y="290" width="240" height="180" rx="8"/>
    <text class="roman roman-d" x="80" y="345">IV</text>
    <text class="block-eyebrow" x="130" y="322">{t.bloqueD}</text>
    <text class="block-title" x="130" y="345">{t.itinerarios}</text>
    <text class="block-desc" x="60" y="390">{t.sistemaEducativoFp}</text>
    <text class="block-desc" x="60" y="406">{t.universidadYBecas}</text>
    <text class="block-desc" x="60" y="438" font-style="italic" fill="#4A2B3F">{t.unidades5Y6}</text>
  </g>

  <!-- Bloque E: Mundo laboral -->
  <g>
    <rect class="card card-e" x="290" y="290" width="240" height="180" rx="8"/>
    <text class="roman roman-e" x="330" y="345">V</text>
    <text class="block-eyebrow" x="375" y="322">{t.bloqueE}</text>
    <text class="block-title" x="375" y="345">{t.mundoLaboral}</text>
    <text class="block-desc" x="310" y="390">{t.mercadoLaboralContratos}</text>
    <text class="block-desc" x="310" y="406">{t.yDerechos}</text>
    <text class="block-desc" x="310" y="438" font-style="italic" fill="#6B1E08">{t.unidades7Y8}</text>
  </g>

  <!-- Bloque F: Buscar empleo -->
  <g>
    <rect class="card card-f" x="540" y="290" width="240" height="180" rx="8"/>
    <text class="roman roman-f" x="580" y="345">VI</text>
    <text class="block-eyebrow" x="625" y="322">{t.bloqueF}</text>
    <text class="block-title" x="625" y="345">{t.buscarEmpleo}</text>
    <text class="block-desc" x="560" y="390">{t.cvMarcaPersonalY}</text>
    <text class="block-desc" x="560" y="406">{t.proyectoDeVida}</text>
    <text class="block-desc" x="560" y="438" font-style="italic" fill="#8A5E18">{t.unidades9Y10}</text>
  </g>

  <!-- Footer arrow flow -->
  <path class="arrow-flow" d="M 160 480 L 660 480"/>
  <text class="flow-label" x="410" y="505">{t.delAutoconocimientoYoA}</text>
</svg>
