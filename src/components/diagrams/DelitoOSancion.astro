    dejaRastro: 'Deixa rastre?',
    antecedentesPenales: 'Antecedents penals',
    cancelablesPasadoUnPlazo: 'Cancel·lables passat un termini',
    registroAdministrativo: 'Registre administratiu',
    noSonAntecedentesPenales: 'No són antecedents penals',
