    queAdemasEsParteInteresada: 'Que a més és part interessada',
    queTePuedePasar: 'Què et pot passar?',
    prisionMultaPenal: 'Presó, multa penal,',
    trabajosComunitariosInhabili: 'treballs comunitaris, inhabilitació',
    multaPuntosCierreLicencia: 'Multa, punts, tancament, llicència',
