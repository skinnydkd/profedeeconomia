    quienDecide: '¿Quién decide?',
    unJuezOTribunal: 'Un juez o tribunal',
    independienteYAjenoAlConflic: 'Independiente y ajeno al conflicto',
    laPropiaAdministracion: 'La propia Administración',
    queAdemasEsParteInteresada: 'Que además es parte interesada',
    queTePuedePasar: '¿Qué te puede pasar?',
    prisionMultaPenal: 'Prisión, multa penal,',
    trabajosComunitariosInhabili: 'trabajos comunitarios, inhabilitación',
    multaPuntosCierreLicencia: 'Multa, puntos, cierre, licencia',
    nuncaPrisionLoProhibeLaConst: 'Nunca prisión: lo prohíbe la Constitución',
    queGarantiasTienes: '¿Qué garantías tienes?',
    abogadoObligatorioJuicioPubl: 'Abogado obligatorio, juicio público',
    presuncionDeInocenciaDudaAFa: 'Presunción de inocencia · duda a favor',
    expedienteConAudienciaPrevia: 'Expediente con audiencia previa',
    presuncionDeInocenciaYMotiva: 'Presunción de inocencia y motivación',
    comoSeRecurre: '¿Cómo se recurre?',
    recursoAnteUnTribunalSuperio: 'Recurso ante un tribunal superior',
    dentroDelPropioOrdenPenal: 'Dentro del propio orden penal',
    primeroAnteLaAdministracion: 'Primero ante la Administración',
    despuesViaContenciosoAdminis: 'Después, vía contencioso-administrativa',
    dejaRastro: '¿Deja rastro?',
    antecedentesPenales: 'Antecedentes penales',
    cancelablesPasadoUnPlazo: 'Cancelables pasado un plazo',
    registroAdministrativo: 'Registro administrativo',
    noSonAntecedentesPenales: 'No son antecedentes penales',
    laReglaQueConectaLasDosColum: 'La regla que conecta las dos columnas: nadie puede ser castigado dos veces por lo mismo.',
    siUnMismoHechoPodriaSerDelit: 'Si un mismo hecho podría ser delito e infracción con idéntico fundamento, el expediente administrativo',
    seParalizaYSePasaElTantoDeCu: 'se paraliza y se pasa el tanto de culpa al juez penal. Solo si este archiva, la Administración continúa.',
    elOrdenPenalTienePreferencia: 'El orden penal tiene preferencia, y sus hechos probados vinculan después a la Administración.',
  },
  ca: {
    comparacionEntreLaViaPenalYL: "Comparació entre la via penal i la via administrativa. En la penal decidix un jutge aplicant el Codi Penal, s'hi pot imposar presó i queden antecedents penals. En l'administrativa decidix la mateixa Administració aplicant una llei sectorial, mai no s'hi pot imposar presó i es recorre primer davant de la mateixa Administració i després davant dels tribunals contenciosos administratius. Ningú no pot ser castigat dues vegades pel mateix fet amb el mateix fonament.",
