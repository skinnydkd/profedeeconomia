---
/**
 * Criminal offence versus administrative infringement (CJD Bach, unit 7).
 *
 * Students use "me han multado" and "me han denunciado" interchangeably and
 * assume both end before a judge. The comparison is laid out row by row
 * because the difference is not the seriousness of the act but who decides,
 * what can be imposed, and which guarantees apply. The note carries the rule
 * that ties the two columns together: ne bis in idem, and the administrative
 * file halting when a crime appears.
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
