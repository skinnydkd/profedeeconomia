const t = COPY[locale];
---

<svg viewBox="0 0 820 560" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="delitoosancion-t delitoosancion-d">
  <title id="delitoosancion-t">{t.elMismoHechoDosPuertasDistin}</title>
  <desc id="delitoosancion-d">{t.comparacionEntreLaViaPenalYL}</desc>
  <defs>
    <style>
      .bg { fill: #FBF6EC; }
      .head-pen { fill: #F1DADD; stroke: #8C2F39; stroke-width: 2; }
      .head-adm { fill: #DBEDED; stroke: #1F6E6E; stroke-width: 2; }
      .cell-pen { fill: #FFFFFF; stroke: #8C2F39; stroke-width: 1.4; }
      .cell-adm { fill: #FFFFFF; stroke: #1F6E6E; stroke-width: 1.4; }
      .head-t { font-family: 'Fraunces', serif; font-size: 18px; font-weight: 500; fill: #2A1F18; text-anchor: middle; }
      .head-s { font-family: 'Switzer', sans-serif; font-size: 9.5px; font-style: italic; fill: #5C4A3D; text-anchor: middle; }
      .q { font-family: 'Fraunces', serif; font-style: italic; font-size: 14px; fill: #2A1F18; }
      .txt { font-family: 'Switzer', sans-serif; font-size: 10.5px; fill: #5C4A3D; }
      .txt-b { font-family: 'Switzer', sans-serif; font-size: 10.5px; font-weight: 700; fill: #2A1F18; }
      .note { fill: #FFFFFF; stroke: #8A7868; stroke-width: 1.6; stroke-dasharray: 5 3; }
      .note-b { font-family: 'Switzer', sans-serif; font-size: 10.5px; font-weight: 700; fill: #2A1F18; }
      .note-t { font-family: 'Switzer', sans-serif; font-size: 10.5px; fill: #5C4A3D; }
      .band { font-family: 'Switzer', sans-serif; font-size: 9px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase; fill: #8A7868; }
    </style>
  </defs>

  <rect class="bg" x="0" y="0" width="820" height="560" />

  <text class="band" x="40" y="30">{t.dosRegimenesSancionadoresNoU}</text>

  <!-- Headers -->
  <rect class="head-pen" x="216" y="46" width="276" height="52" rx="4" />
  <text class="head-t" x="354" y="72">{t.viaPenal}</text>
  <text class="head-s" x="354" y="88">{t.delitosCodigoPenal}</text>

  <rect class="head-adm" x="504" y="46" width="276" height="52" rx="4" />
  <text class="head-t" x="642" y="72">{t.viaAdministrativa}</text>
  <text class="head-s" x="642" y="88">{t.infraccionesLeyesSectoriales}</text>

  <!-- Row 1: who decides -->
  <text class="q" x="40" y="138">{t.quienDecide}</text>
  <rect class="cell-pen" x="216" y="112" width="276" height="52" rx="4" />
  <text class="txt-b" x="234" y="134">{t.unJuezOTribunal}</text>
  <text class="txt" x="234" y="152">{t.independienteYAjenoAlConflic}</text>
  <rect class="cell-adm" x="504" y="112" width="276" height="52" rx="4" />
  <text class="txt-b" x="522" y="134">{t.laPropiaAdministracion}</text>
  <text class="txt" x="522" y="152">{t.queAdemasEsParteInteresada}</text>

  <!-- Row 2: what can happen -->
  <text class="q" x="40" y="206">{t.queTePuedePasar}</text>
  <rect class="cell-pen" x="216" y="180" width="276" height="52" rx="4" />
  <text class="txt-b" x="234" y="202">{t.prisionMultaPenal}</text>
  <text class="txt" x="234" y="220">{t.trabajosComunitariosInhabili}</text>
  <rect class="cell-adm" x="504" y="180" width="276" height="52" rx="4" />
  <text class="txt-b" x="522" y="202">{t.multaPuntosCierreLicencia}</text>
  <text class="txt" x="522" y="220">{t.nuncaPrisionLoProhibeLaConst}</text>

  <!-- Row 3: guarantees -->
  <text class="q" x="40" y="274">{t.queGarantiasTienes}</text>
  <rect class="cell-pen" x="216" y="248" width="276" height="52" rx="4" />
  <text class="txt-b" x="234" y="270">{t.abogadoObligatorioJuicioPubl}</text>
  <text class="txt" x="234" y="288">{t.presuncionDeInocenciaDudaAFa}</text>
  <rect class="cell-adm" x="504" y="248" width="276" height="52" rx="4" />
  <text class="txt-b" x="522" y="270">{t.expedienteConAudienciaPrevia}</text>
  <text class="txt" x="522" y="288">{t.presuncionDeInocenciaYMotiva}</text>

  <!-- Row 4: how to appeal -->
  <text class="q" x="40" y="342">{t.comoSeRecurre}</text>
  <rect class="cell-pen" x="216" y="316" width="276" height="52" rx="4" />
  <text class="txt-b" x="234" y="338">{t.recursoAnteUnTribunalSuperio}</text>
  <text class="txt" x="234" y="356">{t.dentroDelPropioOrdenPenal}</text>
  <rect class="cell-adm" x="504" y="316" width="276" height="52" rx="4" />
  <text class="txt-b" x="522" y="338">{t.primeroAnteLaAdministracion}</text>
  <text class="txt" x="522" y="356">{t.despuesViaContenciosoAdminis}</text>

  <!-- Row 5: trace -->
  <text class="q" x="40" y="410">{t.dejaRastro}</text>
  <rect class="cell-pen" x="216" y="384" width="276" height="52" rx="4" />
  <text class="txt-b" x="234" y="406">{t.antecedentesPenales}</text>
  <text class="txt" x="234" y="424">{t.cancelablesPasadoUnPlazo}</text>
  <rect class="cell-adm" x="504" y="384" width="276" height="52" rx="4" />
  <text class="txt-b" x="522" y="406">{t.registroAdministrativo}</text>
  <text class="txt" x="522" y="424">{t.noSonAntecedentesPenales}</text>

  <!-- Note -->
  <rect class="note" x="40" y="456" width="740" height="86" rx="4" />
  <text class="note-b" x="60" y="482">{t.laReglaQueConectaLasDosColum}</text>
  <text class="note-t" x="60" y="502">{t.siUnMismoHechoPodriaSerDelit}</text>
  <text class="note-t" x="60" y="518">{t.seParalizaYSePasaElTantoDeCu}</text>
  <text class="note-t" x="60" y="534">{t.elOrdenPenalTienePreferencia}</text>
</svg>
