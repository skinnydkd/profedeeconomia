---
/**
 * The three roles in school bullying arranged as a triangle: the one who
 * bullies (top), the one who suffers it (bottom-left) and the one who
 * watches (bottom-right). A highlighted center box stresses that the
 * observer is the turning point: silence sustains the bullying, while
 * speaking up or telling an adult can stop it.
 *
 * Used in FOPP 4ESO (convivencia y trabajo en equipo). Sensitive,
 * empowering framing — not graphic.
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    elTrianguloDelAcoso: 'El triángulo del acoso escolar',
    elAcosoTieneTres: 'El acoso tiene tres papeles: quien acosa, quien lo sufre y quien observa. El observador es la clave: su silencio sostiene el acoso y su intervención puede frenarlo.',
    elObservadorTieneLa: 'El observador tiene la llave',
    elSilencioSostieneEl: 'El silencio sostiene el acoso;',
    intervenirOAvisarLo: 'intervenir o avisar lo frena.',
    quienAcosa: 'Quien acosa',
    elAgresor: 'El agresor',
    ejerceElDanoBusca: 'ejerce el daño, busca poder o aprobación del grupo',
    quienLoSufre: 'Quien lo sufre',
    laVictima: 'La víctima',
    recibeElAcosoSe: 'recibe el acoso, se siente sola y atrapada',
    quienObserva: 'Quien observa',
    elTestigo: 'El testigo',
    veLoQuePasa: 've lo que pasa — y su reacción lo cambia todo',
  },
  ca: {
    elTrianguloDelAcoso: "El triangle de l'assetjament escolar",
    elAcosoTieneTres: "L'assetjament té tres papers: qui assetja, qui el patix i qui l'observa. L'observador és la clau: el seu silenci sosté l'assetjament i la seua intervenció el pot frenar.",
    elObservadorTieneLa: "L'observador té la clau",
    elSilencioSostieneEl: "El silenci sosté l'assetjament;",
    intervenirOAvisarLo: 'intervindre o avisar el frena.',
    quienAcosa: 'Qui assetja',
    elAgresor: "L'agressor",
    ejerceElDanoBusca: 'exercix el dany, busca poder o aprovació del grup',
    quienLoSufre: 'Qui el patix',
    laVictima: 'La víctima',
    recibeElAcosoSe: "rep l'assetjament, se sent sola i atrapada",
    quienObserva: 'Qui observa',
    elTestigo: 'El testimoni',
    veLoQuePasa: 'veu el que passa — i la seua reacció ho canvia tot',
  },
} as const;
const t = COPY[locale];
---
<svg class="d-trianglo-bullying" viewBox="0 0 820 600" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="tb-title tb-desc">
  <title id="tb-title">{t.elTrianguloDelAcoso}</title>
  <desc id="tb-desc">{t.elAcosoTieneTres}</desc>
  <defs>
    <style>
      .d-trianglo-bullying .bg { fill: #FBF6EC; }
      .d-trianglo-bullying .tri { fill: none; stroke: #E5D4BD; stroke-width: 2; stroke-dasharray: 6 6; }
      .d-trianglo-bullying .node { stroke-width: 2; }
      .d-trianglo-bullying .node-agresor { fill: #FBE3D6; stroke: #9C3A1C; }
      .d-trianglo-bullying .node-victima { fill: #F5E5BC; stroke: #A87A2A; }
      .d-trianglo-bullying .node-observador { fill: #DBEDED; stroke: #1F6E6E; }
      .d-trianglo-bullying .role { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; text-anchor: middle; }
      .d-trianglo-bullying .role-agresor { fill: #9C3A1C; }
      .d-trianglo-bullying .role-victima { fill: #A87A2A; }
      .d-trianglo-bullying .role-observador { fill: #1F6E6E; }
      .d-trianglo-bullying .name { font-family: 'Fraunces', serif; font-style: italic; font-size: 24px; font-weight: 500; fill: #2A1F18; text-anchor: middle; }
      .d-trianglo-bullying .descr { font-family: 'Switzer', sans-serif; font-size: 13.5px; font-weight: 400; fill: #5C4A3D; text-anchor: middle; }
      .d-trianglo-bullying .key-box { fill: #FFFFFF; stroke: #1F6E6E; stroke-width: 2; }
      .d-trianglo-bullying .key-eyebrow { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; fill: #1F6E6E; text-anchor: middle; }
      .d-trianglo-bullying .key-text { font-family: 'Fraunces', serif; font-style: italic; font-size: 16px; font-weight: 500; fill: #2A1F18; text-anchor: middle; }
      .d-trianglo-bullying .key-arrow { fill: none; stroke: #1F6E6E; stroke-width: 2.5; }
    </style>
  </defs>
  <rect class="bg" x="0" y="0" width="820" height="600"/>

  <!-- Triangle skeleton: apex (410,110), bottom-left (160,470), bottom-right (660,470) -->
  <polygon class="tri" points="410,150 200,455 620,455"/>

  <!-- Center key box, pointing to the observer (bottom-right) -->
  <!-- Arrow from key box toward observer node -->
  <path class="key-arrow" d="M 520 380 L 600 432" marker-end="url(#tb-arrow)"/>
  <defs>
    <marker id="tb-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#1F6E6E"/>
    </marker>
  </defs>

  <rect class="key-box" x="250" y="300" width="320" height="92" rx="10"/>
  <text class="key-eyebrow" x="410" y="324">{t.elObservadorTieneLa}</text>
  <text class="key-text" x="410" y="350">{t.elSilencioSostieneEl}</text>
  <text class="key-text" x="410" y="372">{t.intervenirOAvisarLo}</text>

  <!-- Top vertex: Quien acosa (agresor) -->
  <g>
    <rect class="node node-agresor" x="245" y="40" width="330" height="92" rx="12"/>
    <text class="role role-agresor" x="410" y="64">{t.quienAcosa}</text>
    <text class="name" x="410" y="94">{t.elAgresor}</text>
    <text class="descr" x="410" y="118">{t.ejerceElDanoBusca}</text>
  </g>

  <!-- Bottom-left vertex: Quien lo sufre (víctima) -->
  <g>
    <rect class="node node-victima" x="20" y="470" width="335" height="92" rx="12"/>
    <text class="role role-victima" x="187" y="494">{t.quienLoSufre}</text>
    <text class="name" x="187" y="524">{t.laVictima}</text>
    <text class="descr" x="187" y="548">{t.recibeElAcosoSe}</text>
  </g>

  <!-- Bottom-right vertex: Quien observa (observador) -->
  <g>
    <rect class="node node-observador" x="465" y="470" width="335" height="92" rx="12"/>
    <text class="role role-observador" x="632" y="494">{t.quienObserva}</text>
    <text class="name" x="632" y="524">{t.elTestigo}</text>
    <text class="descr" x="632" y="548">{t.veLoQuePasa}</text>
  </g>
</svg>
