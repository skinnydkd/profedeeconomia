---
/**
 * Vertical flowchart of the Spanish post-ESO educational system,
 * showing the three main branches (Bachillerato, FP Grado Medio,
 * FP Grado Básico) and their bridges (EBAU, pruebas de acceso)
 * up to Universidad / FP Grado Superior / mundo laboral.
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    itinerariosFormativosDelSist: 'Itinerarios formativos del sistema educativo español tras 4.º ESO',
    sistemaEducativoEspanolTras: 'Sistema educativo español tras 4.º ESO',
    diagramaDeTransicionesDesde: 'Diagrama de transiciones desde 4.º ESO hacia Bachillerato, FP Grado Medio y FP Grado Básico, con las pasarelas hacia FP Grado Superior, Universidad y mundo laboral.',
    puntoDePartida: 'PUNTO DE PARTIDA',
    k4OEso: '4.º ESO',
    bachillerato: 'Bachillerato',
    k2Cursos1618: '2 cursos · 16-18 años',
    ciencias: 'Ciencias',
    yTecno: 'y Tecno.',
    humanid: 'Humanid.',
    yCcSs: 'y CC.SS.',
    artes: 'Artes /',
    general: 'General',
    fpGradoMedio: 'FP Grado Medio',
    k2CursosTecnico: '2 cursos · técnico',
    profesional: 'profesional',
    fpGradoBasico: 'FP Grado Básico',
    alternativa1517Anos: 'Alternativa 15-17 años',
    sinGraduadoEnEso: 'sin Graduado en ESO',
    titulaAcceso: 'titula → acceso',
    viaEbau: 'vía EBAU',
    accesoDirecto: 'acceso directo',
    pruebaAcceso: 'prueba acceso',
    universidad: 'Universidad',
    grados34Anos: 'Grados · 3-4 años',
    masteresDoctorado: 'Másteres · doctorado',
    fpGradoSuperior: 'FP Grado Superior',
    k2CursosTecnico2: '2 cursos · técnico',
    superiorPracticas: 'superior · prácticas',
    mundoLaboral: 'Mundo laboral',
    contratoPorCuenta: 'Contrato por cuenta',
    ajenaOAutonomo: 'ajena o autónomo',
    accesoDirecto2: 'acceso directo',
    trasTitulacion: 'tras titulación',
    k1618Anos: '16-18 años',
    k1618Anos2: '16-18 años',
    k1517Anos: '15-17 años',
    k1820Anos: '18-20 años',
    todosLosItinerariosDesemboca: 'Todos los itinerarios desembocan, antes o después, en el mundo laboral. Las pasarelas garantizan que ninguna decisión es definitiva.',
  },
  ca: {
    itinerariosFormativosDelSist: 'Itineraris formatius del sistema educatiu espanyol després de 4t ESO',
    sistemaEducativoEspanolTras: 'Sistema educatiu espanyol després de 4t ESO',
    diagramaDeTransicionesDesde: 'Diagrama de transicions des de 4t ESO cap a Batxillerat, FP Grau Mitjà i FP Grau Bàsic, amb les passarel·les cap a FP Grau Superior, Universitat i món laboral.',
    puntoDePartida: 'PUNT DE PARTIDA',
    k4OEso: '4t ESO',
    bachillerato: 'Batxillerat',
    k2Cursos1618: '2 cursos · 16-18 anys',
    ciencias: 'Ciències',
    yTecno: 'i Tecno.',
    humanid: 'Humanit.',
    yCcSs: 'i CC.SS.',
    artes: 'Arts /',
    general: 'General',
    fpGradoMedio: 'FP Grau Mitjà',
    k2CursosTecnico: '2 cursos · tècnic',
    profesional: 'professional',
    fpGradoBasico: 'FP Grau Bàsic',
    alternativa1517Anos: 'Alternativa 15-17 anys',
    sinGraduadoEnEso: 'sense Graduat en ESO',
    titulaAcceso: 'titula → accés',
    viaEbau: 'via EBAU',
    accesoDirecto: 'accés directe',
    pruebaAcceso: "prova d'accés",
    universidad: 'Universitat',
    grados34Anos: 'Graus · 3-4 anys',
    masteresDoctorado: 'Màsters · doctorat',
    fpGradoSuperior: 'FP Grau Superior',
    k2CursosTecnico2: '2 cursos · tècnic',
    superiorPracticas: 'superior · pràctiques',
    mundoLaboral: 'Món laboral',
    contratoPorCuenta: 'Contracte per compte',
    ajenaOAutonomo: "d'altri o autònom",
    accesoDirecto2: 'accés directe',
    trasTitulacion: 'després de titular',
    k1618Anos: '16-18 anys',
    k1618Anos2: '16-18 anys',
    k1517Anos: '15-17 anys',
    k1820Anos: '18-20 anys',
    todosLosItinerariosDesemboca: 'Tots els itineraris desemboquen, abans o després, en el món laboral. Les passarel·les garantixen que cap decisió és definitiva.',
  },
} as const;
const t = COPY[locale];
---
<svg viewBox="0 0 880 620" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={t.itinerariosFormativosDelSist}>
  <title>{t.sistemaEducativoEspanolTras}</title>
  <desc>{t.diagramaDeTransicionesDesde}</desc>
  <defs>
    <style>
      .bg { fill: #FBF6EC; }
      .node-root { fill: #C44E2C; stroke: #9C3A1C; stroke-width: 2; }
      .node-bach { fill: #FFFFFF; stroke: #D4A24C; stroke-width: 2; }
      .node-bach-mini { fill: #F5E5BC; stroke: #A87A2A; stroke-width: 1.5; }
      .node-fpm { fill: #ECDCE5; stroke: #5B3A4E; stroke-width: 2; }
      .node-fpb { fill: #EFE2CB; stroke: #8A7868; stroke-width: 1.5; }
      .node-fps { fill: #DBEDED; stroke: #1F6E6E; stroke-width: 2; }
      .node-uni { fill: #FBE3D6; stroke: #C44E2C; stroke-width: 2; }
      .node-laboral { fill: #FFFFFF; stroke: #2A1F18; stroke-width: 2; stroke-dasharray: 4 3; }
      .edge { fill: none; stroke: #5C4A3D; stroke-width: 1.8; marker-end: url(#arrow-edge); }
      .edge-soft { fill: none; stroke: #8A7868; stroke-width: 1.4; marker-end: url(#arrow-soft); stroke-dasharray: 5 4; }
      .root-label-1 { font-family: 'Switzer', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; fill: #FBE3D6; text-anchor: middle; }
      .root-label-2 { font-family: 'Fraunces', serif; font-style: italic; font-size: 19px; font-weight: 500; fill: #FFFFFF; text-anchor: middle; }
      .node-title { font-family: 'Fraunces', serif; font-size: 15px; font-weight: 500; fill: #2A1F18; text-anchor: middle; }
      .node-sub { font-family: 'Switzer', sans-serif; font-size: 11px; fill: #5C4A3D; text-anchor: middle; }
      .mini-label { font-family: 'Switzer', sans-serif; font-size: 10.5px; font-weight: 600; fill: #2A1F18; text-anchor: middle; }
      .edge-label { font-family: 'Switzer', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; fill: #5C4A3D; text-anchor: middle; }
      .edge-label-bg { fill: #FBF6EC; }
      .age-note { font-family: 'Switzer', sans-serif; font-style: italic; font-size: 10px; fill: #8A7868; text-anchor: middle; }
    </style>
    <marker id="arrow-edge" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#5C4A3D"/>
    </marker>
    <marker id="arrow-soft" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#8A7868"/>
    </marker>
  </defs>
  <rect class="bg" x="0" y="0" width="880" height="620"/>

  <!-- Root: 4.º ESO -->
  <g>
    <rect class="node-root" x="350" y="20" width="180" height="60" rx="8"/>
    <text class="root-label-1" x="440" y="42">{t.puntoDePartida}</text>
    <text class="root-label-2" x="440" y="66">{t.k4OEso}</text>
  </g>

  <!-- Edges from root to 3 branches -->
  <path class="edge" d="M 410 80 Q 410 110 230 140"/>
  <path class="edge" d="M 440 80 L 440 140"/>
  <path class="edge" d="M 470 80 Q 470 110 650 140"/>

  <!-- Branch 1: Bachillerato (left) -->
  <g>
    <rect class="node-bach" x="80" y="140" width="280" height="130" rx="8"/>
    <text class="node-title" x="220" y="165">{t.bachillerato}</text>
    <text class="node-sub" x="220" y="183">{t.k2Cursos1618}</text>
    <!-- 3 mini-modalities -->
    <rect class="node-bach-mini" x="95" y="200" width="80" height="55" rx="5"/>
    <text class="mini-label" x="135" y="222">{t.ciencias}</text>
    <text class="mini-label" x="135" y="237">{t.yTecno}</text>
    <rect class="node-bach-mini" x="180" y="200" width="80" height="55" rx="5"/>
    <text class="mini-label" x="220" y="222">{t.humanid}</text>
    <text class="mini-label" x="220" y="237">{t.yCcSs}</text>
    <rect class="node-bach-mini" x="265" y="200" width="80" height="55" rx="5"/>
    <text class="mini-label" x="305" y="222">{t.artes}</text>
    <text class="mini-label" x="305" y="237">{t.general}</text>
  </g>

  <!-- Branch 2: FP Grado Medio (center) -->
  <g>
    <rect class="node-fpm" x="365" y="140" width="170" height="80" rx="8"/>
    <text class="node-title" x="450" y="170">{t.fpGradoMedio}</text>
    <text class="node-sub" x="450" y="190">{t.k2CursosTecnico}</text>
    <text class="node-sub" x="450" y="206">{t.profesional}</text>
  </g>

  <!-- Branch 3: FP Grado Básico (right) -->
  <g>
    <rect class="node-fpb" x="555" y="140" width="190" height="80" rx="8"/>
    <text class="node-title" x="650" y="170">{t.fpGradoBasico}</text>
    <text class="node-sub" x="650" y="190">{t.alternativa1517Anos}</text>
    <text class="node-sub" x="650" y="206">{t.sinGraduadoEnEso}</text>
  </g>

  <!-- FP Básico → FP Medio (pasarela hacia arriba/lateral) -->
  <path class="edge-soft" d="M 600 220 Q 570 260 535 200"/>
  <text class="edge-label" x="585" y="255">{t.titulaAcceso}</text>

  <!-- From Bachillerato down -->
  <path class="edge" d="M 180 270 L 180 350"/>
  <path class="edge" d="M 320 270 L 320 350"/>

  <!-- From FP Medio down (to FP Superior with prueba) and to laboral -->
  <path class="edge" d="M 430 220 L 430 350"/>
  <path class="edge-soft" d="M 500 220 Q 700 280 750 350"/>

  <!-- Edge labels for Bachillerato exits -->
  <rect class="edge-label-bg" x="135" y="305" width="90" height="18" rx="3"/>
  <text class="edge-label" x="180" y="318" fill="#C44E2C">{t.viaEbau}</text>
  <rect class="edge-label-bg" x="270" y="305" width="100" height="18" rx="3"/>
  <text class="edge-label" x="320" y="318">{t.accesoDirecto}</text>

  <!-- Edge labels for FP Medio exits -->
  <rect class="edge-label-bg" x="375" y="305" width="110" height="18" rx="3"/>
  <text class="edge-label" x="430" y="318">{t.pruebaAcceso}</text>

  <!-- Row 3: Universidad / FP Superior / Mundo laboral -->
  <g>
    <rect class="node-uni" x="80" y="350" width="200" height="80" rx="8"/>
    <text class="node-title" x="180" y="382">{t.universidad}</text>
    <text class="node-sub" x="180" y="402">{t.grados34Anos}</text>
    <text class="node-sub" x="180" y="418">{t.masteresDoctorado}</text>
  </g>

  <g>
    <rect class="node-fps" x="320" y="350" width="220" height="80" rx="8"/>
    <text class="node-title" x="430" y="382">{t.fpGradoSuperior}</text>
    <text class="node-sub" x="430" y="402">{t.k2CursosTecnico2}</text>
    <text class="node-sub" x="430" y="418">{t.superiorPracticas}</text>
  </g>

  <g>
    <rect class="node-laboral" x="600" y="350" width="200" height="80" rx="8"/>
    <text class="node-title" x="700" y="382">{t.mundoLaboral}</text>
    <text class="node-sub" x="700" y="402">{t.contratoPorCuenta}</text>
    <text class="node-sub" x="700" y="418">{t.ajenaOAutonomo}</text>
  </g>

  <!-- From FP Superior → Universidad (acceso con o sin EBAU) -->
  <path class="edge-soft" d="M 320 390 L 280 390"/>
  <rect class="edge-label-bg" x="255" y="370" width="90" height="18" rx="3"/>
  <text class="edge-label" x="300" y="383">{t.accesoDirecto2}</text>

  <!-- From FP Superior → Mundo laboral -->
  <path class="edge" d="M 540 390 L 600 390"/>

  <!-- From Universidad → Mundo laboral (bottom curve) -->
  <path class="edge" d="M 180 430 Q 180 510 700 510 L 700 430"/>
  <rect class="edge-label-bg" x="380" y="498" width="140" height="20" rx="3"/>
  <text class="edge-label" x="450" y="513">{t.trasTitulacion}</text>

  <!-- Age annotations -->
  <text class="age-note" x="220" y="290">{t.k1618Anos}</text>
  <text class="age-note" x="430" y="240">{t.k1618Anos2}</text>
  <text class="age-note" x="650" y="240">{t.k1517Anos}</text>
  <text class="age-note" x="430" y="448">{t.k1820Anos}</text>

  <!-- Footer note -->
  <text class="age-note" x="440" y="595" font-style="italic" font-size="11">{t.todosLosItinerariosDesemboca}</text>
</svg>
