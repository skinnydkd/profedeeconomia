---
/**
 * Etapas de financiación de una startup, como línea temporal ascendente.
 * De izquierda a derecha y de menor a mayor importe: bootstrapping y FFF,
 * business angels, capital semilla, serie A, serie B/VC y la salida (IPO o
 * M&A). El eje vertical sugiere el importe captado; bajo el eje, la madurez
 * y el riesgo decreciente para el inversor.
 *
 * Used in EDMN 2BACH · Unit 9 (función financiera).
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    etapasDeFinanciacionDe: 'Etapas de financiación de una startup',
    escaleraAscendenteDeFinancia: 'Escalera ascendente de financiación: empieza con bootstrapping y dinero de familia y amigos, sigue con business angels, capital semilla, serie A y serie B con fondos de capital riesgo, y termina con la salida mediante una salida a bolsa o una adquisición. A medida que sube el importe, baja el riesgo percibido por el inversor.',
    importeCaptado: 'IMPORTE CAPTADO',
    madurezDeLaEmpresa: 'MADUREZ DE LA EMPRESA →',
    fffFamilyFriendsAnd: 'FFF = Family, Friends and Fools. Se financia con ahorros propios y dinero cercano. Ventaja: no se cede control. Inconveniente: si va mal, peligra una relación personal.',
    bootstrapping: 'Bootstrapping',
    k50000: '< 50.000 €',
    fundadoresFamilia: 'Fundadores, familia,',
    amigosFriendsFamily: 'amigos (friends & family)',
    personasConDineroY: 'Personas con dinero y experiencia que invierten en proyectos muy jóvenes. Aportan, además del capital, contactos y consejo (lo que se llama «smart money»).',
    business: 'Business',
    angels: 'Angels',
    inversores: 'Inversores',
    particularesCon: 'particulares con',
    experiencia: 'experiencia',
    primeraRondaInstitucionalSir: 'Primera ronda «institucional». Sirve para validar el producto y conseguir los primeros clientes. Aquí suelen entrar las aceleradoras, que dan dinero y mentoría a cambio de un porcentaje.',
    capital: 'Capital',
    semillaSeed: 'semilla (seed)',
    fondosSeed: 'Fondos seed,',
    aceleradoras: 'aceleradoras',
    elNegocioYaFunciona: 'El negocio ya funciona y busca crecer. Los fondos de capital riesgo entran a cambio de una participación importante y un puesto en el consejo: el fundador empieza a perder control.',
    serieA: 'Serie A',
    fondosDe: 'Fondos de',
    capitalRiesgo: 'capital riesgo',
    rondasGrandesParaEscalar: 'Rondas grandes para escalar deprisa: abrir nuevos mercados, comprar competidores o multiplicar el equipo. Pueden encadenarse varias (serie C, D…) según las necesidades.',
    serieBVc: 'Serie B / VC',
    ventureCapital: 'Venture capital',
    paraEscalar: 'para escalar',
    elMomentoEnQue: 'El momento en que los inversores recuperan su dinero con beneficio: IPO (salir a bolsa vendiendo acciones al público) o M&A (que otra empresa más grande la compre).',
    salidaExit: 'Salida (exit)',
    ipoMA: 'IPO / M&A',
    salidaABolsa: 'Salida a bolsa',
    oAdquisicion: 'o adquisición',
    riesgoDelInversorMuy: 'Riesgo del inversor MUY ALTO',
    menor: 'menor',
  },
  ca: {
    etapasDeFinanciacionDe: "Etapes de finançament d'una startup",
    escaleraAscendenteDeFinancia: "Escala ascendent de finançament: comença amb bootstrapping i diners de família i amics, seguix amb business angels, capital llavor, sèrie A i sèrie B amb fons de capital risc, i acaba amb l'eixida mitjançant una eixida a borsa o una adquisició. A mesura que puja l'import, baixa el risc percebut per l'inversor.",
    importeCaptado: 'IMPORT CAPTAT',
    madurezDeLaEmpresa: "MADURESA DE L'EMPRESA →",
    fffFamilyFriendsAnd: 'FFF = Family, Friends and Fools. Es finança amb estalvis propis i diners pròxims. Avantatge: no se cedix control. Inconvenient: si va malament, perilla una relació personal.',
    bootstrapping: 'Bootstrapping',
    k50000: '< 50.000 €',
    fundadoresFamilia: 'Fundadors, família,',
    amigosFriendsFamily: 'amics (friends & family)',
    personasConDineroY: 'Persones amb diners i experiència que invertixen en projectes molt jóvens. Aporten, a més del capital, contactes i consell (el que es diu «smart money»).',
    business: 'Business',
    angels: 'Angels',
    inversores: 'Inversors',
    particularesCon: 'particulars amb',
    experiencia: 'experiència',
    primeraRondaInstitucionalSir: "Primera ronda «institucional». Servix per a validar el producte i aconseguir els primers clients. Ací solen entrar les acceleradores, que donen diners i mentoria a canvi d'un percentatge.",
    capital: 'Capital',
    semillaSeed: 'llavor (seed)',
    fondosSeed: 'Fons seed,',
    aceleradoras: 'acceleradores',
    elNegocioYaFunciona: "El negoci ja funciona i busca créixer. Els fons de capital risc entren a canvi d'una participació important i un lloc al consell: el fundador comença a perdre control.",
    serieA: 'Sèrie A',
    fondosDe: 'Fons de',
    capitalRiesgo: 'capital risc',
    rondasGrandesParaEscalar: "Rondes grans per a escalar de pressa: obrir mercats nous, comprar competidors o multiplicar l'equip. Se'n poden encadenar diverses (sèrie C, D…) segons les necessitats.",
    serieBVc: 'Sèrie B / VC',
    ventureCapital: 'Venture capital',
    paraEscalar: 'per a escalar',
    elMomentoEnQue: 'El moment en què els inversors recuperen els diners amb benefici: IPO (eixir a borsa venent accions al públic) o M&A (que una altra empresa més gran la compre).',
    salidaExit: 'Eixida (exit)',
    ipoMA: 'IPO / M&A',
    salidaABolsa: 'Eixida a borsa',
    oAdquisicion: 'o adquisició',
    riesgoDelInversorMuy: "Risc de l'inversor MOLT ALT",
    menor: 'menor',
  },
} as const;
const t = COPY[locale];
---
<svg class="d-cascada-financiacion" viewBox="0 0 900 500" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="cascfin-title cascfin-desc">
  <title id="cascfin-title">{t.etapasDeFinanciacionDe}</title>
  <desc id="cascfin-desc">{t.escaleraAscendenteDeFinancia}</desc>
  <defs>
    <style>
      .d-cascada-financiacion .bg { fill: #FBF6EC; }
      .d-cascada-financiacion .axis { stroke: #5C4A3D; stroke-width: 1.5; }
      .d-cascada-financiacion .axis-label { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; fill: #5C4A3D; }
      .d-cascada-financiacion .step { stroke: #9C3A1C; stroke-width: 1.6; }
      .d-cascada-financiacion .step-1 { fill: #F5E5BC; }
      .d-cascada-financiacion .step-2 { fill: #FBE3D6; }
      .d-cascada-financiacion .step-3 { fill: #F4C9B3; }
      .d-cascada-financiacion .step-4 { fill: #E89A78; }
      .d-cascada-financiacion .step-5 { fill: #D4724E; }
      .d-cascada-financiacion .step-6 { fill: #C44E2C; }
      .d-cascada-financiacion .step-name { font-family: 'Switzer', sans-serif; font-size: 11.5px; font-weight: 700; fill: #2A1F18; text-anchor: middle; }
      .d-cascada-financiacion .step-amt { font-family: 'JetBrains Mono', monospace; font-size: 10px; fill: #2A1F18; text-anchor: middle; }
      .d-cascada-financiacion .step-who { font-family: 'Switzer', sans-serif; font-size: 9.5px; fill: #5C4A3D; text-anchor: middle; }
      .d-cascada-financiacion .arrow-line { stroke: #C44E2C; stroke-width: 2.5; fill: none; marker-end: url(#cf-arrow); }
      .d-cascada-financiacion .risk-band { font-family: 'Fraunces', serif; font-style: italic; font-size: 12px; fill: #5C4A3D; }
      .d-cascada-financiacion .risk-grad { fill: none; stroke: #8A7868; stroke-width: 1.4; marker-end: url(#cf-arrow-mute); }
      .d-cascada-financiacion .has-tip { cursor: help; }
    </style>
    <marker id="cf-arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#C44E2C"/>
    </marker>
    <marker id="cf-arrow-mute" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#8A7868"/>
    </marker>
  </defs>
  <rect class="bg" x="0" y="0" width="900" height="500"/>

  <!-- Axes -->
  <line class="axis" x1="80" y1="380" x2="870" y2="380"/>
  <line class="axis" x1="80" y1="380" x2="80" y2="50"/>
  <text class="axis-label" x="42" y="210" text-anchor="middle" transform="rotate(-90 42 210)">{t.importeCaptado}</text>
  <text class="axis-label" x="475" y="478" text-anchor="middle">{t.madurezDeLaEmpresa}</text>

  <!-- Ascending steps. 6 columns, width 110, gap 18, starting x=100. Heights grow. baseline 380. -->
  <!-- Step 1: Bootstrapping / FFF -->
  <rect class="step step-1 has-tip" x="100" y="320" width="110" height="60" rx="4"><title>{t.fffFamilyFriendsAnd}</title></rect>
  <text class="step-name" x="155" y="305">{t.bootstrapping}</text>
  <text class="step-name" x="155" y="290">/ FFF</text>
  <text class="step-amt" x="155" y="345">{t.k50000}</text>
  <text class="step-who" x="155" y="365">{t.fundadoresFamilia}</text>
  <text class="step-who" x="155" y="377">{t.amigosFriendsFamily}</text>

  <!-- Step 2: Business Angels -->
  <rect class="step step-2 has-tip" x="228" y="280" width="110" height="100" rx="4"><title>{t.personasConDineroY}</title></rect>
  <text class="step-name" x="283" y="265">{t.business}</text>
  <text class="step-name" x="283" y="250">{t.angels}</text>
  <text class="step-amt" x="283" y="305">50k – 300k €</text>
  <text class="step-who" x="283" y="345">{t.inversores}</text>
  <text class="step-who" x="283" y="357">{t.particularesCon}</text>
  <text class="step-who" x="283" y="369">{t.experiencia}</text>

  <!-- Step 3: Capital semilla -->
  <rect class="step step-3 has-tip" x="356" y="240" width="110" height="140" rx="4"><title>{t.primeraRondaInstitucionalSir}</title></rect>
  <text class="step-name" x="411" y="225">{t.capital}</text>
  <text class="step-name" x="411" y="210">{t.semillaSeed}</text>
  <text class="step-amt" x="411" y="265">0,3M – 2M €</text>
  <text class="step-who" x="411" y="320">{t.fondosSeed}</text>
  <text class="step-who" x="411" y="332">{t.aceleradoras}</text>

  <!-- Step 4: Serie A -->
  <rect class="step step-4 has-tip" x="484" y="190" width="110" height="190" rx="4"><title>{t.elNegocioYaFunciona}</title></rect>
  <text class="step-name" x="539" y="175" fill="#FFFFFF">{t.serieA}</text>
  <text class="step-amt" x="539" y="215" fill="#FFFFFF">2M – 15M €</text>
  <text class="step-who" x="539" y="320" fill="#2A1F18">{t.fondosDe}</text>
  <text class="step-who" x="539" y="332" fill="#2A1F18">{t.capitalRiesgo}</text>

  <!-- Step 5: Serie B / VC -->
  <rect class="step step-5 has-tip" x="612" y="130" width="110" height="250" rx="4"><title>{t.rondasGrandesParaEscalar}</title></rect>
  <text class="step-name" x="667" y="115" fill="#FFFFFF">{t.serieBVc}</text>
  <text class="step-amt" x="667" y="155" fill="#FFFFFF">15M – 50M €</text>
  <text class="step-who" x="667" y="320" fill="#FFFFFF">{t.ventureCapital}</text>
  <text class="step-who" x="667" y="332" fill="#FFFFFF">{t.paraEscalar}</text>

  <!-- Step 6: Salida -->
  <rect class="step step-6 has-tip" x="740" y="70" width="110" height="310" rx="4"><title>{t.elMomentoEnQue}</title></rect>
  <text class="step-name" x="795" y="55" fill="#FFFFFF">{t.salidaExit}</text>
  <text class="step-amt" x="795" y="95" fill="#FFFFFF">{t.ipoMA}</text>
  <text class="step-who" x="795" y="320" fill="#FFFFFF">{t.salidaABolsa}</text>
  <text class="step-who" x="795" y="332" fill="#FFFFFF">{t.oAdquisicion}</text>

  <!-- Ascending trend arrow over the steps -->
  <path class="arrow-line" d="M 120 350 L 250 318 L 380 280 L 510 235 L 640 175 L 770 115"/>

  <!-- Risk gradient annotation below baseline -->
  <text class="risk-band" x="120" y="445">{t.riesgoDelInversorMuy}</text>
  <line class="risk-grad" x1="320" y1="440" x2="700" y2="440"/>
  <text class="risk-band" x="720" y="445" text-anchor="start">{t.menor}</text>
</svg>
