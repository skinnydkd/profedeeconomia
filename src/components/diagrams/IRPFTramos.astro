---
/**
 * IRPF progresivo por tramos: barras escalonadas con el tipo marginal
 * de cada tramo de base liquidable, ilustrando que el tipo alto solo
 * afecta a la franja que cae dentro de cada tramo, no a toda la renta.
 *
 * Used in Eco 4ESO · Unit 8 (economía personal: nómina, IRPF y contratos).
 */
import { getLocale } from '@/i18n/locale';
const locale = getLocale(Astro.currentLocale);

const COPY = {
  es: {
    elIrpfEsProgresivo: 'El IRPF es progresivo por tramos',
    escaleraDeSeisTramos: 'Escalera de seis tramos de base liquidable con su tipo marginal: 19 %, 24 %, 30 %, 37 %, 45 % y 47 %. Cada tipo se aplica solo a la parte de renta que cae dentro de su tramo, no a toda la renta. Por eso el tipo medio efectivo siempre es menor que el marginal.',
    tipoMarginalPorTramo: 'TIPO MARGINAL POR TRAMO DE RENTA (ESTATAL, 2026)',
    primerTramoEstosPrimeros: 'Primer tramo: estos primeros 12.450 € tributan al 19 %, los gane quien los gane. En la práctica, una buena parte queda exenta gracias al mínimo personal y familiar.',
    soloLosEurosQue: 'Solo los euros que caen entre 12.450 y 20.200 € pagan al 24 %. Lo de abajo siguió pagando al 19 %: subir de tramo nunca hace que cobres menos neto.',
    tramoDondeSeSitua: 'Tramo donde se sitúa el salario medio en España. El 30 % es el tipo MARGINAL: lo que pagas por el último euro, no por toda tu renta.',
    aquiElSaltoA: 'Aquí el salto a 37 % es notable. Es el tramo donde más se nota el ahorro fiscal de aportar a planes de pensiones, que rebajan la base liquidable.',
    tramoDeRentasAltas: 'Tramo de rentas altas. Aun ganando aquí, el tipo MEDIO efectivo sigue siendo bastante menor que el 45 %, porque la mayor parte de la renta tributó a tipos más bajos.',
    tramoMaximoEstatalPara: 'Tramo máximo estatal, para rentas superiores a 300.000 €. Solo paga el 47 % la parte que supera esa cifra; cada CCAA puede además fijar su propio tramo autonómico.',
    masDe300000: 'más de 300.000',
    tramosDeBaseLiquidable: 'TRAMOS DE BASE LIQUIDABLE',
    cadaTipoSeAplica: 'Cada tipo se aplica SOLO a la parte de renta dentro de su tramo, no a toda la renta.',
    porEsoTuTipo: 'Por eso tu tipo MEDIO efectivo siempre es menor que tu tipo MARGINAL (el del último euro).',
  },
  ca: {
    elIrpfEsProgresivo: "L'IRPF és progressiu per trams",
    escaleraDeSeisTramos: "Escala de sis trams de base liquidable amb el seu tipus marginal: 19 %, 24 %, 30 %, 37 %, 45 % i 47 %. Cada tipus s'aplica només a la part de renda que cau dins del seu tram, no a tota la renda. Per això el tipus mitjà efectiu sempre és menor que el marginal.",
    tipoMarginalPorTramo: 'TIPUS MARGINAL PER TRAM DE RENDA (ESTATAL, 2026)',
    primerTramoEstosPrimeros: 'Primer tram: estos primers 12.450 € tributen al 19 %, els guanye qui els guanye. En la pràctica, una bona part queda exempta gràcies al mínim personal i familiar.',
    soloLosEurosQue: 'Només els euros que cauen entre 12.450 i 20.200 € paguen al 24 %. El de davall va seguir pagant al 19 %: pujar de tram mai fa que cobres menys net.',
    tramoDondeSeSitua: "Tram on se situa el salari mitjà a Espanya. El 30 % és el tipus MARGINAL: el que pagues per l'últim euro, no per tota la teua renda.",
    aquiElSaltoA: "Ací el salt a 37 % és notable. És el tram on més es nota l'estalvi fiscal d'aportar a plans de pensions, que rebaixen la base liquidable.",
    tramoDeRentasAltas: 'Tram de rendes altes. Encara guanyant ací, el tipus MITJÀ efectiu continua sent bastant menor que el 45 %, perquè la major part de la renda va tributar a tipus més baixos.',
    tramoMaximoEstatalPara: 'Tram màxim estatal, per a rendes superiors a 300.000 €. Només paga el 47 % la part que supera eixa xifra; cada CCAA pot a més fixar el seu propi tram autonòmic.',
    masDe300000: 'més de 300.000',
    tramosDeBaseLiquidable: 'TRAMS DE BASE LIQUIDABLE',
    cadaTipoSeAplica: "Cada tipus s'aplica NOMÉS a la part de renda dins del seu tram, no a tota la renda.",
    porEsoTuTipo: "Per això el teu tipus MITJÀ efectiu sempre és menor que el teu tipus MARGINAL (el de l'últim euro).",
  },
} as const;
const t = COPY[locale];
---
<svg class="d-irpf-tramos" viewBox="0 0 800 520" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="irpf-title irpf-desc">
  <title id="irpf-title">{t.elIrpfEsProgresivo}</title>
  <desc id="irpf-desc">{t.escaleraDeSeisTramos}</desc>
  <defs>
    <style>
      .d-irpf-tramos .bg { fill: #FBF6EC; }
      .d-irpf-tramos .axis { stroke: #5C4A3D; stroke-width: 1.5; fill: none; }
      .d-irpf-tramos .grid { stroke: #E5D4BD; stroke-width: 1; stroke-dasharray: 2 4; fill: none; }
      .d-irpf-tramos .bar { stroke: #2A1F18; stroke-width: 1.2; }
      .d-irpf-tramos .bar-1 { fill: #F5E5BC; }
      .d-irpf-tramos .bar-2 { fill: #EBD08C; }
      .d-irpf-tramos .bar-3 { fill: #D4A24C; }
      .d-irpf-tramos .bar-4 { fill: #C97F38; }
      .d-irpf-tramos .bar-5 { fill: #C44E2C; }
      .d-irpf-tramos .bar-6 { fill: #9C3A1C; }
      .d-irpf-tramos .step-line { fill: none; stroke: #2A1F18; stroke-width: 2.5; stroke-linejoin: round; }
      .d-irpf-tramos .marg { font-family: 'JetBrains Mono', monospace; font-size: 16px; font-weight: 500; fill: #2A1F18; text-anchor: middle; }
      .d-irpf-tramos .tramo { font-family: 'Switzer', sans-serif; font-size: 9.5px; font-weight: 700; fill: #5C4A3D; text-anchor: middle; }
      .d-irpf-tramos .axis-label { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; fill: #5C4A3D; }
      .d-irpf-tramos .tick-label { font-family: 'JetBrains Mono', monospace; font-size: 10px; fill: #5C4A3D; text-anchor: end; }
      .d-irpf-tramos .header { font-family: 'Switzer', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; fill: #8A7868; text-anchor: middle; }
      .d-irpf-tramos .footer { font-family: 'Fraunces', serif; font-style: italic; font-size: 13px; fill: #5C4A3D; text-anchor: middle; }
      .d-irpf-tramos .has-tip { cursor: help; }
    </style>
  </defs>
  <rect class="bg" x="0" y="0" width="800" height="520"/>

  <text class="header" x="400" y="40">{t.tipoMarginalPorTramo}</text>

  <!-- Plot: y 380 (0%) .. 70 (50%); scale = (380-70)/50 = 6.2 px/% -->
  <!-- Grid horizontal at 10/20/30/40/50 % -->
  <line class="grid" x1="100" y1="318" x2="730" y2="318"/>
  <line class="grid" x1="100" y1="256" x2="730" y2="256"/>
  <line class="grid" x1="100" y1="194" x2="730" y2="194"/>
  <line class="grid" x1="100" y1="132" x2="730" y2="132"/>
  <line class="grid" x1="100" y1="70" x2="730" y2="70"/>

  <!-- Axes -->
  <line class="axis" x1="100" y1="380" x2="730" y2="380"/>
  <line class="axis" x1="100" y1="60" x2="100" y2="380"/>

  <!-- Y ticks -->
  <text class="tick-label" x="92" y="384">0 %</text>
  <text class="tick-label" x="92" y="322">10 %</text>
  <text class="tick-label" x="92" y="260">20 %</text>
  <text class="tick-label" x="92" y="198">30 %</text>
  <text class="tick-label" x="92" y="136">40 %</text>
  <text class="tick-label" x="92" y="74">50 %</text>

  <!-- Six bars, width 90, gap small. x start 120 -->
  <!-- 19% -> h=117.8 -> y=262.2 -->
  <rect class="bar bar-1 has-tip" x="120" y="262.2" width="90" height="117.8"><title>{t.primerTramoEstosPrimeros}</title></rect>
  <text class="marg" x="165" y="252">19 %</text>
  <text class="tramo" x="165" y="398">0 – 12.450 €</text>

  <!-- 24% -> h=148.8 -> y=231.2 -->
  <rect class="bar bar-2 has-tip" x="220" y="231.2" width="90" height="148.8"><title>{t.soloLosEurosQue}</title></rect>
  <text class="marg" x="265" y="221">24 %</text>
  <text class="tramo" x="265" y="398">12.450 – 20.200</text>

  <!-- 30% -> h=186 -> y=194 -->
  <rect class="bar bar-3 has-tip" x="320" y="194" width="90" height="186"><title>{t.tramoDondeSeSitua}</title></rect>
  <text class="marg" x="365" y="184">30 %</text>
  <text class="tramo" x="365" y="398">20.200 – 35.200</text>

  <!-- 37% -> h=229.4 -> y=150.6 -->
  <rect class="bar bar-4 has-tip" x="420" y="150.6" width="90" height="229.4"><title>{t.aquiElSaltoA}</title></rect>
  <text class="marg" x="465" y="140">37 %</text>
  <text class="tramo" x="465" y="398">35.200 – 60.000</text>

  <!-- 45% -> h=279 -> y=101 -->
  <rect class="bar bar-5 has-tip" x="520" y="101" width="90" height="279"><title>{t.tramoDeRentasAltas}</title></rect>
  <text class="marg" x="565" y="91" fill="#FFFFFF">45 %</text>
  <text class="tramo" x="565" y="398">60.000 – 300.000</text>

  <!-- 47% -> h=291.4 -> y=88.6 -->
  <rect class="bar bar-6 has-tip" x="620" y="88.6" width="90" height="291.4"><title>{t.tramoMaximoEstatalPara}</title></rect>
  <text class="marg" x="665" y="78" fill="#FFFFFF">47 %</text>
  <text class="tramo" x="665" y="398">{t.masDe300000}</text>

  <!-- Staircase line connecting bar tops -->
  <polyline class="step-line"
    points="120,262.2 210,262.2 220,231.2 310,231.2 320,194 410,194 420,150.6 510,150.6 520,101 610,101 620,88.6 710,88.6"/>

  <!-- Axis titles -->
  <text class="axis-label" x="415" y="425" text-anchor="middle">{t.tramosDeBaseLiquidable}</text>

  <!-- Footer notes -->
  <text class="footer" x="400" y="475">{t.cadaTipoSeAplica}</text>
  <text class="footer" x="400" y="497">{t.porEsoTuTipo}</text>
</svg>
