---

<svg viewBox="0 0 820 560" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="organizacionterritorial-t organizacionterritorial-d">
  <title id="organizacionterritorial-t">{t.quienDecideQueEnCadaNivelDel}</title>
  <desc id="organizacionterritorial-d">{t.cuatroNivelesDeGobiernoConLa}</desc>
  <defs>
    <style>
      .bg { fill: #FBF6EC; }
      .row { stroke-width: 2; }
      .r-est { fill: #FBE3D6; stroke: #C44E2C; }
      .r-aut { fill: #DBEDED; stroke: #1F6E6E; }
      .r-pro { fill: #F5E5BC; stroke: #A87A2A; }
      .r-mun { fill: #E0DCF0; stroke: #4A3B8F; }
      .lvl { font-family: 'Fraunces', serif; font-size: 16px; font-weight: 500; fill: #2A1F18; }
      .lvl-sub { font-family: 'Switzer', sans-serif; font-size: 9.5px; font-style: italic; fill: #8A7868; }
      .cell { font-family: 'Switzer', sans-serif; font-size: 10.5px; fill: #5C4A3D; }
      .cell-b { font-family: 'Switzer', sans-serif; font-size: 10.5px; font-weight: 700; fill: #2A1F18; }
      .head { font-family: 'Switzer', sans-serif; font-size: 9px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase; fill: #8A7868; }
      .band { font-family: 'Switzer', sans-serif; font-size: 9.5px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; fill: #8A7868; }
      .note { fill: #FFFFFF; stroke: #8A7868; stroke-width: 1.6; stroke-dasharray: 5 3; }
      .note-t { font-family: 'Switzer', sans-serif; font-size: 10.5px; fill: #5C4A3D; }
      .note-b { font-family: 'Switzer', sans-serif; font-size: 10.5px; font-weight: 700; fill: #2A1F18; }
      .rule { stroke: #E5D4BD; stroke-width: 1; }
    </style>
  </defs>

  <rect class="bg" x="0" y="0" width="820" height="560" />

  <text class="band" x="40" y="30">{t.cuatroNivelesNingunoPorEncim}</text>

  <!-- Column headers -->
  <text class="head" x="40" y="62">{t.nivel}</text>
  <text class="head" x="256" y="62">{t.normaQueLoRegula}</text>
  <text class="head" x="440" y="62">{t.quienLoGobierna}</text>
  <text class="head" x="616" y="62">{t.ejemploDeDecisionPropia}</text>
  <line class="rule" x1="40" y1="70" x2="780" y2="70" />

  <!-- Estado -->
  <rect class="row r-est" x="40" y="80" width="740" height="76" rx="4" />
  <text class="lvl" x="60" y="112">{t.estado}</text>
  <text class="lvl-sub" x="60" y="130">{t.todoElTerritorio}</text>
  <text class="cell-b" x="256" y="108">{t.constitucionDe1978}</text>
  <text class="cell" x="256" y="126">{t.competenciasDelArt149}</text>
  <text class="cell" x="440" y="108">{t.cortesGenerales}</text>
  <text class="cell" x="440" y="126">{t.yGobiernoDeEspana}</text>
  <text class="cell" x="616" y="108">{t.elCodigoPenal}</text>
  <text class="cell" x="616" y="126">{t.elSalarioMinimo}</text>

  <!-- Comunitat Valenciana -->
  <rect class="row r-aut" x="40" y="168" width="740" height="76" rx="4" />
  <text class="lvl" x="60" y="200">{t.comunitatValenciana}</text>
  <text class="lvl-sub" x="60" y="218">{t.unaDeLas17Comunidades}</text>
  <text class="cell-b" x="256" y="196">{t.estatutDAutonomia}</text>
  <text class="cell" x="256" y="214">{t.lo51982ReformadoEn2006}</text>
  <text class="cell" x="440" y="196">{t.cortsValencianes}</text>
  <text class="cell" x="440" y="214">{t.consellYSuPresident}</text>
  <text class="cell" x="616" y="196">{t.elCurriculoDeTuInstituto}</text>
  <text class="cell" x="616" y="214">{t.losHospitalesPublicos}</text>

  <!-- Provincia -->
  <rect class="row r-pro" x="40" y="256" width="740" height="76" rx="4" />
  <text class="lvl" x="60" y="288">{t.provincia}</text>
  <text class="lvl-sub" x="60" y="306">{t.alicanteCastellonValencia}</text>
  <text class="cell-b" x="256" y="284">{t.ley71985DeBases}</text>
  <text class="cell" x="256" y="302">{t.delRegimenLocal}</text>
  <text class="cell" x="440" y="284">{t.laDiputacionElegida}</text>
  <text class="cell" x="440" y="302">{t.porLosConcejales}</text>
  <text class="cell" x="616" y="284">{t.carreterasEntrePueblos}</text>
  <text class="cell" x="616" y="302">{t.apoyoAMunicipiosPequenos}</text>

  <!-- Municipio -->
  <rect class="row r-mun" x="40" y="344" width="740" height="76" rx="4" />
  <text class="lvl" x="60" y="376">{t.municipio}</text>
  <text class="lvl-sub" x="60" y="394">{t.elNivelMasCercanoATi}</text>
  <text class="cell-b" x="256" y="372">{t.laMismaLey71985}</text>
  <text class="cell" x="256" y="390">{t.yLasOrdenanzasMunicipales}</text>
  <text class="cell" x="440" y="372">{t.elAyuntamientoAlcalde}</text>
  <text class="cell" x="440" y="390">{t.yConcejalesElegidosCada4Anos}</text>
  <text class="cell" x="616" y="372">{t.laLicenciaDeObras}</text>
  <text class="cell" x="616" y="390">{t.laZonaAzulElHorarioDeFiestas}</text>

  <!-- Note -->
  <rect class="note" x="40" y="446" width="740" height="86" rx="4" />
  <text class="note-b" x="60" y="472">{t.lasCajasTienenLaMismaAnchura}</text>
  <text class="note-t" x="60" y="492">{t.ningunoDeEstosNivelesMandaSo}</text>
  <text class="note-t" x="60" y="508">{t.yElEstatutLeAtribuyenCuandoD}</text>
  <text class="note-t" x="60" y="524">{t.resuelveElTribunalConstituci}</text>
</svg>
