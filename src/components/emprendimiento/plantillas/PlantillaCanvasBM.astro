---
/** Blank Business Model Canvas (9 blocks) for the student team to fill in. */
import type { Locale } from '@/i18n/locale';
interface Props { locale?: Locale }
const { locale = 'es' } = Astro.props;
const LABELS = {
  es: {
    socios: 'Socios clave', actividades: 'Actividades clave', recursos: 'Recursos clave',
    propuesta: 'Propuesta de valor', relaciones: 'Relación con clientes', canales: 'Canales',
    segmentos: 'Segmentos de cliente', costes: 'Estructura de costes', ingresos: 'Fuentes de ingreso',
  },
  ca: {
    socios: 'Socis clau', actividades: 'Activitats clau', recursos: 'Recursos clau',
    propuesta: 'Proposta de valor', relaciones: 'Relació amb els clients', canales: 'Canals',
    segmentos: 'Segments de clients', costes: 'Estructura de costos', ingresos: 'Fonts d\'ingressos',
  },
}[locale];
const BLOQUES = [
  { k: 'socios', label: LABELS.socios },
  { k: 'actividades', label: LABELS.actividades },
  { k: 'recursos', label: LABELS.recursos },
  { k: 'propuesta', label: LABELS.propuesta },
  { k: 'relaciones', label: LABELS.relaciones },
  { k: 'canales', label: LABELS.canales },
  { k: 'segmentos', label: LABELS.segmentos },
  { k: 'costes', label: LABELS.costes },
  { k: 'ingresos', label: LABELS.ingresos },
];
---
<div class="bmc">
  {BLOQUES.map((b) => (
    <div class={`bmc__cell bmc__cell--${b.k}`}>
      <span class="bmc__k">{b.label}</span>
    </div>
  ))}
</div>
<style>
  .bmc { display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: minmax(96px, auto); gap: 6px; }
  .bmc__cell { border: 1px solid var(--color-mustard); border-radius: 5px; padding: 0.5rem 0.6rem; background: var(--color-paper); }
  .bmc__k { display: block; font-family: var(--font-sans); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-mustard-deep); font-weight: 700; }
  .bmc__cell--propuesta { grid-column: 2; grid-row: 1 / span 2; }
  .bmc__cell--costes, .bmc__cell--ingresos { grid-row: 3; }
  @media print { .bmc__cell { break-inside: avoid; } }
  @media (max-width: 600px) { .bmc { grid-template-columns: 1fr 1fr; } .bmc__cell--propuesta { grid-column: auto; grid-row: auto; } .bmc__cell--costes, .bmc__cell--ingresos { grid-row: auto; } }
</style>
