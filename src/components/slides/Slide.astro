---
import { Image } from 'astro:assets';
import type { Slide } from '@/lib/slides/types';
import SlideDiagramMount from './SlideDiagramMount.astro';

interface Props { slide: Slide; pos: string; locale?: 'es' | 'ca' }
const { slide, pos, locale = 'es' } = Astro.props;
const s = slide as any;
const brand = 'profedeeconomia.es';
const L = locale === 'ca'
  ? { ejercicio: 'Exercici', comprueba: 'Comprova el que saps', solucion: 'Solució', fuente: 'Font',
      donde: 'On', ejemplo: 'Exemple', elCaso: 'El cas', datos: 'Dades', pregunta: 'La pregunta',
      repasa: 'Repassa abans de l\u2019examen', saberes: 'Sabers bàsics', competencias: 'Competències específiques', criterios: 'Criteris d\u2019avaluació',
      elGrafico: 'El gràfic' }
  : { ejercicio: 'Ejercicio', comprueba: 'Comprueba lo que sabes', solucion: 'Solución', fuente: 'Fuente',
      donde: 'Donde', ejemplo: 'Ejemplo', elCaso: 'El caso', datos: 'Datos', pregunta: 'La pregunta',
      repasa: 'Repasa antes del examen', saberes: 'Saberes básicos', competencias: 'Competencias específicas', criterios: 'Criterios de evaluación',
      elGrafico: 'El gráfico' };
const letters = ['A', 'B', 'C', 'D'];
---
{slide.tipo === 'cover' && (
  <section class="slide s-cover">
    <svg class="slide__corner" viewBox="0 0 22 14"><path d="M1 13 C7 13 11 3 21 1" fill="none" stroke="var(--color-mustard)" stroke-width="1.3"/></svg>
    <div class="slide__pad">
      {s.eyebrow && <div class="slide__eyebrow">{s.eyebrow}</div>}
      <h1>{s.title}</h1>
      <div class="rule"></div>
      {s.subtitle && <div class="sub">{s.subtitle}</div>}
    </div>
    <div class="slide__foot"><span>{brand}</span><span>{pos}</span></div>
  </section>
)}

{slide.tipo === 'concept' && (
  <section class="slide s-concept">
    <svg class="slide__corner" viewBox="0 0 22 14"><path d="M1 13 C7 13 11 3 21 1" fill="none" stroke="var(--color-mustard)" stroke-width="1.3"/></svg>
    <div class="slide__pad">
      {s.eyebrow && <div class="slide__eyebrow">{s.eyebrow}</div>}
      {s.title && <h2>{s.title}</h2>}
      {s.body && <p class="body">{s.body}</p>}
      {s.pull && <p class="pull">{s.pull}</p>}
    </div>
    <div class="slide__foot"><span>{brand}</span><span>{pos}</span></div>
  </section>
)}

{slide.tipo === 'diagram' && (
  <section class="slide s-diagram">
    <svg class="slide__corner" viewBox="0 0 22 14" style="z-index:2"><path d="M1 13 C7 13 11 3 21 1" fill="none" stroke="var(--color-mustard)" stroke-width="1.3"/></svg>
    <div class="slide__pad">
      <div class="slide__eyebrow">{L.elGrafico}</div>
      {s.caption && <h2>{s.caption}</h2>}
      <div class="viz"><SlideDiagramMount diagrama={s.diagrama} /></div>
    </div>
    <div class="slide__foot"><span>{brand}</span><span>{pos}</span></div>
  </section>
)}

{slide.tipo === 'data' && (
  <section class="slide s-data">
    <div class="panel">
      <div class="num">{s.numero}</div>
      {s.label && <div class="label">{s.label}</div>}
    </div>
    <div class="bd">
      {s.title && <h2>{s.title}</h2>}
      {s.detalle && <p>{s.detalle}</p>}
    </div>
    <div class="slide__foot"><span>{brand}</span><span>{pos}</span></div>
  </section>
)}

{slide.tipo === 'quote' && (
  <section class="slide s-quote">
    <div class="slide__pad">
      <div class="mark">“</div>
      <blockquote>{s.texto}</blockquote>
    </div>
    <div class="slide__foot"><span>{brand}</span><span>{pos}</span></div>
  </section>
)}

{slide.tipo === 'exercise' && (
  <section class="slide s-exercise">
    <svg class="slide__corner" viewBox="0 0 22 14"><path d="M1 13 C7 13 11 3 21 1" fill="none" stroke="var(--color-mustard)" stroke-width="1.3"/></svg>
    <div class="slide__pad">
      <div class="slide__eyebrow">{L.ejercicio}</div>
      <h2>{s.title}</h2>
      {s.enunciado && <p class="enun">{s.enunciado}</p>}
      {Array.isArray(s.pasos) && s.pasos.length > 0 && (
        <ol>{s.pasos.map((p: string) => <li>{p}</li>)}</ol>
      )}
    </div>
    <div class="slide__foot"><span>{brand}</span><span>{pos}</span></div>
  </section>
)}

{slide.tipo === 'terms' && (
  <section class="slide s-terms">
    <svg class="slide__corner" viewBox="0 0 22 14"><path d="M1 13 C7 13 11 3 21 1" fill="none" stroke="var(--color-mustard)" stroke-width="1.3"/></svg>
    <div class="slide__pad">
      {s.eyebrow && <div class="slide__eyebrow">{s.eyebrow}</div>}
      {s.title && <h2>{s.title}</h2>}
      <div class="grid" data-n={s.terms.length}>
        {s.terms.map((t: { t: string; d: string }) => (
          <div class="term">
            <div class="term__t">{t.t}</div>
            <div class="term__d">{t.d}</div>
          </div>
        ))}
      </div>
    </div>
    <div class="slide__foot"><span>{brand}</span><span>{pos}</span></div>
  </section>
)}

{slide.tipo === 'table' && (
  <section class="slide s-table">
    <svg class="slide__corner" viewBox="0 0 22 14"><path d="M1 13 C7 13 11 3 21 1" fill="none" stroke="var(--color-mustard)" stroke-width="1.3"/></svg>
    <div class="slide__pad">
      {s.eyebrow && <div class="slide__eyebrow">{s.eyebrow}</div>}
      {s.title && <h2>{s.title}</h2>}
      <table>
        <thead><tr>{s.head.map((h: string) => <th>{h}</th>)}</tr></thead>
        <tbody>{s.rows.map((r: string[]) => <tr>{r.map((c: string, ci: number) => ci === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
      </table>
      {s.caption && <p class="cap">{s.caption}</p>}
    </div>
    <div class="slide__foot"><span>{brand}</span><span>{pos}</span></div>
  </section>
)}

{slide.tipo === 'split' && (
  <section class="slide s-split">
    <svg class="slide__corner" viewBox="0 0 22 14"><path d="M1 13 C7 13 11 3 21 1" fill="none" stroke="var(--color-mustard)" stroke-width="1.3"/></svg>
    <div class="slide__pad">
      {s.eyebrow && <div class="slide__eyebrow">{s.eyebrow}</div>}
      {s.title && <h2>{s.title}</h2>}
      <div class="cols">
        {[s.left, s.right].map((col: { h?: string; items: string[] }) => (
          <div class="col">
            {col.h && <div class="col__h">{col.h}</div>}
            <ul>{col.items.map((it: string) => <li>{it}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
    <div class="slide__foot"><span>{brand}</span><span>{pos}</span></div>
  </section>
)}

{slide.tipo === 'list' && (
  <section class="slide s-list">
    <svg class="slide__corner" viewBox="0 0 22 14"><path d="M1 13 C7 13 11 3 21 1" fill="none" stroke="var(--color-mustard)" stroke-width="1.3"/></svg>
    <div class="slide__pad">
      {s.eyebrow && <div class="slide__eyebrow">{s.eyebrow}</div>}
      {s.title && <h2>{s.title}</h2>}
      {s.ordered
        ? <ol class="items">{s.items.map((it: string) => <li>{it}</li>)}</ol>
        : <ul class="items">{s.items.map((it: string) => <li>{it}</li>)}</ul>}
    </div>
    <div class="slide__foot"><span>{brand}</span><span>{pos}</span></div>
  </section>
)}

{slide.tipo === 'figure' && (
  <section class="slide s-figure">
    <div class="img">
      {s.meta
        ? <Image src={s.meta} alt={s.alt} widths={[1280]} />
        : <div class="missing">{s.src}</div>}
    </div>
    <div class="strip">
      <div class="strip__text">
        {s.title && <div class="strip__title">{s.title}</div>}
        {s.caption && <div class="strip__cap">{s.caption}</div>}
      </div>
      {s.credit && <div class="strip__credit">{s.credit}</div>}
    </div>
    <div class="slide__foot slide__foot--figure"><span>{brand}</span><span>{pos}</span></div>
  </section>
)}

{slide.tipo === 'quiz' && (
  <section class="slide s-quiz">
    <svg class="slide__corner" viewBox="0 0 22 14"><path d="M1 13 C7 13 11 3 21 1" fill="none" stroke="var(--color-mustard)" stroke-width="1.3"/></svg>
    <div class="slide__pad">
      <div class="slide__eyebrow">{s.eyebrow ?? L.comprueba}</div>
      <h2>{s.pregunta}</h2>
      <ol class="opts">
        {s.opciones.map((o: string, oi: number) => (
          <li class:list={['opt', { 'opt--ok': oi === s.correcta }]}>
            <span class="opt__key">{letters[oi]}</span>
            <span class="opt__text">{o}</span>
          </li>
        ))}
      </ol>
      {s.explicacion && <p class="expl"><strong>{L.solucion}: {letters[s.correcta]}.</strong> {s.explicacion}</p>}
    </div>
    <div class="slide__foot"><span>{brand}</span><span>{pos}</span></div>
  </section>
)}

{slide.tipo === 'formula' && (
  <section class="slide s-formula">
    <svg class="slide__corner" viewBox="0 0 22 14"><path d="M1 13 C7 13 11 3 21 1" fill="none" stroke="var(--color-mustard)" stroke-width="1.3"/></svg>
    <div class="slide__pad">
      {s.eyebrow && <div class="slide__eyebrow">{s.eyebrow}</div>}
      {s.title && <h2>{s.title}</h2>}
      <p class="f">{s.formula}</p>
      {s.terminos && (
        <>
          <div class="lbl">{L.donde}</div>
          <dl class="legend">
            {s.terminos.map((t: { s: string; d: string }) => (<><dt>{t.s}</dt><dd>{t.d}</dd></>))}
          </dl>
        </>
      )}
      {s.ejemplo && <p class="ex"><span class="lbl">{L.ejemplo}</span>{s.ejemplo}</p>}
    </div>
    <div class="slide__foot"><span>{brand}</span><span>{pos}</span></div>
  </section>
)}

{slide.tipo === 'timeline' && (
  <section class="slide s-timeline">
    <svg class="slide__corner" viewBox="0 0 22 14"><path d="M1 13 C7 13 11 3 21 1" fill="none" stroke="var(--color-mustard)" stroke-width="1.3"/></svg>
    <div class="slide__pad">
      {s.eyebrow && <div class="slide__eyebrow">{s.eyebrow}</div>}
      {s.title && <h2>{s.title}</h2>}
      <ol class="rail" data-n={s.hitos.length}>
        {s.hitos.map((h: { fecha: string; hito: string; detalle?: string }) => (
          <li>
            <span class="dot" aria-hidden="true"></span>
            <span class="date">{h.fecha}</span>
            <span class="what">{h.hito}</span>
            {h.detalle && <span class="det">{h.detalle}</span>}
          </li>
        ))}
      </ol>
    </div>
    <div class="slide__foot"><span>{brand}</span><span>{pos}</span></div>
  </section>
)}

{slide.tipo === 'caso' && (
  <section class="slide s-caso">
    <svg class="slide__corner" viewBox="0 0 22 14"><path d="M1 13 C7 13 11 3 21 1" fill="none" stroke="var(--color-mustard)" stroke-width="1.3"/></svg>
    <div class="slide__pad">
      <div class="slide__eyebrow">{s.eyebrow || L.elCaso}</div>
      <h2>{s.title}</h2>
      <p class="ctx">{s.contexto}</p>
      {s.datos && (
        <ul class="datos">{s.datos.map((d: string) => <li>{d}</li>)}</ul>
      )}
      <p class="q"><span class="lbl">{L.pregunta}</span>{s.pregunta}</p>
    </div>
    <div class="slide__foot"><span>{brand}</span><span>{pos}</span></div>
  </section>
)}

{slide.tipo === 'recap' && (
  <section class="slide s-recap">
    <svg class="slide__corner" viewBox="0 0 22 14"><path d="M1 13 C7 13 11 3 21 1" fill="none" stroke="var(--color-mustard)" stroke-width="1.3"/></svg>
    <div class="slide__pad">
      <div class="slide__eyebrow">{s.eyebrow || L.repasa}</div>
      {s.title && <h2>{s.title}</h2>}
      <ul class="checks">
        {s.items.map((it: string) => (
          <li><span class="box" aria-hidden="true"></span><span>{it}</span></li>
        ))}
      </ul>
    </div>
    <div class="slide__foot"><span>{brand}</span><span>{pos}</span></div>
  </section>
)}

{slide.tipo === 'curriculum' && (
  <section class="slide s-curriculum">
    <svg class="slide__corner" viewBox="0 0 22 14"><path d="M1 13 C7 13 11 3 21 1" fill="none" stroke="var(--color-mustard)" stroke-width="1.3"/></svg>
    <div class="slide__pad">
      {s.eyebrow && <div class="slide__eyebrow">{s.eyebrow}</div>}
      {s.title && <h2>{s.title}</h2>}
      <div class="cols" data-n={s.criterios ? 3 : 2}>
        <div class="col">
          <div class="col__h">{L.saberes}</div>
          <ul>{s.saberes.map((x: string) => <li>{x}</li>)}</ul>
        </div>
        <div class="col">
          <div class="col__h">{L.competencias}</div>
          <ul>{s.competencias.map((x: string) => <li>{x}</li>)}</ul>
        </div>
        {s.criterios && (
          <div class="col">
            <div class="col__h">{L.criterios}</div>
            <ul>{s.criterios.map((x: string) => <li>{x}</li>)}</ul>
          </div>
        )}
      </div>
    </div>
    <div class="slide__foot"><span>{brand}</span><span>{pos}</span></div>
  </section>
)}

{slide.tipo === 'close' && (
  <section class="slide s-close">
    <div class="slide__pad">
      <h2>{s.title}</h2>
      {s.nota && <p>{s.nota}</p>}
    </div>
    <div class="slide__foot"><span>{brand}</span><span>{pos}</span></div>
  </section>
)}
