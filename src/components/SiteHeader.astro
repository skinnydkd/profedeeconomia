---
import { ASIGNATURAS_POR_ETAPA, SECCIONES_TRANSVERSALES } from '@/lib/asignaturas';
import { getLocale } from '@/i18n/locale';
import { t, type UIKey } from '@/i18n/ui';
import { localizeAsignatura } from '@/i18n/asignaturas-ca';
import LanguageSwitcher from '@components/LanguageSwitcher.astro';

const locale = getLocale(Astro.currentLocale);
---

<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="brand">
      <span class="brand-mono" aria-hidden="true"><span class="brand-mono-p">p</span><span class="brand-mono-dot">.</span></span>
      <span class="brand-word">profedeeconomia</span>
    </a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="nav-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
      {t('nav.menu', locale)}
    </button>
    <nav class="site-nav" id="site-nav" aria-label={t('nav.aria', locale)}>
      <!-- ESO -->
      <div class="nav-group" data-nav-group>
        <button class="nav-trigger" type="button" aria-haspopup="true" aria-expanded="false">
          {t('nav.eso', locale)}
          <span class="caret" aria-hidden="true">▾</span>
        </button>
        <div class="nav-dropdown" role="menu">
          <div class="dropdown-section">
            <span class="dropdown-label">{t('curso.3eso', locale)}</span>
            {ASIGNATURAS_POR_ETAPA.eso.cursos['3eso'].asignaturas.map((a0) => { const a = localizeAsignatura(a0, locale); return (
              <a href={`/${a.slug}/`} role="menuitem" class={a.estado === 'proximamente' ? 'is-proximamente' : ''}>
                {a.title}
                {a.estado === 'proximamente' && <span class="badge">{t('nav.proximamente', locale)}</span>}
              </a>
            ); })}
          </div>
          <div class="dropdown-section">
            <span class="dropdown-label">{t('curso.4eso', locale)}</span>
            {ASIGNATURAS_POR_ETAPA.eso.cursos['4eso'].asignaturas.map((a0) => { const a = localizeAsignatura(a0, locale); return (
              <a href={`/${a.slug}/`} role="menuitem">
                {a.title}
              </a>
            ); })}
          </div>
        </div>
      </div>

      <!-- BACH -->
      <div class="nav-group" data-nav-group>
        <button class="nav-trigger" type="button" aria-haspopup="true" aria-expanded="false">
          {t('nav.bach', locale)}
          <span class="caret" aria-hidden="true">▾</span>
        </button>
        <div class="nav-dropdown" role="menu">
          <div class="dropdown-section">
            <span class="dropdown-label">{t('curso.1bach', locale)}</span>
            {ASIGNATURAS_POR_ETAPA.bach.cursos['1bach'].asignaturas.map((a0) => { const a = localizeAsignatura(a0, locale); return (
              <a href={`/${a.slug}/`} role="menuitem">
                {a.title}
              </a>
            ); })}
          </div>
          <div class="dropdown-section">
            <span class="dropdown-label">{t('curso.2bach', locale)}</span>
            {ASIGNATURAS_POR_ETAPA.bach.cursos['2bach'].asignaturas.map((a0) => { const a = localizeAsignatura(a0, locale); return (
              <a href={`/${a.slug}/`} role="menuitem">
                {a.title}
              </a>
            ); })}
          </div>
          <div class="dropdown-section">
            <span class="dropdown-label">{t('curso.optativas', locale)}</span>
            {ASIGNATURAS_POR_ETAPA.bach.cursos.bach.asignaturas.map((a0) => { const a = localizeAsignatura(a0, locale); return (
              <a href={`/${a.slug}/`} role="menuitem" class={a.estado === 'proximamente' ? 'is-proximamente' : ''}>
                {a.title}
                {a.estado === 'proximamente' && <span class="badge">{t('nav.proximamente', locale)}</span>}
              </a>
            ); })}
          </div>
          <div class="dropdown-section">
            <span class="dropdown-label">{t('nav.preparacion', locale)}</span>
            <a href="/olimpiada/" role="menuitem">{t('nav.olimpiada', locale)}</a>
          </div>
        </div>
      </div>

      <!-- FP -->
      <div class="nav-group" data-nav-group>
        <button class="nav-trigger" type="button" aria-haspopup="true" aria-expanded="false">
          {t('nav.fp', locale)}
          <span class="caret" aria-hidden="true">▾</span>
        </button>
        <div class="nav-dropdown nav-dropdown--single" role="menu">
          <div class="dropdown-section">
            <span class="dropdown-label">{t('nav.ipe.group', locale)}</span>
            {ASIGNATURAS_POR_ETAPA.fp.cursos.fp.asignaturas.map((a0) => { const a = localizeAsignatura(a0, locale); return (
              <a href={`/${a.slug}/`} role="menuitem" class={a.estado === 'proximamente' ? 'is-proximamente' : ''}>
                <span class="opt-title">{a.shortLabel}</span>
                <span class="opt-desc">{a.slug === 'ipe1-fp' ? t('nav.ipe1.desc', locale) : t('nav.ipe2.desc', locale)}</span>
                {a.estado === 'proximamente' && <span class="badge">{t('nav.proximamente', locale)}</span>}
              </a>
            ); })}
          </div>
        </div>
      </div>

      <!-- Otros -->
      <div class="nav-group" data-nav-group>
        <button class="nav-trigger" type="button" aria-haspopup="true" aria-expanded="false">
          {t('nav.otros', locale)}
          <span class="caret" aria-hidden="true">▾</span>
        </button>
        <div class="nav-dropdown nav-dropdown--single" role="menu">
          {SECCIONES_TRANSVERSALES.map((s) => (
            <a href={`/${s.slug}/`} role="menuitem" class={s.slug === 'jocs-economics' ? 'is-olimpico' : ''}>
              <span class="opt-title">
                {s.slug === 'jocs-economics' && (
                  <span class="opt-rings" aria-hidden="true">
                    <svg viewBox="0 0 30 16" width="22" height="12" fill="none" stroke-width="1.7">
                      <circle cx="6" cy="6" r="4.2" stroke="var(--color-eco1)" />
                      <circle cx="15" cy="6" r="4.2" stroke="var(--color-ink)" />
                      <circle cx="24" cy="6" r="4.2" stroke="var(--color-terra)" />
                      <circle cx="10.5" cy="10" r="4.2" stroke="var(--color-mustard)" />
                      <circle cx="19.5" cy="10" r="4.2" stroke="var(--color-gpe)" />
                    </svg>
                  </span>
                )}
                {t(`sec.${s.slug}.label` as UIKey, locale)}
              </span>
              <span class="opt-desc">{t(`sec.${s.slug}.desc` as UIKey, locale)}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Oposiciones (link directe, sense dropdown) -->
      <a href="/oposiciones" class="nav-direct" rel="external">{t('nav.oposiciones', locale)}</a>
      <LanguageSwitcher />
    </nav>
  </div>
</header>

<script>
  // Click toggle per a dropdowns (a part del hover/focus-within que ja funciona via CSS).
  // Necessari per accessibilitat al mòbil i per teclat.
  const groups = document.querySelectorAll<HTMLElement>('[data-nav-group]');

  // Phone menu: the nav does not fit beside the wordmark below ~760px, so it
  // collapses into a panel toggled by this button (CSS handles the breakpoint;
  // on desktop the button is display:none and never fires).
  const header = document.querySelector<HTMLElement>('.site-header');
  const navToggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');

  function closeGroups(): void {
    groups.forEach((g) => {
      g.classList.remove('is-open');
      g.querySelector<HTMLButtonElement>('.nav-trigger')?.setAttribute('aria-expanded', 'false');
    });
  }

  function setMenu(open: boolean): void {
    header?.classList.toggle('is-menu-open', open);
    navToggle?.setAttribute('aria-expanded', String(open));
    if (!open) closeGroups();
  }

  navToggle?.addEventListener('click', () => {
    setMenu(!header?.classList.contains('is-menu-open'));
  });

  groups.forEach((group) => {
    const trigger = group.querySelector<HTMLButtonElement>('.nav-trigger');
    const dropdown = group.querySelector<HTMLElement>('.nav-dropdown');
    if (!trigger || !dropdown) return;

    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      const isOpen = group.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', String(isOpen));

      // Tancar els altres grups
      groups.forEach((g) => {
        if (g !== group) {
          g.classList.remove('is-open');
          g.querySelector<HTMLButtonElement>('.nav-trigger')?.setAttribute('aria-expanded', 'false');
        }
      });
    });
  });

  // Tancar dropdowns (i el menu de mobil) en clicar fora
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    // The toggle handles itself; clicks inside the panel must not close it.
    if (target.closest('[data-nav-toggle]') || target.closest('#site-nav')) return;
    closeGroups();
    setMenu(false);
  });

  // ESC tanca tots
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const menuWasOpen = header?.classList.contains('is-menu-open');
    closeGroups();
    setMenu(false);
    if (menuWasOpen) navToggle?.focus();
  });
</script>

<style>
  .site-header {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .site-header-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 1.1rem clamp(1.5rem, 4vw, 3rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .brand {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    text-decoration: none;
    flex: none;
  }
  /* Logo A — monograma "p." (p italic terracota + punt mostassa) */
  .brand-mono {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-variation-settings: "SOFT" 100, "WONK" 1;
    line-height: 1;
  }
  .brand-mono-p {
    color: var(--color-terra);
    font-weight: 600;
    font-style: italic;
  }
  .brand-mono-dot {
    color: var(--color-mustard);
    font-weight: 700;
    margin-left: -0.32em;
  }
  .brand-word {
    color: var(--color-ink);
    font-variation-settings: "SOFT" 60, "WONK" 0;
    transition: color .15s ease;
  }
  .brand:hover .brand-word { color: var(--color-terra); }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: nowrap;
  }

  /* ──────────── nav-trigger (botons d'etapa amb dropdown) ──────────── */
  .nav-group {
    position: relative;
  }
  .nav-trigger {
    background: transparent;
    border: 0;
    color: var(--color-ink-soft);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.45rem 0.7rem;
    cursor: pointer;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: color .15s ease, background .15s ease;
    letter-spacing: 0.02em;
  }
  .nav-trigger:hover,
  .nav-trigger:focus-visible {
    color: var(--color-terra);
  }
  .caret {
    font-size: 0.65em;
    color: var(--color-ink-mute);
    transition: transform .15s ease, color .15s ease;
  }
  .nav-group.is-open .caret,
  .nav-group:hover .caret,
  .nav-group:focus-within .caret {
    color: var(--color-terra);
    transform: rotate(180deg);
  }

  /* ──────────── dropdown (hover/focus/click) ──────────── */
  .nav-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%) translateY(-4px);
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(42, 31, 24, 0.08);
    padding: 1rem 1.1rem;
    min-width: 280px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity .15s ease, transform .15s ease, visibility .15s;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    z-index: 60;
  }
  .nav-dropdown--single {
    min-width: 240px;
    gap: 0.1rem;
  }
  /* Pont invisible sobre el buit de 6px trigger↔dropdown: evita que el :hover
     caiga quan el cursor baixa cap a una assignatura i tanque el menú. */
  .nav-dropdown::before {
    content: "";
    position: absolute;
    top: -8px;
    left: 0;
    right: 0;
    height: 8px;
  }

  .nav-group:hover .nav-dropdown,
  .nav-group:focus-within .nav-dropdown,
  .nav-group.is-open .nav-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  /* ──────────── seccions del dropdown ──────────── */
  .dropdown-section {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .dropdown-section + .dropdown-section {
    border-top: 1px dashed var(--color-line);
    padding-top: 0.7rem;
    margin-top: 0.2rem;
  }
  .dropdown-label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--color-terra);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    margin-bottom: 0.3rem;
  }

  /* enllaços dins dropdown */
  .nav-dropdown a {
    color: var(--color-ink);
    text-decoration: none;
    padding: 0.5rem 0.55rem;
    border-radius: 4px;
    font-family: var(--font-serif);
    font-size: 0.98rem;
    line-height: 1.3;
    transition: background .12s ease, color .12s ease;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
  }
  .nav-dropdown a:hover,
  .nav-dropdown a:focus-visible {
    background: var(--color-bg-cream);
    color: var(--color-terra);
  }
  .nav-dropdown a.is-proximamente {
    color: var(--color-ink-soft);
  }
  .badge {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    background: var(--color-line);
    color: var(--color-ink-mute);
    padding: 0.15em 0.5em;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    flex: none;
  }

  /* opt amb descripció (per a "Otros") */
  .opt-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 500;
    display: block;
  }
  /* Olympic-rings flourish for «Jocs Econòmics» (visual only), in palette tones. */
  .opt-rings {
    display: inline-flex;
    vertical-align: middle;
    margin-right: 0.45rem;
    transform: translateY(-0.05em);
  }
  .opt-rings svg { display: block; height: 0.78rem; width: auto; }
  .nav-dropdown a.is-olimpico:hover .opt-rings svg,
  .nav-dropdown a.is-olimpico:focus-visible .opt-rings svg { opacity: 0.95; }
  .opt-desc {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--color-ink-mute);
    margin-top: 0.1rem;
    display: block;
    flex-basis: 100%;
  }
  .nav-dropdown--single a {
    flex-direction: column;
    align-items: flex-start;
    padding: 0.55rem 0.55rem 0.65rem;
  }

  /* ──────────── boto de menu (nomes telefon) ──────────── */
  .nav-toggle {
    display: none; /* the phone media query below turns it on */
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: 0;
    color: var(--color-ink-soft);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0.45rem 0.2rem;
    cursor: pointer;
  }
  .nav-toggle:hover { color: var(--color-terra); }
  .nav-toggle-bars {
    display: inline-flex;
    flex-direction: column;
    justify-content: space-between;
    width: 1.05rem;
    height: 0.72rem;
  }
  .nav-toggle-bars span {
    display: block;
    height: 1.5px;
    width: 100%;
    background: currentColor;
    border-radius: 1px;
    transition: transform .18s var(--ease-soft), opacity .12s ease;
  }
  /* Bars fold into a cross while the panel is open. */
  .site-header.is-menu-open .nav-toggle-bars span:nth-child(1) { transform: translateY(0.345rem) rotate(45deg); }
  .site-header.is-menu-open .nav-toggle-bars span:nth-child(2) { opacity: 0; }
  .site-header.is-menu-open .nav-toggle-bars span:nth-child(3) { transform: translateY(-0.345rem) rotate(-45deg); }

  /* ──────────── link directe (Oposiciones) ──────────── */
  .nav-direct {
    color: var(--color-ink-soft);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.45rem 0.7rem;
    transition: color .15s ease;
    letter-spacing: 0.02em;
  }
  .nav-direct:hover { color: var(--color-terra); }

  /* ──────────── tablet: same inline nav, tighter ──────────── */
  @media (max-width: 860px) {
    .site-header-inner {
      gap: 0.8rem;
      padding: 0.9rem 1.2rem;
    }
    .brand { font-size: 1.1rem; }
    .site-nav {
      gap: 0.05rem;
    }
    .nav-trigger,
    .nav-direct {
      padding: 0.4rem 0.45rem;
      font-size: 0.82rem;
    }
    .nav-dropdown {
      min-width: 220px;
      padding: 0.8rem 0.9rem;
      left: auto;
      right: 0;
      transform: translateY(-4px);
    }
    .nav-group:hover .nav-dropdown,
    .nav-group:focus-within .nav-dropdown,
    .nav-group.is-open .nav-dropdown {
      transform: translateY(0);
    }
  }

  /* ──────────── phone: the nav collapses into a panel ────────────
     The five groups plus the language switcher need ~336px, and the wordmark
     another ~205px. Below this width they cannot share a row, and the old
     `flex-wrap: nowrap` row simply ran off-screen — that is what made every
     page scroll sideways with a dead gutter on the right. */
  @media (max-width: 760px) {
    .nav-toggle { display: inline-flex; }

    .site-nav {
      display: none;
      position: absolute; /* .site-header is sticky, so this anchors to it */
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.3rem clamp(1.2rem, 4vw, 2rem) 1.1rem;
      background: var(--color-paper);
      border-bottom: 1px solid var(--color-line);
      box-shadow: 0 14px 28px rgba(42, 31, 24, 0.10);
      max-height: calc(100vh - 100%);
      max-height: calc(100dvh - 100%);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .site-header.is-menu-open .site-nav { display: flex; }

    .nav-group { position: static; }
    .nav-trigger,
    .nav-direct {
      width: 100%;
      font-size: 1rem;
      padding: 0.8rem 0.2rem;
      border-radius: 0;
      border-bottom: 1px solid var(--color-line-soft);
    }
    .nav-trigger { justify-content: space-between; }
    .caret { display: inline; font-size: 0.72em; }

    /* Dropdowns become an in-flow accordion inside the panel. */
    .nav-dropdown {
      position: static;
      min-width: 0;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      background: transparent;
      padding: 0.55rem 0 0.85rem 0.7rem;
      gap: 0.9rem;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }
    .nav-dropdown::before { content: none; }

    /* Touch devices latch :hover, so only an explicit tap opens a group. These
       must out-specify the base hover/focus rules, which carry the
       translateX(-50%) centring meant for the absolute desktop dropdown. */
    .nav-dropdown,
    .nav-group:hover .nav-dropdown,
    .nav-group:focus-within .nav-dropdown,
    .nav-group.is-open .nav-dropdown { transform: none; display: none; }
    .nav-group.is-open .nav-dropdown { display: flex; }

    .site-nav :global(.lang-switch) { margin: 1rem 0 0; }
    .site-nav :global(.lang-opt) { font-size: 0.82rem; padding: 0.35rem 0.55rem; }
  }
</style>
