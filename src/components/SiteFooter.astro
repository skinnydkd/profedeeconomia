---
import { getLocale } from '@/i18n/locale';
import { t } from '@/i18n/ui';
import LanguageSwitcher from '@components/LanguageSwitcher.astro';

const year = new Date().getFullYear();
const locale = getLocale(Astro.currentLocale);
const licence = {
  es: { pre: 'Materiales bajo licencia', post: `Para citarlos: «profedeeconomia.es, asignatura, unidad N, ${year}».`, href: 'https://creativecommons.org/licenses/by-nc-sa/4.0/deed.es' },
  ca: { pre: 'Materials amb llicència', post: `Per a citar-los: «profedeeconomia.es, assignatura, unitat N, ${year}».`, href: 'https://creativecommons.org/licenses/by-nc-sa/4.0/deed.ca' },
}[locale];
---

<footer class="site-footer">
  <div class="container">
    <div>profedeeconomia.es — {t('footer.tagline', locale)} · {year}</div>
    <div class="footer-links">
      <a href="/sobre/">{t('footer.sobre', locale)}</a> ·
      <a href="/contacto/">{t('footer.contacto', locale)}</a> ·
      <a href="/legal/aviso-legal/">{t('footer.avisoLegal', locale)}</a> ·
      <a href="/legal/privacidad/">{t('footer.privacidad', locale)}</a>
      <LanguageSwitcher />
    </div>
    <p class="footer-licence">
      {licence.pre} <a href={licence.href} rel="license noopener">CC BY-NC-SA 4.0</a>. {licence.post}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg);
    border-top: 1px solid var(--color-line);
    padding: 3.5rem 0 2.5rem;
    font-size: 0.95rem;
    color: var(--color-ink-mute);
  }
  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4vw, 3rem);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
  }
  .footer-licence { flex-basis: 100%; margin: 0; font-size: 0.85rem; }
  .container a { color: var(--color-ink-soft); text-decoration: none; }
  .container a:hover { color: var(--color-terra); }
</style>
