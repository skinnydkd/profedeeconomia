---
/** Renders the teacher tool island matching `componente`. */
import CalificacionesCalc from '@components/generadores/CalificacionesCalc.tsx';
import RubricaGenerator from '@components/generadores/RubricaGenerator.tsx';
import PlanRefuerzo from '@components/generadores/PlanRefuerzo.tsx';
import RegistroAula from '@components/generadores/RegistroAula.tsx';
import MedidasDUA from '@components/generadores/MedidasDUA.tsx';
import Autoevaluacion from '@components/generadores/Autoevaluacion.tsx';
import { type Locale } from '@/i18n/locale';

/**
 * `locale` is an explicit prop (default 'es'), mirroring the /herramientas
 * dispatch. These teacher tools render only on the localized detail page.
 */
interface Props { componente?: string; locale?: Locale }
const { componente, locale = 'es' } = Astro.props;
---
{componente === 'Calificaciones' && <CalificacionesCalc client:load locale={locale} />}
{componente === 'Rubrica' && <RubricaGenerator client:load locale={locale} />}
{componente === 'PlanRefuerzo' && <PlanRefuerzo client:load locale={locale} />}
{componente === 'RegistroAula' && <RegistroAula client:load locale={locale} />}
{componente === 'MedidasDUA' && <MedidasDUA client:load locale={locale} />}
{componente === 'Autoevaluacion' && <Autoevaluacion client:load locale={locale} />}
